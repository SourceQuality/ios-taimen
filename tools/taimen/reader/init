#!/bin/busybox sh
# taimen log reader: the /init of tools/taimen/mkreader.sh's boot image, which sits on both
# boot slots. After an XNU run (PS_HOLD reset) ABL boots it: it collects XNU's logs, shows
# them to the PC as a read-only USB drive labelled TAIMENLOG, then reboots into fastboot.
#   pstore-*        /sys/fs/pstore (console-ramoops = XNU's PRZ at 0xb0080000)
#   sweetlog.bin    last 1025 4K blocks of userdata: the kernel's 4 MiB UFS log ring (ufsrw=1)
#   shim-log.bin    first 64 4K blocks of align_parti: the shim's RAM log
#   reader.txt      this script's own log and dmesg
# Boot-arg-free: everything runs from here, and a 150 s guard reboots into fastboot whatever
# happens.
/bin/busybox mkdir -p /proc /sys /dev /tmp /mnt /out /bin
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox --install -s /bin
export PATH=/bin
mount -t tmpfs tmpfs /dev
mdev -s
mount -t tmpfs -o size=128m tmpfs /tmp
log() { echo "taimen-reader: $*" > /dev/kmsg; echo "$(cut -d' ' -f1 /proc/uptime) $*" >> /out/reader.txt; }
(sleep 150; log "guard: 150 s, rebooting into fastboot"; /bin/rebootbl bootloader) &
log "start, cmdline: $(cat /proc/cmdline)"

mkdir -p /sys/fs/pstore
mount -t pstore pstore /sys/fs/pstore && for f in /sys/fs/pstore/*; do
	[ -f "$f" ] && cp "$f" "/out/pstore-$(basename "$f")"
done
log "pstore: $(ls -l /sys/fs/pstore 2>&1 | tr '\n' ' ')"

# userdata appears once the UFS host has probed its LUNs
dev=
for i in $(seq 1 30); do
	mdev -s
	for u in /sys/class/block/*/uevent; do
		grep -q '^PARTNAME=userdata$' "$u" && dev=$(sed -n 's/^DEVNAME=//p' "$u")
	done
	[ -n "$dev" ] && [ -b "/dev/$dev" ] && break
	sleep 1
done
if [ -n "$dev" ] && [ -b "/dev/$dev" ]; then
	blocks=$(( $(cat "/sys/class/block/$dev/size") / 8 ))
	dd if="/dev/$dev" of=/out/sweetlog.bin bs=4096 skip=$((blocks - 1025)) count=1025 2>> /out/reader.txt
	log "userdata /dev/$dev, $blocks 4K blocks, ring area copied"
else
	log "userdata not found"
fi
# the shim's own RAM log (shim/ufs_taimen.c: the first blocks of align_parti)
ap=
for u in /sys/class/block/*/uevent; do
	grep -q '^PARTNAME=align_parti$' "$u" && ap=$(sed -n 's/^DEVNAME=//p' "$u")
done
if [ -n "$ap" ] && [ -b "/dev/$ap" ]; then
	dd if="/dev/$ap" of=/out/shim-log.bin bs=4096 count=64 2>> /out/reader.txt
	log "align_parti /dev/$ap: shim log copied"
fi

# The Adreno 540 firmware (docs/taimen-gpu-plan.md section 6) from the vendor partition, read-only;
# a few hundred KB, prefixed fw- so the drive stays flat. Not for git: tools/taimen/reader-pull.ps1
# copies it with the logs and the PC moves it to ../research/taimen/firmware.
vd=
for s in vendor_a vendor_b; do
	for u in /sys/class/block/*/uevent; do
		grep -q "^PARTNAME=$s\$" "$u" && vd=$(sed -n 's/^DEVNAME=//p' "$u")
	done
	[ -n "$vd" ] && break
done
if [ -n "$vd" ] && [ -b "/dev/$vd" ]; then
	mkdir -p /vendor
	if mount -t ext4 -o ro,noload "/dev/$vd" /vendor 2>> /out/reader.txt; then
		ls -l /vendor/firmware > /out/fw-list.txt 2>&1
		for f in /vendor/firmware/a5*; do
			[ -f "$f" ] && cp "$f" "/out/fw-$(basename "$f")"
		done
		# the WLAN PD firmware the modem fetches over TFTP (docs/taimen-wifi-plan.md stage 4), ~3.8 MB
		for f in wlanmdsp.mbn bdwlan.bin bdwlan.b09 modemuw.jsn; do
			[ -f "/vendor/firmware/$f" ] && cp "/vendor/firmware/$f" "/out/fw-$f"
		done
		ls -lR /vendor/firmware/wlan > /out/fw-wlan-list.txt 2>&1
		# the ADSP and TAS2557 speaker-amp firmware (docs/taimen-audio-plan.md stage 1), ~9.4 MB,
		# and the Android audio routing tables (open question 5)
		for f in /vendor/firmware/adsp.* /vendor/firmware/tas2557s_*.bin /vendor/etc/mixer_paths*.xml /vendor/etc/audio_platform_info*.xml; do
			[ -f "$f" ] && cp "$f" "/out/fw-$(basename "$f")"
		done
		# the SLPI (sensor DSP) firmware, ~3.9 MB (docs/taimen-sensors-plan.md section 2.1)
		for f in /vendor/firmware/slpi_v2.*; do
			[ -f "$f" ] && cp "$f" "/out/fw-$(basename "$f")"
		done
		umount /vendor
		log "vendor /dev/$vd: $(ls /out | grep -c '^fw-a5') GPU and $(ls /out | grep -c '^fw-wlanmdsp\|^fw-bdwlan\|^fw-modemuw') WLAN firmware files copied"
	else
		log "vendor /dev/$vd: mount failed"
	fi
else
	log "vendor partition not found"
fi

# The sensor registry the SLPI asks the AP for (docs/taimen-sensors-plan.md 2.2: the phone's own
# calibration in /persist/sensors/sns.reg), read-only, as fw-sns.reg with a listing.
pd=
for u in /sys/class/block/*/uevent; do
	grep -q "^PARTNAME=persist\$" "$u" && pd=$(sed -n 's/^DEVNAME=//p' "$u")
done
if [ -n "$pd" ] && [ -b "/dev/$pd" ]; then
	mkdir -p /persist
	if mount -t ext4 -o ro,noload "/dev/$pd" /persist 2>> /out/reader.txt; then
		ls -lR /persist/sensors > /out/fw-persist-sensors-list.txt 2>&1
		[ -f /persist/sensors/sns.reg ] && cp /persist/sensors/sns.reg /out/fw-sns.reg
		umount /persist
		log "persist /dev/$pd: sensors listed$([ -f /out/fw-sns.reg ] && echo ', sns.reg copied')"
	else
		log "persist /dev/$pd: mount failed"
	fi
else
	log "persist partition not found"
fi

dmesg > /out/dmesg.txt
dd if=/dev/zero of=/tmp/log.img bs=1048576 count=48 2>/dev/null
mkdosfs -n TAIMENLOG /tmp/log.img > /dev/null
mount -o loop /tmp/log.img /mnt && cp /out/* /mnt/ && sync && umount /mnt
log "FAT image ready: $(ls /out | tr '\n' ' ')"

mount -t configfs none /sys/kernel/config
G=/sys/kernel/config/usb_gadget/reader
mkdir -p $G/strings/0x409 $G/functions/mass_storage.0 $G/configs/c.1/strings/0x409
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo taimen-reader > $G/strings/0x409/serialnumber
echo ios-taimen > $G/strings/0x409/manufacturer
echo "taimen log reader" > $G/strings/0x409/product
echo "logs" > $G/configs/c.1/strings/0x409/configuration
echo 1 > $G/functions/mass_storage.0/lun.0/removable
echo 1 > $G/functions/mass_storage.0/lun.0/ro
echo /tmp/log.img > $G/functions/mass_storage.0/lun.0/file
ln -s $G/functions/mass_storage.0 $G/configs/c.1/
udc=$(ls /sys/class/udc | head -1)
echo "$udc" > $G/UDC
log "gadget on $udc: $(cat $G/UDC 2>&1)"

# The PC copies the drive within a few seconds of seeing it and then ejects it
# (tools/taimen/reader-pull.ps1): f_mass_storage closes the LUN and its file attribute goes
# empty. Reboot then, or after 45 s if no eject comes.
for i in $(seq 1 45); do
	sleep 1
	if [ -z "$(cat $G/functions/mass_storage.0/lun.0/file 2>/dev/null)" ]; then
		log "the host ejected the drive after $i s"
		break
	fi
done
log "done, rebooting into fastboot"
echo "" > $G/UDC
sync
/bin/rebootbl bootloader
