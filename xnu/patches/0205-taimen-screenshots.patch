+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * TAIMEN: the panel has never shown a kernel frame, so look at the pixels another way.
+ * sweet_fb_screenshot() prints RGB thumbnails of the last surface backboardd swapped and of
+ * the panel memory into the console log, which the UFS log and the log reader bring back:
+ * "SHOT name w h", base64 "SHOT64" lines, "SHOT END name" (tools/taimen/shots.py -> PNG).
+ */
+static uintptr_t sweet_fb_panel;
+static uint32_t sweet_fb_panel_w, sweet_fb_panel_h, sweet_fb_panel_bpr;
+static uint32_t sweet_fb_last_id;
+
+static void
+sweet_fb_shot(const char *what, uintptr_t base, uint32_t w, uint32_t h, uint32_t bpr, uint32_t step)
+{
+	static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+	uint32_t ow = w / step, oh = h / step;
+	char line[97];
+	uint8_t acc[3];
+	int n = 0, na = 0;
+
+	IOLog("SHOT %s %u %u\n", what, ow, oh);
+	for (uint32_t y = 0; y < oh; y++) {
+		const volatile uint32_t *row = (const volatile uint32_t *)(base + (uint64_t)y * step * bpr);
+		for (uint32_t x = 0; x < ow; x++) {
+			uint32_t p = row[x * step];     /* BGRA in memory: 0xAARRGGBB */
+			uint8_t rgb[3] = { (uint8_t)(p >> 16), (uint8_t)(p >> 8), (uint8_t)p };
+			for (int k = 0; k < 3; k++) {
+				acc[na++] = rgb[k];
+				if (na < 3) {
+					continue;
+				}
+				line[n++] = b64[acc[0] >> 2];
+				line[n++] = b64[((acc[0] & 3) << 4) | (acc[1] >> 4)];
+				line[n++] = b64[((acc[1] & 15) << 2) | (acc[2] >> 6)];
+				line[n++] = b64[acc[2] & 63];
+				na = 0;
+				if (n == 96) {
+					line[n] = 0;
+					IOLog("SHOT64 %s\n", line);
+					n = 0;
+				}
+			}
+		}
+	}
+	if (n != 0) {   /* ow * oh * 3 bytes: whole groups, no padding */
+		line[n] = 0;
+		IOLog("SHOT64 %s\n", line);
+	}
+	IOLog("SHOT END %s\n", what);
+}
+
+extern "C" void sweet_fb_screenshot(const char *tag);
+void
+sweet_fb_screenshot(const char *tag)
+{
+	char name[48];
+	int muted = sweet_console_muted;
+
+	sweet_console_muted = 1;        /* the log only; drawing ~6000 lines would take seconds */
+	SweetSurface *s = sweet_fb_last_id ? sweet_surface_copy(sweet_fb_last_id) : NULL;
+	if (s != NULL && s->kernelAddress() != 0 && (s->bytesPerElement == 4 || s->bytesPerElement == 0)) {
+		snprintf(name, sizeof(name), "%s-surface%u", tag, s->id);
+		sweet_fb_shot(name, s->kernelAddress() + s->offset, s->width, s->height, s->bytesPerRow, 5);
+	} else {
+		IOLog("SHOT %s: no swapped surface (last id %u)\n", tag, sweet_fb_last_id);
+	}
+	OSSafeReleaseNULL(s);
+	if (sweet_fb_panel != 0) {
+		snprintf(name, sizeof(name), "%s-panel", tag);
+		sweet_fb_shot(name, sweet_fb_panel, sweet_fb_panel_w, sweet_fb_panel_h, sweet_fb_panel_bpr, 10);
+	}
+	sweet_console_muted = muted;
+}
+#endif
+
