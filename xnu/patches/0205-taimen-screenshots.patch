 	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH,
 	    fScaled ? ", scaled to the 24 bpp panel" : "");
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	sweet_fb_panel_w = fWidth;
+	sweet_fb_panel_h = fHeight;
+	sweet_fb_panel_bpr = fRowBytes;
+	sweet_fb_panel = fPixels;
+#endif
 	return true;
 }
 
