@@ -2229,6 +2328,16 @@ cp_test(vm_offset_t gpu, int level)
 			return;
 		}
 		blit_test(gpu, smmu, scratch_va, scratch);
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+		/* E4 (0234): taimengpuclk=MHZ, then the blits again at that clock */
+		int mhz = 0;
+		if (PE_parse_boot_argn("taimengpuclk", &mhz, sizeof(mhz)) && mhz > 19) {
+			printf("SWEET GPU: XO measured %u MHz\n", taimen_gfx_measure(gpu));
+			if (taimen_gfx_set(gpu, (unsigned)mhz)) {
+				blit_test(gpu, smmu, scratch_va, scratch);
+			}
+		}
+#endif
 		if (level >= 4) {
 			gpu_wait(2);
 			compute_test(gpu, smmu, scratch_va, scratch);
