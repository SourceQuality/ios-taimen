+/*
+ * msm8998 power-domain level (mainline rpmpd.c: msm8998 "rwcx" / "rwmx" id 0, KEY_LEVEL "vlvl";
+ * levels 128 SVS, 256 NOM, 384 TURBO), enable "swen" = 1 with it, sleep and active set
+ * (taimen GPU clocks, docs/taimen-gpu-plan.md 2.4).
+ */
+bool sweet_rpm_rail_level(uint32_t type, uint32_t level);
+bool
+sweet_rpm_rail_level(uint32_t type, uint32_t level)
+{
+	uint32_t kv[4] = {0x6e657773u, 1u, 0x6c766c76u, level};          /* swen = 1, vlvl */
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request("rail sleep", 1, type, 0, kv, 2) && rpm_request("rail active", 0, type, 0, kv, 2);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: %c%c%c%c vlvl %u: %s\n", (char)type, (char)(type >> 8), (char)(type >> 16),
+	    (char)(type >> 24), level, ok ? "ok" : "FAILED");
+	return ok;
+}
+
 /* LDOn on at uv with a load of ma (key "ma": the RPM picks high-power mode for it). */
 bool
 sweet_rpm_ldoa_load(unsigned ldo, uint32_t uv, uint32_t ma)
