+
+/* ---- sessions (taimenmic>=5): the clock and TX path for a recording, the codec's TX port on channel 135 ---- */
+
+#define IFD_TX_PORT_MCH0_7      0x011Cu         /* SB_PGD_TX_PORT_MULTI_CHANNEL_0(7) */
+#define IFD_TX_PORT_MCH1_7      0x011Du         /* SB_PGD_TX_PORT_MULTI_CHANNEL_1(7) */
+#define IFD_TX_PORT_CFG_7       0x0057u         /* SB_PGD_PORT_CFG_BYTE_ADDR(0x50, 7): watermark 12 bytes, enable */
+#define IFD_INT_STATUS_TX_0     0x0036u         /* PGD_PORT_INT_STATUS_TX_0: bit 7 is port 7 */
+#define IFD_INT_CLR_TX_0        0x003Au         /* PGD_PORT_INT_CLR_TX_0 (WH tavil_slimbus_irq) */
+#define IFD_INT_SOURCE_TX_7     0x0077u         /* PGD_PORT_INT_RX_SOURCE0 + 16 + 7: bit 0 overflow, 1 underflow */
+#define IFD_INT_STATUS_7        0x0087u         /* L SLIM_PGD_PORT_INT_STATUS(7) */
+#define CODEC_TX_PORT           7u
+#define SLIM_CHANNEL            135u            /* WH msm8998.c tx_ch_tavil[7] */
+#define MC_DEF_ACT_CHAN         0x21u
+#define MC_CHAN_CTRL            0x23u
+#define MC_RECONFIG_NOW         0x24u
+#define MC_CONNECT_SRC          0x2Cu
+#define MC_DISCONNECT_PORT      0x2Eu
+
+extern int taimen_slim_user(unsigned mc, const uint8_t *pre, unsigned npre, const uint8_t *post, unsigned npost,
+    uint8_t *ack);
+extern uint32_t taimen_slim_int_stat(void);
+bool taimen_wcd_up(unsigned st, int dmic, bool census, bool verbose);
+void taimen_wcd_mute(bool mute);
+void taimen_wcd_settle(void);
+bool taimen_wcd_select(int dmic);
+void taimen_wcd_down(unsigned st, bool verbose);
+bool taimen_wcd_port_up(unsigned st, bool verbose);
+void taimen_wcd_port_down(unsigned st, bool verbose);
+bool taimen_wcd_port_log(unsigned st, const char *what);
+
+static const uint16_t sess_micb[3] = {R_MICB1, R_MICB3, R_MICB4};       /* DMIC0/1, DMIC2/3, DMIC4/5 */
+static const unsigned sess_micb_n[3] = {1, 3, 4};
+static bool sess_up, sess_census, port_connected, chan_defined;
+static int sess_dmic;
+
+static const char *
+ack_err(int e)
+{
+	return e == 0 ? "" : e == EIO ? " (NACK)" : e == ETIMEDOUT ? " (no ACK)" : " (not sent)";
+}
+
+/*
+ * The codec for a recording (WH __tavil_cdc_mclk_enable, the mixer path's muxes, the DMIC and DEC7
+ * widgets, as M4): DIV_CLK1, the SVS vote, master bias, MCLK_PRG, then DMICn -> DEC7 -> TX7 muted
+ * with the HPF at 150 Hz. census: MIC BIAS 1, 3, 4 and the DMIC0-2 clocks all on, for stepping.
+ */
+bool
+taimen_wcd_up(unsigned st, int dmic, bool census, bool verbose)
+{
+	int gain = 4, err;
+	bool rpm;
+	unsigned i, k;
+	uint8_t vol;
+
+	if (!m4_ok) {
+		LOG("%u: no codec (M4)", st);
+		return false;
+	}
+	(void)PE_parse_boot_argn("taimenmicgain", &gain, sizeof(gain));
+	if (gain < -84) {
+		gain = -84;
+	} else if (gain > 40) {
+		gain = 40;
+	}
+	vol = (uint8_t)(int8_t)gain;
+	sess_dmic = dmic >= 0 && dmic <= 5 ? dmic : 0;
+	sess_census = census;
+	k = (unsigned)sess_dmic / 2;
+	rpm = sweet_rpm_xo_buffer(RPM_DIV_CLK1);
+	sess_up = true;
+	tracking = false;
+	n_cdc_err = 0;
+	err = cdc_update(R_PSTATE_CTL_0, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x80, 0x80);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x40, 0x40);
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x40, 0x00);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x20, 0x00);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x80, 0x80);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x30, 0x00);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x02, 0x00);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_FS_CNT_CONTROL, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_MCLK_CONTROL, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_RPM_CLK_GATE, 0x03, 0x00);
+	delay(10);
+	err = err != 0 ? err : cdc_update(R_ADC_MUX3_CFG1, 0x0C, 0x00);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CFG0, 0x80, 0x80);
+	err = err != 0 ? err : cdc_update(R_ADC_MUX7_CFG0, 0x38, (uint8_t)((sess_dmic + 1) << 3));
+	err = err != 0 ? err : cdc_update(R_IF_ROUTER_TX_MUX_CFG1, 0xC0, 0x80);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x0F, 0x04);
+	for (i = 0; i < 3; i++) {
+		if (census || i == k) {
+			err = err != 0 ? err : cdc_update(sess_micb[i], 0xC0, 0x40);
+		}
+	}
+	taimen_mic_msleep(1);
+	for (i = 0; i < 3; i++) {
+		if (census || i == k) {
+			err = err != 0 ? err : cdc_update((uint16_t)(R_DMIC0_CTL + i), 0x0E, 2u << 1);
+			err = err != 0 ? err : cdc_update((uint16_t)(R_DMIC0_CTL + i), 0x01, 0x01);
+		}
+	}
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x10, 0x10);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x20, 0x20);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CFG0, 0x60, 2u << 5);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_SEC2, 0x02, 0x02);
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_SEC2, 0x02, 0x00);
+	err = err != 0 ? err : cdc_write(R_TX7_VOL_CTL, vol);
+	if (verbose || err != 0 || !rpm) {
+		LOG("%u: codec up: DIV_CLK1 %s; ANA_BIAS %#x MCLK_PRG %#x; DMIC%d%s -> DEC7: TX7 CTL %#x CFG0 %#x VOL %#x%s", st,
+		    rpm ? "on" : "NOT acked", cdc_get(R_ANA_BIAS), cdc_get(R_CLK_SYS_MCLK_PRG), sess_dmic,
+		    census ? " (census: MIC BIAS 1/3/4, DMIC0-2 clocks)" : "", cdc_get(R_TX7_PATH_CTL), cdc_get(R_TX7_PATH_CFG0),
+		    cdc_get(R_TX7_VOL_CTL), err != 0 ? " (an access FAILED)" : "");
+	}
+	if (err != 0) {
+		LOG("%u: codec register %#06x FAILED (%d)", st, first_bad_reg, first_bad_err);
+	}
+	return err == 0;
+}
+
+/* the PGA mute, lifted tx_unmute_delay (40 ms) after the start (WH tavil_tx_mute_update_callback) */
+void
+taimen_wcd_mute(bool mute)
+{
+	(void)cdc_update(R_TX7_PATH_CTL, 0x10, mute ? 0x10 : 0x00);
+}
+
+/* 300 ms after the start: the HPF back to its corner (0: 4 Hz) with the gate pulse (WH tx_hpf_corner_freq_callback) */
+void
+taimen_wcd_settle(void)
+{
+	(void)cdc_update(R_TX7_PATH_CFG0, 0x60, 0x00);
+	(void)cdc_update(R_TX7_PATH_SEC2, 0x02, 0x02);
+	taimen_mic_msleep(1);
+	(void)cdc_update(R_TX7_PATH_SEC2, 0x02, 0x00);
+}
+
+/* DMIC MUX7 = DMICn (its clock and bias must be on: the census) */
+bool
+taimen_wcd_select(int dmic)
+{
+	return dmic >= 0 && dmic <= 5 && cdc_update(R_ADC_MUX7_CFG0, 0x38, (uint8_t)((dmic + 1) << 3)) == 0;
+}
+
+void
+taimen_wcd_down(unsigned st, bool verbose)
+{
+	unsigned i, k = (unsigned)sess_dmic / 2;
+	bool off;
+
+	if (!sess_up) {
+		return;
+	}
+	(void)cdc_update(R_TX7_PATH_CTL, 0x10, 0x10);
+	(void)cdc_update(R_TX7_PATH_CTL, 0x20, 0x00);
+	for (i = 0; i < 3; i++) {
+		if (sess_census || i == k) {
+			(void)cdc_update((uint16_t)(R_DMIC0_CTL + i), 0x01, 0x00);
+			(void)cdc_update((uint16_t)(R_DMIC0_CTL + i), 0x0E, 5u << 1);
+			(void)cdc_update(sess_micb[i], 0xC0, 0x00);
+		}
+	}
+	(void)cdc_update(R_CLK_SYS_MCLK_PRG, 0x81, 0x00);
+	(void)cdc_update(R_ANA_BIAS, 0xA0, 0x00);
+	(void)cdc_update(R_PSTATE_CTL_0, 0x01, 0x00);
+	off = sweet_rpm_kv_both("clka div_clk1 off", RPM_CLKA, RPM_DIV_CLK1, RPM_SWEN, 0);
+	sess_up = false;
+	if (verbose || !off) {
+		LOG("%u: codec down: TX7 CTL %#x, MCLK_PRG %#x, ANA_BIAS %#x; MIC BIAS%u %#x; DIV_CLK1 off: %s", st,
+		    cdc_get(R_TX7_PATH_CTL), cdc_get(R_CLK_SYS_MCLK_PRG), cdc_get(R_ANA_BIAS), sess_micb_n[k], cdc_get(sess_micb[k]),
+		    off ? "ok" : "NOT acked");
+	}
+}
+
+/*
+ * The codec's TX port 7 on channel 135 (WH wcd9xxx_cfg_slim_sch_tx, ngd_allocbw; plan 2.7): the
+ * interface registers, CONNECT_SRC (LA, port, channel), DEF_ACT_CHAN (48 kHz, 16 bits, AUTO_ISO as
+ * downstream computes it: 0f 24 20 83, then the channel), RECONFIG_NOW; then the port's status cleared.
+ */
+bool
+taimen_wcd_port_up(unsigned st, bool verbose)
+{
+	int la5 = 1, e1, e2 = -1, e3 = -1;
+	uint8_t v[4] = {0xEE, 0xEE, 0xEE, 0xEE}, a1 = 0, a2 = 0, a3 = 0, pre[4], post[1];
+	bool ok;
+
+	(void)PE_parse_boot_argn("taimenmicla5", &la5, sizeof(la5));
+	ok = ifd_write(IFD_TX_OR_UR_CFG_7, 0x02) == 0 && ifd_write(IFD_TX_PORT_MCH0_7, 1u << CODEC_TX_PORT) == 0 &&
+	    ifd_write(IFD_TX_PORT_MCH1_7, 0x00) == 0 && ifd_write(IFD_TX_PORT_CFG_7, 0x05) == 0;
+	(void)ifd_read(IFD_TX_OR_UR_CFG_7, &v[0]);
+	(void)ifd_read(IFD_TX_PORT_MCH0_7, &v[1]);
+	(void)ifd_read(IFD_TX_PORT_MCH1_7, &v[2]);
+	(void)ifd_read(IFD_TX_PORT_CFG_7, &v[3]);
+	if (verbose || !ok) {
+		LOG("%u: ifd port 7: %02x %02x %02x %02x%s", st, v[0], v[1], v[2], v[3], ok ? "" : " (a write FAILED)");
+	}
+	if (!ok) {
+		return false;
+	}
+	pre[0] = la_gen;
+	pre[1] = CODEC_TX_PORT;
+	pre[2] = SLIM_CHANNEL;
+	e1 = taimen_slim_user(MC_CONNECT_SRC, pre, 3, NULL, 0, &a1);
+	port_connected = e1 == 0;
+	if (e1 == 0) {
+		pre[0] = (uint8_t)(la5 != 0 ? (la_gen & 0x1F) : la_gen);     /* data format 0 << 5 | LA */
+		pre[1] = 0x24;          /* 16 bits >> 2 | coefficient 3 << 5 */
+		pre[2] = 0x20;          /* root exponent 2 << 4 | HARD_ISO */
+		pre[3] = 0x83;          /* presence rate: the 4 kHz family, 12 = 3 x 2^2, exact */
+		post[0] = SLIM_CHANNEL;
+		e2 = taimen_slim_user(MC_DEF_ACT_CHAN, pre, 4, post, 1, &a2);
+		chan_defined = e2 == 0;
+	}
+	if (e2 == 0) {
+		post[0] = la_gen;
+		e3 = taimen_slim_user(MC_RECONFIG_NOW, NULL, 0, post, 1, &a3);
+	}
+	if (verbose || e3 != 0) {
+		LOG("%u: CONNECT_SRC %#x:7 -> 135 ack %#x%s; DEF_ACT_CHAN %02x 24 20 83 ack %#x%s; RECONFIG_NOW ack %#x%s", st,
+		    la_gen, a1, ack_err(e1), la5 != 0 ? (la_gen & 0x1F) : la_gen, a2, ack_err(e2), a3, ack_err(e3));
+	}
+	if (e3 != 0) {
+		taimen_wcd_port_down(st, true);
+		return false;
+	}
+	(void)ifd_write(IFD_INT_CLR_TX_0, 1u << CODEC_TX_PORT);       /* what latched before the channel ran */
+	return true;
+}
+
+/* CHAN_CTRL remove (2 << 6 | LA & 0x1F) and RECONFIG_NOW; a port connected without a channel: DISCONNECT_PORT */
+void
+taimen_wcd_port_down(unsigned st, bool verbose)
+{
+	uint8_t pre[2], post[1], a1 = 0, a2 = 0;
+	int e1 = -1, e2 = -1;
+
+	if (chan_defined) {
+		pre[0] = (uint8_t)(0x80 | (la_gen & 0x1F));
+		post[0] = SLIM_CHANNEL;
+		e1 = taimen_slim_user(MC_CHAN_CTRL, pre, 1, post, 1, &a1);
+		post[0] = la_gen;
+		e2 = taimen_slim_user(MC_RECONFIG_NOW, NULL, 0, post, 1, &a2);
+		if (verbose || e1 != 0 || e2 != 0) {
+			LOG("%u: channel 135 removed: CHAN_CTRL ack %#x%s, RECONFIG_NOW ack %#x%s", st, a1, ack_err(e1), a2,
+			    ack_err(e2));
+		}
+	} else if (port_connected) {
+		pre[0] = la_gen;
+		pre[1] = CODEC_TX_PORT;
+		e1 = taimen_slim_user(MC_DISCONNECT_PORT, pre, 2, NULL, 0, &a1);
+		LOG("%u: DISCONNECT_PORT %#x:7 ack %#x%s", st, la_gen, a1, ack_err(e1));
+	}
+	chan_defined = false;
+	port_connected = false;
+}
+
+/* The codec port's interrupt status (WH tavil_slimbus_irq: the summary, then the port's source byte). */
+bool
+taimen_wcd_port_log(unsigned st, const char *what)
+{
+	uint8_t sum = 0xEE, src = 0xEE, l = 0xEE;
+	bool okr, of, uf;
+
+	okr = ifd_read(IFD_INT_STATUS_TX_0, &sum) == 0 && ifd_read(IFD_INT_SOURCE_TX_7, &src) == 0;
+	(void)ifd_read(IFD_INT_STATUS_7, &l);
+	of = okr && (sum & 0x80) != 0 && (src & 0x01) != 0;
+	uf = okr && (sum & 0x80) != 0 && (src & 0x02) != 0;
+	LOG("%u: %s: codec port 7 tx status %#x source %#x int %#x (%s), NGD int %#x", st, what, sum, src, l,
+	    !okr ? "NOT read" : of ? "OVERFLOW: produced, not taken" : uf ? "underflow" : "no overflow", taimen_slim_int_stat());
+	return okr && !of && !uf;
 }
