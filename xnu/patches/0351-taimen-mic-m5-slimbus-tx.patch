+		sl.p.param_id = AFE_PARAM_ID_CDC_SLIMBUS_SLAVE_CFG;
+		sl.p.param_size = sizeof(sl.cfg);
+		sl.cfg.minor = 1;
+		sl.cfg.ea_lsw = 0x02500100u;            /* the generic device's EA 00 01 50 02 17 02 */
+		sl.cfg.ea_msw = 0x00000217u;
+		sl.cfg.tx_offset = 0;
+		sl.cfg.rx_offset = 16;
+		rs = apr_call("AFE SLIMBUS slave cfg", APR_SVC_AFE, 0, AFE_SVC_CMD_SET_PARAM, &sl, sizeof(sl), 1000);
+		mic_slave_sent = rs == 0;
+	}
+	struct afe_port_set_slim c;
+	bzero(&c, sizeof(c));
+	c.port_id = APR_PORT_SLIM0_TX;
+	c.payload_size = sizeof(c.p) + sizeof(c.cfg);
+	c.p.module_id = AFE_MODULE_AUDIO_DEV_INTERFACE;
+	c.p.param_id = AFE_PARAM_ID_SLIMBUS_CONFIG;
+	c.p.param_size = sizeof(c.cfg);
+	c.cfg.minor = 1;
+	c.cfg.dev_id = 0;                               /* AFE_SLIMBUS_DEVICE_1 */
+	c.cfg.bit_width = 16;
+	c.cfg.data_format = 0;
+	c.cfg.channels = 1;
+	c.cfg.map[0] = MIC_SLIM_CHANNEL;
+	c.cfg.rate = 48000;
