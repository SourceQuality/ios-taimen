+/*
+ * A user message to the manager (MT 2, LA 0xFF): pre, then a TID, then post; the manager's
+ * GENERIC_ACK (MT 6, MC 0x25: TID, code) answers it (WH ngd_xferandwait_ack, ngd_slim_rx). 0 when
+ * the code has bit 5 (success), EIO with the code in *ack otherwise, ETIMEDOUT, ENODEV.
+ */
+int
+taimen_slim_user(unsigned mc, const uint8_t *pre, unsigned npre, const uint8_t *post, unsigned npost, uint8_t *ack)
+{
+	uint8_t m[20];
+	uint8_t tid = tid_new();
+	unsigned rl;
+	int err;
+
+	*ack = 0;
+	if (npre + 1 + npost > 12) {
+		return EINVAL;
+	}
+	rl = hdr(m, MT_DEST_USER, mc, LA_MGR, npre + 1 + npost);
+	if (npre != 0) {
+		memcpy(m + 3, pre, npre);
+	}
+	m[3 + npre] = tid;
+	if (npost != 0) {
+		memcpy(m + 4 + npre, post, npost);
+	}
+	err = xfer(m, rl, (int)MC_GENERIC_ACK, tid, ACK_WAIT_MS);
+	if (err != 0) {
+		return err;
+	}
+	*ack = (uint8_t)(got_rl >= 5 ? got_buf[4] : 0);
+	return (*ack & SAT_SUCCESS) != 0 ? 0 : EIO;
+}
+
+/* INT_STAT, for a session's log (0 when the NGD is not up) */
+uint32_t
+taimen_slim_int_stat(void)
+{
+	return ngd_up && !slim_dead ? ngd_r(NGD_INT_STAT) : 0;
+}
+
+/*
+ * Before a session: the NGD as M1 left it (LADDR, INT_EN), or, if the ADSP reset the block
+ * (WH ngd_slim_power_up after a power collapse), enabled again with a new capability exchange.
+ */
+bool
+taimen_slim_resume(void)
+{
+	uint32_t st, ien;
+
+	if (!ngd_up || slim_dead) {
+		return false;
+	}
+	st = ngd_r(NGD_STATUS);
+	ien = ngd_r(NGD_INT_EN);
+	if ((st & NGD_LADDR) != 0 && ien != 0) {
+		return true;
+	}
+	LOG("slim: the NGD lost its state (status %#x int_en %#x): enabling it again", st, ien);
+	ngd_up = false;
+	cap_seen = false;
+	return taimen_slim_up(slim_idle);
+}
