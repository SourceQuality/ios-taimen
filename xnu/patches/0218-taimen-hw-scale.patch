+static void
+fbcon_vig0_save(void)
+{
+	volatile uint32_t *v = fbcon_vig0;
+	for (unsigned i = 0; i < sizeof(fbcon_vig0_abl) / 4; i++) {
+		fbcon_vig0_abl[i] = v[i];
+	}
+	for (unsigned i = 0; i < sizeof(fbcon_qseed_abl) / 4; i++) {
+		fbcon_qseed_abl[i] = v[VIG_QSEED + i];
+	}
+	fbcon_vig0_saved = true;
+}
+
+/* fbcon_kick_lock held, previous frame done: the caller flushes bit 0 and STARTs. */
+static void
+fbcon_geom_apply(uint32_t g)
+{
+	volatile uint32_t *v = fbcon_vig0, *q = fbcon_vig0 + VIG_QSEED;
+	if (g == 1) {
+		q[QS_OP_MODE] = fbcon_qseed_abl[QS_OP_MODE];
+		static const unsigned keep[] = {VIG_SRC_SIZE, VIG_SRC_IMG, VIG_SRC_XY, VIG_OUT_SIZE, VIG_OUT_XY,
+			                        VIG_SRC0, VIG_YSTRIDE0, VIG_YSTRIDE1, VIG_FORMAT, VIG_UNPACK, VIG_SRC_OP, VIG_DECIMATION};
+		for (unsigned i = 0; i < sizeof(keep) / sizeof(keep[0]); i++) {
+			v[keep[i]] = fbcon_vig0_abl[keep[i]];
+		}
+		for (unsigned i = 0; i < 12; i++) {
+			v[VIG_PE_FIRST + i] = fbcon_vig0_abl[VIG_PE_FIRST + i];
+		}
+		sweet_fbcon_geom = 0;
+		return;
+	}
+	bool scaled = g == 3, pe = scaled || (fbcon_vig0_abl[VIG_SRC_OP] & (1u << 31));
+	v[VIG_SRC_SIZE] = CANVAS_SIZE;
+	v[VIG_SRC_IMG] = CANVAS_SIZE;
+	v[VIG_SRC_XY] = 0;
+	v[VIG_OUT_SIZE] = scaled ? SCALED_SIZE : CANVAS_SIZE;
+	v[VIG_OUT_XY] = scaled ? 55u : (222u << 16 | 157u);
+	v[VIG_YSTRIDE1] = 0;
+	v[VIG_DECIMATION] = 0;
+	if (pe) {               /* pixel extension override: REQ_PIXELS = fetched size per plane */
+		v[VIG_SRC_OP] = fbcon_vig0_abl[VIG_SRC_OP] | (1u << 31);
+		for (unsigned c = 0; c < 3; c++) {
+			v[VIG_PE_FIRST + 4 * c + 0] = 0;
+			v[VIG_PE_FIRST + 4 * c + 1] = 0;
+			v[VIG_PE_FIRST + 4 * c + 2] = CANVAS_SIZE;
+		}
+	}
+	if (scaled) {           /* 21-bit fraction: floor(2^21 * 1125 / 1330), floor(2^21 * 2436 / 2880) */
+		q[QS_PHASE_INIT] = 0;
+		q[QS_STEP_Y_H] = 0x001b1152u;
+		q[QS_STEP_Y_V] = 0x001b1111u;
+		q[QS_STEP_UV_H] = 0x001b1152u;
+		q[QS_STEP_UV_V] = 0x001b1111u;
+		q[QS_PRELOAD] = 0x03040304u;
+		q[QS_SRC_Y] = CANVAS_SIZE;
+		q[QS_SRC_UV] = CANVAS_SIZE;
+		q[QS_DST] = SCALED_SIZE;
+		__builtin_arm_dsb(DSB_SY);
+		q[QS_OP_MODE] = 0x80034001u;    /* EN | 8-bit | bilinear Y/RGB | blend_cfg, last */
+	} else {
+		q[QS_OP_MODE] = fbcon_qseed_abl[QS_OP_MODE];
+	}
