+/*
+ * MDP register census for the hardware scaling (docs/taimen-display-scaling-plan.md E0):
+ * only the ranges of this phone's DT qcom,regs-dump-mdp list (what Linux dumps with the
+ * MDP clocked), MDSS-relative, in the "DISP" line format. At 0 s (ABL's state) and 60 s
+ * (after AppleCLCD's geometry change, if taimenhwscale asked for one).
+ */
+extern "C" int sweet_fbcon_geom;
+extern "C" bool sweet_fbcon_scale_failed;
+static const struct { const char *name; uint32_t off, end; } taimen_mdp_ranges[] = {
+	{"VIG0", 0x5000, 0x5158}, {"QSEED3", 0x5a00, 0x5b00}, {"CTL0", 0x2000, 0x2098},
+	{"LM0", 0x45000, 0x452c0}, {"LM1", 0x46000, 0x462c0}, {"DSC0", 0x81000, 0x81140},
+	{"DSC1", 0x81400, 0x81540}, {"PP1", 0x71800, 0x718d8}, {"MDPTOP", 0x1000, 0x1458},
+};
+
+static void
+taimen_mdp_census(const char *tag)
+{
+	static uint32_t page_pa[8];
+	static vm_offset_t page_va[8];
+	for (unsigned r = 0; r < sizeof(taimen_mdp_ranges) / sizeof(taimen_mdp_ranges[0]); r++) {
+		uint32_t pa = 0xc900000u + (taimen_mdp_ranges[r].off & ~0xfffu);
+		vm_offset_t va = 0;
+		for (unsigned i = 0; i < 8; i++) {
+			if (page_pa[i] == pa) {
+				va = page_va[i];
+				break;
+			}
+			if (page_pa[i] == 0) {
+				va = ml_io_map(pa, PAGE_SIZE);
+				page_pa[i] = pa;
+				page_va[i] = va;
+				break;
+			}
+		}
+		if (va == 0) {
+			IOLog("MDP %s %s: no mapping\n", tag, taimen_mdp_ranges[r].name);
+			continue;
+		}
+		for (uint32_t o = taimen_mdp_ranges[r].off; o < taimen_mdp_ranges[r].end; o += 0x20) {
+			volatile uint32_t *d = (volatile uint32_t *)(va + (o & 0xfffu));
+			uint32_t rel = o - taimen_mdp_ranges[r].off;
+			IOLog("MDP %s %s+0x%03x: %08x %08x %08x %08x %08x %08x %08x %08x\n", tag,
+			    taimen_mdp_ranges[r].name, rel, d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+		}
+	}
+	IOLog("MDP %s: geometry %d%s\n", tag, sweet_fbcon_geom, sweet_fbcon_scale_failed ? ", scaling failed (ABL's restored)" : "");
+}
