+		static const uint64_t pa[2] = {TAIMEN_SCAN0_PA, TAIMEN_SCAN1_PA};
+		for (int i = 0; i < (taimen_hwscale == 3 ? 2 : 1) && taimen_hwscale; i++) {
+			taimen_scan[i] = sweet_surface_create_physical(pa[i], TAIMEN_CANVAS_W, TAIMEN_CANVAS_H,
+			    TAIMEN_CANVAS_BPR, SWEET_FB_FORMAT_BGRA);
+			if (taimen_scan[i] == NULL || taimen_scan[i]->kernelAddress() == 0) {
+				IOLog("TAIMEN SCALE: scan buffer %d at 0x%llx failed, 1:1 copy\n", i, pa[i]);
+				taimen_hwscale = 0;
