+	static const uint16_t gpll0[] = {0x0};
+	static const uint16_t cprh[] = {0x4, 0x8, 0x7f8, 0x3aa0, 0x3aa4};
+	static const uint16_t tsens0[] = {0x1004, 0x10a0, 0x10a4, 0x10a8, 0x10ac, 0x10b0, 0x10bc, 0x10c0, 0x10c4,
+		                          0x10c8, 0x10cc, 0x10d0, 0x10d4, 0x1060, 0x1064, 0x107c, 0x1080};
+	static const uint16_t tsens1[] = {0x1004, 0x10a0, 0x10a4, 0x10a8, 0x10ac, 0x10b0, 0x10b4, 0x10b8, 0x10bc,
+		                          0x1060, 0x1064};
+	static const uint16_t gfmux[] = {0x50, 0x54};
+	static const uint16_t pll[] = {0x0, 0x4, 0xc, 0x10, 0x14, 0x18, 0x1c, 0x2c};
+	static const uint16_t acd[] = {0x800, 0x83c};   /* ACD at +0x800 of the page */
+	static const uint16_t memacc[] = {0x360, 0x364, 0x368, 0x36c, 0x370};
+	static const uint16_t osmclk[] = {0x12c, 0x130, 0x43c};
+#define TREGS(name, pa, size, o) taimen_regs(name, pa, size, o, sizeof(o) / sizeof(o[0]))
+
+	TREGS("fuse", 0x784000, 0x1000, fuse);
+	TREGS("osm0", 0x179c0000, 0x2000, osm);
+	TREGS("osm1", 0x179c2000, 0x2000, osm);
+	TREGS("saw-silver", 0x17912000, 0x1000, saw);
+	TREGS("saw-gold", 0x17812000, 0x1000, saw);
+	TREGS("apm", 0x179d0000, 0x1000, apm);
+	TREGS("gcc-rbcpr-hmss", 0x148000, 0x1000, gcc);
+	TREGS("gcc-gpll0", 0x100000, 0x1000, gpll0);
+	uint32_t rbcpr = taimen_rd1(0x148008);
+	if (rbcpr & (1u << 31)) {
+		printf("TAIMEN CLK: cprh not read: rbcpr clock off (CBCR %#x)\n", rbcpr);
+	} else {
+		TREGS("cprh-silver", 0x179c8000, 0x4000, cprh);
+		TREGS("cprh-gold", 0x179c4000, 0x4000, cprh);
+	}
+	TREGS("tsens0", 0x10aa000, 0x2000, tsens0);
+	TREGS("tsens1", 0x10ad000, 0x2000, tsens1);
+	if (level < 2) {
