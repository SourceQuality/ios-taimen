+static void
+taimen_clk_measure(const char *tag)
+{
+	static const struct {
+		uint32_t sel;
+		const char *name;
+	} m[] = {
+		{0xbc, "rbcpr"}, {0x14e, "bimc(0x14e)"}, {0xa9, "bimc(0xa9)"}, {0xbb, "bimc_hmss_axi"},
+		{0x0, "snoc"}, {0xe, "cnoc"},
+	};
+	char line[200];
+	int len = 0;
+	for (unsigned i = 0; i < sizeof(m) / sizeof(m[0]); i++) {
+		len += snprintf(line + len, sizeof(line) - (size_t)len, " %s %llu", m[i].name, clk_measure_mhz(m[i].sel));
+	}
+	printf("TAIMEN CLK: measure %s (MHz):%s\n", tag, line);
+}
+
+static void
+taimen_clocks(void)
+{
+	int dump = 0, measure = 0, ddr = 0;
+	(void)PE_parse_boot_argn("taimenclkdump", &dump, sizeof(dump));
+	(void)PE_parse_boot_argn("taimenclkmeasure", &measure, sizeof(measure));
+	(void)PE_parse_boot_argn("taimenddr", &ddr, sizeof(ddr));
+	if (dump > 0) {
+		taimen_clk_dump(1);
+	}
+	if (measure || ddr > 0) {
+		taimen_clk_measure("before");
+	}
+	if (ddr > 0) {
+		thread_bind(cpu_to_processor(0));
+		thread_block(THREAD_CONTINUE_NULL);
+		perf_bandwidth(0);
+		bool ok = sweet_rpm_clk_scaling() && sweet_rpm_clk(0x326b6c63u, 0, (uint32_t)ddr * 1000u);
+		delay(10000);
+		printf("TAIMEN CLK: ddr vote %d MHz: %s\n", ddr, ok ? "ok" : "FAILED");
+		taimen_clk_measure("after ddr vote");
+		perf_bandwidth(0);
+		thread_bind(NULL);
+	}
+	if (dump > 1) {
+		taimen_clk_dump(2);
+	}
+}
