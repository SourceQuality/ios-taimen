+	}
+	TREGS("gfmux-silver", 0x17911000, 0x1000, gfmux);
+	TREGS("gfmux-gold", 0x17811000, 0x1000, gfmux);
+	TREGS("acd-silver", 0x17914000, 0x1000, acd);
+	TREGS("acd-gold", 0x17814000, 0x1000, acd);
+	TREGS("memacc", 0x179d1000, 0x1000, memacc);
+	TREGS("osm-clk", 0x179d1000, 0x1000, osmclk);
+	TREGS("pll-silver", 0x17916000, 0x1000, pll);
+	TREGS("pll-gold", 0x17816000, 0x1000, pll);
