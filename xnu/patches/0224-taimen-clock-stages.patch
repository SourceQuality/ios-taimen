+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Clock stages C0, C1 and D1 of docs/taimen-clocks-plan.md (0224), each off unless its boot-arg
+ * is given. Boot 41: the gold cluster runs at 299 MHz (ABL leaves it on GPLL0 / 2, plan 1.5) and
+ * cached memcpy reaches only 0.4-1.5 GB/s (DDR left low, plan 5).
+ *   taimenclkdump=1     C0a: reads Linux also does (fuses, OSM, SAW4, APM, GCC, TSENS; CPRh only
+ *                       with its clock on); =2 adds C0b (GFMUX, PLL, MEM-ACC, ACD, OSM clock),
+ *                       last, as those pages are unproven. Every region is named before it is
+ *                       read, so a reset on a protected page names it in pstore.
+ *   taimenclkmeasure=1  C1: GCC debug-mux counts (only the debug registers change, then restored)
+ *   taimenddr=MHZ       D1: msm8998 RPM clock handoff, scaling on, bimc at MHZ (Linux: 1804);
+ *                       measured and memcpy-timed before and after
+ */
+static void
+taimen_regs(const char *name, uint64_t pa, uint32_t size, const uint16_t *off, unsigned n)
+{
+	printf("TAIMEN CLK: reading %s at %#llx\n", name, pa);
+	vm_offset_t va = ml_io_map(pa, size);
+	if (va == 0) {
+		printf("TAIMEN CLK: %s: map failed\n", name);
+		return;
+	}
+	char line[200];
+	int len = 0;
+	for (unsigned i = 0; i < n; i++) {
+		len += snprintf(line + len, sizeof(line) - (size_t)len, " +%#x=%#x", off[i], clk_rd(va, off[i]));
+		if (i % 6 == 5 || i == n - 1) {
+			printf("TAIMEN CLK: %s%s\n", name, line);
+			len = 0;
+		}
+	}
+}
+
+static uint32_t
+taimen_rd1(uint64_t pa)
+{
+	vm_offset_t va = ml_io_map(pa & ~0xfffULL, 0x1000);
+	return va ? clk_rd(va, (uint32_t)(pa & 0xfff)) : 0xdeadbeef;
+}
+
+static void
+taimen_clk_dump(int level)
+{
+	static const uint16_t fuse[] = {0x130, 0x134, 0x138, 0x13c, 0x218, 0x21c, 0x228, 0x22c, 0x320, 0x324};
+	static const uint16_t osm[] = {0x0, 0x1004, 0x1f10, 0x1c00, 0x1c74, 0x1070, 0x101c, 0x1034};
