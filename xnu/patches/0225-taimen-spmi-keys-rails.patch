diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 0c548d1..6915920 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -27,16 +27,31 @@ void sweet_keys_init(void);
 bool sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out);
 bool sweet_pmic_write(uint16_t ppid, uint8_t addr, uint8_t val);
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Taimen (0225): qcom,spmi@800f000, arbiter v3, which Linux drives like v2 (PPID map at core +
+ * 0x800 + 4n for 512 APIDs, owners at cnfg + 0x700 + 4n, observer channel at obsrvr + 0x8000 *
+ * APID for EE 0); PM8998 PON at SID 0 0x800 as on PM8994. TLMM is pinctrl@3400000, volume up
+ * GPIO 126 as on the Pixel 1; volume down is PON RESIN (RT_STS bit 1), not a GPIO.
+ */
+#define KEYS_CORE_PA     0x0800f000u
+#define KEYS_OBS_PA      0x09400000u
+#define KEYS_CNFG_PA     0x0800a000u
+#define KEYS_CHNLS_PA    0x08400000u     /* write channels, EE 0 */
+#define KEYS_APIDS       512u            /* core is 0x1000: map 0x800 + 4n */
+#define KEYS_TLMM_PA     0x03400000u
+#else
 /* qcom,spmi@400f000: core, obsrvr, cnfg */
 #define KEYS_CORE_PA     0x0400f000u
 #define KEYS_OBS_PA      0x04c00000u
 #define KEYS_CNFG_PA     0x0400a000u
 #define KEYS_CHNLS_PA    0x04400000u     /* write channels, EE 0 */
 #define KEYS_APIDS       256u            /* core is 0xc00: map 0x800 + 4n */
-#define KEYS_PON_RT      0x0810u
-#define KEYS_NO_APID     0xffffu
 /* pinctrl@1010000, one 4 KiB tile per GPIO: CFG +0, IN_OUT +4 */
 #define KEYS_TLMM_PA     0x01010000u
+#endif
+#define KEYS_PON_RT      0x0810u
+#define KEYS_NO_APID     0xffffu
 #define KEYS_GPIO_VOLUP  126u
 #define KEYS_GPIO_VOLDN  121u
 
@@ -242,13 +257,22 @@ keys_thread(void *arg, wait_result_t result)
 		int now[3] = {
 			!!(pon & 1u),
 			!(keys_rd(keys_volup, 4) & 1u),
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+			!!(pon & 2u),                   /* RESIN */
+#else
 			!(keys_rd(keys_voldn, 4) & 1u),
+#endif
 		};
 		if (!pok && keys_pon_apid != KEYS_NO_APID && (errors++ % 250u) == 0) {
 			printf("SWEET KEYS: PON read error arb-status=%#x\n", keys_last_status);
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k != 0 || pok) && now[k] != state[k]) {
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+			bool from_pon = k != 1;
+#else
+			bool from_pon = k == 0;
+#endif
+			if ((!from_pon || pok) && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d\n", code[k], state[k]);
 				sweet_hid_key(code[k], state[k]);
@@ -267,20 +291,27 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_started = true;
+	/* The arbiter first: sweet_pmic_read() serves other drivers even with sweetkeys=0 (0225). */
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x1000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	if (keys_core) {
+		keys_version = keys_rd(keys_core, 0);
+	}
 	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
 	if (!enabled) {
-		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		printf("SWEET KEYS: disabled (sweetkeys=0); PMIC arbiter %#x kept for reads\n", keys_version);
 		return;
 	}
-	keys_core = ml_io_map(KEYS_CORE_PA, 0x1000);
-	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
 	keys_volup = keys_gpio_map(KEYS_GPIO_VOLUP);
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	keys_voldn = keys_volup;                /* unused: volume down is PON RESIN */
+#else
 	keys_voldn = keys_gpio_map(KEYS_GPIO_VOLDN);
+#endif
 	if (!keys_core || !keys_cnfg || !keys_volup || !keys_voldn) {
 		printf("SWEET KEYS: MMIO mapping failed\n");
 		return;
 	}
-	keys_version = keys_rd(keys_core, 0);
 	if (keys_version >= 0x20000000u && keys_version < 0x50000000u) {
 		keys_pon_apid = keys_find_apid(0x008);
 	}
diff --git a/bsd/dev/sweet_perf.c b/bsd/dev/sweet_perf.c
index 0820f83..56ce213 100644
--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -638,13 +638,41 @@ taimen_clk_measure(const char *tag)
 	printf("TAIMEN CLK: measure %s (MHz):%s\n", tag, line);
 }
 
+/*
+ * V1 (taimenvread=1): the rails' own registers over SPMI, read only (sweet_keys.c observer
+ * channel). FTS426 (PM8998 S10/S13, plan 7 V1): type 0x04, subtype 0x05, STATUS1 0x08,
+ * VOLTAGE_CTL1/2 0x40/0x41 = mV, MODE 0x45, EN_CTL 0x46 (bit 7). PM8005 S1 (the GPU's GFX rail,
+ * docs/taimen-gpu-plan.md) is printed raw: its subtype decides the voltage format.
+ */
+extern bool sweet_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out);
+
+static void
+taimen_rail(const char *name, uint16_t ppid)
+{
+	static const uint8_t reg[] = {0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46};
+	uint8_t v[sizeof(reg)] = {0};
+	unsigned ok = 0;
+	for (unsigned i = 0; i < sizeof(reg); i++) {
+		ok += sweet_pmic_read(ppid, reg[i], &v[i]);
+	}
+	printf("TAIMEN SPMI: %s ppid 0x%03x: %u/%u read: type 0x%02x sub 0x%02x sts 0x%02x vctl 0x%02x 0x%02x "
+	    "(%u mV if FTS426) mode 0x%02x en 0x%02x\n", name, ppid, ok, (unsigned)sizeof(reg),
+	    v[0], v[1], v[2], v[3], v[4], (unsigned)v[4] << 8 | v[3], v[5], v[6]);
+}
+
 static void
 taimen_clocks(void)
 {
-	int dump = 0, measure = 0, ddr = 0;
+	int dump = 0, measure = 0, ddr = 0, vread = 0;
 	(void)PE_parse_boot_argn("taimenclkdump", &dump, sizeof(dump));
 	(void)PE_parse_boot_argn("taimenclkmeasure", &measure, sizeof(measure));
 	(void)PE_parse_boot_argn("taimenddr", &ddr, sizeof(ddr));
+	(void)PE_parse_boot_argn("taimenvread", &vread, sizeof(vread));
+	if (vread > 0) {
+		taimen_rail("pm8998 s10 (silver)", 0x12f);
+		taimen_rail("pm8998 s13 (gold)", 0x138);
+		taimen_rail("pm8005 s1 (gfx)", 0x514);
+	}
 	if (dump > 0) {
 		taimen_clk_dump(1);
 	}
