+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * No RTC driver on taimen (the PM8998 RTC sits behind the SPMI arbiter), so the calendar
+ * started at 0 and the lock screen read Wednesday, December 31 (boot 32). The PC passes
+ * its clock as boot-arg taimenepoch (tools/taimen/boot-xnu.sh, when the payload is
+ * built, ~25 s before the kernel asks).
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	long epoch = 0;
+	if (PE_parse_boot_argn("taimenepoch", &epoch, sizeof(epoch)) && epoch > 0) {
+		return epoch + 25;
+	}
+	return 0;
+}
+#endif
