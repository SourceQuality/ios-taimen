+/*
+ * RFX_FINDRM (0280): every regular file below path (depth levels at most) whose name starts with
+ * prefix and ends with suffix is removed and logged. Boot 112: the 32 apps boot 111 wrote into
+ * /Applications were not registered (installd's LastBuildInfo.plist removed: no rescan); without
+ * its com.apple.LaunchServices-*.csstore, lsd rebuilds the database from the app directories.
+ */
+static int
+rootfix_findrm(const char *path, uint32_t depth, const char *prefix, const char *suffix, unsigned *found,
+    vfs_context_t ctx)
+{
+	const size_t bsz = 8192;
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return 0;
+	}
+	if (!vnode_isdir(vp)) {
+		vnode_put(vp);
+		return 0;
+	}
+	char *buf = kalloc_data(bsz, Z_WAITOK);
+	char (*subs)[64] = depth > 1 ? kalloc_data(64 * 64, Z_WAITOK | Z_ZERO) : NULL;
+	char (*hits)[96] = kalloc_data(8 * 96, Z_WAITOK | Z_ZERO);
+	uio_t uio = uio_create(1, 0, UIO_SYSSPACE, UIO_READ);
+	unsigned nsub = 0, nhit = 0;
+	int err = 0, eof = 0;
+	off_t off = 0;
+	size_t pl = strlen(prefix), sl = strlen(suffix);
+	if (buf == NULL || hits == NULL || uio == NULL || (depth > 1 && subs == NULL)) {
+		err = ENOMEM;
+		goto out;
+	}
+	for (unsigned pass = 0; !eof && pass < 256; pass++) {
+		int numdirent = 0;
+		uio_reset(uio, off, UIO_SYSSPACE, UIO_READ);
+		uio_addiov(uio, CAST_USER_ADDR_T(buf), bsz);
+		if ((err = VNOP_READDIR(vp, uio, 0, &eof, &numdirent, ctx)) != 0) {
+			break;
+		}
+		size_t got = bsz - (size_t)uio_resid(uio);
+		if (got == 0) {
+			break;
+		}
+		off = uio_offset(uio);
+		for (char *q = buf; q + __offsetof(struct dirent, d_name) < buf + got;) {
+			struct dirent *d = (struct dirent *)q;
+			if (d->d_reclen == 0) {
+				break;
+			}
+			q += d->d_reclen;
+			if (d->d_ino == 0 || d->d_name[0] == '.') {
+				continue;
+			}
+			if (d->d_type == DT_DIR) {
+				if (subs != NULL && nsub < 64 && d->d_namlen < 64) {
+					strlcpy(subs[nsub++], d->d_name, 64);
+				}
+			} else if (d->d_type == DT_REG && d->d_namlen >= pl + sl && d->d_namlen < 96 &&
+			    strncmp(d->d_name, prefix, pl) == 0 && strcmp(d->d_name + d->d_namlen - sl, suffix) == 0 && nhit < 8) {
+				strlcpy(hits[nhit++], d->d_name, 96);
+			}
+		}
+	}
+	vnode_put(vp);
+	vp = NULLVP;
+	for (unsigned i = 0; i < nhit; i++) {
+		char f[256];
+		snprintf(f, sizeof(f), "%s/%s", path, hits[i]);
+		int e = unlink1(ctx, NULLVP, CAST_USER_ADDR_T(f), UIO_SYSSPACE, 0);
+		printf("TAIMEN ROOTFIX: findrm %s: %s%d\n", f, e ? "error " : "removed ", e);
+		*found += 1;
+	}
+	for (unsigned i = 0; i < nsub; i++) {
+		char child[256];
+		snprintf(child, sizeof(child), "%s/%s", path, subs[i]);
+		(void)rootfix_findrm(child, depth - 1, prefix, suffix, found, ctx);
+	}
+out:
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	if (uio != NULL) {
+		uio_free(uio);
+	}
+	if (hits != NULL) {
+		kfree_data(hits, 8 * 96);
+	}
+	if (subs != NULL) {
+		kfree_data(subs, 64 * 64);
+	}
+	if (buf != NULL) {
+		kfree_data(buf, bsz);
+	}
+	return err;
+}
+
 static const uint8_t *rootfix_blob;
 static uint64_t rootfix_len;
 static int rootfix_chan;
 
 struct rootfix_count { uint32_t done, skipped, failed; };
 
+/* RFX_FINDRM's record: data "prefix\0suffix\0"; EEXIST (counted as already present) if nothing matched */
+static int
+rootfix_findrm_rec(const char *path, uint32_t depth, const uint8_t *data, uint32_t dlen, vfs_context_t ctx)
+{
+	const char *prefix = (const char *)data;
+	size_t pl = strnlen(prefix, dlen);
+	if (dlen < 2 || pl + 1 >= dlen || data[dlen - 1] != 0) {
+		return EINVAL;
+	}
+	unsigned found = 0;
+	int err = rootfix_findrm(path, MIN(depth, 6u), prefix, prefix + pl + 1, &found, ctx);
+	printf("TAIMEN ROOTFIX: findrm %s %s*%s (depth %u): %u removed\n", path, prefix, prefix + pl + 1, depth, found);
+	return err != 0 ? err : found != 0 ? 0 : EEXIST;
+}
