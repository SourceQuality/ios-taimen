+/*
+ * 0369: planar layouts are logged 8 per process (one global budget of 64 went to WeatherPoster
+ * in boot 237, before Maps made its photos), each with the plane keys the layout above ignores.
+ */
+static bool
+sweet_surf_planar_budget(const char *name)
+{
+	static char names[32][20];
+	static uint8_t counts[32];
+	for (int i = 0; i < 32; i++) {
+		if (names[i][0] == 0) {
+			strlcpy(names[i], name, sizeof(names[i]));
+		}
+		if (strncmp(names[i], name, sizeof(names[i])) == 0) {
+			return counts[i]++ < 8;
+		}
+	}
+	return false;
+}
+
+static void
+sweet_surf_log_unparsed(SweetSurface *s, OSDictionary *props)
+{
+	static const char *const known[] = { "IOSurfacePlaneWidth", "IOSurfacePlaneHeight",
+		                             "IOSurfacePlaneBytesPerElement", "IOSurfacePlaneElementWidth", "IOSurfacePlaneElementHeight",
+		                             "IOSurfacePlaneBytesPerRow", "IOSurfacePlaneOffset", "IOSurfacePlaneSize" };
+	OSArray *planes = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	for (unsigned int i = 0; planes != NULL && i < planes->getCount(); i++) {
+		OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+		OSCollectionIterator *it = pd != NULL ? OSCollectionIterator::withCollection(pd) : NULL;
+		OSSymbol *key;
+		while (it != NULL && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+			bool seen = false;
+			for (unsigned int k = 0; k < sizeof(known) / sizeof(known[0]); k++) {
+				seen |= key->isEqualTo(known[k]);
+			}
+			if (!seen) {
+				OSNumber *v = OSDynamicCast(OSNumber, pd->getObject(key));
+				IOLog("SWEET SURF: %s id %u plane %u also has %s = %lld%s\n", s->creator, s->id, i,
+				    key->getCStringNoCopy(), v != NULL ? (long long)v->unsigned64BitValue() : 0LL,
+				    v != NULL ? "" : " (not a number)");
+			}
+		}
+		OSSafeReleaseNULL(it);
+	}
+}
+
+/*
+ * 0369: the remote control's view (bsd/dev/sweet_usb.c "surfs" and "surf ID"): one line of
+ * geometry per surface, and a copy of a surface's bytes from its start (offset 0, allocSize).
+ */
+extern "C" bool sweet_surf_describe(uint32_t id, uint32_t fmt, char *buf, size_t len);
+extern "C" void *sweet_surf_snapshot(uint32_t id, uint32_t *len, char *desc, size_t desclen);
+extern "C" void sweet_surf_snapshot_free(void *copy, uint32_t len);
+
+static void
+sweet_surf_line(SweetSurface *s, char *buf, size_t len)
+{
+	char f[5];
+	for (int i = 0; i < 4; i++) {
+		char c = (char)(s->pixelFormat >> (24 - 8 * i));
+		f[i] = (c >= 0x20 && c < 0x7f) ? c : '?';
+	}
+	f[4] = 0;
+	int n = snprintf(buf, len, "%u %s %ux%u fmt %s bpe %u bpr %u offset 0x%x alloc 0x%x planes %u",
+	    s->id, s->creator[0] ? s->creator : "?", s->width, s->height, f, s->bytesPerElement,
+	    s->bytesPerRow, s->offset, s->allocSize, s->planeCount);
+	for (uint32_t i = 0; i < s->planeCount && n > 0 && (size_t)n < len; i++) {
+		const struct sweet_surface_plane *pl = &s->planes[i];
+		n += snprintf(buf + n, len - (size_t)n, " [%ux%u bpe %u bpr %u offset 0x%x size 0x%x]",
+		    pl->width, pl->height, pl->bytesPerElement, pl->bytesPerRow, pl->offset, pl->size);
+	}
+}
+
+/* fmt 0: any pixel format */
+bool
+sweet_surf_describe(uint32_t id, uint32_t fmt, char *buf, size_t len)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	bool ok = s != NULL && (fmt == 0 || s->pixelFormat == fmt);
+	if (ok) {
+		sweet_surf_line(s, buf, len);
+	}
+	OSSafeReleaseNULL(s);
+	return ok;
+}
+
+void *
+sweet_surf_snapshot(uint32_t id, uint32_t *len, char *desc, size_t desclen)
+{
+	SweetSurface *s = sweet_surface_copy(id);
+	void *copy = NULL;
+	if (s == NULL) {
+		return NULL;
+	}
+	uintptr_t base = s->kernelAddress();
+	if (base != 0 && s->allocSize > 0 && s->allocSize <= (64u << 20) &&
+	    (copy = IOMallocData(s->allocSize)) != NULL) {
+		memcpy(copy, (const void *)base, s->allocSize);
+		*len = s->allocSize;
+		sweet_surf_line(s, desc, desclen);
+	}
+	s->release();
+	return copy;
+}
+
+void
+sweet_surf_snapshot_free(void *copy, uint32_t len)
+{
+	IOFreeData(copy, len);
+}
