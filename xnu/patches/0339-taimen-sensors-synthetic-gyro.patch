+/* 0339: a gyro that never turns: zero rad/s, streamed as the accelerometer streams (its ReportInterval). */
+class SweetHIDGyro : public SweetHIDAccel {
+	OSDeclareDefaultStructors(SweetHIDGyro);
+protected:
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 9; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 6; }
+	virtual IOHIDEvent *event() APPLE_KEXT_OVERRIDE { return IOHIDEvent::gyroEvent(mach_absolute_time(), 0, 0, 0); }
