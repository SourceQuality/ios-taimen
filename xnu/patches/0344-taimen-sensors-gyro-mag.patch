+/*
+ * 0344: the streams after the accelerometer's (M6 stage 12), each a BUFFERING report of its own: report
+ * id = sensor id (a second data type takes the next id no sensor or report has), one sample per report.
+ * They are asked for one after the other, each once the last one's answer came.
+ */
+enum { XS_IDLE, XS_WAIT, XS_ON, XS_OFF };
+enum { XK_GYRO, XK_MAG };
+struct xs_cfg {
+	const char *name, *type;        /* our name; the ALL_SENSOR_INFO type to stream */
+	uint8_t kind, dt, stage, level; /* XK_*, its data type, the log stage, the taimensensors level that asks */
+	int hz;                         /* the rate, unless boot-arg hz_arg says otherwise */
+	const char *hz_arg, *hid;       /* that boot-arg; the SweetHID service that takes the samples */
+};
+static const struct xs_cfg xs_tab[] = {
+	{ "gyro", "GYRO", XK_GYRO, 0, 12, 7, 50, "taimengyrohz", "SweetHIDGyro" },
+	{ "mag", "MAG", XK_MAG, 0, 12, 7, 50, "taimenmaghz", "SweetHIDCompass" },
+};
+#define XS_N                    (sizeof(xs_tab) / sizeof(xs_tab[0]))
+struct xstream {
+	int sid, rid, hz;
+	uint32_t st, tries;
+	uint64_t t0, win_ms, next_ms;
+	uint32_t samples, reports, win, win_reports, logged, last_ts, hid_missing;
+	int32_t raw[3], out[3];
+};
+static struct xstream xs[XS_N];
+static uint32_t xs_cur;
+
+static void
+xs_init(void)
+{
+	for (uint32_t i = 0; i < XS_N; i++) {
+		bzero(&xs[i], sizeof(xs[i]));
+		xs[i].sid = -1;
+		xs[i].rid = -1;
+	}
+}
+
+static bool
+smgr_streaming(void)
+{
+	bool on = acc_on;
+	for (uint32_t i = 0; i < XS_N; i++) {
+		on = on || xs[i].st == XS_ON;
+	}
+	return on;
+}
+
+static bool
+rid_used(int r)
+{
+	if (r == accel_sid) {
+		return true;
+	}
+	for (uint32_t k = 0; k < smgr_ns; k++) {
+		if (smgr_s[k].id == r) {
+			return true;
+		}
+	}
+	for (uint32_t i = 0; i < XS_N; i++) {
+		if (xs[i].rid == r) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* the report id: the sensor id for data type 0 (as the Linux driver), else the next one nobody has */
+static int
+rid_for(int sid, uint8_t dt)
+{
+	int r = sid;
+	for (unsigned n = 0; dt != 0 && n < 256; n++) {
+		r = (r + 1) & 0xFF;
+		if (!rid_used(r)) {
+			break;
+		}
+	}
+	return r;
+}
+
+static int32_t
+clamp32(int64_t v)
+{
+	return v > 0x7FFFFFFFLL ? 0x7FFFFFFF : v < -0x80000000LL ? (int32_t)(-0x7FFFFFFF - 1) : (int32_t)v;
+}
+
+/* a stream's last iOS value as text */
+static void
+xs_out_fmt(uint32_t i, char *b, size_t n)
+{
+	const struct xstream *x = &xs[i];
+	char v[3][24], m[24];
+	uint64_t sq = 0;
+	for (unsigned j = 0; j < 3; j++) {
+		q16_fmt(v[j], sizeof(v[j]), x->out[j], 3);
+		sq += (uint64_t)((int64_t)x->out[j] * x->out[j]);
+	}
+	uint64_t mag = isqrt64(sq);
+	q16_fmt(m, sizeof(m), mag > 0x7FFFFFFFull ? 0x7FFFFFFF : (int32_t)mag, 3);
+	switch (xs_tab[i].kind) {
+	case XK_GYRO:
+		snprintf(b, n, "%s %s %s rad/s (|w| %s)", v[0], v[1], v[2], m);
+		break;
+	case XK_MAG:
+		snprintf(b, n, "%s %s %s uT (|B| %s)", v[0], v[1], v[2], m);
+		break;
+	default:
+		snprintf(b, n, "?");
+		break;
+	}
+}
+
+static void
+xs_buffering(uint32_t i)
+{
+	const struct xs_cfg *c = &xs_tab[i];
+	struct xstream *x = &xs[i];
+	uint8_t m[48], it[9];
+	uint8_t rid = (uint8_t)x->rid, act = 1;
+	uint32_t rate = (uint32_t)x->hz << 16, n = 7;
+
+	n = qm_tlv(m, n, 0x01, &rid, 1);
+	n = qm_tlv(m, n, 0x02, &act, 1);
+	n = qm_tlv(m, n, 0x03, &rate, 4);
+	it[0] = 1;
+	it[1] = (uint8_t)x->sid;
+	it[2] = c->dt;
+	st16(it + 3, 3);
+	st16(it + 5, (uint16_t)x->hz);
+	st16(it + 7, 1);
+	n = qm_tlv(m, n, 0x04, it, 9);
+	smgr_send(m, n, SMGR_MSG_BUFFERING);
+	smgr_state = SM_WAIT_XBUF;
+	xs_cur = i;
+	x->st = XS_WAIT;
+	LOG("%u: t=%u.%03u smgr: %s BUFFERING add (txn %u, try %u): report id 0x%02x, report rate %#x (%d Hz x 65536), "
+	    "item {0x%02x, %u, 3, %d, 1}", c->stage, T, c->name, smgr_wait_txn, x->tries + 1, rid, rate, x->hz, x->sid, c->dt,
+	    x->hz);
+}
+
+/* find stream i's sensor and ask for it; false (stream off) without one */
+static bool
+xs_start(uint32_t i)
+{
+	const struct xs_cfg *c = &xs_tab[i];
+	struct xstream *x = &xs[i];
+	struct smgr_sensor *s = NULL;
+	const struct smgr_dt *t = NULL;
+
+	for (uint32_t k = 0; k < smgr_ns && s == NULL; k++) {
+		if (strlen(smgr_s[k].type) == strlen(c->type) && ci_has(smgr_s[k].type, c->type)) {
+			s = &smgr_s[k];
+		}
+	}
+	for (uint32_t k = 0; s != NULL && k < s->ndt && t == NULL; k++) {
+		if (s->dt[k].dt == c->dt) {
+			t = &s->dt[k];
+		}
+	}
+	if (t == NULL) {
+		x->st = XS_OFF;
+		LOG("%u: t=%u.%03u %s: no sensor of type %s%s among %u sensors; no %s stream", c->stage, T, c->name, c->type,
+		    s != NULL ? " with that data type" : "", smgr_ns, c->name);
+		return false;
+	}
+	int hz = c->hz;
+	if (c->hz_arg != NULL) {
+		(void)PE_parse_boot_argn(c->hz_arg, &hz, sizeof(hz));
+	}
+	if (hz < 1 || hz > 1000) {
+		hz = c->hz;
+	}
+	if (t->max_hz != 0 && (uint32_t)hz > t->max_hz) {
+		hz = (int)t->max_hz;
+	}
+	x->sid = s->id;
+	x->hz = hz;
+	x->rid = rid_for(s->id, c->dt);
+	x->tries = 0;
+	LOG("%u: t=%u.%03u %s: sensor id 0x%02x (type %s) data type %u '%s' vendor '%s', max %u Hz; %d Hz, one sample "
+	    "per report, report id 0x%02x, into %s", c->stage, T, c->name, s->id, s->type, c->dt, t->name, t->vendor, t->max_hz,
+	    hz, x->rid, c->hid);
+	xs_buffering(i);
+	return true;
+}
+
+/* the next stream to ask for; when none is left, streaming (or done, with nothing to stream) */
+static void
+xs_next(void)
+{
+	for (uint32_t i = 0; i < XS_N; i++) {
+		if (xs[i].st == XS_IDLE && sens_level >= xs_tab[i].level && xs_start(i)) {
+			return;
+		}
+	}
+	smgr_state = smgr_streaming() ? SM_STREAM : SM_DONE;
+	if (sens_level >= 7) {
+		static const char *const sn[] = { "-", "asked", "on", "off" };
+		char line[160];
+		size_t n = (size_t)snprintf(line, sizeof(line), "accel %s", acc_on ? "on" : "off");
+		for (uint32_t i = 0; i < XS_N && n + 24 < sizeof(line); i++) {
+			n += (size_t)snprintf(line + n, sizeof(line) - n, ", %s %s", xs_tab[i].name, sn[xs[i].st & 3]);
+		}
+		LOG("12: t=%u.%03u smgr streams: %s", T, line);
+	}
+}
+
+static void
+xs_buf_done(uint32_t res, uint32_t err, int rid, int ack)
+{
+	const struct xs_cfg *c = &xs_tab[xs_cur];
+	struct xstream *x = &xs[xs_cur];
+	LOG("%u: t=%u.%03u smgr: %s BUFFERING add -> result %u error %u, report id %d, ack/nak %d", c->stage, T, c->name, res,
+	    err, rid, ack);
+	if (res != 0) {
+		x->st = XS_OFF;
+		LOG("%u: the SMGR refused the %s stream", c->stage, c->name);
+	} else {
+		x->st = XS_ON;
+		x->t0 = x->win_ms = now_ms();
+		x->next_ms = x->t0 + 1000;
+	}
+	xs_next();
+}
+
+/* the stream of report id rid (asked for or on), else -1 */
+static int
+xs_by_rid(int rid)
+{
+	for (uint32_t i = 0; i < XS_N; i++) {
+		if (xs[i].rid == rid && (xs[i].st == XS_WAIT || xs[i].st == XS_ON)) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static void
+xs_sample(uint32_t i, const int32_t r[3], uint32_t ts, const uint8_t *s)
+{
+	const struct xs_cfg *c = &xs_tab[i];
+	struct xstream *x = &xs[i];
+	int32_t o[3] = { 0, 0, 0 };
+	int took = 0;
+
+	switch (c->kind) {
+	case XK_GYRO:
+	case XK_MAG: {
+		const struct amap_e *m = c->kind == XK_GYRO ? gyromap : magmap;
+		int64_t k = c->kind == XK_MAG ? 100 : 1;        /* Gauss -> microtesla */
+		for (unsigned j = 0; j < 3; j++) {
+			o[j] = clamp32((int64_t)r[m[j].src] * m[j].sign * k);
+		}
+		break;
+	}
+	default:
+		break;
+	}
+	x->samples++;
+	x->win++;
+	memcpy(x->raw, r, sizeof(x->raw));
+	memcpy(x->out, o, sizeof(x->out));
+	if (x->logged < 8) {
+		x->logged++;
+		char a[3][24], ob[96];
+		for (unsigned j = 0; j < 3; j++) {
+			q16_fmt(a[j], sizeof(a[j]), r[j], 3);
+		}
+		xs_out_fmt(i, ob, sizeof(ob));
+		LOG("%u: t=%u.%03u %s sample %u: raw %d %d %d = %s %s %s (Q16.16), ts %u (+%u ticks), extra %u %u %#x -> iOS %s",
+		    c->stage, T, c->name, x->samples, r[0], r[1], r[2], a[0], a[1], a[2], ts, x->samples > 1 ? ts - x->last_ts : 0,
+		    s[12], s[13], ld16(s + 14), ob);
+	}
+	x->last_ts = ts;
+	switch (c->kind) {
+	case XK_GYRO:
+		took = sweet_hid_gyro_sample(o[0], o[1], o[2]);
+		break;
+	case XK_MAG:
+		took = sweet_hid_compass_sample(o[0], o[1], o[2]);
+		break;
+	default:
+		break;
+	}
+	if (took == 0) {
+		x->hid_missing++;
+	}
+}
+
+static void
+xs_report(uint32_t i, const uint8_t *meta, const uint8_t *smp, uint16_t sl)
+{
+	struct xstream *x = &xs[i];
+	x->reports++;
+	x->win_reports++;
+	if (smp == NULL) {
+		return;
+	}
+	uint32_t ts = meta != NULL ? ld32(meta + 5) : 0;
+	for (uint32_t k = 0; k < smp[0] && 1 + 16 * (k + 1) <= sl; k++) {
+		const uint8_t *s = smp + 1 + 16 * k;
+		int32_t r[3] = { (int32_t)ld32(s), (int32_t)ld32(s + 4), (int32_t)ld32(s + 8) };
+		xs_sample(i, r, ts, s);
+	}
+}
+
+/* a rate line per stream each second for 10 s, then each minute */
+static void
+xs_stats(uint64_t now)
+{
+	for (uint32_t i = 0; i < XS_N; i++) {
+		const struct xs_cfg *c = &xs_tab[i];
+		struct xstream *x = &xs[i];
+		if (x->st != XS_ON || now < x->next_ms) {
+			continue;
+		}
+		char ob[96];
