diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 2b58a92..11228fb 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -57,10 +57,20 @@ static volatile uint32_t *early_intr = (volatile uint32_t *)(uintptr_t)(TAIMEN_M
  * START while a frame is in flight desyncs the DSC panel (noise band, frozen
  * picture): that is what boots 1-9 did from here and from start.s.
  */
+/*
+ * Boots 23-26: frames sent during the early boot's memory traffic starved the DSI lanes (HS
+ * FIFO underflow), and the DSI reset that recovers from it left the panel black (boot 26). The
+ * bands still go into the panel memory; nothing is sent before backboardd's first frame (0212).
+ */
+static int taimen_early_kicks;     /* 0: the early bands are never sent */
+
 static void
 taimen_kick(void)
 {
 	uint64_t f, t0, t;
+	if (!taimen_early_kicks) {
+		return;
+	}
 	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
 	__asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(t0));
 	do {
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index b1c7e3b..4b694f4 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -855,9 +855,30 @@ fbcon_frame_done(uint64_t now)
 	return false;
 }
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Set by AppleCLCD's first present. Before it the console only draws into the panel memory:
+ * a frame sent during the early boot's memory traffic starved the DSI (boots 23-26) and the
+ * reset that recovers it left the panel black (boot 26). Boot-arg taimenconsolekick=1 sends
+ * the console's frames from the start as before.
+ */
+bool sweet_fbcon_gui_started;
+static int fbcon_console_kicks = -1;
+#endif
+
 static bool
 fbcon_try_kick(void)
 {
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	if (fbcon_console_kicks < 0) {
+		int v = 0;
+		(void)PE_parse_boot_argn("taimenconsolekick", &v, sizeof(v));
+		fbcon_console_kicks = v != 0;
+	}
+	if (!sweet_fbcon_gui_started && !fbcon_console_kicks) {
+		return true;    /* nothing sent; callers need not wait */
+	}
+#endif
 	if (!os_atomic_cmpxchg(&fbcon_kick_lock, 0u, 1u, acquire)) {
 		return false;
 	}
