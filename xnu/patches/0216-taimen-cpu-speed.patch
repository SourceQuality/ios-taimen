+/*
+ * Boot 31: iOS reaches the home screen but is very slow. How fast does CPU0 run? A
+ * subs/b.ne loop is about one iteration per cycle on these cores; timed against the
+ * 19.2 MHz counter it gives the clock ABL left the core at (no cpufreq on taimen yet).
+ */
+static void
+taimen_cpu_speed(const char *tag)
+{
+	/* fastest of 5 runs of 20M: preemption only makes a run slower */
+	uint64_t best = ~0ULL;
+	for (int run = 0; run < 5; run++) {
+		uint64_t n = 20000000ULL, t0 = mach_absolute_time();
+		__asm__ volatile ("1: subs %0, %0, #1\n\tb.ne 1b" : "+r"(n) : : "cc");
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		best = ns < best ? ns : best;
+	}
+	uint64_t midr;
+	__asm__ volatile ("mrs %0, midr_el1" : "=r"(midr));
+	IOLog("TAIMEN CPU %s: 20M loop in %llu us = ~%llu MHz (1 iteration/cycle), midr %#llx\n",
+	    tag, best / 1000, best ? 20000000ULL * 1000ULL / best : 0, midr);
+}
