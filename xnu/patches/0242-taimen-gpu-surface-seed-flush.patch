diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index 41be9ea..311014a 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -49,6 +49,15 @@ public:
 	uintptr_t kernelAddress();
 };
 
+#define SWEET_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+
+/* The seed: bumped by each unlock that was not read-only (CPU writes), never by users directly. */
+static inline uint32_t
+sweet_surface_seed_value(SweetSurface *s)
+{
+	return *(volatile uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + SWEET_SURFACE_STATE_SEED);
+}
+
 /* Retained surface for an id, or NULL. */
 SweetSurface *sweet_surface_copy(uint32_t id);
 
