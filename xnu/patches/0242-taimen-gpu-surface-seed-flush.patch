diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
index fa25784..77f6257 100644
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -218,6 +218,7 @@ struct sweet_gpu_bo {
 	uint32_t last_seq;              /* last submit listing it */
 	bool used;                      /* listed in a submit at least once */
 	bool wc;                        /* heap memory, write-combined: no cache maintenance */
+	uint32_t seed;                  /* imports: the surface seed at the last full flush */
 	uint32_t heap_first;            /* wc: its first heap page */
 };
 
@@ -602,7 +603,8 @@ SweetGPUUserClient::boImport(uint32_t id, uint64_t *out)
 		return kIOReturnNoMemory;
 	}
 	md->retain();
-	*b = (struct sweet_gpu_bo){ .iova = gva, .size = size, .md = md, .surface = s, .pa = pa, .npages = npages };
+	*b = (struct sweet_gpu_bo){ .iova = gva, .size = size, .md = md, .surface = s, .pa = pa, .npages = npages,
+		                    .seed = sweet_surface_seed_value(s) };
 	out[0] = handle;
 	out[1] = gva;
 	out[2] = size;
@@ -667,6 +669,24 @@ SweetGPUUserClient::submit(const void *in, size_t len, uint64_t *seqOut)
 		 * page of every listed bo was ~1/4 of backboardd's CPU (0182g).
 		 * Heap bos (write-combined) need none.
 		 */
+		if (b->surface != NULL && !b->surface->clientMemory) {
+			/*
+			 * Surface buffers have a writable kernel mapping: their modified
+			 * bit never clears, every page looked written (boot 74: all ~3400
+			 * pages of each display surface flushed at every submit, ~4 ms).
+			 * CPU writers lock them; the seed moves at each write unlock.
+			 */
+			uint32_t seed = sweet_surface_seed_value(b->surface);
+			if (seed != b->seed) {
+				for (uint32_t p = 0; p < b->npages; p++) {
+					flush_dcache64((addr64_t)b->pa[p], PAGE_SIZE, TRUE);
+				}
+				b->seed = seed;
+				flushed += b->npages;
+			}
+			checked += b->npages;
+			continue;
+		}
 		for (uint32_t p = 0; !b->wc && p < b->npages; p++) {
 			flushed += flush_if_written(b->pa[p]);
 		}
