+/* 0350: a real sample within the last 200 ms */
+bool
+SweetHIDAccel::flowing()
+{
+	uint64_t window;
+	nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &window);
+	return fRealAt != 0 && mach_absolute_time() - fRealAt < window;
+}
+
+/* 0350: IEEE 754 single of the fixed-point value v / 2^frac (truncated): the kernel has no floating point */
+static uint32_t
+f32_bits(int64_t v, int frac)
+{
+	if (v == 0) {
+		return 0;
+	}
+	uint32_t sign = v < 0 ? 0x80000000u : 0;
+	uint64_t a = v < 0 ? (uint64_t)-v : (uint64_t)v;
+	int p = 63 - __builtin_clzll(a);
+	int exp = p - frac + 127;
+	if (exp <= 0) {
+		return sign;
+	}
+	uint64_t m = p > 23 ? a >> (p - 23) : a << (23 - p);
+	return sign | ((uint32_t)exp << 23) | ((uint32_t)m & 0x7fffffu);
+}
+
+static uint64_t
+hid_isqrt(uint64_t v)
+{
+	uint64_t r = 0, b = 1ULL << 62;
+	while (b > v) {
+		b >>= 2;
+	}
+	while (b != 0) {
+		if (v >= r + b) {
+			v -= r + b;
+			r = (r >> 1) + b;
+		} else {
+			r >>= 1;
+		}
+		b >>= 2;
+	}
+	return r;
+}
+
+static int64_t
+abs64(int64_t v)
+{
+	return v < 0 ? -v : v;
+}
+
+/* 0350: v as a unit vector in Q14; false for a zero vector */
+static bool
+unit14(const int64_t v[3], int32_t out[3])
+{
+	int64_t w[3] = {v[0], v[1], v[2]};
+	while (abs64(w[0]) >= (1LL << 24) || abs64(w[1]) >= (1LL << 24) || abs64(w[2]) >= (1LL << 24)) {
+		w[0] /= 2;
+		w[1] /= 2;
+		w[2] /= 2;
+	}
+	uint64_t len = hid_isqrt((uint64_t)(w[0] * w[0] + w[1] * w[1] + w[2] * w[2]));
+	if (len == 0) {
+		return false;
+	}
+	for (int i = 0; i < 3; i++) {
+		out[i] = (int32_t)(w[i] * 16384 / (int64_t)len);
+	}
+	return true;
+}
+
+/* 0350: atan2(y, x) in hundredths of a degree, -18000..18000 (atan r ~ 45 r + 15.64 r (1 - r) degrees, 0.2 degree off at most) */
+static int32_t
+atan2_cdeg(int64_t y, int64_t x)
+{
+	uint64_t ax = (uint64_t)abs64(x), ay = (uint64_t)abs64(y);
+	if (ax == 0 && ay == 0) {
+		return 0;
+	}
+	bool steep = ay > ax;
+	uint64_t r = steep ? (ax << 16) / ay : (ay << 16) / ax;
+	int32_t a = (int32_t)((4500 * r + 1564 * ((r * (65536 - r)) >> 16)) >> 16);
+	if (steep) {
+		a = 9000 - a;
+	}
+	if (x < 0) {
+		a = 18000 - a;
+	}
+	return y < 0 ? -a : a;
+}
+
+/* 0350: the unit quaternion (Q14 x, y, z, w) of the rotation matrix whose rows are r[0..2] (Q14) */
+static void
+quat14(const int32_t r[3][3], int32_t q[4])
+{
+	int64_t t = (int64_t)r[0][0] + r[1][1] + r[2][2], s;
+	if (t > 0) {
+		s = 2 * (int64_t)hid_isqrt((uint64_t)(16384 + t) * 16384);
+		if (s == 0) {
+			goto identity;
+		}
+		q[3] = (int32_t)(s / 4);
+		q[0] = (int32_t)(((int64_t)r[2][1] - r[1][2]) * 16384 / s);
+		q[1] = (int32_t)(((int64_t)r[0][2] - r[2][0]) * 16384 / s);
+		q[2] = (int32_t)(((int64_t)r[1][0] - r[0][1]) * 16384 / s);
+	} else if (r[0][0] > r[1][1] && r[0][0] > r[2][2]) {
+		s = 2 * (int64_t)hid_isqrt((uint64_t)(16384 + (int64_t)r[0][0] - r[1][1] - r[2][2]) * 16384);
+		if (s == 0) {
+			goto identity;
+		}
+		q[3] = (int32_t)(((int64_t)r[2][1] - r[1][2]) * 16384 / s);
+		q[0] = (int32_t)(s / 4);
+		q[1] = (int32_t)(((int64_t)r[0][1] + r[1][0]) * 16384 / s);
+		q[2] = (int32_t)(((int64_t)r[0][2] + r[2][0]) * 16384 / s);
+	} else if (r[1][1] > r[2][2]) {
+		s = 2 * (int64_t)hid_isqrt((uint64_t)(16384 + (int64_t)r[1][1] - r[0][0] - r[2][2]) * 16384);
+		if (s == 0) {
+			goto identity;
+		}
+		q[3] = (int32_t)(((int64_t)r[0][2] - r[2][0]) * 16384 / s);
+		q[0] = (int32_t)(((int64_t)r[0][1] + r[1][0]) * 16384 / s);
+		q[1] = (int32_t)(s / 4);
+		q[2] = (int32_t)(((int64_t)r[1][2] + r[2][1]) * 16384 / s);
+	} else {
+		s = 2 * (int64_t)hid_isqrt((uint64_t)(16384 + (int64_t)r[2][2] - r[0][0] - r[1][1]) * 16384);
+		if (s == 0) {
+			goto identity;
+		}
+		q[3] = (int32_t)(((int64_t)r[1][0] - r[0][1]) * 16384 / s);
+		q[0] = (int32_t)(((int64_t)r[0][2] + r[2][0]) * 16384 / s);
+		q[1] = (int32_t)(((int64_t)r[1][2] + r[2][1]) * 16384 / s);
+		q[2] = (int32_t)(s / 4);
+	}
+	return;
+identity:
+	q[0] = q[1] = q[2] = 0;
+	q[3] = 16384;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	memcpy(p, &v, sizeof(v));
+}
+
+/*
+ * 0350: the compass heading. The iPhone X's locationd takes its heading ready-made, as the AOP computes it:
+ * CLCompass7 (picked by CLPlatformInfo::motionCaps bits 4/5 alone, factory at locationd 0x1006e42c8, so
+ * CLCompass6 with its AKM calibrator on the raw magnetometer is out of reach) opens usage pair {0xff0c, 8},
+ * sets its ReportInterval (20000 us) and reads vendor-defined events whose payload is an 88-byte
+ * CMDeviceMotionReport of type 2, Compass (parsed at 0x1002152fc; dropped unless flags bit 8, initialized,
+ * is set; the heading passed straight through, onDeviceMotionServiceIohidEvent 0x1006bd9cc):
+ *   0 u8 type 2, 1 s8 calibration level, 2 u16 flags, 4 u64 0, 12 f32 -1, 16 f32[3] uncalibrated field uT,
+ *   28 f32[4] attitude x y z w (device to North/West/Up), 44 f32[3] rotation rate rad/s, 56 f32[3] user
+ *   acceleration, 68 f32 magnetic heading degrees, 72 f32 accuracy degrees, 76 f32[3] bias uT.
+ * Built here at each of the SLPI's magnetometer samples (sweet_hid_compass_sample) while locationd streams:
+ * up = -accel, east = field x up, north = up x east; the heading is the bearing of the phone's top (+y)
+ * held within 60 degrees of flat, of its back (-z) when upright. The hard-iron bias is the middle of each
+ * axis's range once every axis has spanned 40 uT (the phone turned around). Integer math, the floats
+ * assembled bit by bit. Boot 188: "Compass for AOP started", then {65292, 8} "not ready" and no heading.
+ */
+class SweetHIDHeading : public SweetHIDAccel {
+	OSDeclareDefaultStructors(SweetHIDHeading);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff0c; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 8; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 11; }
+	virtual IOHIDEvent *event() APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEventType eventType() APPLE_KEXT_OVERRIDE { return kIOHIDEventTypeVendorDefined; }
+	virtual int minLevel() APPLE_KEXT_OVERRIDE { return 7; }
+	virtual bool synthesizes() APPLE_KEXT_OVERRIDE { return false; }
+	virtual const char *describe() APPLE_KEXT_OVERRIDE
+	{
+		return "the heading from the SLPI's magnetometer and accelerometer, CMDeviceMotionReport type 2";
+	}
+	IOFixed fMin[3], fMax[3];
+	bool fSeen;
+	UInt32 fReports, fLogged;
+	uint64_t fLoggedAt;
+};
+OSDefineMetaClassAndStructors(SweetHIDHeading, SweetHIDAccel);
+
+IOHIDEvent *
+SweetHIDHeading::event()
+{
+	if (!gSweetAccel || !gSweetAccel->flowing()) {
+		return NULL;
+	}
+	int a[3];
+	IOFixed m[3], g[3] = {0, 0, 0}, b[3] = {0, 0, 0};
+	gSweetAccel->latestMg(a);
+	latestFixed(m);
+	if (gSweetGyro && gSweetGyro->flowing()) {
+		gSweetGyro->latestFixed(g);
+	}
+	bool calibrated = true;
+	for (int i = 0; i < 3; i++) {
+		if (!fSeen || m[i] < fMin[i]) {
+			fMin[i] = m[i];
+		}
+		if (!fSeen || m[i] > fMax[i]) {
+			fMax[i] = m[i];
+		}
+		calibrated = calibrated && fMax[i] - fMin[i] >= (40 << 16);
+	}
+	fSeen = true;
+	int64_t f[3], up[3], e[3], n[3];
+	for (int i = 0; i < 3; i++) {
+		if (calibrated) {
+			b[i] = fMin[i] + (fMax[i] - fMin[i]) / 2;
+		}
+		f[i] = ((int64_t)m[i] - b[i]) / 64;     /* uT in Q10 */
+		up[i] = -a[i];                          /* mg */
+	}
+	e[0] = f[1] * up[2] - f[2] * up[1];
+	e[1] = f[2] * up[0] - f[0] * up[2];
+	e[2] = f[0] * up[1] - f[1] * up[0];
+	n[0] = up[1] * e[2] - up[2] * e[1];
+	n[1] = up[2] * e[0] - up[0] * e[2];
+	n[2] = up[0] * e[1] - up[1] * e[0];
+	int32_t E[3], N[3], U[3], W[3];
+	if (!unit14(e, E) || !unit14(n, N) || !unit14(up, U)) {
+		return NULL;
+	}
+	W[0] = (int32_t)(((int64_t)U[1] * N[2] - (int64_t)U[2] * N[1]) / 16384);
+	W[1] = (int32_t)(((int64_t)U[2] * N[0] - (int64_t)U[0] * N[2]) / 16384);
+	W[2] = (int32_t)(((int64_t)U[0] * N[1] - (int64_t)U[1] * N[0]) / 16384);
+	bool flat = 2 * abs64(U[2]) > 16384;
+	int32_t h = flat ? atan2_cdeg(E[1], N[1]) : atan2_cdeg(-(int64_t)E[2], -(int64_t)N[2]);
+	if (h < 0) {
+		h += 36000;
+	}
+	const int32_t r[3][3] = {{N[0], N[1], N[2]}, {W[0], W[1], W[2]}, {U[0], U[1], U[2]}};
+	int32_t q[4];
+	quat14(r, q);
+
+	uint8_t rep[88];
+	bzero(rep, sizeof(rep));
+	rep[0] = 2;                     /* Compass */
+	rep[1] = 3;                     /* calibration level (2 and up: calibrated) */
+	rep[2] = 0x00;                  /* flags 0x0100: initialized */
+	rep[3] = 0x01;
+	put32(rep + 12, f32_bits(-1, 0));
+	for (int i = 0; i < 3; i++) {
+		put32(rep + 16 + 4 * i, f32_bits(m[i], 16));
+		put32(rep + 44 + 4 * i, f32_bits(g[i], 16));
+		put32(rep + 76 + 4 * i, f32_bits(b[i], 16));
+	}
+	for (int i = 0; i < 4; i++) {
+		put32(rep + 28 + 4 * i, f32_bits(q[i], 14));
+	}
+	put32(rep + 68, f32_bits((int64_t)h * 256 / 100, 8));
+	put32(rep + 72, f32_bits(calibrated ? 15 : 30, 0));
+	uint64_t ts = mach_absolute_time();
+	IOHIDEvent *ev = IOHIDEvent::vendorDefinedEvent(ts, 0xff0c, 8, 0, rep, sizeof(rep));
+	fReports++;
+	uint64_t minute;
+	nanoseconds_to_absolutetime(60 * NSEC_PER_SEC, &minute);
+	if (fLogged < 3 || ts - fLoggedAt > minute) {
+		fLogged++;
+		fLoggedAt = ts;
+		IOLog("TAIMEN SENSORS: heading %d.%02d deg (%s), field %d %d %d uT, bias %d %d %d uT (%s), up %d %d %d mg, "
+		    "q %d %d %d %d /16384, report %u\n", h / 100, h % 100, flat ? "flat: the top" : "upright: the back",
+		    (int)(m[0] / 65536), (int)(m[1] / 65536), (int)(m[2] / 65536), (int)(b[0] / 65536), (int)(b[1] / 65536),
+		    (int)(b[2] / 65536), calibrated ? "calibrated" : "not yet: turn the phone around", (int)up[0], (int)up[1],
+		    (int)up[2], q[0], q[1], q[2], q[3], fReports);
+	}
+	return ev;
+}
+
 /*
  * 0345: the barometer, as locationd's CLPressure opens it: usage pair {0x20, 0x31} (Sensor page,
  * Environmental: Atmospheric Pressure; locationd 0x101431558), kIOHIDEventTypeAtmosphericPressure events
@@ -1377,6 +1655,9 @@ sweet_hid_compass_sample(int x, int y, int z)
 		return 0;
 	}
 	gSweetCompass->realFixed(x, y, z);
+	if (gSweetHeading) {
+		gSweetHeading->realFixed(x, y, z);      /* 0350: a heading at each field sample */
+	}
 	return 1;
 }
 
