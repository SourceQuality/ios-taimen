+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * 0301: ABL powers its USB PHYs down when it boots a kernel. Boot 132 (SuperSpeed): the link sat in
+ * RX.Detect (DSTS link state 5) and the PC never saw a connect; the QUSB2 PHY read PWR_CTRL1 0x23
+ * (POWER_DOWN set) and PLL_STATUS 0x64 (CORE_READY clear), so high speed had no UTMI clock either
+ * (boots 129/131). Both come back up here as Linux brings them up: phy-qcom-qusb2.c msm8998_phy_cfg
+ * (disable_ctrl is POWER_DOWN only; ABL's tuning stays) and phy-qcom-qmp-usbc.c msm8998_usb3phy_cfg
+ * (serdes +0x000, tx/rx +0x200/+0x400, tx2/rx2 +0x600/+0x800, PCS_MISC +0xa00, PCS +0xc00; tables
+ * below). The Type-C lane select (PCS_MISC) stays as ABL set it unless sweetusbflip=0/1 says.
+ * sweetusbphy=0 leaves the PHYs alone, 1 (default) restarts what is down, 2 always reloads the USB3 PHY.
+ */
+#define QMP_PA                  0x0c010000
+#define QMP_PCS                 0xc00
+#define QMP_PCS_MISC            0xa00
+#define QMP_SW_RESET            (QMP_PCS + 0x000)
+#define QMP_POWER_DOWN          (QMP_PCS + 0x004)       /* SW_PWRDN, bit 0, active low */
+#define QMP_START               (QMP_PCS + 0x008)       /* SERDES_START | PCS_START */
+#define QMP_PCS_STATUS          (QMP_PCS + 0x174)       /* PHYSTATUS (bit 6) while initialising */
+#define GCC_USB3_PHY_AUX_CBCR   0x50000
+#define GCC_USB3_PHY_PIPE_CBCR  0x50004
+#define QUSB2_PLL_STATUS        0x1a0                   /* CORE_READY_STATUS, bit 0 */
+#define QUSB2_PWR_CTRL1         0x210                   /* POWER_DOWN, bit 0 */
+
+static const uint16_t qmp_serdes_tbl[][2] = {      /* Linux msm8998_usb3_serdes_tbl */
+	{ 0x138, 0x30 }, { 0x034, 0x04 }, { 0x080, 0x14 }, { 0x03c, 0x06 }, { 0x08c, 0x08 },
+	{ 0x15c, 0x06 }, { 0x164, 0x01 }, { 0x13c, 0x80 }, { 0x0b0, 0x82 }, { 0x0b8, 0xab },
+	{ 0x0bc, 0xea }, { 0x0c0, 0x02 }, { 0x060, 0x06 }, { 0x068, 0x16 }, { 0x070, 0x36 },
+	{ 0x0dc, 0x00 }, { 0x0d8, 0x3f }, { 0x0f8, 0x01 }, { 0x0f4, 0xc9 }, { 0x148, 0x0a },
+	{ 0x0a0, 0x00 }, { 0x09c, 0x34 }, { 0x098, 0x15 }, { 0x090, 0x04 }, { 0x154, 0x00 },
+	{ 0x094, 0x00 }, { 0x0f0, 0x00 }, { 0x00c, 0x0a }, { 0x048, 0x07 }, { 0x0d0, 0x80 },
+	{ 0x184, 0x01 }, { 0x010, 0x01 }, { 0x01c, 0x31 }, { 0x020, 0x01 }, { 0x014, 0x00 },
+	{ 0x018, 0x00 }, { 0x024, 0x85 }, { 0x028, 0x07 },
+};
+static const uint16_t qmp_tx_tbl[][2] = {      /* Linux msm8998_usb3_tx_tbl */
+	{ 0x060, 0x10 }, { 0x0a4, 0x12 }, { 0x08c, 0x16 }, { 0x044, 0x00 },
+};
+static const uint16_t qmp_rx_tbl[][2] = {      /* Linux msm8998_usb3_rx_tbl */
+	{ 0x030, 0x0b }, { 0x0d4, 0x0f }, { 0x0d8, 0x4e }, { 0x0dc, 0x18 }, { 0x0f8, 0x07 },
+	{ 0x0fc, 0x80 }, { 0x104, 0x43 }, { 0x10c, 0x1c }, { 0x034, 0x75 }, { 0x03c, 0x00 },
+	{ 0x040, 0x00 }, { 0x044, 0x80 }, { 0x008, 0x0a }, { 0x014, 0x06 }, { 0x100, 0x00 },
+	{ 0x0c0, 0x03 }, { 0x164, 0x05 },
+};
+static const uint16_t qmp_pcs_tbl[][2] = {      /* Linux msm8998_usb3_pcs_tbl */
+	{ 0x0c8, 0x83 }, { 0x0cc, 0x09 }, { 0x0d0, 0xa2 }, { 0x0d4, 0x40 }, { 0x0c4, 0x02 },
+	{ 0x080, 0xd1 }, { 0x084, 0x1f }, { 0x088, 0x47 }, { 0x064, 0x1b }, { 0x00c, 0x9f },
+	{ 0x010, 0x9f }, { 0x014, 0xb7 }, { 0x018, 0x4e }, { 0x01c, 0x65 }, { 0x020, 0x6b },
+	{ 0x024, 0x15 }, { 0x028, 0x0d }, { 0x02c, 0x15 }, { 0x030, 0x0d }, { 0x034, 0x15 },
+	{ 0x038, 0x0d }, { 0x03c, 0x15 }, { 0x040, 0x0d }, { 0x044, 0x15 }, { 0x048, 0x0d },
+	{ 0x04c, 0x15 }, { 0x050, 0x0d }, { 0x05c, 0x02 }, { 0x0a0, 0x04 }, { 0x08c, 0x44 },
+	{ 0x070, 0xe7 }, { 0x074, 0x03 }, { 0x078, 0x40 }, { 0x07c, 0x00 }, { 0x1d8, 0x8a },
+	{ 0x0b8, 0x75 }, { 0x0b0, 0x86 }, { 0x0bc, 0x13 },
+};
+
+static void
+phy_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* write the tables, or count the registers that differ from them */
+static unsigned
+qmp_tables(vm_offset_t qmp, bool write)
+{
+	static const struct {
+		uint32_t at;
+		const uint16_t (*t)[2];
+		unsigned n;
+	} part[] = {
+		{ 0x000, qmp_serdes_tbl, sizeof(qmp_serdes_tbl) / sizeof(qmp_serdes_tbl[0]) },
+		{ 0x200, qmp_tx_tbl, sizeof(qmp_tx_tbl) / sizeof(qmp_tx_tbl[0]) },
+		{ 0x400, qmp_rx_tbl, sizeof(qmp_rx_tbl) / sizeof(qmp_rx_tbl[0]) },
+		{ 0x600, qmp_tx_tbl, sizeof(qmp_tx_tbl) / sizeof(qmp_tx_tbl[0]) },
+		{ 0x800, qmp_rx_tbl, sizeof(qmp_rx_tbl) / sizeof(qmp_rx_tbl[0]) },
+		{ QMP_PCS, qmp_pcs_tbl, sizeof(qmp_pcs_tbl) / sizeof(qmp_pcs_tbl[0]) },
+	};
+	unsigned diff = 0;
+	for (unsigned k = 0; k < sizeof(part) / sizeof(part[0]); k++) {
+		for (unsigned i = 0; i < part[k].n; i++) {
+			uint32_t off = part[k].at + part[k].t[i][0];
+			if (write) {
+				phy_wr(qmp, off, part[k].t[i][1]);
+			} else if ((usb_rd(qmp, off) & 0xff) != part[k].t[i][1]) {
+				diff++;
+			}
+		}
+	}
+	return diff;
+}
+
+static void
+ud_phys_on(void)
+{
+	int mode = 1, flip = -1;
+	PE_parse_boot_argn("sweetusbphy", &mode, sizeof(mode));
+	PE_parse_boot_argn("sweetusbflip", &flip, sizeof(flip));
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	vm_offset_t hs = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	vm_offset_t qmp = ml_io_map(QMP_PA, 0x1000);
+	if (gcc == 0 || hs == 0 || qmp == 0) {
+		printf("SWEET USB: PHY map failed\n");
+		return;
+	}
+	uint32_t aux = usb_rd(gcc, GCC_USB3_PHY_AUX_CBCR), pipe = usb_rd(gcc, GCC_USB3_PHY_PIPE_CBCR);
+	uint32_t pwr = usb_rd(hs, QUSB2_PWR_CTRL1) & 0xff;
+	unsigned diff = qmp_tables(qmp, false);
+	printf("SWEET USB: ABL's PHYs: QUSB2 PWR_CTRL1 0x%02x PLL_STATUS 0x%02x; USB3 SW_RESET 0x%x POWER_DOWN 0x%x "
+	    "START 0x%x PCS_STATUS 0x%02x PCS_MISC 0x%x, %u table values differ; aux CBCR 0x%08x pipe CBCR 0x%08x\n",
+	    pwr, usb_rd(hs, QUSB2_PLL_STATUS) & 0xff, usb_rd(qmp, QMP_SW_RESET), usb_rd(qmp, QMP_POWER_DOWN),
+	    usb_rd(qmp, QMP_START), usb_rd(qmp, QMP_PCS_STATUS), usb_rd(qmp, QMP_PCS_MISC), diff, aux, pipe);
+	if (mode == 0) {
+		return;
+	}
+	if (pwr & 1) {
+		phy_wr(hs, QUSB2_PWR_CTRL1, pwr & ~1u);
+		delay(200);                             /* Linux: 150 us for the PLL to lock */
+	}
+	if (aux & CBCR_CLK_OFF) {
+		phy_wr(gcc, GCC_USB3_PHY_AUX_CBCR, aux | 1);
+	}
+	phy_wr(gcc, GCC_USB3_PHY_PIPE_CBCR, pipe | 1); /* halt bit not meaningful (Linux BRANCH_HALT_SKIP) */
+	bool down = (usb_rd(qmp, QMP_SW_RESET) & 1) || !(usb_rd(qmp, QMP_POWER_DOWN) & 1) ||
+	    (usb_rd(qmp, QMP_START) & 3) != 3 || (usb_rd(qmp, QMP_PCS_STATUS) & (1u << 6));
+	if (flip == 0 || flip == 1) {
+		phy_wr(qmp, QMP_PCS_MISC, 2u | (uint32_t)flip);      /* SW_PORTSELECT_MUX | VAL */
+		down = true;
+	}
+	int i = 0;
+	if (down || mode >= 2) {
+		/* qmp_usbc_power_off, then qmp_usbc_init + qmp_usbc_power_on */
+		phy_wr(qmp, QMP_SW_RESET, 1);
+		phy_wr(qmp, QMP_START, 0);
+		phy_wr(qmp, QMP_POWER_DOWN, usb_rd(qmp, QMP_POWER_DOWN) | 1);
+		qmp_tables(qmp, true);
+		phy_wr(qmp, QMP_SW_RESET, 0);
+		phy_wr(qmp, QMP_START, 3);
+		for (i = 0; i < 100 && (usb_rd(qmp, QMP_PCS_STATUS) & (1u << 6)); i++) {
+			delay(100);
+		}
+	}
+	printf("SWEET USB: PHYs now: QUSB2 PWR_CTRL1 0x%02x PLL_STATUS 0x%02x (%s); USB3 %s, PCS_STATUS 0x%02x "
+	    "after %d00 us (%s), PCS_MISC 0x%x, aux CBCR 0x%08x pipe CBCR 0x%08x\n",
+	    usb_rd(hs, QUSB2_PWR_CTRL1) & 0xff, usb_rd(hs, QUSB2_PLL_STATUS) & 0xff,
+	    (usb_rd(hs, QUSB2_PLL_STATUS) & 1) ? "ready" : "NOT ready", (down || mode >= 2) ? "restarted" : "left running",
+	    usb_rd(qmp, QMP_PCS_STATUS) & 0xff, i, (usb_rd(qmp, QMP_PCS_STATUS) & (1u << 6)) ? "NOT ready" : "ready",
+	    usb_rd(qmp, QMP_PCS_MISC), usb_rd(gcc, GCC_USB3_PHY_AUX_CBCR), usb_rd(gcc, GCC_USB3_PHY_PIPE_CBCR));
+}
+#endif
