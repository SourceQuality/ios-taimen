diff --git a/bsd/kern/taimen_rootfix.c b/bsd/kern/taimen_rootfix.c
new file mode 100644
index 0000000..386c5a5
--- /dev/null
+++ b/bsd/kern/taimen_rootfix.c
@@ -0,0 +1,180 @@
+/*
+ * Taimen root fixups: the iOS root on userdata is patched at every boot, after vfs_mountroot
+ * and before launchd, from the payload blob ROOTFIX (/chosen/memory-map, mkpayload --blob;
+ * built by port/tools/taimen/mkrootfix.py). No reflash and no HFS+ tools on the PC: the
+ * mounted root (ufsrw=1) is written through the VFS.
+ *   blob     "RFX1", u32 count, then records: u32 op, mode, uid, gid, path length, data
+ *            length, the NUL-terminated path, the data (both padded to 4 bytes)
+ *   ops      1 write (create or replace), 2 write only if absent (prefs iOS may own later),
+ *            3 mkdir if absent; owner and mode set on what was written or created;
+ *            "@HOSTUUID@" in a path is replaced by IOPlatformUUID
+ * Without the blob nothing happens. Boot-arg taimenrootfix=0 skips it.
+ */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <uuid/uuid.h>
+
+extern vm_map_address_t phystokv(uint64_t pa);
+extern kern_return_t IOBSDGetPlatformUUID(__darwin_uuid_t uuid, mach_timespec_t timeoutp);
+extern int taimen_mkdir(const char *path, int mode, vfs_context_t ctx);   /* vfs_syscalls.c */
+void taimen_rootfix(void);
+
+#define RFX_MAGIC       0x31584652u     /* "RFX1" */
+#define RFX_WRITE       1u
+#define RFX_CREATE      2u
+#define RFX_MKDIR       3u
+
+/*
+ * "@HOSTUUID@" in a path becomes IOPlatformUUID (gethostuuid; from the ADT's unique-chip-id
+ * and chip-id), the name CFPreferences gives ByHost files, e.g. LastSystemVersion in
+ * Preferences/ByHost/com.apple.migration.<uuid>.plist.
+ */
+static char rootfix_uuid[37];
+
+static const char *
+rootfix_path(const char *path, char *buf, size_t len)
+{
+	const char *at = strstr(path, "@HOSTUUID@");
+	if (at == NULL) {
+		return path;
+	}
+	if (rootfix_uuid[0] == '\0') {
+		uuid_t u;
+		mach_timespec_t timeout = {5, 0};
+		if (IOBSDGetPlatformUUID(u, timeout) != KERN_SUCCESS) {
+			return NULL;
+		}
+		uuid_unparse_upper(u, rootfix_uuid);
+		printf("TAIMEN ROOTFIX: IOPlatformUUID %s\n", rootfix_uuid);
+	}
+	snprintf(buf, len, "%.*s%s%s", (int)(at - path), path, rootfix_uuid, at + 10);
+	return buf;
+}
+
+static int
+rootfix_owner(vnode_t vp, uint32_t mode, uint32_t uid, uint32_t gid, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, uid);
+	VATTR_SET(&va, va_gid, gid);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	return vnode_setattr(vp, &va, ctx);
+}
+
+static int
+rootfix_write(const char *path, const uint8_t *data, uint32_t len, uint32_t mode, uint32_t uid,
+    uint32_t gid, bool only_if_absent, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int err;
+	if (only_if_absent && vnode_lookup(path, 0, &vp, ctx) == 0) {
+		vnode_put(vp);
+		return EEXIST;
+	}
+	err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, (int)(mode & 07777), 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	int resid = 0;
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	int err2 = rootfix_owner(vp, mode, uid, gid, ctx);
+	(void)vnode_close(vp, FWRITE, ctx);
+	return err ? err : err2;
+}
+
+static int
+rootfix_mkdir(const char *path, uint32_t mode, uint32_t uid, uint32_t gid, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		vnode_put(vp);
+		return EEXIST;
+	}
+	int err = taimen_mkdir(path, (int)(mode & 07777), ctx);
+	if (err) {
+		return err;
+	}
+	if ((err = vnode_lookup(path, 0, &vp, ctx)) == 0) {
+		err = rootfix_owner(vp, mode, uid, gid, ctx);
+		vnode_put(vp);
+	}
+	return err;
+}
+
+void
+taimen_rootfix(void)
+{
+	int enabled = 1;
+	DTEntry node;
+	uint64_t const *v;
+	unsigned int size;
+	(void)PE_parse_boot_argn("taimenrootfix", &enabled, sizeof(enabled));
+	if (!enabled || SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "ROOTFIX", (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("TAIMEN ROOTFIX: %s\n", enabled ? "no ROOTFIX blob in the payload" : "disabled");
+		return;
+	}
+	const uint8_t *b = (const uint8_t *)phystokv(v[0]), *end = b + v[1];
+	const uint32_t *h = (const uint32_t *)b;
+	if (v[1] < 8 || h[0] != RFX_MAGIC) {
+		printf("TAIMEN ROOTFIX: bad blob (len %llu magic %#x)\n", v[1], v[1] >= 4 ? h[0] : 0);
+		return;
+	}
+	uint32_t count = h[1], done = 0, skipped = 0, failed = 0;
+	vfs_context_t ctx = vfs_context_kernel();
+	const uint8_t *p = b + 8;
+	for (uint32_t i = 0; i < count; i++) {
+		if (p + 24 > end) {
+			printf("TAIMEN ROOTFIX: blob truncated at record %u\n", i);
+			break;
+		}
+		const uint32_t *r = (const uint32_t *)p;
+		uint32_t op = r[0], mode = r[1], uid = r[2], gid = r[3], plen = r[4], dlen = r[5];
+		const char *path = (const char *)(p + 24);
+		const uint8_t *data = p + 24 + ((plen + 3u) & ~3u);
+		p = data + ((dlen + 3u) & ~3u);
+		if (p > end || plen == 0 || path[plen - 1] != '\0' || path[0] != '/') {
+			printf("TAIMEN ROOTFIX: bad record %u\n", i);
+			break;
+		}
+		char pbuf[256];
+		const char *rawpath = path;
+		if ((path = rootfix_path(rawpath, pbuf, sizeof(pbuf))) == NULL) {
+			printf("TAIMEN ROOTFIX: %s: no IOPlatformUUID\n", rawpath);
+			failed++;
+			continue;
+		}
+		int err = op == RFX_MKDIR ? rootfix_mkdir(path, mode, uid, gid, ctx) :
+		    (op == RFX_WRITE || op == RFX_CREATE) ?
+		    rootfix_write(path, data, dlen, mode, uid, gid, op == RFX_CREATE, ctx) : EINVAL;
+		if (err == 0) {
+			done++;
+		} else if (err == EEXIST) {
+			skipped++;
+		} else {
+			failed++;
+		}
+		if (err != EEXIST) {
+			printf("TAIMEN ROOTFIX: %s %s (%u bytes, %o %u:%u): %s%d\n",
+			    op == RFX_MKDIR ? "mkdir" : op == RFX_CREATE ? "create" : "write", path, dlen, mode,
+			    uid, gid, err ? "error " : "ok ", err);
+		}
+	}
+	printf("TAIMEN ROOTFIX: %u records: %u written, %u already present, %u failed\n", count, done, skipped, failed);
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 90e68bb..5756246 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -14579,3 +14579,17 @@ fs_snapshot(__unused proc_t p, struct fs_snapshot_args *uap,
 
 	return error;
 }
+
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/* bsd/kern/taimen_rootfix.c: mkdir with a kernel-space path (mkdir1at is static). */
+int taimen_mkdir(const char *path, int mode, vfs_context_t ctx);
+int
+taimen_mkdir(const char *path, int mode, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(ctx, CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+#endif
