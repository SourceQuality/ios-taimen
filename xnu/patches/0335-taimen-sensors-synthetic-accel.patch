+/*
+ * 0335 (docs/taimen-sensors-plan.md M0): the accelerometer locationd reads (CLAccelerometer, its
+ * orientation detector, then CoreMotion and backboardd's BKOrientationManager rotate the screen).
+ * Samples are in g (IOFixed): about (0, -1, 0) upright in portrait, z -1 lying face up. They stream
+ * while the event system asks for them (ReportInterval/BatchInterval in us, 0 = stop), at most
+ * 100 Hz, and copyEvent returns the last one.
+ */
+class SweetHIDAccel : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDAccel);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEvent *copyEvent(IOHIDEventType type, IOHIDEvent *matching = 0, IOOptionBits options = 0) APPLE_KEXT_OVERRIDE;
+	void sample(int mx, int my, int mz);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 3; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 4; }
+private:
+	static void tick(OSObject *owner, IOTimerEventSource *sender);
+	IOHIDEvent *event();
+	IOTimerEventSource *fTimer;
+	volatile int fMg[3];            /* the current sample, milli-g */
+	volatile UInt32 fIntervalUS;    /* 0: not streaming */
+	UInt32 fSent, fSaid;
+};
+OSDefineMetaClassAndStructors(SweetHIDAccel, IOHIDEventService);
+static SweetHIDAccel *gSweetAccel;
+
+bool
+SweetHIDAccel::start(IOService *provider)
+{
+	int level = 0;
+	if (!PE_parse_boot_argn("taimensensors", &level, sizeof(level)) || level < 1) {
+		return false;   /* no service: locationd sees no accelerometer, as before */
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	fMg[0] = 0;
+	fMg[1] = -1000;
+	fMg[2] = 0;
+	fTimer = IOTimerEventSource::timerEventSource(this, &SweetHIDAccel::tick);
+	if (!fTimer || _hidWorkLoop->addEventSource(fTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	gSweetAccel = this;
+	registerService();
+	IOLog("TAIMEN SENSORS: SweetHIDAccel up (0xff00/3, synthetic: the control port's accel/orient), portrait\n");
+	return true;
+}
+
+IOHIDEvent *
+SweetHIDAccel::event()
+{
+	return IOHIDEvent::accelerometerEvent(mach_absolute_time(), (IOFixed)(((int64_t)fMg[0] << 16) / 1000),
+	           (IOFixed)(((int64_t)fMg[1] << 16) / 1000), (IOFixed)(((int64_t)fMg[2] << 16) / 1000));
+}
+
+void
+SweetHIDAccel::tick(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDAccel *me = (SweetHIDAccel *)owner;
+	UInt32 us = me->fIntervalUS;
+	if (us == 0) {
+		return;
+	}
+	IOHIDEvent *e = me->event();
+	if (e) {
+		me->dispatchEvent(e);
+		e->release();
+		me->fSent++;
+	}
+	sender->setTimeoutUS(us);
+}
+
+IOReturn
+SweetHIDAccel::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *ri = OSDynamicCast(OSNumber, d->getObject(kIOHIDReportIntervalKey));
+	OSNumber *bi = OSDynamicCast(OSNumber, d->getObject("BatchInterval"));
+	if (fSaid < 24) {
+		fSaid++;
+		char keys[160] = "";
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+		if (it) {
+			size_t n = 0;
+			for (OSString *k; (k = OSDynamicCast(OSString, it->getNextObject())) != NULL && n + 2 < sizeof(keys);) {
+				n += (size_t)snprintf(keys + n, sizeof(keys) - n, "%s%s", n ? " " : "", k->getCStringNoCopy());
+			}
+			it->release();
+		}
+		IOLog("SWEET HID: SweetHIDAccel properties [%s]: ReportInterval %lld, BatchInterval %lld (%u samples sent)\n",
+		    keys, ri ? (long long)ri->unsigned64BitValue() : -1LL, bi ? (long long)bi->unsigned64BitValue() : -1LL, fSent);
+	}
+	if (ri || bi) {
+		UInt64 us = ri ? ri->unsigned64BitValue() : bi->unsigned64BitValue();
+		if (ri && bi && bi->unsigned64BitValue() > us) {
+			us = bi->unsigned64BitValue();
+		}
+		UInt32 was = fIntervalUS;
+		fIntervalUS = us == 0 ? 0 : (UInt32)(us < 10000 ? 10000 : us > 1000000 ? 1000000 : us);
+		if (ri) {
+			setProperty(kIOHIDReportIntervalKey, ri->unsigned64BitValue(), 32);
+		}
+		if (fIntervalUS && !was) {
+			fTimer->setTimeoutUS(fIntervalUS);
+		} else if (!fIntervalUS) {
+			fTimer->cancelTimeout();
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+IOHIDEvent *
+SweetHIDAccel::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return type == kIOHIDEventTypeAccelerometer ? event() : NULL;
+}
+
+void
+SweetHIDAccel::sample(int mx, int my, int mz)
+{
+	fMg[0] = mx;
+	fMg[1] = my;
+	fMg[2] = mz;
+	IOLog("TAIMEN SENSORS: accel now %d %d %d mg (streaming every %u us, %u samples sent)\n", mx, my, mz,
+	    fIntervalUS, fSent);
+	IOHIDEvent *e = event();
+	if (e) {
+		dispatchEvent(e);
+		e->release();
+	}
+}
+
 bool
 SweetHIDKeyboard::start(IOService *provider)
 {
@@ -664,6 +809,17 @@ sweet_hid_kbd(uint32_t usage, int down)
 	}
 }
 
+/* 0335: the accelerometer's sample, milli-g; returns 0 without the service (taimensensors=0) */
+extern "C" int
+sweet_hid_accel(int mx, int my, int mz)
+{
+	if (!gSweetAccel) {
+		return 0;
+	}
+	gSweetAccel->sample(mx, my, mz);
+	return 1;
+}
