+#define REG_NGROUPS             (sizeof(reg_groups) / sizeof(reg_groups[0]))
+
+static uint8_t *reg_data;
+static uint32_t reg_len;
+static uint32_t reg_fix;                        /* taimensnsregfix */
+static uint32_t reg_reqs, reg_req_ok, reg_req_fail, reg_other;
+static uint16_t reg_seen[REG_SEEN_MAX];
+static bool reg_seen_ok[REG_SEEN_MAX];
+static uint32_t reg_nseen, reg_served, reg_unknown;
+
+static uint32_t
+reg_size(const struct reg_group *g)
+{
+	return reg_fix != 0 && (g->id == 20 || g->id == 2980) ? reg_fix : g->size;
+}
+
+static const struct reg_group *
+reg_find(uint16_t id)
+{
+	for (unsigned i = 0; i < REG_NGROUPS; i++) {
+		if (reg_groups[i].id == id) {
+			return &reg_groups[i];
+		}
+	}
+	return NULL;
+}
+
+/* distinct groups, for the summary */
+static void
+reg_count(uint16_t id, bool ok)
+{
+	for (uint32_t i = 0; i < reg_nseen; i++) {
+		if (reg_seen[i] == id) {
+			if (ok && !reg_seen_ok[i]) {
+				reg_seen_ok[i] = true;
+				reg_served++;
+				reg_unknown--;
+			}
+			return;
+		}
+	}
+	if (reg_nseen < REG_SEEN_MAX) {
+		reg_seen[reg_nseen] = id;
+		reg_seen_ok[reg_nseen] = ok;
+		reg_nseen++;
+	}
+	if (ok) {
+		reg_served++;
+	} else {
+		reg_unknown++;
+	}
+}
+
+/* sns.reg from the root, kept for the SLPI's reads; how the table fits it, logged once */
+static void
+reg_load(void)
+{
+	int fix = 0;
+	void *d = NULL;
+	uint32_t n = 0;
+
+	if (PE_parse_boot_argn("taimensnsregfix", &fix, sizeof(fix)) && fix > 0 && fix <= SNS_REG_DATA_MAX) {
+		reg_fix = (uint32_t)fix;
+		LOG("9: taimensnsregfix=%#x: groups 20 and 2980 are served with %#x bytes (the table says 0x3a)", fix, fix);
+	}
+	if (taimen_fw_load(FW_DIR "sns.reg", 1u << 20, &d, &n) != 0 || d == NULL || n == 0) {
+		LOG("9: no %ssns.reg: every group read will get a failure", FW_DIR);
+		return;
+	}
+	reg_data = (uint8_t *)d;
+	reg_len = n;
+	unsigned beyond = 0, past_end = 0;
+	for (unsigned i = 0; i < REG_NGROUPS; i++) {
+		const struct reg_group *g = &reg_groups[i];
+		uint32_t size = reg_size(g), last = 0;
+		if (g->off + size > reg_len) {
+			past_end++;
+			LOG("9: sns.reg group %u (%#x + %#x) runs past the file's end (%#x)", g->id, g->off, size, reg_len);
+			continue;
+		}
+		for (uint32_t k = 0; k < SNS_REG_DATA_MAX && g->off + k < reg_len; k++) {
+			if (reg_data[g->off + k] != 0) {
+				last = k + 1;
+			}
+		}
+		if (last > size) {
+			beyond++;
+			LOG("9: sns.reg group %u @%#x: data up to +%#x, the table serves %#x bytes%s", g->id, g->off, last, size,
+			    g->id == 20 || g->id == 2980 ? " (REG/ FIXME: 0x7e on some SoCs; taimensnsregfix=0x7e)" : "");
+		}
+	}
+	/* 256-byte blocks with data that no table group starts: groups this table does not know */
+	char extra[128];
+	unsigned nextra = 0;
+	size_t el = 0;
+	extra[0] = 0;
+	for (uint32_t b = 0; b < reg_len; b += 0x100) {
+		bool known = false, data = false;
+		for (unsigned i = 0; i < REG_NGROUPS && !known; i++) {
+			known = reg_groups[i].off == b;
+		}
+		for (uint32_t k = b; k < b + 0x100 && k < reg_len && !data; k++) {
+			data = reg_data[k] != 0;
+		}
+		if (!known && data) {
+			nextra++;
+			if (el + 8 < sizeof(extra)) {
+				el += (size_t)snprintf(extra + el, sizeof(extra) - el, " %#x", b);
+			}
+		}
+	}
+	LOG("9: sns.reg %u bytes for the registry server: %u table groups, %u with data past their size, %u past the "
+	    "end; %u blocks with data outside the table:%s", reg_len, (unsigned)REG_NGROUPS, beyond, past_end, nextra,
+	    nextra != 0 ? extra : " none");
+}
+
+static void
+reg_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
+{
+	uint8_t type = d[0];
+	uint16_t txn = ld16(d + 1), msg = ld16(d + 3);
+
+	if (type != QMI_REQ || msg != SNS_REG_MSG_GROUP) {
+		/* REG/ answers nothing else either */
+		if (reg_other++ < 16) {
+			LOG("9: t=%u.%03u sns_reg: QMI type %u msg %#x txn %u from %u:%#x, %u bytes: not a group read, no answer",
+			    T, type, msg, txn, node, port, len);
+		}
+		return;
+	}
+	uint16_t tl = 0, id = 0;
+	const uint8_t *v = qm_find(d, len, 0x01, &tl);
+	bool have_id = v != NULL && tl >= 2;
+	if (have_id) {
+		memcpy(&id, v, 2);
+	}
+	const struct reg_group *g = have_id ? reg_find(id) : NULL;
+	uint32_t size = g != NULL ? reg_size(g) : 0;
+	bool ok = g != NULL && reg_data != NULL && g->off + size <= reg_len && size <= SNS_REG_DATA_MAX;
+
+	uint8_t m[7 + 5 + 5 + 3 + 2 + SNS_REG_DATA_MAX], data[2 + SNS_REG_DATA_MAX];
+	uint16_t result = ok ? 0 : 1, dl = (uint16_t)(ok ? size : 0);
+	uint32_t n = 7;
+	m[0] = QMI_RESP;
+	st16(m + 1, txn);
+	st16(m + 3, SNS_REG_MSG_GROUP);
+	n = qm_tlv(m, n, 0x02, &result, 2);
+	n = qm_tlv(m, n, 0x03, &id, 2);
+	memcpy(data, &dl, 2);
+	if (ok) {
+		memcpy(data + 2, reg_data + g->off, dl);
+	}
+	n = qm_tlv(m, n, 0x04, data, (uint16_t)(2 + dl));
+	st16(m + 5, (uint16_t)(n - 7));
+	qrtr_send(QRTR_TYPE_DATA, PORT_SNS_REG, node, port, m, n);
+
+	reg_reqs++;
+	if (ok) {
+		reg_req_ok++;
+	} else {
+		reg_req_fail++;
+	}
+	reg_count(id, ok);
+	if (ok) {
+		LOG("9: t=%u.%03u sns_reg group %u served: %#x + %#x (txn %u, %u:%#x)", T, id, g->off, size, txn, node, port);
+	} else {
+		LOG("9: t=%u.%03u sns_reg group %u %s: failure, 0 bytes (txn %u, %u:%#x)", T, id,
+		    !have_id ? "(no group TLV 0x01)" : g == NULL ? "UNKNOWN" : reg_data == NULL ? "no sns.reg" : "past the file",
+		    txn, node, port);
+	}
+}
