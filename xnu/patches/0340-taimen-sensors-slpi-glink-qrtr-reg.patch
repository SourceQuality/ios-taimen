+/* ---------------------------------------------------------------- M3: the loop (0340) */
+
+#define M3_WINDOW_MS            20000
+
+static void
+m3_summary(const char *when)
+{
+	char chans[160], smgr[64];
+	size_t cl = 0;
+	chans[0] = 0;
+	for (uint32_t i = 0; i < g_chans && cl + 40 < sizeof(chans); i++) {
+		struct chan *c = &g_ch[i];
+		cl += (size_t)snprintf(chans + cl, sizeof(chans) - cl, "%s%s(%s)", i != 0 ? " " : "", c->name,
+		    chan_up(c) ? "up" : c->remote_open ? "acked" : "down");
+	}
+	if (smgr_node != 0xFFFFFFFFu) {
+		snprintf(smgr, sizeof(smgr), "SMGR v%u inst %u at %u:%#x", smgr_word & 0xFF, smgr_word >> 8, smgr_node, smgr_port);
+	} else {
+		snprintf(smgr, sizeof(smgr), "no SMGR");
+	}
+	LOG("9: M3%s: dsps glink v%u features %#x (SLPI %#x)%s, chans %s, qrtr node %d v%u, servers %u (%s), "
+	    "sns_reg %u groups served, %u unknown (%u requests: %u ok, %u failed)", when, g_rver, g_features, g_rfeat,
+	    g_rver_seen ? "" : " (no VERSION seen)", g_chans != 0 ? chans : "none", q_hello_rx ? (int)q_node : -1, q_ver,
+	    q_nsrv, smgr, reg_served, reg_unknown, reg_reqs, reg_req_ok, reg_req_fail);
+	glink_summary();
+	for (uint32_t i = 0; i < q_nsrv; i++) {
+		LOG("8:  server svc %#x v%u inst %u node %u port %#x", q_srv[i].svc, q_srv[i].word & 0xFF, q_srv[i].word >> 8,
+		    q_srv[i].node, q_srv[i].port);
+	}
+	LOG("8:  qrtr: %u HELLO, %u BYE, %u lookups, %u pd-mapper requests, %u RESUME_TX, %u other", q_hellos, q_byes,
+	    q_lookups, q_pdreqs, q_resumes, q_other);
+}
+
+static void
+m3_run(int level)
+{
+	LOG("7: M3 (taimensensors=%d): GLINK on the dsps edge (APCS bit %u), QRTR, SNS_REG; t= is from AUTH_AND_RESET",
+	    level, SLPI_GLINK_BIT);
+	reg_load();
+	if (!glink_init()) {
+		return;
+	}
+	glink_register(QCHAN, qrtr_rx);
+	uint32_t n = 0;
+	struct smp2p_hdr *in = (struct smp2p_hdr *)smem_part_get(slpi_part, slpi_cacheline, ITEM_SMP2P_IN, &n);
+	volatile uint32_t *slave = in != NULL ? smp2p_find(in, "slave-kernel") : NULL;
+	uint64_t start = now_ms(), last_status = start;
+	uint32_t last_sig = 0;
+	bool summary = false;
+	for (;;) {
+		bool busy = glink_poll();
+		qrtr_poll();
+		if (!summary && now_ms() - start >= M3_WINDOW_MS) {
+			summary = true;
+			m3_summary("");
+			LOG("9: t=%u.%03u the registry stays served, polled every 20 ms", T);
+		}
+		if (slave != NULL && (*slave & SLAVE_ERR_FATAL) != 0) {
+			LOG("9: t=%u.%03u *** SLPI FATAL (slave-kernel %#x) ***", T, *slave);
+			crash_reason();
+			m3_summary(" (at the SLPI's fatal error)");
+			break;
+		}
+		if (g_dead && summary) {
+			LOG("9: t=%u.%03u GLINK is dead; the sensors thread ends", T);
+			break;
+		}
+		/* after the window: a status line each minute in which something happened */
+		if (summary && now_ms() - last_status >= 60000) {
+			last_status = now_ms();
+			uint32_t sig = g_rx_msgs + q_nsrv + reg_reqs + q_lookups + q_pdreqs;
+			if (sig != last_sig) {
+				last_sig = sig;
+				LOG("9: t=%u.%03u status: slave-kernel %#x, glink rx %u tx %u, servers %u%s, sns_reg %u served %u "
+				    "unknown (%u requests)", T, slave != NULL ? *slave : 0, g_rx_msgs, g_tx_msgs, q_nsrv,
+				    smgr_node != 0xFFFFFFFFu ? " (SMGR up)" : "", reg_served, reg_unknown, reg_reqs);
+			}
+		}
+		if (busy) {
+			IODelay(200);
+		} else {
+			IOSleep(summary ? 20 : 2);
+		}
+	}
 }
 
