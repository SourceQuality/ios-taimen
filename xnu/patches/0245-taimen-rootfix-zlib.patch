+/*
+ * zlib's allocations (a few hundred KB for one inflate), with the size in front for the free.
+ */
+static void *
+rootfix_zalloc(void *opaque, u_int items, u_int size)
+{
+	(void)opaque;
+	size_t n = (size_t)items * size + 16;
+	uint8_t *p = kalloc_data(n, Z_WAITOK | Z_ZERO);
+	if (p == NULL) {
+		return NULL;
+	}
+	*(size_t *)p = n;
+	return p + 16;
+}
+
+static void
+rootfix_zfree(void *opaque, void *ptr)
+{
+	(void)opaque;
+	uint8_t *p = (uint8_t *)ptr - 16;
+	kfree_data(p, *(size_t *)p);
+}
+
+/*
+ * RFX_CREATE_Z: written only if absent, from u32 size + zlib data (mkrootfix.py --zfile). ABL
+ * starts no payload over ~35 MiB (boot 78); the 19 MB sweetgl dylib is ~4.4 MB this way.
+ */
+static int
+rootfix_create_z(const char *path, const uint8_t *data, uint32_t dlen, uint32_t mode, uint32_t uid,
+    uint32_t gid, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		vnode_put(vp);
+		return EEXIST;
+	}
+	if (dlen < 4) {
+		return EINVAL;
+	}
+	uint32_t olen;
+	memcpy(&olen, data, 4);
+	if (olen == 0 || olen > (256u << 20)) {
+		return EINVAL;
+	}
+	uint8_t *out = kalloc_data(olen, Z_WAITOK);
+	if (out == NULL) {
+		return ENOMEM;
+	}
+	z_stream zs = {
+		.next_in = (Bytef *)(uintptr_t)(data + 4), .avail_in = dlen - 4,
+		.next_out = out, .avail_out = olen,
+		.zalloc = rootfix_zalloc, .zfree = rootfix_zfree,
+	};
+	int err = EINVAL;
+	if (inflateInit(&zs) == Z_OK) {
+		int r = inflate(&zs, Z_FINISH);
+		inflateEnd(&zs);
+		err = r == Z_STREAM_END && zs.total_out == olen ? 0 : EINVAL;
+	}
+	if (err == 0) {
+		err = rootfix_write(path, out, olen, mode, uid, gid, true, ctx);
+	} else {
+		printf("TAIMEN ROOTFIX: %s: zlib data does not inflate to %u bytes\n", path, olen);
+	}
+	kfree_data(out, olen);
+	return err;
+}
+
 /* EEXIST when there is nothing to remove (counted with "already present"). */
 static int
 rootfix_remove(const char *path, vfs_context_t ctx)
