+		    op == RFX_CREATE_Z ? rootfix_create_z(path, data, dlen, mode, uid, gid, ctx) :
 		    (op == RFX_WRITE || op == RFX_CREATE) ?
 		    rootfix_write(path, data, dlen, mode, uid, gid, op == RFX_CREATE, ctx) : EINVAL;
 		if (err == 0) {
@@ -188,7 +262,8 @@ rootfix_apply(void)
