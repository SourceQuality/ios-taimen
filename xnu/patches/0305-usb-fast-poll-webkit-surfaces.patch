+/*
+ * 0305: a short sleep while frames move. Events are polled, so with 1 ms between polls only one
+ * bulk transfer per direction completed per millisecond: ~1 MB/s (the 11 MB screenshot took 10-26 s).
+ */
+static void
+ud_sleep_us(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	(void)assert_wait_deadline_with_leeway(&ud.sleep_chan, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL, deadline, 0);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
 static void
 ud_sleep_ms(unsigned ms)
 {
@@ -1049,7 +1062,8 @@ ud_event(uint32_t ev)
 static void
 ud_thread(void *arg __unused, wait_result_t wr __unused)
 {
-	uint32_t ticks = 0, last_dsts = ~0u, changes = 0;
+	uint32_t ticks = 0, last_dsts = ~0u, changes = 0, busy = 0;
+	uint64_t last_ms = 0;
 	for (;;) {
 		/* 0301: every change of the link state (DSTS bits 21:18) and connect speed, the first 40 */
 		uint32_t dsts = dwc_rd(DSTS);
@@ -1071,10 +1085,23 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 			}
 			dwc_wr(GEVNTCOUNT, count);
 		}
-		if ((++ticks % 30000) == 0) {
-			printf("SWEET USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		/* ticks: milliseconds (the link state and frame lines use them) */
+		uint64_t now_ns;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+		uint64_t now_ms = now_ns / NSEC_PER_MSEC;
+		if (now_ms != last_ms) {
+			last_ms = now_ms;
+			if ((++ticks % 30000) == 0) {
+				printf("SWEET USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+			}
+		}
+		/* busy: something happened in the last 20 ms, or a frame is still on its way out */
+		busy = (count != 0 || ud.tx_busy || ud.txq_count != 0) ? 400 : (busy ? busy - 1 : 0);
+		if (busy) {
+			ud_sleep_us(50);
+		} else {
+			ud_sleep_ms(1);
 		}
-		ud_sleep_ms(1);
 	}
 }
 
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 1553ab1..394b2b5 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -464,14 +464,51 @@ OSDefineMetaClassAndStructors(IOSurfaceRootUserClient, IOUserClient);
 
 static uint64_t sweet_surf_logged;      /* selectors / traps already logged (< 64) */
 
+/*
+ * 0305: Safari's pages draw black (boot 135: the page loads, the content area stays black). Every
+ * create by WebKit's processes and MobileSafari is logged (up to 400), and each selector the first
+ * time each of them uses it.
+ */
+static bool
+sweet_surf_webkit(char *name, size_t len)
+{
+	proc_selfname(name, (int)len);
+	return strncmp(name, "com.apple.WebK", 14) == 0 || strncmp(name, "MobileSafari", 12) == 0;
+}
+
+static void
+sweet_surf_log_webkit(const char *what, uint32_t n)
+{
+	static struct { char name[20]; uint64_t seen; } who[8];
+	char name[32];
+	if (!sweet_surf_webkit(name, sizeof(name))) {
+		return;
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		if (who[i].name[0] == 0) {
+			strlcpy(who[i].name, name, sizeof(who[i].name));
+		}
+		if (strncmp(who[i].name, name, sizeof(who[i].name) - 1) == 0) {
+			uint32_t bit = (what[0] == 't' ? 48 : 0) + n;
+			if (bit < 64 && !(who[i].seen & (1ULL << bit))) {
+				who[i].seen |= 1ULL << bit;
+				IOLog("SWEET SURF: webkit %s %s %u\n", name, what, n);
+			}
+			return;
+		}
+	}
+}
+
 static void
 sweet_surf_log_once(const char *what, uint32_t n)
 {
 	uint32_t bit = (what[0] == 't' ? 48 : 0) + n;
 	if (bit >= 64 || (sweet_surf_logged & (1ULL << bit))) {
+		sweet_surf_log_webkit(what, n);
 		return;
 	}
 	sweet_surf_logged |= 1ULL << bit;
+	sweet_surf_log_webkit(what, n);
 	char name[32];
 	proc_selfname(name, sizeof(name));
 	IOLog("SWEET SURF: %s %s %u\n", name, what, n);
@@ -774,7 +811,10 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 			}
 		}
 	}
