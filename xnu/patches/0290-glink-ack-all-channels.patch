+/*
+ * 0290: the modem's other channels (glink_ssr, SSM_RTR_MODEM_APPS, apr_*, LOOPBACK_CTL_MPSS, DS,
+ * DATA1-4/11) were never acknowledged. Android's daemons open them; a modem task waiting on one of
+ * them would look like the DOG_HB starvation that follows WLAN mission (boots 116-121). Each one is
+ * now acknowledged and opened from our side, given receive intents, and what comes in is counted
+ * and discarded.
+ */
+struct xchan { char name[33]; uint32_t rcid, lcid, rx, bytes; bool acked, closed; };
+static struct xchan g_x[16];
+static unsigned g_nx;
+
 static void
-send_open(void)
+send_open_ch(uint32_t lcid, const char *name)
 {
-	struct { struct glink_msg m; char name[8]; } __attribute__((packed)) req = {};
+	struct { struct glink_msg m; char name[40]; } __attribute__((packed)) req = {};
+	uint32_t l = (uint32_t)strlen(name) + 1;
 	req.m.cmd = CMD_OPEN;
-	req.m.p1 = CHAN_LCID;
-	req.m.p2 = sizeof(CHAN_NAME);
-	memcpy(req.name, CHAN_NAME, sizeof(CHAN_NAME));
-	tx_write(&req, sizeof(req), NULL, 0);
+	req.m.p1 = (uint16_t)lcid;
+	req.m.p2 = l;
+	memcpy(req.name, name, MIN(l, 39u));
+	tx_write(&req, sizeof(struct glink_msg) + ((l + 7) & ~7u), NULL, 0);
+}
+
+static void
+send_open(void)
+{
+	send_open_ch(CHAN_LCID, CHAN_NAME);
 	g_open_sent = true;
 }
 
+/* our lcid for the modem's channel id */
+static uint32_t
+lcid_of(uint32_t rcid)
+{
+	if (rcid == g_rcid) {
+		return CHAN_LCID;
+	}
+	for (unsigned i = 0; i < g_nx; i++) {
+		if (g_x[i].rcid == rcid) {
+			return g_x[i].lcid;
+		}
+	}
+	return CHAN_LCID;
+}
+
+static struct xchan *
+xchan_by_rcid(uint32_t rcid)
+{
+	for (unsigned i = 0; i < g_nx; i++) {
+		if (g_x[i].rcid == rcid && rcid != g_rcid) {
+			return &g_x[i];
+		}
+	}
+	return NULL;
+}
+
+static void
+advertise_intents_ch(uint32_t lcid, uint32_t count, uint32_t size)
+{
+	struct { struct glink_msg m; uint32_t pair[2 * OUR_INTENTS]; } __attribute__((packed)) m = {};
+	count = MIN(count, (uint32_t)OUR_INTENTS);
+	m.m.cmd = CMD_INTENT;
+	m.m.p1 = (uint16_t)lcid;
+	m.m.p2 = count;
+	for (uint32_t i = 0; i < count; i++) {
+		m.pair[2 * i] = size;
+		m.pair[2 * i + 1] = g_next_intent++;
+	}
+	tx_write(&m, sizeof(struct glink_msg) + 8 * count, NULL, 0);
+}
+
 static void
 advertise_intents(uint32_t count, uint32_t size)
 {
