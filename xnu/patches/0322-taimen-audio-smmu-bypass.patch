+static void
+tas_msleep(unsigned ms)
+{
+	uint64_t deadline;
+	if (ms != 0) {
+		clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&tas_sleep_chan, THREAD_UNINT, deadline);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
