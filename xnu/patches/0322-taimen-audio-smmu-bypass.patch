+
+/* ---- the blob: every read is bounds-checked, a failure sticks ---- */
+static uint32_t
+c_get(struct cur *c, unsigned n)        /* big-endian, n <= 4 */
+{
+	uint32_t v = 0;
+	if (c->bad || c->len - c->pos < n) {
+		c->bad = true;
+		return 0;
+	}
+	while (n-- > 0) {
+		v = (v << 8) | c->p[c->pos++];
+	}
+	return v;
+}
+
+static const uint8_t *
+c_skip(struct cur *c, uint32_t n)
+{
+	if (c->bad || c->len - c->pos < n) {
+		c->bad = true;
+		return NULL;
+	}
+	c->pos += n;
+	return c->p + c->pos - n;
+}
+
+static void
+c_str(struct cur *c)                    /* a NUL-terminated description */
+{
+	while (!c->bad && c_get(c, 1) != 0) {
+	}
+}
+
+static bool
+c_block(struct cur *c, uint32_t drv, struct tas_blk *b)        /* core.c:1233-1272 */
+{
+	b->type = c_get(c, 4);
+	uint32_t crc = drv >= 0x200u ? c_get(c, 4) : 0;         /* core.c:1242: driver >= 0x200 */
+	b->pon = (uint8_t)(crc >> 24), b->pcrc = (uint8_t)(crc >> 16);
+	b->yon = (uint8_t)(crc >> 8), b->ycrc = (uint8_t)crc;
+	b->ncmd = c_get(c, 4);
+	c->bad = c->bad || b->ncmd > (c->len - c->pos) / 4u;
+	b->cmd = c_skip(c, b->ncmd * 4u);
+	return !c->bad;
+}
+
+static uint32_t
+burst_cmds(unsigned len)                /* commands one 0x85 burst takes (core.c:2058-2093) */
+{
+	return 2u + (len >= 2 ? (len - 2u) / 4u + 1u : 0u);
+}
+
+/* Every burst ends inside its block and stays in one page (core.c:1886 refuses more). */
+static bool
+blk_check(struct tas_fw *f, const struct tas_blk *b)
+{
+	for (uint32_t i = 0; i < b->ncmd;) {
+		const uint8_t *k = b->cmd + 4u * i;
+		unsigned len = ((unsigned)k[0] << 8) | k[1];
+		if (k[2] != 0x85u) {
+			f->odd += (k[2] > 0x7fu && k[2] != 0x81u);
+			i++;
+		} else if (burst_cmds(len) > b->ncmd - i) {
+			printf("TAIMEN TAS2557: %s: block %#x: burst of %u at command %u of %u runs past the block\n",
+			    f->what, b->type, len, i, b->ncmd);
+			return false;
+		} else if (k[6] + MAX(len, 1u) > 0x80u) {
+			printf("TAIMEN TAS2557: %s: block %#x: burst of %u to B%u P%u R%u leaves the page\n", f->what,
+			    b->type, len, k[4], k[5], k[6]);
+			return false;
+		} else {
+			i += burst_cmds(len);
+		}
+	}
+	return true;
+}
+
+static const char *
+tas_name(const uint8_t *s, char out[64])
+{
+	unsigned i;
+	for (i = 0; s != NULL && i < 63 && s[i] != 0; i++) {
+		out[i] = (s[i] >= 0x20 && s[i] < 0x7f) ? (char)s[i] : '?';
+	}
+	out[i] = 0;
+	return out;
+}
+
+static bool
+fw_parse(struct tas_fw *f, const char *what, const uint8_t *p, uint32_t len)   /* core.c:1157-1618 */
+{
+	struct cur c = {p, len, 0, false};
+	char name[64], attr[64], types[96];
+	unsigned k, i = 0;
+	bzero(f, sizeof(*f));
+	f->what = what, f->p = p, f->len = len;
+	if (p == NULL || len < 104 || c_get(&c, 4) != 0x35353532u) {        /* "5552", core.c:1164-1172 */
+		printf("TAIMEN TAS2557: %s: not a TAS firmware (%u bytes)\n", what, len);
+		return false;
+	}
+	f->size = c_get(&c, 4);
+	(void)c_get(&c, 4);                     /* checksum: core.c does not check it either */
+	f->ppc = c_get(&c, 4), f->fwver = c_get(&c, 4), f->drv = c_get(&c, 4);
+	(void)c_get(&c, 4);                     /* timestamp */
+	f->ddc = c_skip(&c, 64);
+	c_str(&c);
+	uint32_t family = c_get(&c, 4), device = c_get(&c, 4);
+	if (c.bad || family != 0 || device != 3) {
+		printf("TAIMEN TAS2557: %s: bad header (family %u device %u, want 0/3)\n", what, family, device);
+		return false;
+	}
+	for (k = 0; k < K_KINDS; k++) {
+		if (k == K_CAL && c.len - c.pos <= 64) {
+			break;                          /* core.c:1611 */
+		}
+		f->n[k] = c_get(&c, 2);
+		for (i = 0; i < f->n[k] && !c.bad; i++) {
+			struct tas_item spare, *it = i < TAS_ITEMS ? &f->it[k][i] : &spare;
+			bzero(it, sizeof(*it));
+			it->name = c_skip(&c, 64);
+			c_str(&c);
+			it->nblk = 1;                   /* a PLL is one block (core.c:1319-1368) */
+			if (k == K_PROG) {              /* core.c:1370-1425 */
+				it->a = (uint8_t)c_get(&c, 1);
+				it->boost = (uint16_t)c_get(&c, 2);
+			} else if (k == K_CONF) {       /* core.c:1427-1496 */
+				bool dev = f->drv >= 0x300u || (f->drv >= 0x101u && f->drv < 0x200u);
+				it->devices = dev ? (uint16_t)c_get(&c, 2) : (uint16_t)(TAS_L | TAS_R);
+				it->a = (uint8_t)c_get(&c, 1), it->b = (uint8_t)c_get(&c, 1);
+				it->rate = c_get(&c, 4);
+			} else if (k == K_CAL) {        /* core.c:1498-1556 */
+				it->a = (uint8_t)c_get(&c, 1), it->b = (uint8_t)c_get(&c, 1);
+			}
+			if (k != K_PLL) {               /* data: name, description, blocks (core.c:1274-1317) */
+				(void)c_skip(&c, 64);
+				c_str(&c);
+				it->nblk = (uint16_t)c_get(&c, 2);
+			}
+			it->data = c.pos;
+			for (unsigned j = 0; j < it->nblk && !c.bad; j++) {
+				struct tas_blk b;
+				c.bad = !c_block(&c, f->drv, &b) || !blk_check(f, &b);
+			}
+			if (c.bad) {
+				break;
+			}
+		}
+		if (c.bad) {
+			printf("TAIMEN TAS2557: %s: %s %u of %u is cut short or malformed (offset %u of %u)\n", what,
+			    tas_kind[k], i, f->n[k], c.pos, len);
+			return false;
+		}
+	}
+	printf("TAIMEN TAS2557: %s: %u bytes (header %u), PPC %#x, fw %#x, driver %#x, '%s': %u PLLs, %u programs, "
+	    "%u configurations, %u calibrations, %u bytes left, %u odd commands\n", what, len, f->size, f->ppc,
+	    f->fwver, f->drv, tas_name(f->ddc, name), f->n[K_PLL], f->n[K_PROG], f->n[K_CONF], f->n[K_CAL],
+	    c.len - c.pos, f->odd);
+	for (k = 0; k < K_KINDS; k++) {
+		for (i = 0; i < MIN(f->n[k], TAS_ITEMS); i++) {
+			const struct tas_item *it = &f->it[k][i];
+			struct cur bc = {p, len, it->data, false};
+			struct tas_blk b;
+			unsigned o = 0;
+			types[0] = 0;
+			for (unsigned j = 0; j < it->nblk && c_block(&bc, f->drv, &b) && o + 16 < sizeof(types); j++) {
+				o += (unsigned)snprintf(types + o, sizeof(types) - o, "%s%02x(%u)", j ? "/" : "", b.type, b.ncmd);
+			}
+			attr[0] = 0;
+			if (k == K_PROG) {
+				(void)snprintf(attr, sizeof(attr), " mode %u boost %u", it->a, it->boost);
+			} else if (k == K_CONF) {
+				(void)snprintf(attr, sizeof(attr), " program %u PLL %u devices %u %u Hz", it->a, it->b,
+				    it->devices, it->rate);
+			} else if (k == K_CAL) {
+				(void)snprintf(attr, sizeof(attr), " program %u configuration %u", it->a, it->b);
+			}
+			printf("TAIMEN TAS2557: %s: %s %u '%s'%s: %s\n", what, tas_kind[k], i, tas_name(it->name, name),
+			    attr, types);
+		}
+	}
+	return true;
+}
+
+/* ---- registers ---- */
+static int
+tas_fail(struct tas_chip *c, const char *op, uint32_t reg, int err)
+{
+	printf("TAIMEN TAS2557: %s 0x%02x: %s B%u P%u R%u: err %d (i2c status %#x flags %#x op %#x)\n", c->name,
+	    c->addr, op, TB(reg), TP(reg), TRG(reg), err, tas_bus.last_status, tas_bus.last_flags, tas_bus.last_op);
+	c->book = c->page = -1;
+	return err;
+}
+
+static int
+raw_wr(struct tas_chip *c, uint8_t reg, const uint8_t *d, unsigned n)
+{
+	uint8_t buf[64];
+	if (n + 1u > sizeof(buf)) {
+		return EINVAL;
+	}
+	buf[0] = reg;
+	bcopy(d, buf + 1, n);
+	return taimen_i2c_write(&tas_bus, c->addr, buf, n + 1u);
+}
+
+/* regmap.c:246-312: a new book is page 0, the book (R127), then the page */
+static int
+tas_bp(struct tas_chip *c, uint8_t book, uint8_t page)
+{
+	const uint8_t zero = 0;
+	int err;
+	if (c->book != book) {
+		if ((err = raw_wr(c, TAS_PAGE_REG, &zero, 1)) != 0 || (err = raw_wr(c, TAS_BOOK_REG, &book, 1)) != 0) {
+			return tas_fail(c, "book select", TR(book, 0, TAS_BOOK_REG), err);
+		}
+		c->book = book, c->page = 0;
+	}
+	if (c->page != page) {
+		if ((err = raw_wr(c, TAS_PAGE_REG, &page, 1)) != 0) {
+			return tas_fail(c, "page select", TR(book, page, TAS_PAGE_REG), err);
+		}
+		c->page = page;
+	}
+	return 0;
+}
+
+/* n bytes from reg on (auto-increment within the page), in I2C-sized pieces */
+static int
+tas_io(unsigned ci, uint32_t reg, uint8_t *d, unsigned n, bool rd)
+{
+	struct tas_chip *c = &tas_chip[ci];
+	unsigned r = TRG(reg), step = rd ? taimen_i2c_max_read(&tas_bus) : tas.wchunk;
+	int err;
+	if (n == 0 || r + n > 0x80u || step == 0) {
+		return tas_fail(c, "access (bad length)", reg, EINVAL);
+	}
+	TRY(tas_bp(c, TB(reg), TP(reg)));
+	for (unsigned done = 0, k; done < n; done += k) {
+		uint8_t a = (uint8_t)(r + done);
+		k = MIN(n - done, step);
+		err = rd ? taimen_i2c_write_read(&tas_bus, c->addr, &a, 1, d + done, k) : raw_wr(c, a, d + done, k);
+		if (err != 0) {
+			return tas_fail(c, rd ? "read" : "write", TR(TB(reg), TP(reg), a), err);
+		}
+	}
+	return 0;
+}
+
+static int
+tas_wr(unsigned ci, uint32_t reg, uint8_t v)
+{
+	return tas_io(ci, reg, &v, 1, false);
+}
+
+static int
+tas_rd(unsigned ci, uint32_t reg, uint8_t *v)
+{
+	return tas_io(ci, reg, v, 1, true);
+}
+
+/* regmap_update_bits on each chip of mask: read, write only a change */
+static int
+tas_upd(unsigned mask, uint32_t reg, uint8_t m, uint8_t v)
+{
+	for (unsigned ci = 0; ci < 2; ci++) {
+		uint8_t old = 0;
+		if (mask & (1u << ci)) {
+			TRY(tas_rd(ci, reg, &old));
+			if (((old & ~m) | (v & m)) != old) {
+				TRY(tas_wr(ci, reg, (uint8_t)((old & ~m) | (v & m))));
+			}
+		}
+	}
+	return 0;
+}
+
+/* core.c:141-165: each step on each chip of mask (L then R); !stop: try them all, return the first error */
+static int
+tas_seq(unsigned mask, const struct tas_step *s, unsigned n, bool stop)
+{
+	int first = 0;
+	for (unsigned i = 0; i < n; i++) {
+		if (s[i].reg == TAS_DELAY) {
+			tas_msleep(s[i].val);
+			continue;
+		}
+		for (unsigned ci = 0; ci < 2; ci++) {
+			int err = (mask & (1u << ci)) ? tas_wr(ci, s[i].reg, (uint8_t)s[i].val) : 0;
+			if (err != 0 && stop) {
+				return err;
+			}
+			first = first ? first : err;
+		}
+	}
+	return first;
+}
+
+/* ---- blocks (core.c:1972-2192) ---- */
+static uint8_t
+crc8_4d(uint8_t v)                      /* CRC-8 of one byte: polynomial 0x4D, MSB first, initial 0 */
+{
+	for (unsigned i = 0; i < 8; i++) {
+		v = (v & 0x80u) ? (uint8_t)((v << 1) ^ 0x4du) : (uint8_t)(v << 1);
+	}
+	return v;
+}
+
+/* The YRAM part of a write: tas2557-core.h YRAM1..5 (core.c:1640-1775) */
+static bool
+tas_yram(uint8_t bk, uint8_t pg, unsigned r, unsigned n, unsigned *off, unsigned *m)
+{
+	unsigned lo = 8, hi = 127, end = r + n - 1u;
+	if (bk == 140 && pg == 42) {
+		lo = 88;
+	} else if ((bk == 140 && pg == 50) || (bk == 0 && pg == 61)) {
+		hi = 27;
+	} else if (!(bk == 140 && pg >= 43 && pg <= 49) && !(bk == 0 && pg >= 50 && pg <= 60)) {
+		return false;
+	}
+	if (end < lo || r > hi) {
+		return false;
+	}
+	*off = MAX(r, lo);
+	*m = MIN(end, hi) - *off + 1u;
+	return true;
+}
+
+/*
+ * Read back the YRAM bytes of one write and add their CRC-8s (core.c:1794-1970), leaving out
+ * B0 P53 R44-48 (the coefficient swap command). A single write must read back as written (*retry).
+ */
+static int
+tas_ysum(unsigned ci, uint8_t bk, uint8_t pg, unsigned r, const uint8_t *d, unsigned n, uint8_t *sum, bool *retry)
+{
+	bool swap = bk == 0 && pg == 53;
+	unsigned off, m;
+	uint8_t rb[128];
+	if ((swap && n == 1 && r >= 44 && r <= 48) || (swap && n == 4 && r == 44) || !tas_yram(bk, pg, r, n, &off, &m)) {
+		return 0;
+	}
+	TRY(tas_io(ci, TR(bk, pg, off), rb, m, true));
+	if (n == 1 && rb[0] != d[0]) {
+		printf("TAIMEN TAS2557: %s: B%u P%u R%u wrote %#x, reads %#x\n", tas_chip[ci].name, bk, pg, r, d[0], rb[0]);
+		*retry = true;
+		return 0;
+	}
+	for (unsigned i = 0; i < m; i++) {
+		if (!(swap && off + i >= 44 && off + i <= 48)) {
+			*sum = (uint8_t)(*sum + crc8_4d(rb[i]));
+		}
+	}
+	return 0;
+}
+
+/* One block to one chip: CRC reset, the commands, PRAM CRC and YRAM sum; retried on a mismatch. */
+static int
+blk_load(unsigned ci, const struct tas_blk *b, const char *what)
+{
+	for (unsigned attempt = 1; attempt <= TAS_TRIES; attempt++) {
+		uint8_t ysum = 0, pcrc = 0;
+		bool retry = false;
+		if (b->pon) {
+			TRY(tas_wr(ci, TAS_CRC_RESET, 1));
+		}
+		for (uint32_t i = 0; i < b->ncmd && !retry;) {
+			const uint8_t *k = b->cmd + 4u * i, *a = k + 4;
+			unsigned len = ((unsigned)k[0] << 8) | k[1];
+			if (k[2] <= 0x7fu) {
+				TRY(tas_wr(ci, TR(k[0], k[1], k[2]), k[3]));
+				TRY(b->yon ? tas_ysum(ci, k[0], k[1], k[2], &k[3], 1, &ysum, &retry) : 0);
+				i++;
+			} else if (k[2] == 0x85u) {     /* a length of 0 writes one byte, as core.c */
+				TRY(tas_io(ci, TR(a[0], a[1], a[2]), __DECONST(uint8_t *, a + 3), MAX(len, 1u), false));
+				TRY(b->yon ? tas_ysum(ci, a[0], a[1], a[2], a + 3, MAX(len, 1u), &ysum, &retry) : 0);
+				i += burst_cmds(len);
+			} else {
+				if (k[2] == 0x81u) {
+					tas_msleep(MIN(len, TAS_SLEEP_MAX));
+				}
+				i++;
+			}
+		}
+		if (!retry && b->pon) {
+			TRY(tas_rd(ci, TAS_CRC_CHECKSUM, &pcrc));
+			retry = pcrc != b->pcrc;
+		}
+		if (!retry && (!b->yon || ysum == b->ycrc)) {
+			return 0;
+		}
+		printf("TAIMEN TAS2557: %s: %s block %#x (%u commands), try %u: PRAM CRC %#x (fw %#x%s), YRAM sum %#x "
+		    "(fw %#x%s)\n", tas_chip[ci].name, what, b->type, b->ncmd, attempt, pcrc, b->pcrc,
+		    b->pon ? "" : ", unused", ysum, b->ycrc, b->yon ? "" : ", unused");
+	}
+	tas.crc_errors++;
+	return tas.strict ? EIO : 0;
+}
+
+static unsigned
+blk_mask(uint32_t type, unsigned devices)       /* core.c:1991-2009 */
+{
+	return type == BLK_PLL ? devices : type == BLK_PGM_ALL ? (TAS_L | TAS_R) :
+	       (type == BLK_PGM_A || type == BLK_CFG_COEFF_A || type == BLK_CFG_PRE_A) ? TAS_L :
+	       (type == BLK_PGM_B || type == BLK_CFG_COEFF_B || type == BLK_CFG_PRE_B) ? TAS_R : 0;
+}
+
+/* core.c:2173-2192: an item's blocks of this type (BLK_ANY: all), each to its chips among devices */
+static int
+tas_load_item(const struct tas_fw *f, const struct tas_item *it, uint32_t type, unsigned devices, const char *what)
+{
+	struct cur c = {f->p, f->len, it->data, false};
+	for (unsigned i = 0; i < it->nblk; i++) {
+		struct tas_blk b;
+		if (!c_block(&c, f->drv, &b)) {
+			return EINVAL;                  /* parsed before: cannot happen */
+		}
+		if (type != BLK_ANY && b.type != type) {
+			continue;
+		}
+		if (blk_mask(b.type, TAS_L | TAS_R) == 0) {
+			printf("TAIMEN TAS2557: %s: block %u type %#x: no chip for it\n", what, i, b.type);
+			return EINVAL;
+		}
+		for (unsigned ci = 0; ci < 2; ci++) {
+			int err = (blk_mask(b.type, devices) & devices & (1u << ci)) ? blk_load(ci, &b, what) : 0;
+			if (err != 0) {
+				printf("TAIMEN TAS2557: %s: block %u type %#x on %s failed (%d)\n", what, i, b.type,
+				    tas_chip[ci].name, err);
+				return err;
+			}
+		}
+	}
+	return 0;
+}
+
+/* ---- reset ---- */
+/* PM8998 GPIO registers (pinctrl-spmi-gpio, qpnp-pin): subtype, status1, rt, mode, vin, pull, LV/MV source, out, en */
+static const uint8_t pmg_reg[9] = {0x05, 0x08, 0x10, 0x40, 0x41, 0x42, 0x44, 0x45, 0x46};
+
+static bool
+tas_rst_log(const char *when, uint8_t v[9])
+{
+	bool ok = true;
+	for (unsigned i = 0; i < 9; i++) {
+		v[i] = 0;
+		ok = ok && sweet_pmic_read(TAS_RST_PPID, pmg_reg[i], &v[i]);
+	}
+	printf("TAIMEN TAS2557: reset (PM8998 GPIO 6) %s:%s subtype %#x status1 %#x rt %#x mode %#x vin %#x pull %#x "
+	    "src %#x out %#x en %#x\n", when, ok ? "" : " PMIC READ FAILED,", v[0], v[1], v[2], v[3], v[4], v[5], v[6],
+	    v[7], v[8]);
+	return ok;
+}
+
+static bool
+tas_probe(const char *when)
+{
+	const uint8_t reg = TAS_PAGE_REG;
+	uint8_t pg[2] = {0, 0};
+	int e[2];
+	for (unsigned ci = 0; ci < 2; ci++) {
+		e[ci] = taimen_i2c_write_read(&tas_bus, tas_chip[ci].addr, &reg, 1, &pg[ci], 1);
+	}
+	printf("TAIMEN TAS2557: probe %s: L %s (page %u), R %s (page %u)\n", when,
+	    e[0] == 0 ? "ok" : e[0] == ENXIO ? "NACK" : "error", pg[0], e[1] == 0 ? "ok" : e[1] == ENXIO ? "NACK" : "error", pg[1]);
+	return e[0] == 0 && e[1] == 0;
+}
+
+/* Reset released (input, pull-up) is expected; if the amps NACK, pulse it as regmap.c:674-691 does. */
+static bool
+tas_reset(void)
+{
+	uint8_t v[9];
+	bool pm = tas_rst_log("at init", v);
+	if (tas_probe("at init")) {
+		return true;
+	}
+	if (!pm) {
+		printf("TAIMEN TAS2557: amps silent and the reset GPIO unreadable\n");
+		return false;
+	}
+	/* output, constant source: level = MODE bit 0 (invert), on LV/MV subtypes 0x10/0x11 SRC bit 7 */
+	bool lvmv = v[0] == 0x10u || v[0] == 0x11u;
+	bool ok = lvmv ? sweet_pmic_write(TAS_RST_PPID, 0x44, 0x00) && sweet_pmic_write(TAS_RST_PPID, 0x40, 0x01) :
+	    sweet_pmic_write(TAS_RST_PPID, 0x40, 0x10);
+	ok = ok && sweet_pmic_write(TAS_RST_PPID, 0x46, 0x80);
+	tas_msleep(5);
+	ok = ok && (lvmv ? sweet_pmic_write(TAS_RST_PPID, 0x44, 0x80) : sweet_pmic_write(TAS_RST_PPID, 0x40, 0x11));
+	tas_msleep(2);
+	(void)tas_rst_log(ok ? "after the pulse" : "after a FAILED pulse", v);
+	return tas_probe("after the reset pulse");
+}
+
+/* ---- init ---- */
+static bool tas_report(unsigned ci, const char *when, bool up);
+
+static int
+tas_load(unsigned wl, const struct tas_item *prog, const struct tas_item *cfg, const struct tas_item *pll,
+    const struct tas_item *cal)
+{
+	static const unsigned wls[4] = {16, 20, 24, 32};
+	const unsigned d = tas.devices, both = TAS_L | TAS_R;
+	uint8_t v[2] = {0, 0};
+	char name[64], name2[64];
+
+	/* regmap.c:1217-1244: SW reset, 1 ms, revision */
+	tas_chip[0].book = tas_chip[0].page = tas_chip[1].book = tas_chip[1].page = -1;
+	TRY(TAS_WR_ALL(both, TAS_SW_RESET, 0x01));
+	tas_msleep(1);
+	tas_chip[0].book = tas_chip[0].page = tas_chip[1].book = tas_chip[1].page = -1;
+	TRY(tas_rd(0, TAS_REV_PGID, &v[0]));
+	TRY(tas_rd(1, TAS_REV_PGID, &v[1]));
+	printf("TAIMEN TAS2557: revision L %#x R %#x (PG2.1 = %#x)\n", v[0], v[1], TAS_PG_2P1);
+	if (v[0] != TAS_PG_2P1 || v[1] != TAS_PG_2P1) {
+		printf("TAIMEN TAS2557: not two PG2.1 chips: the PG21 firmware does not fit\n");
+		return ENODEV;
+	}
+	/* core.c:721-758 tas2557_load_default, with 697-719 tas2557_load_platdata */
+	TRY(TAS_WR_ALL(both, TAS_TEST_MODE, 0x0d));
+	TRY(tas_rd(0, TAS_BROADCAST, &v[0]));
+	TRY(tas_rd(1, TAS_BROADCAST, &v[1]));
+	printf("TAIMEN TAS2557: broadcast/trim L %#x R %#x\n", v[0], v[1]);
+	TRY(tas_seq(both, tas_default_seq, NSTEPS(tas_default_seq), true));
+	TRY(tas_seq(both, tas_irq_seq, NSTEPS(tas_irq_seq), true));     /* live.dts has the IRQ GPIOs */
+	TRY(tas_upd(both, TAS_ASI1_DAC_FORMAT, 0x18, (uint8_t)(wl << 3)));
+	TRY(tas_wr(1, TAS_GPIO3_PIN, 0x00));    /* ti,echo-ref 0 (core.c:307-313): only L drives DOUT */
+	TRY(tas_wr(0, TAS_GPIO3_PIN, 0x10));
+	TRY(tas_upd(both, TAS_ASI1_DAC_FORMAT, 0x01, 0x01));
+	TRY(tas_upd(both, TAS_GPIO_HIZ_CTRL2, 0x30, 0x30));
+	/* core.c:2710-2719: the program, "both" blocks first, to both chips whatever the devices */
+	TRY(tas_load_item(&tas_fw, prog, BLK_PGM_ALL, both, "program"));
+	TRY(tas_load_item(&tas_fw, prog, BLK_PGM_A, both, "program"));
+	TRY(tas_load_item(&tas_fw, prog, BLK_PGM_B, both, "program"));
+	TRY(tas_rd(0, TAS_SPK_CTRL, &v[0]));
+	printf("TAIMEN TAS2557: program 0 '%s' loaded, DAC gain %u\n", tas_name(prog->name, name), (v[0] >> 3) & 0xfu);
+	/* core.c:864-912: the PLL, then pre-power and coefficient blocks of each device */
+	TRY(tas_load_item(&tas_fw, pll, BLK_ANY, d, "PLL"));
+	TRY(tas_load_item(&tas_fw, cfg, BLK_CFG_PRE_A, d, "configuration"));
+	TRY(tas_load_item(&tas_fw, cfg, BLK_CFG_PRE_B, d, "configuration"));
+	TRY(tas_load_item(&tas_fw, cfg, BLK_CFG_COEFF_A, d, "configuration"));
+	TRY(tas_load_item(&tas_fw, cfg, BLK_CFG_COEFF_B, d, "configuration"));
+	printf("TAIMEN TAS2557: configuration '%s' loaded (PLL '%s', devices %u)\n", tas_name(cfg->name, name),
+	    tas_name(pll->name, name2), d);
+	/* core.c:920-924, 2813-2834: calibration 0's coefficients, only in tuning mode */
+	if (cal == NULL || prog->a != APP_TUNINGMODE) {
+		printf("TAIMEN TAS2557: calibration not applied (%s)\n", cal ? "not tuning mode" : "none");
+	} else {
+		TRY(tas_load_item(&tas_cal, cal, BLK_CFG_COEFF_A, d, "calibration"));
+		TRY(tas_load_item(&tas_cal, cal, BLK_CFG_COEFF_B, d, "calibration"));
+		printf("TAIMEN TAS2557: calibration '%s' loaded\n", tas_name(cal->name, name));
+	}
+	/* the plan's step 5: the AFE's word length over whatever the firmware set */
+	TRY(tas_rd(0, TAS_ASI1_DAC_FORMAT, &v[0]));
+	TRY(tas_rd(1, TAS_ASI1_DAC_FORMAT, &v[1]));
+	TRY(tas_upd(both, TAS_ASI1_DAC_FORMAT, 0x18, (uint8_t)(wl << 3)));
+	printf("TAIMEN TAS2557: ASI1 DAC format after the firmware L %#x R %#x (format %u, %u/%u bits) -> %u bits\n",
+	    v[0], v[1], v[0] >> 5, wls[(v[0] >> 3) & 3u], wls[(v[1] >> 3) & 3u], wls[wl]);
+	TRY(tas_rd(0, TAS_POWER_CTRL1, &v[0]));
+	TRY(tas_rd(1, TAS_POWER_CTRL1, &v[1]));
+	printf("TAIMEN TAS2557: power ctrl1 L %#x R %#x (no startup sequence: the amps stay down)\n", v[0], v[1]);
+	for (unsigned ci = 0; ci < 2; ci++) {   /* reading the flags clears them */
+		(void)tas_report(ci, "loaded", false);
+	}
+	return 0;
+}
+
+static bool
+tas_init_locked(const uint8_t *fw, uint32_t fw_len, const uint8_t *cal, uint32_t cal_len, unsigned bits)
+{
+	static const unsigned wls[4] = {16, 20, 24, 32};
+	uint64_t t0 = mach_absolute_time(), ns;
+	unsigned wl, conf, mw;
+	char name[64];
+	int err;
+	for (wl = 0; wl < 4 && wls[wl] != bits; wl++) {
+	}
+	if (wl == 4) {
+		printf("TAIMEN TAS2557: bad ASI word length %u (16, 20, 24 or 32)\n", bits);
+		return false;
+	}
+	(void)PE_parse_boot_argn("taimentascrc", &tas.strict, sizeof(tas.strict));
+	if (tas.powered) {
+		(void)tas_seq(tas.devices, tas_shutdown_seq, NSTEPS(tas_shutdown_seq), false);
+		tas.powered = false;
+	}
+	tas.loaded = false;
+	tas.crc_errors = 0;
+	if (!fw_parse(&tas_fw, "fw", fw, fw_len)) {
+		return false;
+	}
+	/* tas2557_set_program(0, -1), core.c:2652-2676: the first configuration of program 0 */
+	for (conf = 0; conf < MIN(tas_fw.n[K_CONF], TAS_ITEMS) && tas_fw.it[K_CONF][conf].a != 0; conf++) {
+	}
+	if (tas_fw.n[K_PROG] == 0 || conf >= MIN(tas_fw.n[K_CONF], TAS_ITEMS) ||
+	    tas_fw.it[K_CONF][conf].b >= MIN(tas_fw.n[K_PLL], TAS_ITEMS) ||
+	    (tas_fw.it[K_CONF][conf].devices & (TAS_L | TAS_R)) == 0) {
+		printf("TAIMEN TAS2557: fw: no program 0 with a configuration, a PLL and devices\n");
+		return false;
+	}
+	const struct tas_item *cfg = &tas_fw.it[K_CONF][conf];
+	tas.devices = cfg->devices & (TAS_L | TAS_R);
+	if (cfg->rate != 48000) {
+		printf("TAIMEN TAS2557: configuration %u runs at %u Hz, not 48000\n", conf, cfg->rate);
+	}
+	bool have_cal = cal != NULL && cal_len != 0 && fw_parse(&tas_cal, "cal", cal, cal_len) && tas_cal.n[K_CAL] != 0;
+	if (!taimen_i2c_init(&tas_bus)) {
+		return false;
+	}
+	mw = taimen_i2c_max_write(&tas_bus);
+	tas.wchunk = mw > 4u ? (mw - 1u) & ~3u : 0;     /* the register address takes a byte */
+	if (tas.wchunk == 0 || !tas_reset()) {
+		return false;
+	}
+	err = tas_load(wl, &tas_fw.it[K_PROG][0], cfg, &tas_fw.it[K_PLL][cfg->b], have_cal ? &tas_cal.it[K_CAL][0] : NULL);
+	if (err != 0) {
+		printf("TAIMEN TAS2557: loading failed (%d)\n", err);
+		return false;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	tas.loaded = true;
+	printf("TAIMEN TAS2557: fw %u '%s' P%u/C%u/K%u; prog 0 conf %u cal %s loaded in %llu ms (bursts of %u), ASI1 %u "
+	    "bits, %u CRC mismatches%s; amps powered down\n", fw_len, tas_name(tas_fw.ddc, name), tas_fw.n[K_PROG],
+	    tas_fw.n[K_CONF], have_cal ? tas_cal.n[K_CAL] : 0, conf, have_cal ? "0" : "none",
+	    (unsigned long long)(ns / 1000000u), tas.wchunk, bits, tas.crc_errors, tas.crc_errors ? " (WARNING)" : "");
+	return true;
+}
+
+bool
+taimen_tas2557_init(const uint8_t *fw, uint32_t fw_len, const uint8_t *cal, uint32_t cal_len, unsigned bit_width)
+{
+	lck_mtx_lock(&tas_lock);
+	bool ok = tas_init_locked(fw, fw_len, cal, cal_len, bit_width);
+	lck_mtx_unlock(&tas_lock);
+	if (!ok) {
+		printf("TAIMEN TAS2557: init failed\n");
+	}
+	return ok;
+}
+
+/* ---- power, flags ---- */
+/* Safe guard, FLAGS_1/2 (regmap.c:745-796; reading clears them), power-up 0xc0 (regmap.c:803-826), die temperature */
+static bool
+tas_report(unsigned ci, const char *when, bool up)
+{
+	static const uint32_t regs[4] = {TAS_SAFE_GUARD, TAS_FLAGS_1, TAS_FLAGS_2, TAS_POWER_UP_FLAG};
+	uint8_t v[4] = {0, 0, 0, 0}, t[4];
+	char temp[24] = "";
+	int err = 0;
+	for (unsigned i = 0; i < 4 && err == 0; i++) {
+		err = tas_rd(ci, regs[i], &v[i]);
+	}
+	if (err == 0 && tas.powered && tas_io(ci, TAS_DIE_TEMP, t, 4, true) == 0) {
+		int32_t raw = (int32_t)(((uint32_t)t[0] << 24) | ((uint32_t)t[1] << 16) | ((uint32_t)t[2] << 8) | t[3]);
+		(void)snprintf(temp, sizeof(temp), ", die %d C", (int)(raw >> 23));
+	}
+	uint8_t f1 = v[1], f2 = v[2];
+	bool down = up && (v[3] & 0xc0u) != 0xc0u;
+	bool ok = err == 0 && v[0] == TAS_SAFE_GUARD_PATTERN && (f1 & 0xfcu) == 0 && (f2 & 0x0cu) == 0 && !down;
+	printf("TAIMEN TAS2557: %s %s: %s safe guard %#x, flags %#x/%#x, power-up %#x%s%s%s%s%s%s%s%s%s%s\n",
+	    tas_chip[ci].name, when, err ? "I2C ERROR," : ok ? "ok," : "BAD,", v[0], f1, f2, v[3], temp,
+	    (f1 & 0x80u) ? " OVER-CURRENT" : "", (f1 & 0x40u) ? " UNDER-VOLTAGE" : "", (f1 & 0x20u) ? " CLOCK-HALT" : "",
+	    (f1 & 0x10u) ? " DIE-OVERTEMP" : "", (f1 & 0x08u) ? " BROWNOUT" : "", (f1 & 0x04u) ? " CLOCK-LOST" : "",
+	    (f2 & 0x08u) ? " CLOCK-DET1" : "", (f2 & 0x04u) ? " CLOCK-DET2" : "", down ? " NOT-POWERED" : "");
+	return ok;
+}
+
+/* core.c:968-1052 tas2557_enable(true) */
+static bool
+tas_power_on(void)
+{
+	bool ok[2] = {true, true};
+	int err;
+	for (unsigned ci = 0; ci < 2; ci++) {
+		uint8_t sg = 0, f = 0;
+		if (!(tas.devices & (1u << ci))) {
+			continue;
+		}
+		if (tas_rd(ci, TAS_SAFE_GUARD, &sg) != 0 || sg != TAS_SAFE_GUARD_PATTERN) {   /* core.c:982-1000 */
+			printf("TAIMEN TAS2557: %s safe guard %#x (want %#x): settings lost, init again\n", tas_chip[ci].name,
+			    sg, TAS_SAFE_GUARD_PATTERN);
+			tas.loaded = false;
+			return false;
+		}
+		(void)(tas_rd(ci, TAS_FLAGS_1, &f) || tas_rd(ci, TAS_FLAGS_2, &f));      /* clearIRQ, regmap.c:605-617 */
+	}
+	if ((err = tas_seq(tas.devices, tas_startup_seq, NSTEPS(tas_startup_seq), true)) != 0 ||
+	    (err = tas_seq(tas.devices, tas_unmute_seq, NSTEPS(tas_unmute_seq), true)) != 0) {
+		printf("TAIMEN TAS2557: power up failed (%d): shutting down\n", err);
+		(void)tas_seq(tas.devices, tas_shutdown_seq, NSTEPS(tas_shutdown_seq), false);
+		return false;
+	}
+	tas.powered = true;
+	tas_msleep(20);
+	for (unsigned ci = 0; ci < 2; ci++) {
+		if ((tas.devices & (1u << ci)) && !(ok[ci] = tas_report(ci, "power up", true))) {
+			tas_msleep(10);                 /* regmap.c:809-814: once more after 10 ms */
+			ok[ci] = tas_report(ci, "power up, again", true);
+		}
+	}
+	printf("TAIMEN TAS2557: power up L %s R %s\n", (tas.devices & TAS_L) ? (ok[0] ? "ok" : "BAD") : "unused",
+	    (tas.devices & TAS_R) ? (ok[1] ? "ok" : "BAD") : "unused");
+	return ok[0] && ok[1];
+}
+
+bool
+taimen_tas2557_power(bool on)
+{
+	bool ok = false;
+	lck_mtx_lock(&tas_lock);
+	if (!tas.loaded) {
+		printf("TAIMEN TAS2557: power %s: not loaded\n", on ? "on" : "off");
+	} else if (on) {
+		ok = tas.powered || tas_power_on();
+	} else {                                /* core.c:1054-1071, best effort */
+		ok = tas_seq(tas.devices, tas_shutdown_seq, NSTEPS(tas_shutdown_seq), false) == 0;
+		tas.powered = false;
+		printf("TAIMEN TAS2557: power down %s\n", ok ? "ok" : "with I2C errors");
+	}
+	lck_mtx_unlock(&tas_lock);
+	return ok;
+}
+
+void
+taimen_tas2557_status(void)
+{
+	lck_mtx_lock(&tas_lock);
+	if (!tas.loaded) {
+		printf("TAIMEN TAS2557: status: not loaded\n");
+	}
+	for (unsigned ci = 0; ci < 2 && tas.loaded; ci++) {
+		if (tas.devices & (1u << ci)) {
+			(void)tas_report(ci, tas.powered ? "status (on)" : "status (off)", tas.powered);
+		}
+	}
+	lck_mtx_unlock(&tas_lock);
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
