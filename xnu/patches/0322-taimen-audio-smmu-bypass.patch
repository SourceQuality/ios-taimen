diff --git a/bsd/dev/taimen_i2c.c b/bsd/dev/taimen_i2c.c
new file mode 100644
index 0000000..dee80ab
--- /dev/null
+++ b/bsd/dev/taimen_i2c.c
@@ -0,0 +1,409 @@
+/*
+ * Pixel 2 XL (taimen): a polled QUP I2C master for any BLSP QUP, the master taimen_touch.c runs on
+ * BLSP1 QUP5 with its addresses passed in (struct taimen_i2c). First user: the TAS2557 amps on
+ * BLSP2 QUP1 (taimen_tas2557.c, port/docs/taimen-audio-plan.md stage 7).
+ *   init        GCC: the BLSP AHB vote bit (wait for the AHB branch), the QUP's RCGR on XO /1,
+ *               the QUP I2C branch. Pins: function, drive, pull. QUP: SW reset, mini core,
+ *               N = 15, v1 tags (QUP_I2C_MASTER_GEN 0); FIFO sizes from QUP_IO_MODE.
+ *   write       START|addr, DATA.., STOP|last in one run: at most taimen_i2c_max_write() bytes,
+ *               EINVAL above (the FIFO is filled once and not refilled; callers split)
+ *   write_read  START|addr, DATA cmd.., START|addr+r, REC|len (repeated start; the REC tag ends
+ *               with NACK + STOP), len <= taimen_i2c_max_read(); ncmd 0 is a plain read
+ * Returns 0, ENXIO (NACK), EIO (bus error, timeout, QUP state) or EINVAL. After EIO the QUP is
+ * reset. No lock: callers serialize (taimen_tas2557.c holds its own mutex).
+ * The struct is defined here and, identically, in taimen_tas2557.c; .size guards the copies.
+ */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define TAIMEN_I2C_PINS 4
+#define TAIMEN_I2C_TAGS 64u             /* cap on FIFO entries per run (local tag array) */
+
+struct taimen_i2c_pin {
+	uint32_t pa;            /* TLMM tile of the pin: CFG +0, IN_OUT +4 */
+	uint8_t gpio;           /* number, for the logs */
+	uint8_t func;           /* mux function (blsp_i2cN) */
+	uint8_t ma;             /* drive strength, 2..16 mA */
+	uint8_t pull;           /* 0 none, 1 down, 3 up */
+};
+
+struct taimen_i2c {
+	/* set by the caller */
+	uint32_t size;          /* sizeof(struct taimen_i2c) */
+	const char *name;       /* for the logs */
+	uint32_t qup_pa;        /* QUP base */
+	uint32_t vote_pa;       /* GCC APCS_CLOCK_BRANCH_ENA_VOTE */
+	uint32_t vote_bit;      /* the BLSP AHB bit in it */
+	uint32_t ahb_cbcr_pa;   /* BLSPn_AHB_CBCR, polled for CLK_OFF */
+	uint32_t cbcr_pa;       /* BLSPn_QUPm_I2C_APPS_CBCR */
+	uint32_t rcgr_pa;       /* its CMD_RCGR; CFG_RCGR at +4 */
+	uint32_t clk_ctl;       /* QUP_I2C_CLK_CTL for the bus speed */
+	unsigned npins;
+	struct taimen_i2c_pin pin[TAIMEN_I2C_PINS];
+	/* set by taimen_i2c_init */
+	vm_offset_t qup, vote, ahb, cbcr, rcgr, tlmm[TAIMEN_I2C_PINS];
+	unsigned tx_max;        /* FIFO entries (16-bit tags) per run */
+	unsigned rx_max;        /* bytes per read */
+	uint32_t last_status;   /* QUP_I2C_STATUS at the last failure */
+	uint32_t last_flags;    /* QUP_ERROR_FLAGS at the last failure */
+	uint32_t last_op;       /* QUP_OPERATIONAL at the last failure */
+	bool ready;
+};
+
+bool taimen_i2c_init(struct taimen_i2c *b);
+int taimen_i2c_write(struct taimen_i2c *b, uint8_t addr7, const uint8_t *buf, unsigned len);
+int taimen_i2c_write_read(struct taimen_i2c *b, uint8_t addr7, const uint8_t *cmd, unsigned ncmd,
+    uint8_t *buf, unsigned len);
+unsigned taimen_i2c_max_write(const struct taimen_i2c *b);
+unsigned taimen_i2c_max_read(const struct taimen_i2c *b);
+
+/* QUP registers (mainline i2c-qup.c), as taimen_touch.c */
+#define QUP_CONFIG        0x000u
+#define QUP_STATE         0x004u
+#define QUP_IO_MODE       0x008u
+#define QUP_SW_RESET      0x00cu
+#define QUP_OPERATIONAL   0x018u
+#define QUP_ERROR_FLAGS   0x01cu
+#define QUP_HW_VERSION    0x030u
+#define QUP_MX_OUTPUT_CNT 0x100u
+#define QUP_OUT_FIFO      0x110u
+#define QUP_MX_WRITE_CNT  0x150u
+#define QUP_MX_INPUT_CNT  0x200u
+#define QUP_MX_READ_CNT   0x208u
+#define QUP_IN_FIFO       0x218u
+#define QUP_I2C_CLK_CTL   0x400u
+#define QUP_I2C_STATUS    0x404u
+#define QUP_I2C_MASTER_GEN 0x408u
+#define QUP_STATE_RESET   0u
+#define QUP_STATE_RUN     1u
+#define QUP_STATE_PAUSE   3u
+#define QUP_STATE_VALID   (1u << 2)
+#define QUP_STATE_MASTER  (1u << 4)
+#define QUP_IN_NOT_EMPTY  (1u << 5)
+#define QUP_OUT_FULL      (1u << 6)
+#define QUP_OUT_SVC       (1u << 8)
+#define QUP_IN_SVC        (1u << 9)
+#define QUP_MX_OUTPUT_DONE (1u << 10)
+#define QUP_NO_INPUT      (1u << 7)
+#define QUP_MINI_CORE     (2u << 8)
+#define QUP_N_VAL         15u
+#define QUP_REPACK_EN     (3u << 14)
+#define QUP_TAG_START     (1u << 8)
+#define QUP_TAG_DATA      (2u << 8)
+#define QUP_TAG_STOP      (3u << 8)
+#define QUP_TAG_REC       (4u << 8)
+#define QUP_NACK          (1u << 3)
+#define QUP_BUS_ACTIVE    (1u << 8)
+#define QUP_BUS_ERRORS    0x38000fcu
+#define QUP_ERRORS        0x7cu
+#define GCC_CLK_OFF       (1u << 31)
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* One register: map its page, return the register's own address. */
+static vm_offset_t
+map_reg(uint32_t pa)
+{
+	vm_offset_t page = ml_io_map(pa & ~0xfffu, 0x1000);
+	return page ? page + (pa & 0xfffu) : 0;
+}
+
+static bool
+i2c_clocks(struct taimen_i2c *b)
+{
+	wr(b->vote, 0, rd(b->vote, 0) | (1u << b->vote_bit));                  /* BLSP AHB */
+	for (unsigned i = 0; i < 1000 && (rd(b->ahb, 0) & GCC_CLK_OFF); i++) {
+		delay(1);
+	}
+	uint32_t cfg = rd(b->rcgr, 4);
+	if (((cfg >> 8) & 7u) != 0 || (cfg & 0x1fu) != 1u) {
+		wr(b->rcgr, 4, 1u);                                     /* XO, divide by 1 */
+		wr(b->rcgr, 0, rd(b->rcgr, 0) | 1u);                    /* UPDATE */
+		for (unsigned i = 0; i < 1000 && (rd(b->rcgr, 0) & 1u); i++) {
+			delay(1);
+		}
+	}
+	wr(b->cbcr, 0, rd(b->cbcr, 0) | 1u);                            /* CLK_ENABLE */
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(rd(b->cbcr, 0) & GCC_CLK_OFF)) {
+			printf("TAIMEN I2C: %s: clocks on (vote %#x ahb %#x cbcr %#x rcgr %#x/%#x, cfg was %#x)\n",
+			    b->name, rd(b->vote, 0), rd(b->ahb, 0), rd(b->cbcr, 0), rd(b->rcgr, 0), rd(b->rcgr, 4), cfg);
+			return true;
+		}
+		delay(1);
+	}
+	printf("TAIMEN I2C: %s: QUP I2C clock stays off (cbcr %#x ahb %#x vote %#x rcgr %#x/%#x)\n",
+	    b->name, rd(b->cbcr, 0), rd(b->ahb, 0), rd(b->vote, 0), rd(b->rcgr, 0), rd(b->rcgr, 4));
+	return false;
+}
+
+/* TLMM CFG: pull 1:0, function 5:2, drive 8:6 = mA/2 - 1, OE 9 (off: the QUP drives the pins). */
+static void
+i2c_pins(struct taimen_i2c *b)
+{
+	for (unsigned i = 0; i < b->npins; i++) {
+		const struct taimen_i2c_pin *p = &b->pin[i];
+		unsigned ma = p->ma < 2 ? 2u : (p->ma > 16 ? 16u : p->ma);
+		uint32_t was = rd(b->tlmm[i], 0);
+		wr(b->tlmm[i], 0, (p->pull & 3u) | ((uint32_t)(p->func & 0xfu) << 2) | ((ma / 2u - 1u) << 6));
+		printf("TAIMEN I2C: %s: gpio%u cfg %#x -> %#x, in %u\n", b->name, p->gpio, was,
+		    rd(b->tlmm[i], 0), rd(b->tlmm[i], 4) & 1u);
+	}
+}
+
+static bool
+qup_state(struct taimen_i2c *b, uint32_t state)
+{
+	for (unsigned i = 0; i < 100; i++) {
+		uint32_t s = rd(b->qup, QUP_STATE);
+		if ((s & QUP_STATE_VALID) && (s & 3u) == state) {
+			return true;
+		}
+		if (s & QUP_STATE_VALID) {
+			wr(b->qup, QUP_STATE, state);
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+qup_reset(struct taimen_i2c *b)
+{
+	wr(b->qup, QUP_SW_RESET, 1);
+	delay(10);
+	if (!qup_state(b, QUP_STATE_RESET)) {
+		printf("TAIMEN I2C: %s: QUP does not reach RESET (state %#x)\n", b->name, rd(b->qup, QUP_STATE));
+		return false;
+	}
+	wr(b->qup, QUP_CONFIG, QUP_MINI_CORE | QUP_N_VAL);
+	wr(b->qup, QUP_I2C_MASTER_GEN, 0);     /* v1 tags */
+	return true;
+}
+
+/* Error bits seen: clear them, keep them for the caller's log, NACK -> ENXIO. */
+static int
+qup_fail(struct taimen_i2c *b, uint32_t bus, uint32_t qerr)
+{
+	b->last_status = rd(b->qup, QUP_I2C_STATUS);
+	b->last_flags = rd(b->qup, QUP_ERROR_FLAGS);
+	b->last_op = rd(b->qup, QUP_OPERATIONAL);
+	wr(b->qup, QUP_ERROR_FLAGS, qerr);
+	wr(b->qup, QUP_I2C_STATUS, bus);
+	return (bus & QUP_NACK) ? ENXIO : EIO;
+}
+
+/*
+ * One QUP run: nt tags (two per FIFO word, low half first), then nin bytes in if nin > 0.
+ * FIFO mode: everything fits the FIFOs, so the output FIFO is filled once in PAUSE.
+ */
+static int
+qup_run(struct taimen_i2c *b, const uint16_t *tag, unsigned nt, uint8_t *in, unsigned nin)
+{
+	vm_offset_t q = b->qup;
+	unsigned pos = 0;
+	int err = EIO;
+	bool bus_err = false;
+	if (!qup_state(b, QUP_STATE_RESET) || !(rd(q, QUP_STATE) & QUP_STATE_MASTER)) {
+		goto out;
+	}
+	wr(q, QUP_MX_OUTPUT_CNT, 0);
+	wr(q, QUP_MX_WRITE_CNT, nt);
+	if (nin) {
+		wr(q, QUP_MX_INPUT_CNT, 0);
+		wr(q, QUP_MX_READ_CNT, nin);
+	}
+	wr(q, QUP_CONFIG, QUP_MINI_CORE | QUP_N_VAL | (nin ? 0u : QUP_NO_INPUT));
+	wr(q, QUP_IO_MODE, QUP_REPACK_EN);
+	if (!qup_state(b, QUP_STATE_RUN)) {
+		goto out;
+	}
+	wr(q, QUP_I2C_CLK_CTL, b->clk_ctl);
+	if (!qup_state(b, QUP_STATE_PAUSE)) {
+		goto out;
+	}
+	for (unsigned i = 0; i < nt; i += 2) {
+		if (rd(q, QUP_OPERATIONAL) & QUP_OUT_FULL) {
+			goto out;
+		}
+		wr(q, QUP_OUT_FIFO, tag[i] | (i + 1 < nt ? (uint32_t)tag[i + 1] << 16 : 0u));
+	}
+	if (!qup_state(b, QUP_STATE_RUN)) {
+		goto out;
+	}
+	for (unsigned t = 0; t < 20000; t++) {
+		uint32_t bus = rd(q, QUP_I2C_STATUS) & QUP_BUS_ERRORS;
+		uint32_t qerr = rd(q, QUP_ERROR_FLAGS) & QUP_ERRORS;
+		uint32_t op = rd(q, QUP_OPERATIONAL);
+		if (bus || qerr) {
+			err = qup_fail(b, bus, qerr);
+			bus_err = true;
+			break;
+		}
+		if (op & (QUP_OUT_SVC | QUP_IN_SVC)) {
+			wr(q, QUP_OPERATIONAL, op & (QUP_OUT_SVC | QUP_IN_SVC));
+		}
+		if (nin) {
+			while (pos < nin && (rd(q, QUP_OPERATIONAL) & QUP_IN_NOT_EMPTY)) {
+				uint32_t v = rd(q, QUP_IN_FIFO);
+				in[pos++] = (uint8_t)v;
+				if (pos < nin) {
+					in[pos++] = (uint8_t)(v >> 16);
+				}
+			}
+			if (pos == nin) {
+				err = 0;
+				break;
+			}
+		} else if (op & QUP_MX_OUTPUT_DONE) {
+			err = 0;
+			break;
+		}
+		delay(1);
+	}
+	for (unsigned t = 0; t < 1000 && (rd(q, QUP_I2C_STATUS) & QUP_BUS_ACTIVE); t++) {
+		delay(1);
+	}
+	if (err == 0) {
+		/* a NACK of the last byte shows only once the bus is idle */
+		uint32_t bus = rd(q, QUP_I2C_STATUS) & QUP_BUS_ERRORS;
+		uint32_t qerr = rd(q, QUP_ERROR_FLAGS) & QUP_ERRORS;
+		if (bus || qerr) {
+			err = qup_fail(b, bus, qerr);
+			bus_err = true;
+		}
+	}
+out:
+	if (err == EIO && !bus_err) {
+		b->last_status = rd(q, QUP_I2C_STATUS);
+		b->last_flags = rd(q, QUP_ERROR_FLAGS);
+		b->last_op = rd(q, QUP_OPERATIONAL) | (1u << 31);   /* bit 31: timeout or QUP state, no bus error */
+	}
+	wr(q, QUP_STATE, QUP_STATE_RESET);
+	if (err == EIO) {
+		(void)qup_reset(b);
+	}
+	return err;
+}
+
+bool
+taimen_i2c_init(struct taimen_i2c *b)
+{
+	if (b == NULL || b->size != sizeof(*b) || b->npins > TAIMEN_I2C_PINS || b->name == NULL) {
+		printf("TAIMEN I2C: bad bus descriptor (size %u, expected %u)\n", b ? b->size : 0,
+		    (unsigned)sizeof(*b));
+		return false;
+	}
+	b->ready = false;
+	if (b->qup == 0) {
+		b->qup = ml_io_map(b->qup_pa, 0x1000);
+		b->vote = map_reg(b->vote_pa);
+		b->ahb = map_reg(b->ahb_cbcr_pa);
+		b->cbcr = map_reg(b->cbcr_pa);
+		b->rcgr = map_reg(b->rcgr_pa);
+		bool mapped = b->qup && b->vote && b->ahb && b->cbcr && b->rcgr;
+		for (unsigned i = 0; i < b->npins; i++) {
+			b->tlmm[i] = ml_io_map(b->pin[i].pa, 0x1000);
+			mapped = mapped && b->tlmm[i];
+		}
+		if (!mapped) {
+			printf("TAIMEN I2C: %s: MMIO mapping failed\n", b->name);
+			b->qup = 0;
+			return false;
+		}
+	}
+	if (!i2c_clocks(b)) {
+		return false;
+	}
+	i2c_pins(b);
+	if (!qup_reset(b)) {
+		return false;
+	}
+	/* QUP_IO_MODE: out block 1:0, out FIFO 4:2, in block 6:5, in FIFO 9:7 (bytes; v1: 2 per entry) */
+	static const unsigned blk[4] = {4, 16, 32, 0};
+	uint32_t io = rd(b->qup, QUP_IO_MODE);
+	unsigned out_fifo = blk[io & 3u] * (2u << ((io >> 2) & 7u));
+	unsigned in_fifo = blk[(io >> 5) & 3u] * (2u << ((io >> 7) & 7u));
+	b->tx_max = MIN(out_fifo / 2u, TAIMEN_I2C_TAGS);
+	b->rx_max = MIN(in_fifo / 2u, 255u);
+	b->last_status = b->last_flags = b->last_op = 0;
+	printf("TAIMEN I2C: %s: QUP hw %#x io %#x, FIFOs out %u in %u bytes: writes up to %u bytes, reads up to %u, "
+	    "clk_ctl %#x, state %#x\n", b->name, rd(b->qup, QUP_HW_VERSION), io, out_fifo, in_fifo,
+	    b->tx_max ? b->tx_max - 1u : 0u, b->rx_max, b->clk_ctl, rd(b->qup, QUP_STATE));
+	if (b->tx_max < 8u || b->rx_max < 4u) {
+		printf("TAIMEN I2C: %s: FIFOs too small\n", b->name);
+		return false;
+	}
+	b->ready = true;
+	return true;
+}
+
+int
+taimen_i2c_write(struct taimen_i2c *b, uint8_t addr7, const uint8_t *buf, unsigned len)
+{
+	uint16_t tag[TAIMEN_I2C_TAGS];
+	if (b == NULL || !b->ready || buf == NULL || addr7 > 0x7fu || len == 0 || len + 1u > b->tx_max) {
+		return EINVAL;
+	}
+	tag[0] = (uint16_t)(QUP_TAG_START | ((unsigned)addr7 << 1));
+	for (unsigned i = 0; i < len; i++) {
+		tag[1 + i] = (uint16_t)((i == len - 1 ? QUP_TAG_STOP : QUP_TAG_DATA) | buf[i]);
+	}
+	return qup_run(b, tag, len + 1u, NULL, 0);
+}
+
+int
+taimen_i2c_write_read(struct taimen_i2c *b, uint8_t addr7, const uint8_t *cmd, unsigned ncmd,
+    uint8_t *buf, unsigned len)
+{
+	uint16_t tag[TAIMEN_I2C_TAGS];
+	unsigned nt = 0;
+	if (b == NULL || !b->ready || buf == NULL || addr7 > 0x7fu || len == 0 || len > b->rx_max ||
+	    (ncmd && cmd == NULL) || ncmd + 3u > b->tx_max) {
+		return EINVAL;
+	}
+	if (ncmd) {
+		tag[nt++] = (uint16_t)(QUP_TAG_START | ((unsigned)addr7 << 1));
+		for (unsigned i = 0; i < ncmd; i++) {
+			tag[nt++] = (uint16_t)(QUP_TAG_DATA | cmd[i]);
+		}
+	}
+	tag[nt++] = (uint16_t)(QUP_TAG_START | ((unsigned)addr7 << 1) | 1u);
+	tag[nt++] = (uint16_t)(QUP_TAG_REC | len);
+	return qup_run(b, tag, nt, buf, len);
+}
+
+/* Payload bytes of one write (the address takes one FIFO entry); 0 before init. */
+unsigned
+taimen_i2c_max_write(const struct taimen_i2c *b)
+{
+	return (b && b->ready) ? b->tx_max - 1u : 0u;
+}
+
+unsigned
+taimen_i2c_max_read(const struct taimen_i2c *b)
+{
+	return (b && b->ready) ? b->rx_max : 0u;
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
diff --git a/bsd/dev/taimen_tas2557.c b/bsd/dev/taimen_tas2557.c
new file mode 100644
index 0000000..2347754
--- /dev/null
+++ b/bsd/dev/taimen_tas2557.c
@@ -0,0 +1,928 @@
+/*
+ * Pixel 2 XL (taimen) speakers: two TI TAS2557 smart amps, left 0x4C and right 0x4D on BLSP2 QUP1
+ * (taimen_i2c.c), shared reset PM8998 GPIO 6. Loaded and switched as the wahoo Android driver does
+ * (research/dl/wahoo-tas2557: "core" tas2557-core.c, "regmap" tas2557-regmap.c, tas2557.h and
+ * tas2557-core.h, whose registers are B book, P page, R register); plan: taimen-audio-plan.md stage 7.
+ *   firmware  TI's "5552" format, the same for tas2557s_PG21_uCDSP.bin and tas2557_cal.bin (core.c
+ *             fw_parse*): header, PLLs, programs, configurations, calibrations; blocks of 4-byte
+ *             commands {book, page, offset, value}: offset <= 0x7F writes, 0x81 sleeps
+ *             (book << 8 | page) ms, 0x85 bursts that many bytes to the next command's address.
+ *             Every length is checked against the blob. The loader walks the caller's buffers,
+ *             which only have to live during init (nothing is copied or allocated).
+ *   load      as Android: SW reset, default data, program 0, its first configuration (PLL, pre-power
+ *             and coefficients for each of its devices), calibration 0, ASI1 word length. "Both"
+ *             blocks go to each address in turn (no broadcast). Per block and chip the PRAM CRC
+ *             (B0 P0 R32/R33) and the YRAM sum are checked as core.c tas2557_load_block does; a
+ *             mismatch retries the block, then warns (boot-arg taimentascrc=1: fails). Bursts longer
+ *             than one I2C write go in 4-byte steps (the address auto-increments within a page).
+ *   power     core.c's startup + unmute and shutdown, only while the I2S bit clock runs; then each
+ *             chip's safe guard, flags, power-up state and die temperature are logged.
+ * Call from a thread (it sleeps); a mutex serializes the entry points.
+ */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+/* As in taimen_i2c.c (.size guards the two copies). */
+#define TAIMEN_I2C_PINS 4
+struct taimen_i2c_pin {
+	uint32_t pa;
+	uint8_t gpio, func, ma, pull;
+};
+struct taimen_i2c {
+	uint32_t size;
