+/* size bytes at an align-aligned physical address (align a power of two, >= 4 KB) */
+static void *
+pool_alloc_aligned(uint64_t size, uint64_t align, uint64_t *pa)
+{
+	uint64_t pad = (align - ((POOL_PA + pool_used) & (align - 1))) & (align - 1), skip = 0;
+	if (pad != 0 && pool_alloc(pad, &skip) == NULL) {
+		return NULL;
+	}
+	return pool_alloc(size, pa);
+}
