+/*
+ * 0283: icnss registers a PDR listener before WLFW connects (Android's "QMI Server Connected: state
+ * 0x981" has ICNSS_PDR_REGISTERED, and the wlan_pd UP indication is ACKed just before it,
+ * dmesg:3540-3542): servreg-notif (QMI 0x42, instance 180 = the wlan_pd domain's) REGISTER_LISTENER
+ * for msm/modem/wlan_pd, then every STATE_UPDATED indication answered with SET_ACK (mainline
+ * pdr_internal.h layouts: strings without a NUL, u16 transaction ids).
+ */
+#define SRN_REGISTER_LISTENER   0x20
+#define SRN_STATE_UPDATED_IND   0x22
+#define SRN_SET_ACK             0x23
+#define SRN_WLAN_PD             "msm/modem/wlan_pd"
+
+static uint32_t sr_node, sr_port;
+static uint16_t sr_txn = 1;
+static unsigned sr_inds;
+
+static void
+sr_send(uint16_t msg, const struct wmsg *m0)
+{
+	(void)msg;
+	struct wmsg m = *m0;
+	uint16_t l = (uint16_t)(m.n - 7);
+	memcpy(m.b + 5, &l, 2);
+	qrtr_send(QRTR_TYPE_DATA, PORT_SRNC, sr_node, sr_port, m.b, m.n);
+}
+
+static void
+sr_new(struct wmsg *m, uint16_t msg)
+{
+	bzero(m->b, sizeof(m->b));
+	m->b[0] = QMI_REQ;
+	uint16_t t = sr_txn++;
+	memcpy(m->b + 1, &t, 2);
+	memcpy(m->b + 3, &msg, 2);
+	m->n = 7;
+}
+
+static void
+servreg_arrive(uint32_t node, uint32_t port, uint32_t inst)
+{
+	if (sr_port != 0 || (inst >> 8) != 180) {
+		return;
+	}
+	sr_node = node;
+	sr_port = port;
+	struct wmsg m;
+	sr_new(&m, SRN_REGISTER_LISTENER);
+	wm_u8(&m, 0x01, 1);
+	wm_tlv(&m, 0x02, SRN_WLAN_PD, (uint16_t)strlen(SRN_WLAN_PD));
+	sr_send(SRN_REGISTER_LISTENER, &m);
+	LOG("M7: t=%u ms: servreg-notif at %u:%#x (instance %#x): listener for %s sent", g_ms, node, port, inst, SRN_WLAN_PD);
+}
+
+static void
+servreg_rx(const uint8_t *d, uint32_t len)
+{
+	uint16_t msg, l = 0;
+	if (len < 7) {
+		return;
+	}
+	memcpy(&msg, d + 3, 2);
+	if (d[0] == QMI_RESP && msg == SRN_REGISTER_LISTENER) {
+		uint16_t err = 0;
+		bool ok = w_result(d, len, &err);
+		const uint8_t *v = qm_find(d, len, 0x10, &l);
+		uint32_t st = 0;
+		if (v != NULL && l >= 4) {
+			memcpy(&st, v, 4);
+		}
+		LOG("M7: t=%u ms: servreg listener %s err %u, wlan_pd state %#x", g_ms, ok ? "ok" : "FAILED", err, st);
+	} else if (d[0] == QMI_IND && msg == SRN_STATE_UPDATED_IND) {
+		const uint8_t *v = qm_find(d, len, 0x01, &l);
+		uint32_t st = 0;
+		uint16_t txn = 0;
+		if (v != NULL && l >= 4) {
+			memcpy(&st, v, 4);
+		}
+		char name[80] = {};
+		qm_string(d, len, 0x02, name, sizeof(name));
+		if ((v = qm_find(d, len, 0x03, &l)) != NULL && l >= 2) {
+			memcpy(&txn, v, 2);
+		}
+		sr_inds++;
+		struct wmsg m;
+		sr_new(&m, SRN_SET_ACK);
+		wm_tlv(&m, 0x01, name, (uint16_t)strlen(name));
+		wm_tlv(&m, 0x02, &txn, 2);
+		sr_send(SRN_SET_ACK, &m);
+		LOG("M7: t=%u ms: servreg: %s state %#x, transaction %u: ACKed", g_ms, name, st, txn);
+	} else if (d[0] == QMI_RESP && msg == SRN_SET_ACK) {
+		uint16_t err = 0;
+		bool ok = w_result(d, len, &err);
+		LOG("M7: t=%u ms: servreg ack %s err %u", g_ms, ok ? "ok" : "FAILED", err);
+	} else {
+		LOG("M7: t=%u ms: servreg-notif message type %u id %#x", g_ms, d[0], msg);
+	}
+}
