+/* Any active-set request (TaimenModem's BoB vote): type, id, then nkvp key/value pairs. */
+bool sweet_rpm_vote(const char *what, uint32_t type, uint32_t id, const uint32_t *kv, unsigned nkvp);
+bool
+sweet_rpm_vote(const char *what, uint32_t type, uint32_t id, const uint32_t *kv, unsigned nkvp)
+{
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request(what, 0, type, id, kv, nkvp);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: %s: %s\n", what, ok ? "ok" : "FAILED");
+	return ok;
+}
