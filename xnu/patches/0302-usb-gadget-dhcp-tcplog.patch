+		return;
+	}
 	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
 		/*
 		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
@@ -940,6 +1074,66 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t sweet_log_position(void);
 
+/*
+ * 0302: the live log over TCP as well, port 5141 on the phone (192.168.7.2). The PC connects out,
+ * so its firewall needs no inbound rule (Windows: tools/windows/usblog.ps1). Each connection gets
+ * the last 64 KiB, then the new bytes every 100 ms. Nothing here may print.
+ */
+static void
+ud_tcplog_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t ls = NULL;
+	for (;;) {
+		if (ls == NULL) {
+			ud_sleep_ms(1000);
+			if (!ud.configured) {
+				continue;
+			}
+			if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) != 0) {
+				ls = NULL;
+				continue;
+			}
+			int on = 1;
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+			struct sockaddr_in a;
+			bzero(&a, sizeof(a));
+			a.sin_len = sizeof(a);
+			a.sin_family = AF_INET;
+			a.sin_port = htons(5141);
+			if (sock_bind(ls, (struct sockaddr *)&a) != 0 || sock_listen(ls, 1) != 0) {
+				sock_close(ls);
+				ls = NULL;
+				continue;
+			}
+		}
+		socket_t cs = NULL;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &cs) != 0 || cs == NULL) {
+			ud_sleep_ms(100);
+			continue;
+		}
+		uint64_t pos = sweet_log_position();
+		pos = pos > 65536 ? pos - 65536 : 0;
+		for (;;) {
+			uint32_t n;
+			int err = 0;
+			while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+				struct iovec iov = { .iov_base = chunk, .iov_len = n };
+				struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+				size_t sent = 0;
+				if ((err = sock_send(cs, &msg, 0, &sent)) != 0) {
+					break;
+				}
+			}
+			if (err != 0) {
+				break;
+			}
+			ud_sleep_ms(100);
+		}
+		sock_close(cs);
+	}
+}
+
 static void
 ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -1242,5 +1436,8 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_tcplog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_TAIMEN */
