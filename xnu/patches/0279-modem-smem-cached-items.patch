 }
 
+static void
+smem_part_dump(struct smem_part_hdr *p)
+{
+	char line[200];
+	int n = 0;
+	uint8_t *e = (uint8_t *)p + sizeof(*p), *end = (uint8_t *)p + p->free_uncached;
+	while (e + sizeof(struct smem_priv_entry) <= end && n < 150) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)", h->item, h->size);
+		e += sizeof(*h) + h->pad_hdr + h->size;
+	}
+	LOG("M5: apps<->mpss partition: uncached%s; free %#x..%#x of %#x, cache line %u", n ? line : " none",
+	    p->free_uncached, p->free_cached, p->size, smem_part_cacheline(p));
+	uint32_t cl = smem_part_cacheline(p), hdr = (uint32_t)((sizeof(struct smem_priv_entry) + cl - 1) / cl * cl);
+	n = 0;
+	e = (uint8_t *)p + p->size - hdr;
+	end = (uint8_t *)p + p->free_cached;
+	while (e > end && n < 150) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5 || h->size > p->size) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " (bad canary %#x)", h->canary);
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %u(%u)", h->item, h->size);
+		e -= h->size + hdr;
+	}
+	LOG("M5: apps<->mpss partition: cached%s", n ? line : " none");
+}
