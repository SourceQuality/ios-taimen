+ */
 static void
 taimen_gold_watch(void)
 {
 	static vm_offset_t ts[2];
 	static const uint32_t base[2] = {0x10aa000u, 0x10ad000u}, n[2] = {14, 8};
+	int hot = -1000, hot_t = 0;
+	uint32_t hot_i = 0;
 	if (tg_mhz == 0) {
 		return;
 	}
@@ -1383,6 +1388,11 @@ taimen_gold_watch(void)
 			if (dc & 0x800) {
