@@ -2614,7 +2616,7 @@ audio_thread(void *arg, wait_result_t)
 				LOG("t=%u.%03u 7: %s", T, amps ? "M7 TAS2557 amps loaded (powered down)" : "the amps did NOT load");
 			}
