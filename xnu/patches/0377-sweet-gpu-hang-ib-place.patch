+static uint32_t
+phys_word(uint64_t va, bool *ok)
+{
+	uint64_t pa;
+	*ok = gva_pa(va, &pa);
+	return *ok ? ml_phys_read_word((vm_offset_t)pa) : 0;
+}
+
+/*
+ * 0377: CP_IB1_BASE and CP_IB2_BASE hold where an IB starts (boot 260: both page-aligned), *_BUFSZ the dwords the CP
+ * has left of it. IB1's size comes from the hung submit's IB list, IB2's from the CP_INDIRECT_BUFFER packet in IB1
+ * that names it; the window is then 64 dwords before the CP's place and 192 after (from the start when a size is
+ * unknown).
+ */
+static uint32_t
+ib2_size(uint64_t ib1, uint32_t ib1_dwords, uint64_t ib2)
+{
+	for (uint32_t i = 0; i < ib1_dwords && i < 16384;) {
+		bool ok;
+		uint32_t h = phys_word(ib1 + 4ull * i, &ok);
+		if (!ok) {
+			break;
+		}
+		uint32_t t = h >> 28, len;
+		if (t == 4) {
+			len = 1 + (h & 0x7f);
+		} else if (t == 7) {
+			len = 1 + (h & 0x7fff);
+			uint32_t op = (h >> 16) & 0x7f;
+			if ((op == 0x3f || op == 0x37) && (h & 0x7fff) >= 3) {
+				bool a, b, c;
+				uint64_t at = phys_word(ib1 + 4ull * (i + 1), &a) | (uint64_t)phys_word(ib1 + 4ull * (i + 2), &b) << 32;
+				uint32_t sz = phys_word(ib1 + 4ull * (i + 3), &c);
+				if (a && b && c && at == ib2) {
+					return sz;
+				}
+			}
+		} else {
+			break;          /* not a packet: lost the thread */
+		}
+		i += len;
+	}
+	return 0;
+}
