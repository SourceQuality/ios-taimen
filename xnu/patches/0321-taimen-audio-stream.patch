+/*
+ * Stage 5 mode A (taimenaudiosmmu=2): stream 1 of the LPASS Q6 SMMU through an identity context
+ * bank (SCTLR.M=0, no translation), as TaimenModem's anoc2 WLAN bank (0281). Boot 156: sCR0
+ * 0x00200626 (translation on, unmatched streams fault), 12 SMRs, 13 banks, no valid SMR: the DSP's
+ * reads with SID 1 (msm-audio-ion's iova | 1 << 32) need one. A free bank from the top down.
+ */
+#define LPASS_CB_CBAR           0x0001f000u     /* S1 translate, S2 bypass, memory attributes WB */
+#define LPASS_CB_CBA2R          0x00000001u     /* VA64 */
+#define LPASS_CB_SCTLR          0x000000e0u     /* CFCFG|CFIE|CFRE, M=0: no translation */
+
+static volatile uint8_t *lpass_cb;      /* the bank we gave stream 1, for its fault status */
+
+static bool
+lpass_smmu_identity(void)
+{
+	volatile uint8_t *s = (volatile uint8_t *)ml_io_map(LPASS_SMMU_PA, LPASS_SMMU_SIZE);
+	if (s == NULL) {
+		return false;
+	}
+	uint32_t id0 = r32(s, 0x20), id1 = r32(s, 0x24);
+	uint32_t nsmr = id0 & 0xFF, ncb = id1 & 0xFF;
+	uint32_t psize = (id1 & (1u << 31)) ? 0x10000 : 0x1000, npage = 1u << (((id1 >> 28) & 7) + 1);
+	uint32_t slot = ~0u, cb = ~0u, smr, s2cr;
+	uint64_t used = 0;
+	for (uint32_t i = 0; i < nsmr && i < 128; i++) {
+		smr = r32(s, 0x800 + 4 * i);
+		s2cr = r32(s, 0xC00 + 4 * i);
+		bool valid = (smr >> 31) != 0;
+		uint32_t id = smr & 0x7FFF, m = (smr >> 16) & 0x7FFF;
+		if (valid && ((id ^ LPASS_SID) & ~m) == 0) {
+			slot = i;
+		} else if (!valid && slot == ~0u) {
+			slot = i;
+		}
+		if (valid && ((s2cr >> 16) & 3) == 0) {
+			used |= 1ull << (s2cr & 0x3F);
+		}
+	}
+	for (uint32_t i = ncb; i-- > 1;) {
+		if ((used & (1ull << i)) == 0) {
+			cb = i;
+			break;
+		}
+	}
+	if (slot == ~0u || cb == ~0u || (uint64_t)(npage + cb + 1) * psize > LPASS_SMMU_SIZE) {
+		LOG("5: no free SMR/bank for stream 1 (slot %u cb %u)", slot, cb);
+		return false;
+	}
+	volatile uint8_t *gr1 = s + psize, *cbp = s + (uint64_t)npage * psize + (uint64_t)cb * psize;
+	w32(cbp, 0x58, 0xFFFFFFFF);                 /* FSR: clear */
+	w32(cbp, 0x20, 0);                          /* TTBR0 */
+	w32(cbp, 0x24, 0);
+	w32(cbp, 0x30, 0);                          /* TCR */
+	w32(cbp, 0x10, 0);                          /* TCR2 */
+	w32(cbp, 0x38, 0);                          /* MAIR */
+	w32(cbp, 0x3C, 0);
+	w32(gr1, 0x800 + 4 * cb, LPASS_CB_CBA2R);
+	w32(gr1, 0x000 + 4 * cb, LPASS_CB_CBAR);
+	w32(cbp, 0x0, LPASS_CB_SCTLR);              /* SCTLR last */
+	w32(s, 0xC00 + 4 * slot, cb);               /* S2CR: translate, this bank */
+	w32(s, 0x800 + 4 * slot, (1u << 31) | LPASS_SID);   /* SMR: stream 1 exactly, valid last */
+	w32(s, 0x70, 0);                            /* sTLBGSYNC */
+	uint32_t n;
+	for (n = 0; n < 100000 && (r32(s, 0x74) & 1) != 0; n++) {
+		IODelay(1);
+	}
+	smr = r32(s, 0x800 + 4 * slot);
+	s2cr = r32(s, 0xC00 + 4 * slot);
+	bool ok = (smr >> 31) != 0 && (smr & 0x7FFF) == LPASS_SID && ((s2cr >> 16) & 3) == 0 && (s2cr & 0xFF) == cb;
+	lpass_cb = cbp;
+	LOG("5: M5 stream 1 identity bank CB%u SMR%u: SMR %08x S2CR %08x SCTLR %08x -> %s", cb, slot, smr, s2cr,
+	    r32(cbp, 0x0), ok ? "OK" : "NOT as written");
+	return ok;
+}
+
+static void
+lpass_smmu_faults(const char *when)
+{
+	if (lpass_cb == NULL) {
+		return;
+	}
+	uint32_t fsr = r32(lpass_cb, 0x58);
+	LOG("t=%u.%03u 5: stream 1 bank %s: FSR %08x FAR %08x%08x FSYNR0 %08x", T, when, fsr, r32(lpass_cb, 0x64),
+	    r32(lpass_cb, 0x60), r32(lpass_cb, 0x68));
+}
