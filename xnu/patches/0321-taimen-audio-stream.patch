+/* ---------------------------------------------------------------- stage 8: ADM COPP + ASM stream (tone) */
+
+/*
+ * HackiOS redwood_sound.c's order with taimen's port (plan stage 8): map the period buffers for
+ * ASM, open an ADM COPP on 0x1006 (null topology), open an ASM write stream (session 1, stream 1,
+ * multi-channel PCM v2, no POPP), route the session to the COPP, send the media format, run, then
+ * keep 8 x 20 ms periods queued (ASM_DATA_CMD_WRITE_V2; ASM_DATA_EVENT_WRITE_DONE_V2 frees one).
+ * The DSP reads the periods through the LPASS SMMU (stream 1): the address form is the boot-arg
+ * taimenaudioaddr: 0 = pa | 1 << 32 (stream 1 identity bank, msm_audio_ion's SID bits; mode A),
+ * 1 = plain pa (SMMU bypass, mode B).
+ */
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS      0x00010D92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS   0x00010D93u
+#define ASM_CMD_SHARED_MEM_UNMAP_REGIONS    0x00010D94u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2    0x00010D98u
+#define ASM_DATA_EVENT_WRITE_DONE_V2        0x00010D99u
+#define ASM_SESSION_CMD_RUN_V2              0x00010DAAu
+#define ASM_DATA_CMD_WRITE_V2               0x00010DABu
+#define ASM_STREAM_CMD_OPEN_WRITE_V3        0x00010DB3u
+#define ASM_STREAM_CMD_CLOSE                0x00010BCDu
+#define ASM_SESSION_EVENT_RX_UNDERFLOW      0x00010C17u
+#define ASM_NULL_POPP_TOPOLOGY              0x00010C68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2  0x00010DA5u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5      0x00010325u
+#define ADM_CMD_DEVICE_OPEN_V5              0x00010326u
+#define ADM_CMD_DEVICE_CLOSE_V5             0x00010327u
+#define ADM_CMDRSP_DEVICE_OPEN_V5           0x00010329u
+#define ADM_NULL_COPP_TOPOLOGY              0x00010312u
+#define SHMEM8_4K_POOL                      3
+#define PCM_CHANNEL_FL                      1
+#define PCM_CHANNEL_FR                      2
+#define ASM_PORT                            0x0101  /* session 1 << 8 | stream 1 */
+
+#define PERIODS                 8
+#define PERIOD_FRAMES           960             /* 20 ms at 48 kHz */
+#define PERIOD_BYTES            (PERIOD_FRAMES * 4)
+
+struct asm_map_regions {
+	uint16_t pool, nregions;
+	uint32_t property;
+	struct { uint32_t lsw, msw, size; } r;
+} __attribute__((packed));
+struct adm_open_v5 {
+	uint16_t flags, mode, endpoint1, endpoint2;
+	uint32_t topology;
+	uint16_t channels, bit_width;
+	uint32_t rate;
+	uint8_t  map[8];
+} __attribute__((packed));
+struct asm_open_write_v3 {
+	uint32_t mode_flags;
+	uint16_t sink, bits;
+	uint32_t popp, fmt;
+} __attribute__((packed));
+struct adm_routing_v5 {
+	uint32_t matrix, nsessions;
+	uint16_t session, ncopps, copp, pad;
+} __attribute__((packed));
+struct asm_fmt_update_v2 {
+	uint32_t blk_size;
+	uint16_t channels, bits;
+	uint32_t rate;
+	uint16_t is_signed, reserved;
+	uint8_t  map[8];
+} __attribute__((packed));
+struct asm_write_v2 {
+	uint32_t lsw, msw, handle, size, seq, ts_lsw, ts_msw, flags;
+} __attribute__((packed));
+
+static uint8_t *periods;
+static uint64_t periods_pa;
+static uint32_t asm_handle, writes_done, underflows, periods_out;
+static uint16_t copp_id;
+
+/* 1 kHz at -20 dBFS (3277), 48 samples a cycle: round(3277 sin(2 pi k / 48)) */
+static const int16_t tone48[48] = {
+	0, 428, 848, 1254, 1638, 1992, 2317, 2600, 2838, 3025, 3166, 3253,
+	3277, 3253, 3166, 3025, 2838, 2600, 2317, 1992, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1992, -2317, -2600, -2838, -3025, -3166, -3253,
+	-3277, -3253, -3166, -3025, -2838, -2600, -2317, -1992, -1638, -1254, -848, -428,
+};
+
+static uint64_t
+dsp_addr(uint64_t pa)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("taimenaudioaddr", &mode, sizeof(mode));
+	return mode == 1 ? pa : (pa | (1ull << 32));
+}
+
+static void
+period_fill(unsigned i, bool tone)
+{
+	int16_t *s = (int16_t *)(periods + (uint64_t)i * 0x1000);
+	for (unsigned f = 0; f < PERIOD_FRAMES; f++) {
+		int16_t v = tone ? tone48[f % 48] : 0;
+		s[2 * f] = v;
+		s[2 * f + 1] = v;
+	}
+	mb();
+}
+
+static bool
+period_send(unsigned i)
+{
+	struct asm_write_v2 w;
+	uint64_t a = dsp_addr(periods_pa + (uint64_t)i * 0x1000);
+	bzero(&w, sizeof(w));
+	w.lsw = (uint32_t)a;
+	w.msw = (uint32_t)(a >> 32);
+	w.handle = asm_handle;
+	w.size = PERIOD_BYTES;
+	w.seq = i;
+	periods_out++;
+	return apr_send(APR_SVC_ASM, ASM_PORT, ASM_DATA_CMD_WRITE_V2, &w, sizeof(w));
+}
+
+/* ASM events outside a call: write done (refill), underflow. From apr_rx's default case. */
+static bool
+asm_event(const struct apr_hdr *h, const uint32_t *p, uint32_t plen)
+{
+	if (h->opcode == ASM_DATA_EVENT_WRITE_DONE_V2) {
+		writes_done++;
+		if (periods_out > 0) {
+			periods_out--;
+		}
+		return true;
+	}
+	if (h->opcode == ASM_SESSION_EVENT_RX_UNDERFLOW) {
+		underflows++;
+		return true;
+	}
+	(void)p;
+	(void)plen;
+	return false;
+}
+
+static bool
+stage8(void)
+{
+	uint64_t pa = 0;
+	periods = (uint8_t *)pool_alloc((uint64_t)PERIODS * 0x1000, &pa);
+	if (periods == NULL) {
+		LOG("8: no pool room for the periods");
+		return false;
+	}
+	periods_pa = pa;
+	uint64_t a = dsp_addr(pa);
+	struct asm_map_regions mr = { SHMEM8_4K_POOL, 1, 0, { (uint32_t)a, (uint32_t)(a >> 32), PERIODS * 0x1000 } };
+	int rc = apr_call("ASM map periods", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &mr, sizeof(mr), 1000);
+	if (rc != 0 || apr_wait_opcode != ASM_CMDRSP_SHARED_MEM_MAP_REGIONS || apr_wait_len < 4) {
+		LOG("8: ASM map of %#llx (DSP address %#llx) failed: %d", pa, a, rc);
+		return false;
+	}
+	asm_handle = apr_wait_payload[0];
+	struct adm_open_v5 ao;
+	bzero(&ao, sizeof(ao));
+	ao.mode = 1;                            /* RX */
+	ao.endpoint1 = APR_PORT_QUAT_MI2S_RX;
+	ao.endpoint2 = 0xFFFF;
+	ao.topology = ADM_NULL_COPP_TOPOLOGY;
+	ao.channels = 2;
+	ao.bit_width = 16;
+	ao.rate = 48000;
+	ao.map[0] = PCM_CHANNEL_FL;
+	ao.map[1] = PCM_CHANNEL_FR;
+	rc = apr_call("ADM DEVICE_OPEN_V5 0x1006", APR_SVC_ADM, APR_PORT_QUAT_MI2S_RX, ADM_CMD_DEVICE_OPEN_V5, &ao, sizeof(ao), 1000);
+	if (apr_wait_opcode != ADM_CMDRSP_DEVICE_OPEN_V5 || apr_wait_len < 8 || apr_wait_payload[0] != 0) {
+		LOG("8: ADM open failed (rc %d, opcode %#x, status %#x)", rc, apr_wait_opcode, apr_wait_len >= 4 ? apr_wait_payload[0] : 0);
+		return false;
+	}
+	copp_id = (uint16_t)apr_wait_payload[1];
+	struct asm_open_write_v3 ow = { 0, 0, 16, ASM_NULL_POPP_TOPOLOGY, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	rc = apr_call("ASM OPEN_WRITE_V3", APR_SVC_ASM, ASM_PORT, ASM_STREAM_CMD_OPEN_WRITE_V3, &ow, sizeof(ow), 1000);
+	if (rc != 0) {
+		return false;
+	}
+	struct adm_routing_v5 rt = { 0, 1, 1, 1, copp_id, 0 };
+	rc = apr_call("ADM MATRIX_MAP_ROUTINGS_V5", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &rt, sizeof(rt), 1000);
+	if (rc != 0) {
+		return false;
+	}
+	struct asm_fmt_update_v2 fu;
+	bzero(&fu, sizeof(fu));
+	fu.blk_size = sizeof(fu) - 4;
+	fu.channels = 2;
+	fu.bits = 16;
+	fu.rate = 48000;
+	fu.is_signed = 1;
+	fu.map[0] = PCM_CHANNEL_FL;
+	fu.map[1] = PCM_CHANNEL_FR;
+	rc = apr_call("ASM MEDIA_FMT_UPDATE_V2", APR_SVC_ASM, ASM_PORT, ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &fu, sizeof(fu), 1000);
+	if (rc != 0) {
+		return false;
+	}
+	uint32_t run[3] = { 0, 0, 0 };
+	rc = apr_call("ASM RUN_V2", APR_SVC_ASM, ASM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 1000);
+	if (rc != 0) {
+		return false;
+	}
+	/* 3 s of tone, then silence until every period is back */
+	uint64_t t = now_ms();
+	unsigned next = 0, sent = 0;
+	for (unsigned i = 0; i < PERIODS; i++) {
+		period_fill(i, true);
+		period_send(i);
+		sent++;
+	}
+	uint32_t seen_done = writes_done;
+	while (now_ms() - t < 5000) {
+		if (!glink_poll()) {
+			IOSleep(1);
+		}
+		while (writes_done != seen_done) {
+			seen_done++;
+			if (now_ms() - t < 3000) {
+				period_fill(next, true);
+				period_send(next);
+				sent++;
+			}
+			next = (next + 1) % PERIODS;
+		}
+		if (now_ms() - t >= 3000 && periods_out == 0) {
+			break;
+		}
+	}
+	LOG("t=%u.%03u 8: %s: %u periods sent, %u written back, %u underflows, %u still out (%llu ms)", T,
+	    writes_done >= 100 ? "M8 the stream ran" : "the stream did NOT run", sent, writes_done, underflows, periods_out,
+	    now_ms() - t);
+	apr_call("ASM CLOSE", APR_SVC_ASM, ASM_PORT, ASM_STREAM_CMD_CLOSE, NULL, 0, 1000);
+	apr_next_dst = copp_id;                 /* q6adm: src the AFE port, dest the COPP */
+	apr_call("ADM DEVICE_CLOSE_V5", APR_SVC_ADM, APR_PORT_QUAT_MI2S_RX, ADM_CMD_DEVICE_CLOSE_V5, NULL, 0, 1000);
+	uint32_t um = asm_handle;
+	apr_call("ASM unmap periods", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_UNMAP_REGIONS, &um, sizeof(um), 1000);
+	return writes_done >= 100;
+}
