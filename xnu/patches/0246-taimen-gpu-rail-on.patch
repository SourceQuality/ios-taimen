 static vm_offset_t
 taimen_power_up(void)
@@ -2432,6 +2432,19 @@ taimen_power_up(void)
 	printf("SWEET GPU: taimen: S1 %s en %02x %u mV; gpucc cx %08x gx %08x misc %08x gfx3d %08x\n",
 	    s1 ? "ok" : "UNREADABLE", en, (unsigned)hi << 8 | lo, rd(cc, 0x1004), rd(cc, 0x1094), rd(cc, 0x130),
 	    rd(cc, 0x1098));
+	/*
+	 * Boot 78c (after two boot images ABL refused) found S1 off (en 00): set ABL's 752 mV
+	 * and switch it on, as the MSM8996 path does with its S2.
+	 */
+	for (int attempt = 0; s1 && attempt < 3 && (!(en & 0x80) || ((unsigned)hi << 8 | lo) < 700); attempt++) {
+		bool ok = sweet_pmic_write(0x514, 0x40, 752 & 0xff) && sweet_pmic_write(0x514, 0x41, 752 >> 8) &&
