+		printf("SWEET GPU: taimen: S1 was off, switched on (%s, try %d): en %02x %u mV\n",
+		    ok ? "written" : "write FAILED", attempt + 1, en, (unsigned)hi << 8 | lo);
+	}
 	if (!s1 || !(en & 0x80) || ((unsigned)hi << 8 | lo) < 700) {
