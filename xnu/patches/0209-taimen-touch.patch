+ * that register belong to SMP2P: write 1 only. docs/taimen-touch-plan.md 4.
+ */
+#define RPM_MSGRAM_PA   0x00778000u
+#define RPM_MSGRAM_SIZE 0x7000u
+#define RPM_IPC_PA      0x17911000u
+#define RPM_IPC_OFF     0x8u
+#else
 #define RPM_MSGRAM_PA   0x00068000u
