+bool
+sweet_rpm_ldoa_set(unsigned ldo, uint32_t uv, uint32_t set)
+{
+	uint32_t kv[4] = {0x6e657773u, 1u, 0x00007675u, uv};      /* swen = 1, uv */
+	char what[12];
+	snprintf(what, sizeof(what), "L%u/%u", ldo, set);
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request(what, set, 0x616f646cu, ldo, kv, 2);     /* "ldoa" */
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: L%u %u uV set %u: %s\n", ldo, uv, set, ok ? "ok" : "FAILED");
+	return ok;
