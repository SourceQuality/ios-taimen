+/* One key/value in the sleep and then the active set (TaimenModem's QDSS and RF_CLK2 votes). */
+bool sweet_rpm_kv_both(const char *what, uint32_t type, uint32_t id, uint32_t key, uint32_t value);
+bool
+sweet_rpm_kv_both(const char *what, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	uint32_t kv[2] = {key, value};
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request(what, 1, type, id, kv, 1) && rpm_request(what, 0, type, id, kv, 1);
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: %s (both sets): %s\n", what, ok ? "ok" : "FAILED");
+	return ok;
+}
