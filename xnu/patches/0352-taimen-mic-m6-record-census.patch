+/*
+ * M6 (plan section 6): the census. The speakers' session opens first, playing silence (so its APR
+ * calls do not stall the reads), then the recording with every DMIC's bias and clock on. From RUN:
+ * 0.5-1.5 s quiet on DMIC0; at 1.5 s stage 8's tone (1 kHz, -20 dBFS) and DMIC0, at 2.5 s DMIC1,
+ * 3.5 s DMIC2, 4.5 s DMIC4, each measured after 200 ms; the tone ends at 5.5 s.
+ */
+static bool
+mic_m6(bool dsp_mem, bool tone_ok)
+{
+	static const int step_dmic[4] = { 0, 1, 2, 4 };
+	char t1[16], t2[16], t3[16], t4[16], ex[40];
+	bool tone = tone_ok, playing = false, ok;
+	unsigned next = 0;
+	uint32_t seen = 0;
+	int32_t rise[5] = { 0, 0, 0, 0, 0 }, lo = 32767, hi = -32768;
+	uint64_t frames = 0;
+
+	if (!dsp_mem) {
+		MLOG("6: no LPASS SMMU stream 1 bank (taimenaudiosmmu=2 or taimenaudioaddr=1): the DSP cannot write our memory");
+		return false;
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		meter_reset(&m6_meter[i]);
+	}
+	m6_window = -1;
+	if (tone) {
+		playing = afe_start() && stream_open();
+		if (playing) {
+			if (amps) {
+				(void)taimen_tas2557_power(true);
+			}
+			seen = writes_done;
+			for (unsigned i = 0; i < PERIODS; i++) {
+				period_fill(i, false);
+				period_send(i);
+			}
+		} else {
+			MLOG("6: the speakers' session did NOT open: no tone");
+			afe_stop();                     /* as the feeder does */
+			tone = false;
+		}
+	} else {
+		MLOG("6: no speaker tone (it needs taimenaudio>=7: the MI2S port and the amps): the reads only");
+	}
+	ok = mic_session_up(6, 0, true, true);
+	int w = 0;
+	while (ok) {
+		if (!glink_poll()) {
+			IOSleep(1);
+		}
+		uint64_t el = now_ms() - mic_t0;
+		while (playing && writes_done != seen) {
+			seen++;
+			period_fill(next, el >= 1500 && el < 5500);
+			period_send(next);
+			next = (next + 1) % PERIODS;
+		}
+		int want = el < 500 ? -1 : el < 1500 ? 0 : el < 5500 ? (int)((el - 1500) / 1000) + 1 : -1;
+		if (want >= 1 && want != w) {
+			(void)taimen_wcd_select(step_dmic[want - 1]);
+			w = want;
+		}
+		m6_window = want >= 1 && (el - 1500) % 1000 < 200 ? -1 : want;
+		(void)mic_service(m6_sink);
+		if (el >= 5600) {
+			break;
+		}
+		if (el >= 1500 && mic_dones == 0) {
+			MLOG("6: NO READ_DONE in 1.5 s (the stream or the AFE port)");
+			ok = false;
+		}
+	}
+	m6_window = -1;
+	uint32_t reads = mic_dones, good = mic_good, errors = mic_errors, overflows = mic_overflows;
+	mic_session_down(6, true);
+	if (playing) {
+		uint64_t td = now_ms();
+		while (periods_out > 0 && now_ms() - td < 500) {
+			if (!glink_poll()) {
+				IOSleep(1);
+			}
+		}
+		if (amps) {
+			(void)taimen_tas2557_power(false);
+		}
+		stream_close();
+		afe_stop();
+	}
+	for (unsigned i = 0; i < 5; i++) {
+		const struct mic_meter *m = &m6_meter[i];
+		int32_t q = meter_1k_db(&m6_meter[0]), d = meter_1k_db(m);
+		rise[i] = q > -9999 && d > -9999 ? d - q : -9999;     /* nothing to compare: -inf */
+		frames += m->frames;
+		if (m->frames != 0) {
+			lo = MIN(lo, m->lo);
+			hi = MAX(hi, m->hi);
+		}
+		ex[0] = 0;
+		if (i != 0) {
+			snprintf(ex, sizeof(ex), " (%s dB over quiet)", db_text(t1, sizeof(t1), rise[i]));
+		}
+		char what[32];
+		snprintf(what, sizeof(what), "6: %s DMIC%d", i == 0 ? "quiet" : "tone", i == 0 ? 0 : step_dmic[i - 1]);
+		meter_log(what, m, ex);
+	}
+	bool heard = tone && MAX(rise[1], rise[2]) >= 200;
+	bool pass = ok && good >= 250 && hi > lo && heard;
+	MLOG("6: %s: DMIC0 1 kHz %s dB over quiet; DMIC1 %s; DMIC2 %s; DMIC4 %s; %u reads (%u full), %u errors, %u overflows",
+	    pass ? "M6 the microphone hears the speaker" : "M6 NOT reached", db_text(t1, sizeof(t1), rise[1]),
+	    db_text(t2, sizeof(t2), rise[2]), db_text(t3, sizeof(t3), rise[3]), db_text(t4, sizeof(t4), rise[4]), reads, good,
+	    errors, overflows);
+	if (!pass) {
+		MLOG("6: %s", !ok || reads == 0 ? "no READ_DONE: the stream or the AFE port" :
+		    good < 250 ? "too few full periods (READ_DONE with a status or a short size)" :
+		    frames == 0 || (lo == 0 && hi == 0) ? "all zeros: channel 135 carries nothing (M5) or the mux" :
+		    hi == lo ? "constant samples: a DMIC edge with no mic (try taimenmicdmic=1)" :
+		    !tone ? "no tone to hear" : "noise without the tone: the wrong mic or gain, or the speakers silent");
+	}
+	return pass;
+}
