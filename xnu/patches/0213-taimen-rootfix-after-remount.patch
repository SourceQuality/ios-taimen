@@ -117,37 +119,17 @@ rootfix_mkdir(const char *path, uint32_t mode, uint32_t uid, uint32_t gid, vfs_c
 	return err;
 }
 
-void
-taimen_rootfix(void)
+static const uint8_t *rootfix_blob;
+static uint64_t rootfix_len;
+static int rootfix_chan;
+
+static void
+rootfix_apply(void)
 {
-	int enabled = 1;
-	DTEntry node;
-	uint64_t const *v;
-	unsigned int size;
-	(void)PE_parse_boot_argn("taimenrootfix", &enabled, sizeof(enabled));
-	if (!enabled || SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
-	    SecureDTGetProperty(node, "ROOTFIX", (void const **)&v, &size) != kSuccess || size != 16) {
-		printf("TAIMEN ROOTFIX: %s\n", enabled ? "no ROOTFIX blob in the payload" : "disabled");
-		return;
-	}
-	const uint8_t *b = (const uint8_t *)phystokv(v[0]), *end = b + v[1];
