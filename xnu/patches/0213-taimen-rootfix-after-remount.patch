 	const uint8_t *p = b + 8;
 	for (uint32_t i = 0; i < count; i++) {
 		if (p + 24 > end) {
@@ -188,4 +170,55 @@ taimen_rootfix(void)
 	}
 	printf("TAIMEN ROOTFIX: %u records: %u written, %u already present, %u failed\n", count, done, skipped, failed);
 }
+
+/*
+ * Boots 26-27: the root comes up read-only, launchd's boot tasks remount it read-write
+ * (mount -uw /), and an update from here fails: HFS takes local mount args, which
+ * mount_common copies in, and bsdinit_task runs as the init process (copyin from a kernel
+ * address: EFAULT). So wait for launchd's remount and write then. launchd.plist edits take
+ * effect from the next boot (the root persists); prefs are in place before SpringBoard.
+ */
+static void
+rootfix_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned waited = 0;
+	while (rootvnode == NULLVP || vfs_isrdonly(vnode_mount(rootvnode))) {
+		if (waited >= 120 * 5) {
+			printf("TAIMEN ROOTFIX: root still read-only after 120 s, nothing written\n");
+			return;         /* a kernel thread ends by returning */
+		}
+		(void)tsleep(&rootfix_chan, PZERO, "rootfix", hz / 5);
+		waited++;
+	}
+	printf("TAIMEN ROOTFIX: root read-write after %u.%u s\n", waited / 5, (waited % 5) * 2);
+	rootfix_apply();
+}
+
+void
+taimen_rootfix(void)
+{
+	int enabled = 1;
+	DTEntry node;
+	uint64_t const *v;
+	unsigned int size;
+	thread_t thread;
+	(void)PE_parse_boot_argn("taimenrootfix", &enabled, sizeof(enabled));
+	if (!enabled || SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "ROOTFIX", (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("TAIMEN ROOTFIX: %s\n", enabled ? "no ROOTFIX blob in the payload" : "disabled");
+		return;
+	}
+	rootfix_blob = (const uint8_t *)phystokv(v[0]);
+	rootfix_len = v[1];
+	const uint32_t *h = (const uint32_t *)rootfix_blob;
+	if (rootfix_len < 8 || h[0] != RFX_MAGIC) {
+		printf("TAIMEN ROOTFIX: bad blob (len %llu magic %#x)\n", rootfix_len, rootfix_len >= 4 ? h[0] : 0);
+		return;
+	}
+	if (kernel_thread_start(rootfix_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("TAIMEN ROOTFIX: no thread\n");
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_TAIMEN */
