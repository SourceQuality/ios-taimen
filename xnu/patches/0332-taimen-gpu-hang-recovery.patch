+/* a5xx_pm_resume's power islands and the subset of a5xx_hw_init this driver runs */
+static void
+hw_init_regs(vm_offset_t gpu, uint64_t pm4, uint64_t pfp, bool say)
+{
+	/*
+	 * a5xx_pm_resume (A530): power the RB/CCU and SP islands; without them
+	 * the CP hung on the first 2D blit (0126a, RBBM_STATUS c00001c3).
+	 */
+	gw(gpu, R_GPMU_RBCCU_POWER_CNTL, 0x778000);
+	bool rbccu = poll(gpu, R_GPMU_RBCCU_PWR_CLK_STATUS * 4, 1u << 20, 1u << 20, 1);
+	gw(gpu, R_GPMU_SP_POWER_CNTL, 0x778000);
+	bool sp = poll(gpu, R_GPMU_SP_PWR_CLK_STATUS * 4, 1u << 20, 1u << 20, 1);
+	if (say) {
+		printf("SWEET GPU: RBCCU power %s (%08x), SP power %s (%08x)\n", rbccu ? "on" : "TIMEOUT",
+		    gr(gpu, R_GPMU_RBCCU_PWR_CLK_STATUS), sp ? "on" : "TIMEOUT", gr(gpu, R_GPMU_SP_PWR_CLK_STATUS));
+	}
+
+	/* Subset of a5xx_hw_init (A530 values; HWCG, GPMU firmware, CP_PROTECT left out). */
+	gw(gpu, R_VBIF_RR_QOS_ARB, 3);
+	gw(gpu, R_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	gw(gpu, R_RBBM_AHB_CNTL0, 1);
+	gw(gpu, R_UCHE_CACHE_WAYS, 2);
+	gw64(gpu, R_UCHE_TRAP_BASE, 0x0001ffffffff0000ull);
+	gw64(gpu, R_UCHE_WRITE_THRU_BASE, 0x0001ffffffff0000ull);
+	gw64(gpu, R_UCHE_GMEM_RANGE_MIN, 0x00100000);
+	gw64(gpu, R_UCHE_GMEM_RANGE_MAX, 0x00100000 + 0x100000 - 1);   /* 1 MB GMEM */
+	gw(gpu, R_CP_MEQ_THRESHOLDS, 0x40);
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	gw(gpu, R_CP_MERCIU_SIZE, 0x400);       /* A540 (mainline a5xx_gpu.c, kgsl a5xx_start) */
+#else
+	gw(gpu, R_CP_MERCIU_SIZE, 0x40);
+#endif
+	gw(gpu, R_CP_ROQ_THRESHOLDS_2, 0x80000060);
+	gw(gpu, R_CP_ROQ_THRESHOLDS_1, 0x40201b16);
+	gw(gpu, R_PC_DBG_ECO_CNTL, (0x400u << 11) | (0x300u << 22));
+	gw(gpu, R_UCHE_MODE_CNTL, 1u << 29);
+	gw(gpu, R_CP_CHICKEN_DBG, 0x02000000);
+	gw(gpu, R_RBBM_AHB_CNTL1, 0xa6ffffff);
+	gw(gpu, R_RBBM_AHB_CNTL2, 0x3f);
+	gw(gpu, R_TPL1_MODE_CNTL, 2u << 7);     /* highest bank bit 15 */
+	gw(gpu, R_RB_MODE_CNTL, 2u << 1);
+	gw(gpu, R_VPC_DBG_ECO_CNTL, gr(gpu, R_VPC_DBG_ECO_CNTL) | (1u << 10));
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	/* A540 deltas (docs/taimen-gpu-plan.md 2.6, mainline a5xx_hw_init): */
+	gw(gpu, 0x302a, 9);                                             /* VBIF_GATE_OFF_WRREQ_EN */
+	gw(gpu, 0x0e8f, 2);                                             /* UCHE_DBG_ECO_CNTL_2: bank bit 15 */
+	gw(gpu, R_VPC_DBG_ECO_CNTL, gr(gpu, R_VPC_DBG_ECO_CNTL) | (1u << 23));
+	gw(gpu, 0x0e04, gr(gpu, 0x0e04) & ~(1u << 18));                 /* HLSQ_DBG_ECO_CNTL */
+#endif
+	gw(gpu, R_SECVID_TSB_CNTL, 0);
+	gw64(gpu, R_SECVID_TSB_BASE, 0);
+	gw(gpu, R_SECVID_TSB_SIZE, 0);
+	/*
+	 * Every block in 64-bit mode (the CP alone was not enough: the 0127a
+	 * blit faulted at the source PA's low 32 bits).
+	 */
+	static const uint16_t addr_mode[] = {
+		0x0860 /* CP */, 0x0bc1 /* VSC */, 0x0c81 /* GRAS */, 0x0cc5 /* RB */, 0x0d01 /* PC */,
+		0x0e05 /* HLSQ */, 0x0e41 /* VFD */, 0x0e61 /* VPC */, 0x0e80 /* UCHE */, 0x0ec1 /* SP */,
+		0x0f01 /* TPL1 */, R_SECVID_TSB_ADDR_MODE,
+	};
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		gw(gpu, addr_mode[i], 1);
+	}
+	gw64(gpu, R_CP_ME_INSTR_BASE, pm4);
+	gw64(gpu, R_CP_PFP_INSTR_BASE, pfp);
+	gw64(gpu, R_CP_RB_BASE, rb_pa);
+	/* BUFSZ log2(16 KB / 8) = 11, BLKSZ log2(32 / 8) = 2 (mainline), NO_UPDATE */
+	gw(gpu, R_CP_RB_CNTL, 11u | (2u << 8) | (1u << 27));
+}
+
+static void
+me_init(void)
+{
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f);
+	emit(0x3);
+	emit(0x20000000);
+	emit(0);
+	emit(0);
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	emit(0);                /* A540: no microcode workarounds (a5xx_me_init) */
+#else
+	emit(0xb);              /* A530 token-end-sync workaround */
+#endif
+	emit(0);
+	emit(0);
+}
