+/*
+ * 0332: taimengpuhang=S: S seconds after the service is up, hang the CP on purpose (a
+ * CP_WAIT_REG_MEM on a word never written, in the ring), wait for the fence, and check the
+ * GPU again after the recovery.
+ */
+static void
+hang_test(void *arg, wait_result_t result)
+{
+	(void)result;
+	gpu_sleep((unsigned)(uintptr_t)arg);
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	if (!g_ready || rb_free() < 64) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		printf("SWEET GPU: hang test: service not up or ring full, not run\n");
+		return;
+	}
+	*(volatile uint32_t *)(g_scratch_va + 88) = 0;
+	flush_dcache64((addr64_t)g_scratch + 88, 4, TRUE);
+	emit(pkt7(CP_WAIT_REG_MEM, 6));
+	emit(3u | (1u << 4));           /* WRITE_EQ, poll memory */
+	emit((uint32_t)g_scratch + 88);
+	emit((uint32_t)(g_scratch >> 32));
+	emit(0xbadc0de1u);
+	emit(0xffffffffu);
+	emit(16);
+	uint32_t seq = ++g_submit_seq;
+	emit(pkt7(CP_EVENT_WRITE, 4));
+	emit(CACHE_FLUSH_TS);
+	emit((uint32_t)g_fence_pa);
+	emit((uint32_t)(g_fence_pa >> 32));
+	emit(seq);
+	flush_dcache64((addr64_t)rb_pa, RB_DWORDS * 4, TRUE);
+	gw(g_gpu, R_CP_RB_WPTR, rb_n);
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	printf("SWEET GPU: hang test: the CP waits for a word never written (fence %u)\n", seq);
+	uint64_t t0 = mach_absolute_time();
+	int r = sweet_gpu_wait(seq, 15000);
+	printf("SWEET GPU: hang test: wait -> %d after %llu ms; service %s, %u recoveries\n", r,
+	    usecs(mach_absolute_time() - t0) / 1000, g_ready ? "up" : "OFF", g_recoveries);
+	if (g_ready) {
+		api_selftest();
+	}
+}
+
+static void
+hang_test_start(void)
+{
+	int secs = 0;
+	thread_t thread;
+	if (PE_parse_boot_argn("taimengpuhang", &secs, sizeof(secs)) && secs > 0 &&
+	    kernel_thread_start(hang_test, (void *)(uintptr_t)secs, &thread) == KERN_SUCCESS) {
+		printf("SWEET GPU: hang test in %d s (taimengpuhang)\n", secs);
+		thread_deallocate(thread);
+	}
+}
