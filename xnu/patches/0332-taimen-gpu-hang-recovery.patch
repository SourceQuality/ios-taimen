+/* VM lock held, g_ready false. */
+static bool
+gpu_recover(const char *why)
+{
+	int max = 4;
+	(void)PE_parse_boot_argn("taimengpurecover", &max, sizeof(max));
+	if (g_gpu == 0 || g_pm4 == 0 || max <= 0 || g_recoveries >= (unsigned)max) {
+		if (max > 0 && g_recoveries >= (unsigned)max) {
+			printf("SWEET GPU: no recovery: %u done already (taimengpurecover=%d)\n", g_recoveries, max);
+		}
+		return false;
+	}
+	g_recoveries++;
+	uint64_t t0 = mach_absolute_time();
+	vm_offset_t gpu = g_gpu;
+	gw(gpu, R_RBBM_SW_RESET_CMD, 1);
+	(void)gr(gpu, R_RBBM_SW_RESET_CMD);
+	delay(100);
+	gw(gpu, R_RBBM_SW_RESET_CMD, 0);
+	delay(1000);
+	uint32_t rptr = gr(gpu, R_CP_RB_RPTR), st = gr(gpu, R_RBBM_STATUS);
+	hw_init_regs(gpu, g_pm4, g_pfp, false);
+	rb_n = 0;
+	me_init();
+	volatile uint32_t *mark = (volatile uint32_t *)(g_scratch_va + 80);
+	mark[0] = 0;
+	mark[1] = 0;
+	flush_dcache64((addr64_t)g_scratch + 80, 8, TRUE);
+	emit(pkt7(CP_MEM_WRITE, 3));
+	emit((uint32_t)g_scratch + 80);
+	emit((uint32_t)(g_scratch >> 32));
+	emit(0x7ec0e700u | g_recoveries);
+	gw(gpu, R_CP_PFP_ME_CNTL, 0);   /* clear ME_HALT */
+	bool cp = kick(gpu);
+	delay(1000);
+	flush_dcache64((addr64_t)g_scratch + 80, 8, TRUE);
+	bool landed = mark[0] == (0x7ec0e700u | g_recoveries);
+	uint64_t r1 = 0;
+	int64_t r = -1;
+	bool secure_left = false;
+	if (cp && landed) {
+		/* qcom_scm_set_remote_state(SCM_GPU_ZAP_SHADER_RESUME 0, pas id): svc 1 (boot) cmd 0x0a */
+		r = scm_call(1, 0x0a, 2, 0, GPU_PAS_ID, 0, &r1);
+		if (r == 0) {
+			emit(pkt7(CP_SET_SECURE_MODE, 1));
+			emit(0);
+			emit(pkt7(CP_MEM_WRITE, 3));
+			emit((uint32_t)g_scratch + 84);
+			emit((uint32_t)(g_scratch >> 32));
+			emit(0x5ec0de00u | g_recoveries);
+			bool k = kick(gpu);
+			delay(1000);
+			flush_dcache64((addr64_t)g_scratch + 80, 8, TRUE);
+			secure_left = k && mark[1] == (0x5ec0de00u | g_recoveries);
+		}
+	}
+	if (!(cp && landed && secure_left)) {
+		cp_state(gpu, "recovery failed:");
+		printf("SWEET GPU: recovery %u FAILED (%s): RPTR after reset %u, RBBM_STATUS %08x; ring %s, marker %08x, "
+		    "zap resume %lld/%llx, secure mode %s\n", g_recoveries, why, rptr, st, cp ? "read" : "NOT read",
+		    mark[0], r, r1, secure_left ? "left" : "NOT left");
+		return false;
+	}
+	/* the hung submits' fences and the kernel quads' as done, by the CPU and then by the CP */
+	*(volatile uint32_t *)g_fence_va = g_submit_seq;
+	flush_dcache64((addr64_t)g_fence_pa, 64, TRUE);
+	*(volatile uint32_t *)(g_scratch_va + 64) = g_seq;
+	flush_dcache64((addr64_t)g_scratch + 64, 4, TRUE);
+	emit(pkt7(CP_EVENT_WRITE, 4));
+	emit(CACHE_FLUSH_TS);
+	emit((uint32_t)g_fence_pa);
+	emit((uint32_t)(g_fence_pa >> 32));
+	emit(g_submit_seq);
+	(void)kick(gpu);
+	g_fence_seen = g_submit_seq;
+	g_fence_when = 0;
+	smmu_report();
+	g_ready = true;
+	printf("SWEET GPU: recovered (%s) in %llu ms: soft reset (RPTR %u, RBBM_STATUS %08x), CP restarted, zap resumed, "
+	    "secure mode left, fences done up to %u (recovery %u of %d)\n", why, usecs(mach_absolute_time() - t0) / 1000,
+	    rptr, st, g_submit_seq, g_recoveries, max);
+	return true;
+}
