+bool
+taimen_wcd_m4(void)
+{
+	struct pmg g0, g1;
+	int dmic = 0, gain = 4, err = 0;
+	bool rpm, pins, v11, off;
+	uint16_t micb, dctl;
+	unsigned micb_n, i, bad = 0, ncpr = 0;
+	uint8_t vol;
+
+	if (la_gen == LA_NONE || !chip_is_tavil()) {
+		LOG("4: no codec (M3)");
+		return false;
+	}
+	(void)PE_parse_boot_argn("taimenmicdmic", &dmic, sizeof(dmic));
+	(void)PE_parse_boot_argn("taimenmicgain", &gain, sizeof(gain));
+	if (dmic < 0 || dmic > 5) {
+		dmic = 0;
+	}
+	if (gain < -84) {
+		gain = -84;
+	} else if (gain > 40) {
+		gain = 40;
+	}
+	vol = (uint8_t)(int8_t)gain;            /* SOC_SINGLE_SX_TLV: dB as a signed byte */
+	micb = (uint16_t)(dmic < 2 ? R_MICB1 : dmic < 4 ? R_MICB3 : R_MICB4);
+	micb_n = dmic < 2 ? 1u : dmic < 4 ? 3u : 4u;
+	dctl = (uint16_t)(R_DMIC0_CTL + (unsigned)dmic / 2);
+	v11 = chip_id[0] == 0x01 && chip_id[1] == 0x00;
+
+	/* MCLK 9.6 MHz: RPM DIV_CLK1 (clka 0xb, swen) out of PM8998 GPIO13 (WH audio-ext-clk.c audio_pmi_clk) */
+	pmg_read(&g0);
+	gpio13_log("before", &g0);
+	rpm = sweet_rpm_xo_buffer(RPM_DIV_CLK1);
+	pins = g0.ok && gpio13_mclk(&g0);
+	pmg_read(&g1);
+	gpio13_log("after", &g1);
+	LOG("4: DIV_CLK1 (clka 0xb) on: %s; pm8998 gpio13 mode %#x src %#x en %#x%s", rpm ? "ok" : "NOT acked", g1.mode,
+	    g1.src, g1.en, pins ? "" : " (GPIO13 NOT configured)");
+
+	n_expect = 0;
+	n_cdc_err = 0;
+	n_cdc_writes = 0;
+	n_cdc_same = 0;
+	tracking = true;
+	/* once (WH tavil_probe, tavil_codec_probe): the MCLK rate, the defaults */
+	err = cdc_update(R_RPM_CLK_MCLK_CFG, 0x03, 0x01);                       /* 9.6 MHz */
+	err = err != 0 ? err : cdc_table(tavil_defaults, NELEM(tavil_defaults));
+	/* the codec's clock (WH __tavil_cdc_mclk_enable: SVS vote, master bias, MCLK; ANA_CLK_TOP is Tasha's) */
+	err = err != 0 ? err : cdc_update(R_PSTATE_CTL_0, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x80, 0x80);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x40, 0x40);
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x40, 0x00);
+	err = err != 0 ? err : cdc_update(R_ANA_BIAS, 0x20, 0x00);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x80, 0x80);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x30, 0x00);     /* no divider at 9.6 MHz */
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x02, 0x00);
+	err = err != 0 ? err : cdc_update(R_CLK_SYS_MCLK_PRG, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_FS_CNT_CONTROL, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_MCLK_CONTROL, 0x01, 0x01);
+	err = err != 0 ? err : cdc_update(R_RPM_CLK_GATE, 0x03, 0x00);
+	delay(10);
+	LOG("4: clock: ANA_BIAS %#x MCLK_PRG %#x MCLK_CONTROL %#x%s", cdc_get(R_ANA_BIAS), cdc_get(R_CLK_SYS_MCLK_PRG),
+	    cdc_get(R_MCLK_CONTROL), err != 0 ? " (an access FAILED)" : "");
+	/* CPR with the MCLK on (WH tavil_update_cpr_defaults, v1.1 only) */
+	if (v11) {
+		err = err != 0 ? err : cdc_write(R_CPR_SVS2_MIN_CX_VDD, 0x2C);
+		err = err != 0 ? err : cdc_update(R_RPM_CLK_GATE, 0x10, 0x00);
+		for (i = 0; i < NELEM(tavil_cpr) && err == 0; i++) {
+			err = cdc_write32(R_CPR_WR_DATA_0, tavil_cpr[i][0]);
+			err = err != 0 ? err : cdc_write32(R_CPR_WR_ADDR_0, tavil_cpr[i][1]);
+			ncpr += err == 0;
+		}
+	}
+	/* WH tavil_codec_init_reg and tavil_handle_pdata: MIC BIAS 1.8 V, DMIC clock drive 2 mA, MAD rate */
+	err = err != 0 ? err : cdc_table(tavil_common, NELEM(tavil_common));
+	if (v11) {
+		err = err != 0 ? err : cdc_table(tavil_1_1, NELEM(tavil_1_1));
+	}
+	err = err != 0 ? err : cdc_update(R_MICB1, 0x3F, 0x10);
+	err = err != 0 ? err : cdc_update(R_MICB2, 0x3F, 0x10);
+	err = err != 0 ? err : cdc_update(R_MICB3, 0x3F, 0x10);
+	err = err != 0 ? err : cdc_update(R_MICB4, 0x3F, 0x10);
+	err = err != 0 ? err : cdc_update(R_PAD_DRVCTL_0, 0x0C, 0x00);
+	err = err != 0 ? err : cdc_update(R_DMIC0_CTL, 0x0E, 5u << 1);         /* /16: 600 kHz */
+	err = err != 0 ? err : cdc_update(R_DMIC0_CTL + 1, 0x0E, 5u << 1);
+	err = err != 0 ? err : cdc_update(R_DMIC0_CTL + 2, 0x0E, 5u << 1);
+	LOG("4: defaults %u+%u+%u, CPR %u: %s (%u writes, %u already set)", NELEM(tavil_defaults), NELEM(tavil_common),
+	    v11 ? NELEM(tavil_1_1) : 0u, ncpr, err == 0 ? "ok" : "FAILED", n_cdc_writes, n_cdc_same);
+
+	/* the TX path, muted (the mixer path dmic1 and handset-mic; WH tavil_dec_enum_put, the DMIC and DEC7
+	 * widgets, hw_params at 48 kHz) */
+	err = err != 0 ? err : cdc_update(R_ADC_MUX3_CFG1, 0x0C, 0x00);          /* ADC MUX7 = DMIC */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CFG0, 0x80, 0x80);          /* ... and DEC7's DMIC select */
+	err = err != 0 ? err : cdc_update(R_ADC_MUX7_CFG0, 0x38, (uint8_t)((dmic + 1) << 3));
+	err = err != 0 ? err : cdc_update(R_IF_ROUTER_TX_MUX_CFG1, 0xC0, 0x80);  /* CDC_IF TX7 MUX = DEC7 */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x0F, 0x04);           /* 48 kHz */
+	err = err != 0 ? err : cdc_update(micb, 0xC0, 0x40);                     /* MIC BIAS on */
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_update(dctl, 0x0E, 2u << 1);                  /* /4: 2.4 MHz */
+	err = err != 0 ? err : cdc_update(dctl, 0x01, 0x01);                     /* the DMIC clock */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x10, 0x10);           /* mute */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CTL, 0x20, 0x20);           /* DEC7 clock */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_CFG0, 0x60, 2u << 5);       /* HPF 150 Hz */
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_SEC2, 0x02, 0x02);
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_update(R_TX7_PATH_SEC2, 0x02, 0x00);
+	err = err != 0 ? err : cdc_write(R_TX7_VOL_CTL, vol);
+	tracking = false;
+	LOG("4: TX7: DMIC%d -> DEC7 -> TX7, MICB%u %#x, DMIC%u_CTL %#x, TX7 CTL %#x CFG0 %#x VOL %#x%s", dmic, micb_n,
+	    cdc_get(micb), (unsigned)dmic / 2, cdc_get(dctl), cdc_get(R_TX7_PATH_CTL), cdc_get(R_TX7_PATH_CFG0),
+	    cdc_get(R_TX7_VOL_CTL), err != 0 ? " (an access FAILED)" : "");
+	if (err != 0) {
+		LOG("4: register %#06x FAILED (%d), %u failures: the rest of the sequence was skipped", first_bad_reg,
+		    first_bad_err, n_cdc_err);
+	}
+	for (i = 0; i < n_expect; i++) {
+		uint8_t v = 0xEE;
+		int e = cdc_read_hw(expect[i].reg, &v, 1);
+		if (e != 0 || (v & expect[i].mask) != expect[i].val) {
+			if (bad++ < 16) {
+				LOG("4: %#06x read %#x%s, written %#x under mask %#x", expect[i].reg, v, e != 0 ? " (FAILED)" : "",
+				    expect[i].val, expect[i].mask);
+			}
+		}
+	}
+	if (err == 0 && bad == 0) {
+		LOG("4: M4 %u registers read back as written", n_expect);
+	} else {
+		LOG("4: M4 NOT reached: %u of %u registers did not read back as written", bad, n_expect);
+	}
+
+	/* down (WH: the DEC7 and DMIC widgets, MIC BIAS, MCLK and master bias off, the SVS vote, the ext clock) */
+	(void)cdc_update(R_TX7_PATH_CTL, 0x10, 0x10);
+	(void)cdc_update(R_TX7_PATH_CTL, 0x20, 0x00);
+	(void)cdc_update(dctl, 0x01, 0x00);
+	(void)cdc_update(dctl, 0x0E, 5u << 1);
+	(void)cdc_update(micb, 0xC0, 0x00);
+	(void)cdc_update(R_CLK_SYS_MCLK_PRG, 0x81, 0x00);
+	(void)cdc_update(R_ANA_BIAS, 0xA0, 0x00);
+	(void)cdc_update(R_PSTATE_CTL_0, 0x01, 0x00);
+	off = sweet_rpm_kv_both("clka div_clk1 off", RPM_CLKA, RPM_DIV_CLK1, RPM_SWEN, 0);
+	LOG("4: down: TX7 CTL %#x, DMIC%u_CTL %#x, MICB%u %#x, MCLK_PRG %#x, ANA_BIAS %#x, PSTATE %#x; DIV_CLK1 off: %s",
+	    cdc_get(R_TX7_PATH_CTL), (unsigned)dmic / 2, cdc_get(dctl), micb_n, cdc_get(micb), cdc_get(R_CLK_SYS_MCLK_PRG),
+	    cdc_get(R_ANA_BIAS), cdc_get(R_PSTATE_CTL_0), off ? "ok" : "NOT acked");
+	return err == 0 && bad == 0;
+}
 #endif /* ARM64_BOARD_CONFIG_TAIMEN */
