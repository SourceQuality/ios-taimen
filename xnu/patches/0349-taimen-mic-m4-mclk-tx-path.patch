+#define R_MCLK_CONTROL          0x0D41u         /* CDC_CLK_RST_CTRL_MCLK_CONTROL */
+#define R_FS_CNT_CONTROL        0x0D42u         /* CDC_CLK_RST_CTRL_FS_CNT_CONTROL */
