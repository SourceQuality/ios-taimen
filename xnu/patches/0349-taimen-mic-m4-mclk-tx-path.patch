+#define R_DMIC0_CTL             0x0218u         /* CPE_SS_DMIC0_CTL; DMIC1_CTL, DMIC2_CTL follow */
+#define R_ANA_BIAS              0x0601u
+#define R_MICB1                 0x0622u
