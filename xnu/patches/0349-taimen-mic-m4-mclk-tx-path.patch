 	if (err == 0) {
 		n_cdc_writes++;
 		shadow_set(reg, v);
+		if (tracking) {
+			expect_set(reg, 0xFF, v);
+		}
+	}
+	return err;
+}
+
+/* regmap_update_bits: read (once), change the bits, write if they changed */
+static int
+cdc_update(uint16_t reg, uint8_t mask, uint8_t v)
+{
+	int i = shadow_find(reg), err;
+	uint8_t cur = 0, nv;
+	if (i >= 0) {
+		cur = shadow[i].val;
+	} else {
+		err = cdc_read_hw(reg, &cur, 1);
+		if (err != 0) {
+			return err;
+		}
+		shadow_set(reg, cur);
+	}
+	nv = (uint8_t)((cur & ~mask) | (v & mask));
+	if (tracking) {
+		expect_set(reg, mask, v);
+	}
+	if (nv == cur) {
+		n_cdc_same++;
+		return 0;
+	}
+	err = cdc_write_n(reg, &nv, 1);
+	if (err == 0) {
+		n_cdc_writes++;
+		shadow_set(reg, nv);
 	}
 	return err;
 }
@@ -367,4 +431,322 @@ taimen_wcd_m3(void)
