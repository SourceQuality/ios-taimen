+static void
+expect_set(uint16_t reg, uint8_t mask, uint8_t v)
+{
+	unsigned i;
+	for (i = 0; i < n_expect; i++) {
+		if (expect[i].reg == reg) {
+			break;
+		}
+	}
+	if (i == n_expect) {
+		if (n_expect == EXPECT_N) {
+			return;
+		}
+		expect[i].reg = reg;
+		expect[i].mask = 0;
+		expect[i].val = 0;
+		n_expect++;
+	}
+	expect[i].mask = (uint8_t)(expect[i].mask | mask);
+	expect[i].val = (uint8_t)((expect[i].val & ~mask) | (v & mask));
+}
