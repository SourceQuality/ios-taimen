+/* M2: modem_a's image/ (mba.mbn, modem.mdt and its segments) and the EFS partitions, read only. */
+static struct fat modem_fs;
+static uint8_t m2_buf[0x1000];
+
+static bool
+m2(void)
+{
+	struct fat *f = &modem_fs;
+	if (!fat_mount(f, "modem_a")) {
+		LOG("M2: modem_a: not found or not FAT");
+		return false;
+	}
+	LOG("M2: modem_a on LUN %u at block %#llx, %llu MiB: FAT%d, %u-byte clusters, %u FATs of %u sectors",
+	    f->p.lun, f->p.first, f->p.nblocks * 4096 >> 20, f->bits, f->cluster_bytes, f->nfats, f->fatsz);
+	struct fat_file img = {}, mba = {}, mdt = {};
+	if (!fat_lookup(f, NULL, "image", &img) || !img.dir) {
+		LOG("M2: modem_a has no image/ directory");
+		return false;
+	}
+	char line[192];
+	int n = 0, files = 0, r;
+	uint8_t e[32];
+	for (uint32_t i = 0; (r = fat_dir_entry(f, &img, i, e)) >= 0; i++) {
+		if (r != 1 || e[0] == '.') {
+			continue;
+		}
+		char nm[13];
+		int k = 0;
+		for (int c = 0; c < 8 && e[c] != ' '; c++) {
+			nm[k++] = (char)e[c];
+		}
+		if (e[8] != ' ') {
+			nm[k++] = '.';
+			for (int c = 8; c < 11 && e[c] != ' '; c++) {
+				nm[k++] = (char)e[c];
+			}
+		}
+		nm[k] = 0;
+		files++;
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %s", nm);
+		if (n > 150) {
+			LOG("M2:   image/:%s", line);
+			n = 0;
+		}
+	}
+	if (n > 0) {
+		LOG("M2:   image/:%s", line);
+	}
+	bool have_mba = fat_lookup(f, &img, "mba.mbn", &mba);
+	bool have_mdt = fat_lookup(f, &img, "modem.mdt", &mdt);
+	unsigned phnum = 0, loads = 0;
+	uint64_t load_bytes = 0;
+	if (have_mdt && fat_read(f, &mdt, 0, m2_buf, MIN(mdt.size, (uint32_t)sizeof(m2_buf))) == 0 &&
+	    memcmp(m2_buf, "\x7f" "ELF", 4) == 0) {
+		const struct elf32_ehdr *eh = (const struct elf32_ehdr *)m2_buf;
+		phnum = eh->e_phnum;
+		for (unsigned i = 0; i < phnum && eh->e_phoff + (i + 1) * sizeof(struct elf32_phdr) <= sizeof(m2_buf); i++) {
+			const struct elf32_phdr *ph = (const struct elf32_phdr *)(m2_buf + eh->e_phoff) + i;
+			if (ph->p_type == PT_LOAD && ph->p_filesz != 0 && (ph->p_flags & MDT_TYPE_MASK) != MDT_TYPE_HASH) {
+				loads++;
+				load_bytes += ph->p_filesz;
+			}
+		}
+	}
+	uint8_t mh[4] = {};
+	if (have_mba) {
+		(void)fat_read(f, &mba, 0, mh, sizeof(mh));
+	}
+	LOG("M2: %d files in image/; mba.mbn %s (%u bytes, %s), modem.mdt %s (%u bytes): %u program headers, %u "
+	    "loadable segments, %llu KiB", files, have_mba ? "found" : "MISSING", mba.size,
+	    memcmp(mh, "\x7f" "ELF", 4) == 0 ? "ELF" : "not ELF", have_mdt ? "found" : "MISSING", mdt.size, phnum,
+	    loads, load_bytes >> 10);
+	static const char *const efs[] = {"modemst1", "modemst2", "fsg", "fsc"};
+	unsigned efs_ok = 0;
+	for (unsigned i = 0; i < sizeof(efs) / sizeof(efs[0]); i++) {
+		struct part p;
+		if (!part_open(efs[i], &p) || part_read(&p, 0, m2_buf, 512) != 0) {
+			LOG("M2: %s: not found or unreadable", efs[i]);
+			continue;
+		}
+		unsigned nz = 0;
+		for (unsigned b = 0; b < 512; b++) {
+			nz += m2_buf[b] != 0;
+		}
+		efs_ok++;
+		LOG("M2: %s on LUN %u at block %#llx, %llu KiB; first 512 bytes: %u non-zero", efs[i], p.lun, p.first,
+		    p.nblocks * 4, nz);
+	}
+	return have_mba && have_mdt && loads > 0 && efs_ok == 4;
+}
