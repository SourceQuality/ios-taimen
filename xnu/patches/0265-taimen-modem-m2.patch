+static int
+ufs_find_partition(const char *want)
+{
+	uint64_t first = 0, n = 0;
+	int error = ufs_gpt_lookup(want, &first, &n);
+	if (error == ENXIO) {
+		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+	} else if (error == ENOENT) {
+		printf("SWEET UFS: no GPT partition named \"%s\"\n", want);
+	}
+	if (error == 0) {
+		su.first_block = first;
+		su.nblocks = n;
+	}
+	return error;
+}
+
+/*
+ * Read-only access to any GPT partition on LUNs 0-5 (xnu 0265, TaimenModem: modem_a and the EFS
+ * partitions, docs/taimen-wifi-plan.md stage 4). Under the driver lock, su.lun switched for these
+ * commands and put back; the root partition's state is not touched. Each LUN's first command is
+ * tried twice (a unit attention after the switch).
+ */
+int sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks);
+int sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst, uint32_t len);
+
+int
+sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks)
+{
+	int error = ENODEV;
+	if (!su.ready) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t root = su.lun;
+	for (uint8_t l = 0; l < 6; l++) {
+		su.lun = l;
+		error = ufs_gpt_lookup(name, first, nblocks);
+		if (error != 0 && error != ENXIO && error != ENOENT) {
+			error = ufs_gpt_lookup(name, first, nblocks);
+		}
+		if (error == 0) {
+			*lun = l;
+			break;
+		}
+	}
+	su.lun = root;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error == 0 ? 0 : ENOENT;
+}
+
+int
+sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst, uint32_t len)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = 0;
+	if (!su.ready || lun > 5 || off > nblocks * UFS_BLOCK || len > nblocks * UFS_BLOCK - off) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t root = su.lun;
+	su.lun = lun;
+	for (uint32_t done = 0; done < len && error == 0;) {
+		uint64_t pos = off + done;
+		uint64_t blk = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t nblk = (uint32_t)MIN((uint64_t)(BOUNCE_SIZE / UFS_BLOCK), (skip + (len - done) + UFS_BLOCK - 1) / UFS_BLOCK);
+		error = ufs_read_blocks(first + blk, nblk);
+		if (error) {
+			error = ufs_read_blocks(first + blk, nblk);
+		}
+		if (error == 0) {
+			uint32_t chunk = MIN(nblk * UFS_BLOCK - skip, len - done);
+			memcpy((uint8_t *)dst + done, b + skip, chunk);
+			done += chunk;
+		}
+	}
+	su.lun = root;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
