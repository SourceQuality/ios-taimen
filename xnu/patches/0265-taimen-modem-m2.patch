+/* ---------------------------------------------------------------- UFS partitions and FAT */
+
+/*
+ * M2 (0265): the firmware the modem boots from. modem_a is VFAT (Android mounts it at /firmware):
+ * mba.mbn and modem.mdt + modem.bNN in image/; the EFS partitions (modemst1, modemst2, fsg, fsc)
+ * are raw. Read through sweet_ufs.c's read-only partition API (any LUN), the FAT here: FAT16/32,
+ * 8.3 names (the firmware names fit, VFAT keeps a short entry next to each long one), one FAT
+ * block cached.
+ */
+extern "C" int sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks);
+extern "C" int sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst,
+    uint32_t len);
+
+struct part {
+	uint8_t lun;
+	uint64_t first, nblocks;
+};
+
+static bool
+part_open(const char *name, struct part *p)
+{
+	return sweet_ufs_part_find(name, &p->lun, &p->first, &p->nblocks) == 0;
+}
+
+static int
+part_read(const struct part *p, uint64_t off, void *dst, uint32_t len)
+{
+	return sweet_ufs_part_read(p->lun, p->first, p->nblocks, off, dst, len);
+}
+
+struct fat {
+	struct part p;
+	uint32_t bps, spc, rsvd, nfats, fatsz, root_ents, root_clus, cluster_bytes;
+	uint64_t fat_off, root_off, data_off;
+	int bits;                               /* 16 or 32 */
+	uint8_t cache[4096];
+	uint64_t cache_off;                     /* ~0: empty */
+};
+
+struct fat_file {
+	uint32_t clus, size;
+	bool dir;
+};
+
+#define FAT_EOC(f, c)   ((f)->bits == 16 ? (c) >= 0xFFF8u : (c) >= 0x0FFFFFF8u)
+
+static bool
+fat_mount(struct fat *f, const char *name)
+{
+	uint8_t bs[512];
+	if (!part_open(name, &f->p) || part_read(&f->p, 0, bs, sizeof(bs)) != 0 || bs[510] != 0x55 || bs[511] != 0xAA) {
+		return false;
+	}
+	f->bps = bs[11] | bs[12] << 8;
+	f->spc = bs[13];
+	f->rsvd = bs[14] | bs[15] << 8;
+	f->nfats = bs[16];
+	f->root_ents = bs[17] | bs[18] << 8;
+	uint32_t fatsz16 = bs[22] | bs[23] << 8;
+	uint32_t fatsz32 = bs[36] | bs[37] << 8 | bs[38] << 16 | (uint32_t)bs[39] << 24;
+	f->fatsz = fatsz16 != 0 ? fatsz16 : fatsz32;
+	f->bits = f->root_ents != 0 ? 16 : 32;  /* FAT12 does not hold a modem image */
+	f->root_clus = bs[44] | bs[45] << 8 | bs[46] << 16 | (uint32_t)bs[47] << 24;
+	if (f->bps == 0 || f->spc == 0 || f->nfats == 0 || f->fatsz == 0) {
+		return false;
+	}
+	f->cluster_bytes = f->bps * f->spc;
+	f->fat_off = (uint64_t)f->rsvd * f->bps;
+	f->root_off = f->fat_off + (uint64_t)f->nfats * f->fatsz * f->bps;
+	f->data_off = f->root_off + (((uint64_t)f->root_ents * 32 + f->bps - 1) / f->bps) * f->bps;
+	f->cache_off = ~0ull;
+	return true;
+}
+
+static uint32_t
+fat_next(struct fat *f, uint32_t clus)
+{
+	uint64_t off = f->fat_off + (uint64_t)clus * (f->bits / 8);
+	uint64_t blk = off & ~(uint64_t)(sizeof(f->cache) - 1);
+	if (f->cache_off != blk) {
+		if (part_read(&f->p, blk, f->cache, sizeof(f->cache)) != 0) {
+			return 0x0FFFFFFFu;
+		}
+		f->cache_off = blk;
+	}
+	const uint8_t *e = f->cache + (off - blk);
+	return f->bits == 16 ? (uint32_t)(e[0] | e[1] << 8) :
+	       (e[0] | e[1] << 8 | e[2] << 16 | (uint32_t)e[3] << 24) & 0x0FFFFFFFu;
+}
+
+/* Bytes [off, off + len) of a file or directory (clus 0 with bits 16: the fixed root). */
+static int
+fat_read(struct fat *f, const struct fat_file *ff, uint64_t off, void *dst, uint32_t len)
+{
+	if (ff->clus == 0 && f->bits == 16) {
+		return part_read(&f->p, f->root_off + off, dst, len);
+	}
+	uint32_t clus = ff->clus;
+	for (uint64_t skip = off / f->cluster_bytes; skip > 0; skip--) {
+		clus = fat_next(f, clus);
+		if (clus < 2 || FAT_EOC(f, clus)) {
+			return EIO;
+		}
+	}
+	uint32_t done = 0, in = (uint32_t)(off % f->cluster_bytes);
+	while (done < len) {
+		if (clus < 2 || FAT_EOC(f, clus)) {
+			return EIO;
+		}
+		uint32_t n = MIN(f->cluster_bytes - in, len - done);
+		int err = part_read(&f->p, f->data_off + (uint64_t)(clus - 2) * f->cluster_bytes + in,
+		    (uint8_t *)dst + done, n);
+		if (err != 0) {
+			return err;
+		}
+		done += n;
+		in = 0;
+		if (done < len) {
+			clus = fat_next(f, clus);
+		}
+	}
+	return 0;
+}
+
+static void
+fat_83(const char *name, char out[11])
+{
+	memset(out, ' ', 11);
+	const char *dot = strchr(name, '.');
+	for (int i = 0; i < 8 && name[i] != 0 && &name[i] != dot; i++) {
+		out[i] = (char)(name[i] >= 'a' && name[i] <= 'z' ? name[i] - 32 : name[i]);
+	}
+	for (int i = 0; dot != NULL && i < 3 && dot[1 + i] != 0; i++) {
+		char c = dot[1 + i];
+		out[8 + i] = (char)(c >= 'a' && c <= 'z' ? c - 32 : c);
+	}
+}
+
+/*
+ * Entry idx of a directory (dir NULL: the root) into e: 1 a live short entry, 0 one to skip
+ * (deleted, long-name part, volume label), -1 the end.
+ */
+static int
+fat_dir_entry(struct fat *f, const struct fat_file *dir, uint32_t idx, uint8_t e[32])
+{
+	struct fat_file root = { f->bits == 16 ? 0 : f->root_clus, f->bits == 16 ? f->root_ents * 32u : 0, true };
+	const struct fat_file *d = dir != NULL ? dir : &root;
+	uint64_t off = (uint64_t)idx * 32;
+	if (off >= (d->size != 0 ? d->size : 0x100000u) || fat_read(f, d, off, e, 32) != 0 || e[0] == 0) {
+		return -1;
+	}
+	return e[0] == 0xE5 || (e[11] & 0x0F) == 0x0F || (e[11] & 0x08) ? 0 : 1;
+}
+
+static void
+fat_entry_file(const struct fat *f, const uint8_t *e, struct fat_file *out)
+{
+	out->clus = (uint32_t)(e[26] | e[27] << 8) | (f->bits == 32 ? (uint32_t)(e[20] | e[21] << 8) << 16 : 0);
+	out->size = e[28] | e[29] << 8 | e[30] << 16 | (uint32_t)e[31] << 24;
+	out->dir = (e[11] & 0x10) != 0;
+}
+
+static bool
+fat_lookup(struct fat *f, const struct fat_file *dir, const char *name, struct fat_file *out)
+{
+	char want[11];
+	uint8_t e[32];
+	int r;
+	fat_83(name, want);
+	for (uint32_t i = 0; (r = fat_dir_entry(f, dir, i, e)) >= 0; i++) {
+		if (r == 1 && memcmp(e, want, 11) == 0) {
+			fat_entry_file(f, e, out);
+			return true;
+		}
+	}
+	return false;
+}
+
