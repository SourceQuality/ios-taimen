diff --git a/osfmk/vm/vm_compressor.c b/osfmk/vm/vm_compressor.c
index 1e7ca07..7e4c229 100644
--- a/osfmk/vm/vm_compressor.c
+++ b/osfmk/vm/vm_compressor.c
@@ -868,6 +868,17 @@ vm_compressor_set_size(void)
 		compressor_pool_size = max_mem;
 	}
 	compressor_pool_multiplier = 1;
+#endif
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	/*
+	 * The 4 KiB kernel's compact layout leaves ~45 GiB of kernel VA after the physmap for every
+	 * kmem claim. The macOS pool (16 x max_mem) next to the 24 GiB zone map overflows it above
+	 * 1 GiB of RAM: kmem_range_init panicked at 1.5 GiB (boot 92: 24 GiB of compressor) and at
+	 * 2 GiB (boot 63). With no swap file the pool never holds more than RAM: 4 x max_mem.
+	 */
+	if (vm_compression_limit == 0) {
+		compressor_pool_size = 4ULL * max_mem;
+	}
 #endif
 	if (compressor_pool_size > compressor_pool_max_size) {
 		compressor_pool_size = compressor_pool_max_size;
