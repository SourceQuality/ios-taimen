+	orr		x11, x11, x12, lsl #2
+	adrp	x9, EXT(taimen_smp_crumbs)@page
+	add		x9, x9, EXT(taimen_smp_crumbs)@pageoff
+	add		x9, x9, x11, lsl #6
+	str		x10, [x9, #8]
+	mrs		x12, CurrentEL
+	str		x12, [x9, #16]
+	mrs		x12, SCTLR_EL1
+	str		x12, [x9, #24]
+	str		x0, [x9, #32]
+	mov		x13, #1
+	str		x13, [x9]
