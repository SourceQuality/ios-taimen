+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Taimen SMP bring-up (0219, docs/taimen-smp-plan.md). From XNU, PSCI SYSTEM_RESET came back
+ * with x0 unchanged (boots 14-15) although the shim's identical call worked, and the phone's
+ * Linux starts all 8 cores with CPU_ON over smc. So: probe PSCI in three contexts, CPU_ON in
+ * the first that answers, and follow the new core through breadcrumbs it writes from its
+ * first instruction on (start.s sweet_secondary_entry 0x01, arm_init_cpu 0x05/0x07/0x09,
+ * initCPU 0x0A).
+ */
+extern "C" {
+uint64_t taimen_smp_crumbs[8][8] __attribute__((aligned(64)));
+void taimen_smp_mark(uint64_t stage, uint64_t a, uint64_t b);
+}
+
+static unsigned
+taimen_crumb_slot(uint64_t mpidr)
+{
+	return (unsigned)((((mpidr >> 8) & 1) << 2) | (mpidr & 3));
+}
+
+/* Secondary, MMU on. Line: stage, MPIDR, a, b, -, -, CNTVCT. */
+void
+taimen_smp_mark(uint64_t stage, uint64_t a, uint64_t b)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	volatile uint64_t *c = taimen_smp_crumbs[taimen_crumb_slot(mpidr)];
+	c[1] = mpidr;
+	c[2] = a;
+	c[3] = b;
+	c[6] = __builtin_arm_rsr64("CNTVCT_EL0");
+	__builtin_arm_dmb(DMB_ISH);
+	c[0] = stage;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+/* CPU0 before CPU_ON, and when polling: the core's MMU-off writes go straight to memory. */
+static void
+taimen_crumb_clear(uint64_t mpidr)
+{
+	volatile uint64_t *c = taimen_smp_crumbs[taimen_crumb_slot(mpidr)];
+	for (int i = 0; i < 8; i++) {
+		c[i] = 0;
+	}
+	__asm__ volatile ("dc civac, %0" : : "r"(c) : "memory");
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+taimen_crumb_read(uint64_t mpidr, uint64_t out[8])
+{
+	volatile uint64_t *c = taimen_smp_crumbs[taimen_crumb_slot(mpidr)];
+	__asm__ volatile ("dc civac, %0" : : "r"(c) : "memory");
+	__builtin_arm_dsb(DSB_SY);
+	for (int i = 0; i < 8; i++) {
+		out[i] = c[i];
+	}
+}
+
+enum { TPSCI_THREAD, TPSCI_NOIRQ, TPSCI_NOIRQ_PMR0, TPSCI_N };
+static const char *const taimen_psci_ctx_name[TPSCI_N] = {"thread", "irq off", "irq off, pmr 0"};
+static int taimen_psci_ctx = -1;        /* the first context PSCI_VERSION answered in */
+
+static uint64_t
+taimen_psci(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3, bool hvc, int ctx)
+{
+	boolean_t istate = TRUE;
+	uint64_t pmr = 0;
+	if (ctx != TPSCI_THREAD) {
+		istate = ml_set_interrupts_enabled(FALSE);
+	}
+	if (ctx == TPSCI_NOIRQ_PMR0) {          /* no NS Group 1 interrupt is signalled */
+		pmr = __builtin_arm_rsr64("ICC_PMR_EL1");
+		__builtin_arm_wsr64("ICC_PMR_EL1", 0);
+		__builtin_arm_isb(ISB_SY);
+	}
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	if (hvc) {
+		__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	} else {
+		__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+		    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+		    "x14", "x15", "x16", "x17", "cc", "memory");
+	}
+	uint64_t r = x0;
+	if (ctx == TPSCI_NOIRQ_PMR0) {
+		__builtin_arm_wsr64("ICC_PMR_EL1", pmr);
+		__builtin_arm_isb(ISB_SY);
+	}
+	if (ctx != TPSCI_THREAD) {
+		(void)ml_set_interrupts_enabled(istate);
+	}
+	return r;
+}
+
+static const char *
+taimen_psci_err(int32_t rc)
+{
+	switch (rc) {
+	case 0: return "SUCCESS";
+	case -1: return "NOT_SUPPORTED";
+	case -2: return "INVALID_PARAMETERS";
+	case -3: return "DENIED";
+	case -4: return "ALREADY_ON";
+	case -5: return "ON_PENDING";
+	case -6: return "INTERNAL_FAILURE";
+	case -9: return "INVALID_ADDRESS";
+	default: return "?";
+	}
+}
+
+static void
+taimen_psci_probe(void)
+{
+	static const uint32_t aff[8] = {0x0, 0x1, 0x2, 0x3, 0x100, 0x101, 0x102, 0x103};
+	for (int ctx = 0; ctx < TPSCI_N; ctx++) {
+		const char *n = taimen_psci_ctx_name[ctx];
+		uint64_t v = taimen_psci(0x84000000ULL, 0, 0, 0, false, ctx);
+		IOLog("TAIMEN PSCI [%s] VERSION -> %#llx%s\n", n, v, v == 0x84000000ULL ? " UNCHANGED" : "");
+		uint64_t f1 = taimen_psci(0x8400000AULL, 0xC4000003ULL, 0, 0, false, ctx);
+		uint64_t f2 = taimen_psci(0x8400000AULL, 0xC4000004ULL, 0, 0, false, ctx);
+		uint64_t f3 = taimen_psci(0x8400000AULL, 0x84000009ULL, 0, 0, false, ctx);
+		IOLog("TAIMEN PSCI [%s] FEATURES CPU_ON %#llx AFFINITY_INFO %#llx SYSTEM_RESET %#llx\n", n, f1, f2, f3);
+		char line[128];
+		int len = 0;
+		for (int i = 0; i < 8 && len < (int)sizeof(line); i++) {
+			int32_t r = (int32_t)taimen_psci(0xC4000004ULL, aff[i], 0, 0, false, ctx);
+			len += snprintf(line + len, sizeof(line) - (size_t)len, " %x:%d", aff[i], r);
+		}
+		IOLog("TAIMEN PSCI [%s] AFFINITY_INFO%s (0 on, 1 off, 2 pending)\n", n, line);
+		if (taimen_psci_ctx < 0 && v >= 0x10000ULL && v < 0x80000000ULL) {
+			taimen_psci_ctx = ctx;
+		}
+	}
+	uint64_t h = taimen_psci(0x84000000ULL, 0, 0, 0, true, TPSCI_THREAD);
+	IOLog("TAIMEN PSCI [thread, hvc] VERSION -> %#llx%s\n", h, h == 0x84000000ULL ? " UNCHANGED" : "");
+	IOLog("TAIMEN PSCI: CPU_ON goes in context %s\n", taimen_psci_ctx >= 0 ? taimen_psci_ctx_name[taimen_psci_ctx] : "none");
+}
+#endif
