--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -289,6 +289,27 @@ LEXT(bootstrap_instructions)
 	.globl EXT(sweet_secondary_entry)
 LEXT(sweet_secondary_entry)
 	msr		DAIFSet, #0xf
+#if defined(TAIMEN)
+	/* 0219 breadcrumb 0x01, MMU off: this core runs our code. One 64-byte line per core in
+	 * taimen_smp_crumbs (SweetCPU.cpp), slot Aff1 * 4 + Aff0: stage, MPIDR, CurrentEL,
+	 * SCTLR_EL1, x0. adrp gives the physical address while the MMU is off. */
