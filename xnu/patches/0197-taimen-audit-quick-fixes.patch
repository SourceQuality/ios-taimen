+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * PSCI SYSTEM_RESET (0x84000009, smc conduit per the Linux DTS; proven by the
+ * granule probe). Without a hook, reboot and panic-restart spin until the
+ * APSS watchdog bites ~32 s later.
+ */
+static int
+taimen_halt_restart(unsigned int type __unused)
+{
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("dsb sy; smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : : "memory");
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
+	return 0;
+}
+#endif
+
