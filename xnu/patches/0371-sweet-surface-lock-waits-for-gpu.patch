diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index cdf1a8c..68be6e9 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -1104,6 +1104,33 @@ extern "C" boolean_t pmap_valid_page(ppnum_t pn);
  * gallery drew once and then showed black cards: PosterBoard encodes its snapshot ("Creating
  * snapshot from IOSurface") from the surface AegirPoster's Metal rendering wrote.
  */
+/*
+ * 0371: the lock first waits for the last GPU submit that listed the surface, as IOSurfaceLock waits
+ * for the GPU on Apple's. Invalidating while that submit still ran let the CPU fetch the old bytes
+ * and keep them over what the GPU wrote next: the poster gallery's card was drawn on the first visit
+ * (the live scene) and black on every later one (the whole card, its clock too: PosterBoard's
+ * snapshot, which backboardd renders into a surface and PosterBoard locks and reads at once).
+ */
+extern "C" int sweet_gpu_wait(uint32_t seqno, uint32_t timeout_ms);
+
+static void
+sweet_surface_gpu_done(SweetSurface *s)
+{
+	static unsigned logged;
+	uint32_t seq = __atomic_load_n(&s->gpuSeq, __ATOMIC_ACQUIRE);
+	uint64_t t0 = mach_absolute_time();
+	int e = sweet_gpu_wait(seq, 2000);
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if ((e != 0 || ns > 1000000) && logged < 16) {
+		logged++;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET SURF: %s's lock of surface %u (%ux%u) waited %llu ms for GPU submit %u%s\n", name, s->id,
+		    s->width, s->height, ns / 1000000, seq, e != 0 ? " and gave up" : "");
+	}
+}
+
 static void
 sweet_surface_invalidate(SweetSurface *s)
 {
@@ -1146,9 +1173,10 @@ IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOu
 	if (s == NULL) {
 		return kIOReturnNotFound;
 	}
-	uint32_t use = s->gpuUse;
+	uint32_t use = __atomic_load_n(&s->gpuUse, __ATOMIC_ACQUIRE);
 	if (use != s->gpuUseSeen) {
 		s->gpuUseSeen = use;
+		sweet_surface_gpu_done(s);
 		sweet_surface_invalidate(s);
 	}
 	IOReturn ret = sweet_surface_seed_out(s, seedOut, false);
