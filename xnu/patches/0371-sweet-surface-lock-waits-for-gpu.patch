diff --git a/iokit/Kernel/arm/SweetGPU.cpp b/iokit/Kernel/arm/SweetGPU.cpp
index 72ca03d..d344859 100644
--- a/iokit/Kernel/arm/SweetGPU.cpp
+++ b/iokit/Kernel/arm/SweetGPU.cpp
@@ -709,10 +709,6 @@ SweetGPUUserClient::submit(const void *in, size_t len, uint64_t *seqOut)
 		if (b == NULL) {
 			return kIOReturnBadArgument;
 		}
-		if (b->surface != NULL) {
-			/* 0358: the next CPU lock of the surface cleans and invalidates it (SweetSurface trapLock) */
-			OSIncrementAtomic((volatile SInt32 *)&b->surface->gpuUse);
-		}
 		/*
 		 * CPU-cached: its CPU writes to memory, no stale lines over GPU
 		 * writes. Only pages written since the last submit: flushing every
@@ -755,6 +751,15 @@ SweetGPUUserClient::submit(const void *in, size_t len, uint64_t *seqOut)
 		struct sweet_gpu_bo *b = bo(handles[i]);
 		b->last_seq = seq;
 		b->used = true;
+		if (b->surface != NULL) {
+			/*
+			 * 0358: the next CPU lock of the surface cleans and invalidates it; 0371: after waiting
+			 * for this submit (SweetSurface trapLock). The seqno is stored before the count moves,
+			 * so a lock that sees the count also sees the seqno.
+			 */
+			__atomic_store_n(&b->surface->gpuSeq, seq, __ATOMIC_RELEASE);
+			__atomic_fetch_add(&b->surface->gpuUse, 1, __ATOMIC_RELEASE);
