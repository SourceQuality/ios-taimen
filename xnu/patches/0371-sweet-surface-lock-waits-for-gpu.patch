 	bool                      readOnly;     /* ...from a read-only mapping: mapped read-only */
 	volatile uint32_t         gpuUse;       /* 0358: GPU submits that listed it (SweetGPU) */
 	uint32_t                  gpuUseSeen;   /* ...as of the last CPU lock's cache maintenance */
