diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b3764fe..b13498e 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -762,6 +762,8 @@ sweet_ufs_init(void)
 	sweet_gpu_init();
 	/* Wi-Fi through the modem DSP with taimenwifi=N (0263, docs/taimen-wifi-plan.md) */
 	taimen_modem_init();
