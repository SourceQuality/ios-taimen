diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 9c42e45..a9f325b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -9,8 +9,14 @@
  * in after `fastboot boot`. It never writes a register, and it touches the
  * DWC3 / PHY register blocks only when the GCC status registers say their
  * power domain and clocks are on (an access to a gated block would hang).
+ *
+ * taimen (MSM8998, 0297): the same DWC3 + QUSB2 v2 pair at other addresses (DT ssusb@a800000,
+ * qusb@c012000; QSCRATCH at core + 0xf8800 as on sweet), GCC offsets from the downstream
+ * msm-clocks-hwio-8998.h (USB30 master/sleep/mock-utmi 0x0f008/0x0f00c/0x0f010, cfg-noc 0x05018,
+ * aggre1 0x82024) and mainline gcc-msm8998.c (usb_30_gdsc 0xf004, ahb2phy 0x6a004). ABL's
+ * fastboot leaves it up in device mode here too.
  */
-#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(ARM64_BOARD_CONFIG_TAIMEN)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
@@ -44,10 +50,20 @@ extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 #define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
 #define CBCR_CLK_OFF            (1u << 31)
 
+/* order matters: [0] master, [3] cfg-noc-axi and [5] ahb2phy gate the register accesses below */
 static const struct {
 	const char *name;
 	uint32_t    off;
 } usb_cbcr[] = {
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	{ "master", 0x0f008 },
+	{ "sleep", 0x0f00c },
+	{ "utmi", 0x0f010 },
+	{ "cfg-noc-axi", 0x05018 },
+	{ "aggre-axi", 0x82024 },
+	{ "ahb2phy", 0x6a004 },
+	{ "clkref", 0x88008 },                  /* USB3_CLKREF_EN: an enable bit, not a CBCR */
+#else
 	{ "master", 0x0f010 },
 	{ "sleep", 0x0f014 },
 	{ "utmi", 0x0f018 },
@@ -55,11 +71,17 @@ static const struct {
 	{ "aggre-axi", 0x8201c },
 	{ "ahb2phy", 0x6a004 },
 	{ "clkref", 0x8c010 },
+#endif
 };
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#define DWC3_PA                 0x0a800000
+#define QUSB2_PA                0x0c012000
+#else
 #define DWC3_PA                 0x0a600000
-#define DWC3_SIZE               0x0000d000
 #define QUSB2_PA                0x088e2000
+#endif
+#define DWC3_SIZE               0x0000d000
 #define QUSB2_SIZE              0x00000400
 
 static uint32_t
@@ -164,7 +186,7 @@ sweet_usb_probe(void)
  * session; Linux dwc3-qcom forces that in software when the charger
  * reports a cable (dwc3_qcom_vbus_override_enable).
  */
-#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_PA             (DWC3_PA + 0xf8800)
 #define QSCRATCH_HS_PHY_CTRL    0x10
 #define   UTMI_OTG_VBUS_VALID   (1u << 20)
 #define   SW_SESSVLD_SEL        (1u << 28)
@@ -892,4 +914,4 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		thread_deallocate(thread);
 	}
 }
-#endif /* ARM64_BOARD_CONFIG_SWEET */
+#endif /* ARM64_BOARD_CONFIG_SWEET || ARM64_BOARD_CONFIG_TAIMEN */
