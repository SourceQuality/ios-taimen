+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * taimengpuheap=MB (default 0: off). Mesa's own buffers (bo new) come from
+ * the top of the upper DDR bank, above XNU's RAM (TAIMEN_MEM), mapped
+ * write-combined into the client: no cache maintenance or modified-bit
+ * tracking at submit or cpu prep. Boots 69-72: ~7 ms of kernel time per
+ * submit, mostly cleaning and write-protecting the pages Mesa wrote
+ * (FlushPoC_DcacheRegion, pmap_clear_modify). The pages are not managed by
+ * the VM, so a write-combined mapping leaves the physmap alone (managed
+ * pages froze boot 0150a). First fit over a byte map; a bo that does not
+ * fit gets wired kernel memory as before.
+ */
+#include <pexpert/pexpert.h>
+extern "C" unsigned long gPhysBase, gPhysSize;
+#define TAIMEN_HEAP_END 0x17e400000ULL  /* the upper bank's RAM ends at 0x17e4c0000 (Linux /proc/iomem) */
+static uint64_t gHeapBase;              /* 0: no heap */
+static uint32_t gHeapPages, gHeapRover;
+static uint8_t *gHeapMap;               /* a byte per page, 1: used */
+static IOLock *gHeapLock;
+
+static void
+heap_init(void)
+{
+	uint32_t mb = 0;
+	(void)PE_parse_boot_argn("taimengpuheap", &mb, sizeof(mb));
+	if (mb == 0) {
+		return;
+	}
+	uint64_t size = (uint64_t)mb << 20;
+	uint64_t base = (TAIMEN_HEAP_END - size) & ~((2ULL << 20) - 1);
+	if (mb > 1024 || base < (uint64_t)gPhysBase + gPhysSize) {
+		printf("SWEET GPU: heap of %u MB at 0x%llx overlaps XNU's RAM (to 0x%llx): off\n", mb, base,
+		    (uint64_t)gPhysBase + gPhysSize);
+		return;
+	}
+	gHeapPages = (uint32_t)((TAIMEN_HEAP_END - base) / PAGE_SIZE);
+	gHeapMap = (uint8_t *)IOMallocZeroData(gHeapPages);
+	gHeapLock = IOLockAlloc();
+	if (gHeapMap == NULL || gHeapLock == NULL) {
+		return;
+	}
+	gHeapBase = base;
+	printf("SWEET GPU: heap %u MB at 0x%llx, write-combined for the clients\n", mb, base);
+}
+
+/* First page of a free run of n heap pages, now used; or -1. */
+static int64_t
+heap_alloc(uint32_t n)
+{
+	if (gHeapBase == 0 || n == 0 || n > gHeapPages) {
+		return -1;
+	}
+	int64_t found = -1;
+	IOLockLock(gHeapLock);
+	for (int pass = 0; pass < 2 && found < 0; pass++) {
+		uint32_t start = pass ? 0 : gHeapRover, end = pass ? gHeapRover : gHeapPages, run = 0;
+		for (uint32_t p = start; p < end; p++) {
+			run = gHeapMap[p] ? 0 : run + 1;
+			if (run == n) {
+				found = p + 1 - n;
+				break;
+			}
+		}
+	}
+	if (found >= 0) {
+		memset(gHeapMap + found, 1, n);
+		gHeapRover = (uint32_t)found + n < gHeapPages ? (uint32_t)found + n : 0;
+	}
+	IOLockUnlock(gHeapLock);
+	return found;
+}
+
+static void
+heap_free(uint32_t first, uint32_t n)
+{
+	IOLockLock(gHeapLock);
+	memset(gHeapMap + first, 0, n);
+	IOLockUnlock(gHeapLock);
+}
+#endif
