+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Lock held. A new bo in heap pages [first, first + npages) (already marked
+ * used; freed here on failure), zeroed, write-combined for the client.
+ */
+IOReturn
+SweetGPUUserClient::boNewHeap(struct sweet_gpu_bo *b, uint32_t handle, uint64_t size, uint32_t first, uint64_t *out)
+{
+	uint32_t npages = (uint32_t)(size / PAGE_SIZE);
+	uint64_t pa0 = gHeapBase + (uint64_t)first * PAGE_SIZE;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa0, size, kIODirectionInOut);
+	IOMemoryMap *kmap = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	uint64_t *pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	uint64_t gva = 0;
+	IOMemoryMap *umap = NULL;
+	if (kmap != NULL && pa != NULL) {
+		/* plain stores: no DC ZVA on non-cacheable memory */
+		volatile uint64_t *z = (volatile uint64_t *)kmap->getVirtualAddress();
+		for (uint64_t i = 0; i < size / 8; i++) {
+			z[i] = 0;
+		}
+		__builtin_arm_dsb(0xf);
+		for (uint32_t p = 0; p < npages; p++) {
+			pa[p] = pa0 + (uint64_t)p * PAGE_SIZE;
+		}
+		gva = sweet_gpu_vm_map(pa, npages, false);
+		umap = gva ? md->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapWriteCombineCache) : NULL;
+	}
+	OSSafeReleaseNULL(kmap);
+	if (umap == NULL) {
+		if (gva) {
+			sweet_gpu_vm_unmap(gva);
+		}
+		if (pa != NULL) {
+			IOFreeData(pa, npages * sizeof(uint64_t));
+		}
+		OSSafeReleaseNULL(md);
+		heap_free(first, npages);
+		return kIOReturnNoMemory;
+	}
+	*b = (struct sweet_gpu_bo){ .iova = gva, .size = size, .md = md, .umap = umap, .pa = pa, .npages = npages,
+		                    .wc = true, .heap_first = first };
+	fBoBytes += size;
+	out[0] = handle;
+	out[1] = gva;
+	out[2] = umap->getAddress();
+	return kIOReturnSuccess;
+}
+#endif
