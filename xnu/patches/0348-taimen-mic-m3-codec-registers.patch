+/* WH slim_slicesize: 1, 2, 3, 4, 6, 8, 12 or 16 bytes */
+static bool
+slice_code(unsigned n, uint16_t *code)
+{
+	static const uint8_t sizes[8] = {1, 2, 3, 4, 6, 8, 12, 16};
+	uint16_t i;
+	for (i = 0; i < 8; i++) {
+		if (sizes[i] == n) {
+			*code = i;
+			return true;
+		}
+	}
+	return false;
+}
+
 bool
 taimen_slim_ready(void)
 {
@@ -468,4 +486,84 @@ taimen_slim_addr_query(const uint8_t ea[6], unsigned tries, uint8_t *la, unsigne
 	*used = i;
 	return err;
 }
+
+/* REQUEST_VALUE: n bytes of value elements from elem on the device at la, the REPLY_VALUE's data. */
+int
+taimen_slim_read(uint8_t la, uint16_t elem, uint8_t *buf, unsigned n)
+{
+	uint8_t m[8];
+	uint16_t ec = 0;
+	unsigned i;
+	int err = EINVAL;
+
+	if (!slice_code(n, &ec) || elem > 0xFFF) {
+		return EINVAL;
+	}
+	ec = (uint16_t)(ec | 0x8u | (unsigned)(elem << 4));
+	for (i = 0; i < RW_TRIES; i++) {
+		uint8_t tid = tid_new();
+		unsigned rl = hdr(m, MT_CORE, MC_REQUEST_VALUE, la, 3);
+		m[3] = tid;
+		m[4] = (uint8_t)ec;
+		m[5] = (uint8_t)(ec >> 8);
+		err = xfer(m, rl, (int)MC_REPLY_VALUE, tid, VALUE_WAIT_MS);
+		if (err == 0 && got_rl == 4 + n) {
+			memcpy(buf, got_buf + 4, n);
+			n_reads++;
+			return 0;
+		}
+		if (err == 0) {
+			LOG("slim: REPLY_VALUE of %#x@%#x: RL %u for %u bytes", elem, la, got_rl, n);
+			err = EBADMSG;
+		}
+		if (slim_dead || err == ENODEV) {
+			break;
+		}
+		taimen_mic_msleep(5);
+	}
+	return err;
+}
+
+/* CHANGE_VALUE: n bytes to the value elements from elem on the device at la; done when sent. */
+int
+taimen_slim_write(uint8_t la, uint16_t elem, const uint8_t *buf, unsigned n)
+{
+	uint8_t m[24];
+	uint16_t ec = 0;
+	unsigned i, rl;
+	int err = EINVAL;
+
+	if (!slice_code(n, &ec) || elem > 0xFFF) {
+		return EINVAL;
+	}
+	ec = (uint16_t)(ec | 0x8u | (unsigned)(elem << 4));
+	for (i = 0; i < RW_TRIES; i++) {
+		rl = hdr(m, MT_CORE, MC_CHANGE_VALUE, la, 2 + n);
+		m[3] = (uint8_t)ec;
+		m[4] = (uint8_t)(ec >> 8);
+		memcpy(m + 5, buf, n);
+		err = xfer(m, rl, -1, 0, 0);
+		if (err == 0) {
+			n_writes++;
+			return 0;
+		}
+		if (slim_dead || err == ENODEV) {
+			break;
+		}
+		taimen_mic_msleep(5);
+	}
+	return err;
+}
+
+void
+taimen_slim_counts(unsigned *reads, unsigned *writes, unsigned *nacks, unsigned *timeouts)
+{
+	*reads = n_reads;
+	*writes = n_writes;
+	*nacks = n_nacks;
+	*timeouts = n_timeouts;
+	if (n_stray != 0 || n_ieve != 0) {
+		LOG("slim: %u messages received, %u not waited for; IE/VE change seen %u times", n_rx, n_stray, n_ieve);
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_TAIMEN */
diff --git a/bsd/dev/taimen_wcd934x.c b/bsd/dev/taimen_wcd934x.c
