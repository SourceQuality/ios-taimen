@@ -38,6 +44,7 @@ bool taimen_wcd_m2(void);
 #define MCLK_PPID               0x0CCu          /* PM8998 GPIO 13, SPMI 0xCC00 (live.dts gpio@cc00) */
 
 #define LA_NONE                 0xFFu
+#define ELEM_BASE               0x800u          /* WH WCD9XXX_REGISTER_START_OFFSET */
 
 static vm_offset_t rst_pin;
 static uint8_t la_gen = LA_NONE, la_ifd = LA_NONE;
@@ -162,4 +169,202 @@ taimen_wcd_m2(void)
 	LOG("2: M2 the WCD9340 is on the bus: generic %#x, interface %#x", la_gen, la_ifd);
 	return true;
 }
+
+/* ---- codec registers (WH wcd9xxx_page_write, wcd9xxx_slim_read_device / write_device) ---- */
+
+#define SHADOW_N                160u
+
+static int cur_page = -1;
+static struct { uint16_t reg; uint8_t val; } shadow[SHADOW_N];
+static unsigned n_shadow;
+static unsigned n_cdc_writes, n_cdc_err;
+static uint16_t first_bad_reg;
+static int first_bad_err;
+static uint8_t chip_id[4];
+
+static int
+shadow_find(uint16_t reg)
+{
+	unsigned i;
+	for (i = 0; i < n_shadow; i++) {
+		if (shadow[i].reg == reg) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static void
+shadow_set(uint16_t reg, uint8_t v)
+{
+	int i = shadow_find(reg);
+	if (i >= 0) {
+		shadow[i].val = v;
+	} else if (n_shadow < SHADOW_N) {
+		shadow[n_shadow].reg = reg;
+		shadow[n_shadow].val = v;
+		n_shadow++;
+	}
+}
+
+static void
+cdc_failed(uint16_t reg, int err)
+{
+	if (n_cdc_err++ == 0) {
+		first_bad_reg = reg;
+		first_bad_err = err;
+	}
+}
+
+static int
+cdc_page(uint16_t reg)
+{
+	uint8_t pg = (uint8_t)(reg >> 8);
+	int err;
+	if (cur_page == (int)pg) {
+		return 0;
+	}
+	err = taimen_slim_write(la_gen, ELEM_BASE, &pg, 1);
+	cur_page = err == 0 ? (int)pg : -1;
+	return err;
+}
+
+/* n bytes from reg on (same page), from the codec */
+static int
+cdc_read_hw(uint16_t reg, uint8_t *buf, unsigned n)
+{
+	int err = cdc_page(reg);
+	if (err == 0) {
+		err = taimen_slim_read(la_gen, (uint16_t)(ELEM_BASE + (reg & 0xFFu)), buf, n);
+	}
+	if (err != 0) {
+		cdc_failed(reg, err);
+	}
+	return err;
+}
+
+static int
+cdc_write_n(uint16_t reg, const uint8_t *buf, unsigned n)
+{
+	int err = cdc_page(reg);
+	if (err == 0) {
+		err = taimen_slim_write(la_gen, (uint16_t)(ELEM_BASE + (reg & 0xFFu)), buf, n);
+	}
+	if (err != 0) {
+		cdc_failed(reg, err);
+	}
+	return err;
+}
+
+static int
+cdc_write(uint16_t reg, uint8_t v)
+{
+	int err = cdc_write_n(reg, &v, 1);
+	if (err == 0) {
+		n_cdc_writes++;
+		shadow_set(reg, v);
+	}
+	return err;
+}
+
+static uint8_t
+cdc_get(uint16_t reg)           /* a fresh read for the log (0xEE when it fails) */
+{
+	uint8_t v = 0xEE;
+	(void)cdc_read_hw(reg, &v, 1);
+	return v;
+}
+
+static int
+ifd_write(uint16_t reg, uint8_t v)
+{
+	return taimen_slim_write(la_ifd, (uint16_t)(ELEM_BASE + reg), &v, 1);
+}
+
+static int
+ifd_read(uint16_t reg, uint8_t *v)
+{
+	return taimen_slim_read(la_ifd, (uint16_t)(ELEM_BASE + reg), v, 1);
+}
+
+/* ---- M3: chip id, bring-up, the interface device ---- */
+
+#define R_CHIP_ID0              0x0021u         /* CHIP_TIER_CTRL_CHIP_ID_BYTE0..3 */
+#define R_RPM_CLK_GATE          0x0002u
+#define R_RPM_CLK_MCLK_CFG      0x0003u
+#define R_RPM_RST_CTL           0x0009u
+#define R_RPM_PWR_CDC_DIG_HM    0x0011u
+#define R_SIDO_VOUT_A_STARTUP   0x071Bu
+#define R_SIDO_VOUT_D_STARTUP   0x071Cu
+#define IFD_TX_OR_UR_CFG_7      0x01F7u         /* SB_PGD_PORT_TX_OR_UR_CFG(7): Tavil auto-recovery */
+
+static bool
+chip_is_tavil(void)
+{
+	return chip_id[2] == 0x08 && chip_id[3] == 0x01;        /* major 0x0108 */
+}
+
+bool
+taimen_wcd_m3(void)
+{
+	uint8_t v = 0xEE, rst, hm;
+	unsigned reads, writes, nacks, timeouts;
+	int err, e2;
+	bool before;
+
+	if (la_gen == LA_NONE || la_ifd == LA_NONE) {
+		LOG("3: no logical addresses (M2)");
+		return false;
+	}
+	cur_page = -1;
+	n_cdc_err = 0;
+	memset(chip_id, 0xEE, sizeof(chip_id));
+	err = cdc_read_hw(R_CHIP_ID0, chip_id, 4);
+	before = err == 0 && chip_is_tavil();
+	LOG("3: chip id (before the bring-up) %02x %02x %02x %02x%s", chip_id[0], chip_id[1], chip_id[2], chip_id[3],
+	    err != 0 ? " (READ FAILED)" : "");
+	if (err != 0) {
+		LOG("3: REQUEST_VALUE got no REPLY_VALUE (%d): element-code encoding or the LA", err);
+		return false;
+	}
+	/* WH wcd934x_bringup (wcd9xxx_device_init runs it before the chip id read) */
+	err = cdc_write(R_RPM_RST_CTL, 0x01);
+	err = err != 0 ? err : cdc_write(R_SIDO_VOUT_A_STARTUP, 0x19);
+	err = err != 0 ? err : cdc_write(R_SIDO_VOUT_D_STARTUP, 0x15);
+	taimen_mic_msleep(1);
+	err = err != 0 ? err : cdc_write(R_RPM_PWR_CDC_DIG_HM, 0x05);
+	err = err != 0 ? err : cdc_write(R_RPM_PWR_CDC_DIG_HM, 0x07);
+	err = err != 0 ? err : cdc_write(R_RPM_RST_CTL, 0x03);
+	err = err != 0 ? err : cdc_write(R_RPM_RST_CTL, 0x07);
+	err = err != 0 ? err : cdc_write(R_RPM_PWR_CDC_DIG_HM, 0x03);
+	rst = cdc_get(R_RPM_RST_CTL);
+	hm = cdc_get(R_RPM_PWR_CDC_DIG_HM);
+	LOG("3: bring-up%s read back: RST_CTL %#x DIG_HM_CTL %#x", err != 0 ? " FAILED," : "", rst, hm);
+	if (!before) {
+		e2 = cdc_read_hw(R_CHIP_ID0, chip_id, 4);
+		LOG("3: chip id after the bring-up %02x %02x %02x %02x%s", chip_id[0], chip_id[1], chip_id[2], chip_id[3],
+		    e2 != 0 ? " (READ FAILED)" : "");
+	}
+	if (chip_is_tavil()) {
+		LOG("3: chip id %02x %02x %02x %02x: WCD9340 v1.%u", chip_id[0], chip_id[1], chip_id[2], chip_id[3],
+		    chip_id[0] == 0x01 && chip_id[1] == 0x00 ? 1u : 0u);
+	} else {
+		LOG("3: chip id %02x %02x %02x %02x is NOT a WCD934x (major 0x0108): wrong LA or page", chip_id[0],
+		    chip_id[1], chip_id[2], chip_id[3]);
+	}
+	e2 = ifd_write(IFD_TX_OR_UR_CFG_7, 0x02);
+	if (e2 == 0) {
+		e2 = ifd_read(IFD_TX_OR_UR_CFG_7, &v);
+	}
+	LOG("3: interface %#x wrote 0x02 read %#x%s", ELEM_BASE + IFD_TX_OR_UR_CFG_7, v, e2 != 0 ? " (FAILED)" : "");
+	taimen_slim_counts(&reads, &writes, &nacks, &timeouts);
+	if (err != 0 || !chip_is_tavil()) {
+		LOG("3: M3 NOT reached: %u reads, %u writes, %u NACKs, %u timeouts", reads, writes, nacks, timeouts);
+		return false;
+	}
+	/* the milestone is the chip id; a read-back mismatch is logged and M4 still runs */
+	LOG("3: M3 %u reads, %u writes, %u NACKs, %u timeouts%s", reads, writes, nacks, timeouts,
+	    e2 != 0 || v != 0x02 || rst != 0x07 || hm != 0x03 ? " (a read-back above is NOT as written)" : "");
+	return true;
+}
 #endif /* ARM64_BOARD_CONFIG_TAIMEN */
