+/*
+ * 0300: at SuperSpeed (taimen: ABL drives this port over the USB3 PHY and leaves the QUSB2 PHY
+ * powered down, PWR_CTRL1 0x23, so high speed has no UTMI clock: boots 129/131 timed out on the
+ * first endpoint command). USB 3.0 device descriptor (ep0 2^9), a BOS (USB 2.0 extension + the
+ * SuperSpeed capability), and the NCM configuration with 1024-byte bulk endpoints, each endpoint
+ * followed by its SuperSpeed companion.
+ */
+static const uint8_t ud_bos_desc[22] = {
+	5, 0x0f, 22, 0, 2,                              /* BOS: 2 capabilities */
+	7, 0x10, 0x02, 0x02, 0, 0, 0,                   /* USB 2.0 extension: LPM */
+	10, 0x10, 0x03, 0x00, 0x0e, 0x00, 0x01, 0x0a, 0xff, 0x07, /* SuperSpeed: FS/HS/SS, U1 10 us, U2 2047 us */
+};
+static const uint8_t ud_cfg_desc_ncm_ss[104] = {
+	9, 2, 104, 0, 2, 1, 0, 0x80, 112,               /* config: 2 interfaces, 896 mA (8 mA units) */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0x00, 0,             /* comm interface 0: CDC NCM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                /* NCM 1.00 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes */
+	6, 0x30, 0, 0, 16, 0,                           /*   companion: no burst, 16 bytes per interval */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 0 */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x01, 0,             /* data interface 1 alt 1: NTB */
+	7, 5, 0x81, 0x02, 0x00, 0x04, 0,                /* ep 0x81 bulk IN, 1024 */
+	6, 0x30, 0, 0, 0, 0,                            /*   companion */
+	7, 5, 0x01, 0x02, 0x00, 0x04, 0,                /* ep 0x01 bulk OUT, 1024 */
+	6, 0x30, 0, 0, 0, 0,                            /*   companion */
+};
