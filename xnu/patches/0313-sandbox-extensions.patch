+/*
+ * 0313: sandbox extensions. tccd issues one with every grant (a file or mach extension the client
+ * then consumes); when the issue failed it denied the request: "Failed to issue Sandbox Extension
+ * for kTCCServicePhotos" (boot 147), so every TCC preflight came back denied and assetsd, which
+ * preflights Photos, aborted ("assetsd requires TCCPhotosService access"). Without a sandbox an
+ * extension grants nothing, so issue a token naming the class and path and accept any consume.
+ *   op 5, libsystem_sandbox __sandbox_extension_issue: arg -> {char *class; u64 u32; char *path;
+ *        u64 flags; char *token_out (2048 bytes); u64 pid; u64 ...}
+ *   op 6, sandbox_extension_consume: arg -> {char *token; u64 length; int64 *handle_out}
+ */
+static uint64_t sweet_sandbox_next_handle = 1;
+
+static int
+sweet_sandbox_extension_issue(user_addr_t arg)
+{
+	uint64_t a[7];
+	char cls[96] = "", path[512] = "", token[700];
+	size_t len;
+	if (copyin(arg, a, sizeof(a)) != 0 || a[4] == 0) {
+		return EFAULT;
+	}
+	if (a[0] != 0) {
+		(void)copyinstr((user_addr_t)a[0], cls, sizeof(cls), &len);
+	}
+	if (a[2] != 0) {
+		(void)copyinstr((user_addr_t)a[2], path, sizeof(path), &len);
+	}
+	snprintf(token, sizeof(token), "0000000000000000000000000000000000000000;00;00000000;0000000000000000;"
+	    "0000000000000000;0000000000000001;%s;01;00000000;0000000000000000;%s", cls, path);
+	return copyout(token, (user_addr_t)a[4], strlen(token) + 1);
+}
+
+static int
+sweet_sandbox_extension_consume(user_addr_t arg)
+{
+	uint64_t a[3];
+	if (copyin(arg, a, sizeof(a)) != 0 || a[2] == 0) {
+		return EFAULT;
+	}
+	int64_t handle = (int64_t)sweet_sandbox_next_handle++;     /* races only reuse a meaningless number */
+	return copyout(&handle, (user_addr_t)a[2], sizeof(handle));
+}
+
 static int
 sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
