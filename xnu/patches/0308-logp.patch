 		wklog = 0;
 		(void)PE_parse_boot_argn("sweetwklog", &wklog, sizeof(wklog));
 	}
-	if (strncmp(name, "netsvcd", 7) == 0 ||
+	extern bool sweet_logp_match(const char *name);         /* bsd/kern/kern_exec.c, 0308 */
+	if (strncmp(name, "netsvcd", 7) == 0 || sweet_logp_match(name) ||
