diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 1ceb39c..2b58a92 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -16,6 +16,9 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 #include <mach/vm_param.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/queue.h>
 
 /* persistent_ram_buffer: "DBGC", start, size, then the text (no ECC) */
 #define PRZ_OFF         (SWEET_EARLY_LOG_PRZ - SWEET_EARLY_LOG_BLOCK)
@@ -270,4 +273,21 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/* Bring-up: where is every kernel thread? (state, wait event, continuation; symbolicate with tools/taimen/symbolicate.py) */
+extern queue_head_t threads;
+extern lck_mtx_t tasks_threads_lock;
+void
+taimen_thread_dump(const char *tag)
+{
+	thread_t th;
+	unsigned n = 0;
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&threads, th, thread_t, threads) {
+		printf("TAIMEN THR [%s] #%u tid %llu state 0x%x pri %d wait_event 0x%llx cont 0x%llx\n", tag, n++, thread_tid(th),
+		    th->state, th->sched_pri, (unsigned long long)th->wait_event, (unsigned long long)(uintptr_t)th->continuation);
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+}
+#endif
 #endif /* SWEET */
