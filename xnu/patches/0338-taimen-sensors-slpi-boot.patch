@@ -308,6 +695,9 @@ sensors_thread(void *arg, wait_result_t)
 	LOG("3: TZ pas supported(%u) -> %lld/%llu", SLPI_PAS_ID, (long long)r, r1);
 	fw_census();
 	LOG("5: census done");
+	if (level >= 3) {
+		slpi_boot();
+	}
