+/* the HID usage (page 7) and shift for an ASCII character, US layout */
+static bool
+ctl_usage(char c, uint32_t *usage, bool *shift)
+{
+	static const char plain[] = " -=[]\\;'`,./", shifted[] = " _+{}|:\"~<>?";
+	static const uint8_t punct[] = { 0x2c, 0x2d, 0x2e, 0x2f, 0x30, 0x31, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38 };
+	static const char digits_shifted[] = "!@#$%^&*()";
+	*shift = false;
+	if (c >= 'a' && c <= 'z') {
+		*usage = 0x04 + (uint32_t)(c - 'a');
+		return true;
+	}
+	if (c >= 'A' && c <= 'Z') {
+		*usage = 0x04 + (uint32_t)(c - 'A');
+		*shift = true;
+		return true;
+	}
+	if (c >= '1' && c <= '9') {
+		*usage = 0x1e + (uint32_t)(c - '1');
+		return true;
+	}
+	if (c == '0') {
+		*usage = 0x27;
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(punct); i++) {
+		if (c == plain[i] || (i > 0 && c == shifted[i])) {
+			*usage = punct[i];
+			*shift = c != plain[i];
+			return true;
+		}
+	}
+	for (unsigned i = 0; i < 10; i++) {
+		if (c == digits_shifted[i]) {
+			*usage = 0x1e + i;
+			*shift = true;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+ctl_press(uint32_t usage, bool shift)
+{
+	if (shift) {
+		sweet_hid_kbd(0xe1, 1);
+	}
+	sweet_hid_kbd(usage, 1);
+	delay(25000);
+	sweet_hid_kbd(usage, 0);
+	if (shift) {
+		sweet_hid_kbd(0xe1, 0);
+	}
+	delay(25000);
+}
