+static void
+rootfix_one(uint32_t op, uint32_t mode, uint32_t uid, uint32_t gid, const char *rawpath, const uint8_t *data,
+    uint32_t dlen, bool quiet, struct rootfix_count *c, vfs_context_t ctx)
