+		printf("TAIMEN ROOTFIX: %s: no IOPlatformUUID\n", rawpath);
+		c->failed++;
+		return;
+	}
+	int err = op == RFX_MKDIR ? rootfix_mkdir(path, mode, uid, gid, ctx) :
+	    op == RFX_RENAME ? rootfix_rename(path, data, dlen, ctx) :
+	    op == RFX_LIST ? rootfix_list(path, mode, ctx) :
+	    op == RFX_REMOVE ? rootfix_remove(path, ctx) :
+	    op == RFX_CREATE_Z ? rootfix_create_z(path, data, dlen, mode, uid, gid, ctx) :
+	    (op == RFX_WRITE || op == RFX_CREATE) ?
+	    rootfix_write(path, data, dlen, mode, uid, gid, op == RFX_CREATE, ctx) : EINVAL;
+	if (err == 0) {
+		c->done++;
+	} else if (err == EEXIST) {
+		c->skipped++;
+	} else {
+		c->failed++;
+	}
+	if (err != EEXIST && op != RFX_LIST && (!quiet || err != 0)) {
+		printf("TAIMEN ROOTFIX: %s %s (%u bytes, %o %u:%u): %s%d\n",
+		    op == RFX_MKDIR ? "mkdir" : op == RFX_REMOVE ? "remove" : op == RFX_CREATE ? "create" :
+		    op == RFX_CREATE_Z ? "create (zlib)" : op == RFX_RENAME ? "rename" : "write",
+		    path, dlen, mode,
+		    uid, gid, err ? "error " : "ok ", err);
+	}
+}
