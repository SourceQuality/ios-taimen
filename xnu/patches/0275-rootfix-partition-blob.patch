+extern int sweet_ufs_part_find(const char *name, uint8_t *lun, uint64_t *first, uint64_t *nblocks);
+extern int sweet_ufs_part_read(uint8_t lun, uint64_t first, uint64_t nblocks, uint64_t off, void *dst, uint32_t len);
+
+/*
+ * RFX_PART (0275): the records of an RFX1 blob on a raw partition, read in order through
+ * sweet_ufs.c (the stock apps, ~490 MB: mkrootfix.py --apps-archive, fastboot flash system_b).
+ * Each record's data is read into its own buffer; the per-record log is only for failures.
+ */
+static int
+rootfix_part(const char *path, vfs_context_t ctx)
+{
+	uint8_t lun = 0;
+	uint64_t first = 0, nblocks = 0, off = 8;
+	uint32_t hdr[6];
+	if (sweet_ufs_part_find(path + 1, &lun, &first, &nblocks) != 0) {
+		printf("TAIMEN ROOTFIX: part %s: no such partition\n", path);
+		return ENOENT;
+	}
+	if (sweet_ufs_part_read(lun, first, nblocks, 0, hdr, 8) != 0 || hdr[0] != RFX_MAGIC) {
+		printf("TAIMEN ROOTFIX: part %s: no RFX1 blob (%#x)\n", path, hdr[0]);
+		return EINVAL;
+	}
+	uint32_t count = hdr[1];
+	struct rootfix_count c = {};
+	uint64_t t0 = mach_absolute_time(), bytes = 0;
+	printf("TAIMEN ROOTFIX: part %s: %u records on LUN %u at block %#llx\n", path, count, lun, first);
+	for (uint32_t i = 0; i < count; i++) {
+		if (sweet_ufs_part_read(lun, first, nblocks, off, hdr, sizeof(hdr)) != 0) {
+			printf("TAIMEN ROOTFIX: part %s: read error at record %u\n", path, i);
+			c.failed++;
+			break;
+		}
+		uint32_t op = hdr[0], plen = hdr[4], dlen = hdr[5];
+		uint32_t pl = (plen + 3u) & ~3u, dl = (dlen + 3u) & ~3u;
+		char rpath[1024];
+		uint8_t *data = NULL;
+		if (op == RFX_PART || plen == 0 || pl > sizeof(rpath) || dlen > (256u << 20) ||
+		    sweet_ufs_part_read(lun, first, nblocks, off + 24, rpath, pl) != 0 || rpath[plen - 1] != 0 ||
+		    rpath[0] != '/') {
+			printf("TAIMEN ROOTFIX: part %s: bad record %u at %#llx\n", path, i, off);
+			c.failed++;
+			break;
+		}
+		if (dlen != 0 && ((data = kalloc_data(dlen, Z_WAITOK)) == NULL ||
+		    sweet_ufs_part_read(lun, first, nblocks, off + 24 + pl, data, dlen) != 0)) {
+			printf("TAIMEN ROOTFIX: part %s: record %u data (%u bytes) unreadable\n", path, i, dlen);
+			if (data != NULL) {
+				kfree_data(data, dlen);
+			}
+			c.failed++;
+			break;
+		}
+		rootfix_one(op, hdr[1], hdr[2], hdr[3], rpath, data, dlen, true, &c, ctx);
+		if (data != NULL) {
+			kfree_data(data, dlen);
+		}
+		bytes += dlen;
+		off += 24 + pl + dl;
+		if ((i + 1) % 1000 == 0) {
+			printf("TAIMEN ROOTFIX: part %s: %u of %u records, %llu MB read\n", path, i + 1, count, bytes >> 20);
+		}
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("TAIMEN ROOTFIX: part %s: %u records: %u written, %u already present, %u failed; %llu MB in %llu s\n",
+	    path, count, c.done, c.skipped, c.failed, bytes >> 20, ns / 1000000000ull);
+	return c.failed != 0 ? EIO : 0;
+}
