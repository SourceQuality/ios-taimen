+void
+SweetBattery::pollPMI8998(void)
+{
+	uint8_t soc = 0, cp = 0, v0 = 0, v1 = 0, i0 = 0, i1 = 0, t0 = 0, t1 = 0, usb = 0, chg = 0;
+	bool valid = fReal;
+	/* Linux fg_get_msoc_raw: the two copies must match. */
+	for (int i = 0; valid && i < 5; i++) {
+		valid = reg(0x4009, &soc) && reg(0x400a, &cp);
+		if (valid && soc == cp) {
+			break;
+		}
+		valid = valid && i < 4;
+	}
+	int step = !valid ? 1 : !(reg(0x41a0, &v0) && reg(0x41a1, &v1)) ? 2 :
+	    !(reg(0x41a2, &i0) && reg(0x41a3, &i1)) ? 3 : !(reg(0x4150, &t0) && reg(0x4151, &t1)) ? 4 :
+	    !reg(0x1310, &usb) ? 5 : !reg(0x1006, &chg) ? 6 : 0;
+	static int logged;
+	if (fReal && step != 0 && logged < 10) {
+		logged++;
+		IOLog("SWEET BATTERY: PMI8998 read failed at step %d\n", step);
+	}
+	if (step != 0) {
+		fTempValid = false;
+		fTemp = 2500;
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	unsigned percent = ((unsigned)soc * 100u + 127u) / 255u;
+	unsigned mv = (unsigned)((((uint64_t)v1 << 8 | v0) * 122070u) / 1000000u);
+	int ua = (int)((int64_t)(int16_t)((uint16_t)i1 << 8 | i0) * 488281 / 1000);
+	int ma = -ua / 1000;                            /* iOS: negative while discharging */
+	int kelvin = (((t1 & 7) << 8 | t0) + 2) / 4;
+	fTemp = (kelvin - 273) * 100;
+	fTempValid = true;
+	bool external = (usb & 0x10u) != 0;
+	unsigned st = chg & 7u;
+	bool full = st == 5 || st == 6;
+	bool charging = external && st <= 4;
+	uint8_t regs[6] = {soc, usb, chg, 0, 0, 0};
+	if (memcmp(regs, fLastRegs, sizeof(regs)) != 0 || fPolls % 12 == 0) {
+		IOLog("SWEET BATTERY: soc 0x%02x = %u%% %u mV %d mA %d C usb rt 0x%02x chgr 0x%02x -> external %d "
+		    "charging %d full %d\n", soc, percent, mv, ma, kelvin - 273, usb, chg, external, charging, full);
+		memcpy(fLastRegs, regs, sizeof(regs));
+	}
+	fPolls++;
+	publish(percent, mv, ma, external, external, charging, full, true, true);
+}
