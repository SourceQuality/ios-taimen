+
+/*
+ * 0304: the last swapped surface for the remote screenshot (bsd/dev/sweet_usb.c, TCP 5144): its
+ * kernel address and geometry, retained until sweet_fb_grab_release(ref).
+ */
+extern "C" bool sweet_fb_grab(uintptr_t *base, uint32_t *w, uint32_t *h, uint32_t *bpr, void **ref);
+extern "C" void sweet_fb_grab_release(void *ref);
+
+bool
+sweet_fb_grab(uintptr_t *base, uint32_t *w, uint32_t *h, uint32_t *bpr, void **ref)
+{
+	SweetSurface *s = sweet_fb_last_id ? sweet_surface_copy(sweet_fb_last_id) : NULL;
+	if (s == NULL || s->kernelAddress() == 0 || !(s->bytesPerElement == 4 || s->bytesPerElement == 0)) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	*base = s->kernelAddress() + s->offset;
+	*w = s->width;
+	*h = s->height;
+	*bpr = s->bytesPerRow;
+	*ref = s;
+	return true;
+}
+
+void
+sweet_fb_grab_release(void *ref)
+{
+	SweetSurface *s = (SweetSurface *)ref;
+	OSSafeReleaseNULL(s);
+}
 #endif
 
 bool
