+	uint32_t lo = ~0u, hi = 0, filesz = 0, memsz = 0, nload = 0, reloc = 0;
 	for (uint32_t i = 0; i < phnum && phoff + (i + 1) * 32 <= mdt_len; i++) {
 		const struct zap_phdr *ph = (const struct zap_phdr *)(m + phoff + i * 32);
 		/* PT_LOAD, not the hash segment (type field 2 in flags 26:24), not empty */
@@ -632,13 +656,37 @@ zap_load(void)
 		hi = (ph->paddr + ph->memsz + 0xfff) & ~0xfffu;
 		filesz = ph->filesz;
 		memsz = ph->memsz;
+		reloc = (ph->flags >> 27) & 1;  /* QCOM_MDT_RELOCATABLE */
 	}
 	if (nload != 1 || filesz != seg_len || memsz > ZAP_SIZE) {
 		printf("SWEET GPU: zap layout unexpected: %u loadable, filesz %u seg %u memsz %u\n",
