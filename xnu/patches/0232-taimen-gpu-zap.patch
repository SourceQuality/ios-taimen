@@ -611,6 +617,23 @@ zap_load(void)
 		return false;
 	}
 	vm_offset_t meta_va;
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	/*
+	 * a540_zap.mdt is 6684 bytes: more than one 4K page. Like mainline (32-bit DMA mask) it goes
+	 * contiguous below 4 GB, in the free tail of the splash region; that mapping is device
