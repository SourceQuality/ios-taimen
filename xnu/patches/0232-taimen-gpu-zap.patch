 		return false;
 	}
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	/* a540_zap: paddr 0x5000, memsz 0x1334, relocatable, 1 MB alignment (boot 52 notes) */
+	if (!reloc) {
+		printf("SWEET GPU: zap segment at %x is not relocatable: not supported\n", lo);
+		return false;
+	}
+	/*
