+	 */
+	uint64_t meta = ZAP_META_PA;
+	meta_va = mdt_len >= 0x34 && mdt_len <= 0x10000 && !(mdt_len & 3) ? ml_io_map(meta, round_page(mdt_len)) : 0;
+	if (meta_va == 0) {
+		printf("SWEET GPU: zap metadata %u bytes: unexpected size or map failed\n", mdt_len);
+		return false;
+	}
+	for (uint32_t off = 0; off < mdt_len; off += 4) {
+		wr(meta_va, off, *(const uint32_t *)(phystokv(mdt) + off));
+	}
+	const uint8_t *m = (const uint8_t *)phystokv(mdt);
+#else
 	uint64_t meta = gpu_page(&meta_va);
