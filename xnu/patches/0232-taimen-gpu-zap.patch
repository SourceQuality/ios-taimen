+	uint64_t avail = 0, supported = 0;
+	int64_t ra = scm_call(6, 1, 1, 0x02000201ull, 0, 0, &avail);
+	int64_t rs = scm_call(2, 7, 1, GPU_PAS_ID, 0, 0, &supported);
+	printf("SWEET GPU: scm is_call_avail(pas_init_image) -> %lld/%llx, pas_is_supported(13) -> %lld/%llx\n",
+	    ra, avail, rs, supported);
+	if (ra != 0 || avail != 1 || rs != 0 || supported != 1) {
+		printf("SWEET GPU: TZ does not offer PAS for the GPU from here, stop\n");
+		return false;
+	}
+#else
+	(void)reloc;
 	flush_dcache64((addr64_t)meta, PAGE_SIZE, TRUE);
+#endif
 	uint64_t r1 = 0;
 	/* PAS_INIT_IMAGE (svc 2 cmd 1): args (pas id VAL, metadata RW) */
 	int64_t r = scm_call(2, 1, 2u | (2u << 6), GPU_PAS_ID, meta, 0, &r1);
