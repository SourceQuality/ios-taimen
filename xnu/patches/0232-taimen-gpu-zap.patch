-	flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
-	flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
-	flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)src, bytes, TRUE);
+	flush_dcache64((addr64_t)d1, bytes, TRUE);
+	flush_dcache64((addr64_t)d2, bytes, TRUE);
+	flush_dcache64((addr64_t)d3, bytes, TRUE);
 	uint64_t fence = scratch + 16;
 	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 16);
 	printf("SWEET GPU: blit pages src %llx dst %llx %llx %llx\n", src, d1, d2, d3);
@@ -716,9 +767,9 @@ blit_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t sc
 		bool read = kick(gpu);
 		delay(5000);
 		flush_dcache64((addr64_t)scratch, 64, TRUE);
-		flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
-		flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
-		flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)d1, bytes, TRUE);
+		flush_dcache64((addr64_t)d2, bytes, TRUE);
+		flush_dcache64((addr64_t)d3, bytes, TRUE);
 		uint32_t bad = 0, nonzero = 0, first = ~0u;
 		for (uint32_t y = 0; y < 64; y++) {
 			for (uint32_t x = 0; x < 64; x++) {
