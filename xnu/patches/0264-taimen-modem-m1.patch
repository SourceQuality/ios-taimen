@@ -41,6 +46,13 @@ extern "C" void taimen_modem_init(void);
 #define ITEM_SMP2P_IN           435
 #define ITEM_GLINK              478
 
+#define POOL_PA                 0x89000000ull
+#define POOL_SIZE               0x01000000ull   /* 16 MB: MSA, rmtfs and the QMI/WLAN buffers later */
+#define VMID_HLOS               3
+#define VMID_MSS_MSA            15
+#define PERM_RWX                7
+#define PERM_RW                 6
+
 #define SCM_FN(svc, cmd)        (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
 #define SCM_SIP_FNID(svc, cmd)  (0x02000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
 
@@ -57,6 +69,25 @@ struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, f
 struct smem_priv_entry { uint16_t canary, item; uint32_t size; uint16_t pad_data, pad_hdr; uint32_t rsvd; } __attribute__((packed));
 
 static uint8_t *smem;
+static IOMemoryMap *pool_map;
+static uint8_t *pool;                   /* write-combined */
+static uint64_t pool_used;
+
+static inline void mb(void) { __asm__ volatile ("dsb sy" ::: "memory"); }
+
+static void *
+pool_alloc(uint64_t size, uint64_t *pa)
+{
+	size = (size + 0xfff) & ~0xfffull;
+	if (pool == NULL || pool_used + size > POOL_SIZE) {
+		return NULL;
+	}
+	*pa = POOL_PA + pool_used;
+	void *va = pool + pool_used;
+	pool_used += size;
+	bzero(va, size);
+	return va;
+}
 
 /* ---------------------------------------------------------------- TrustZone */
 
@@ -92,6 +123,48 @@ scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t
 	return args[0];
 }
 
+/*
+ * hyp_assign_phys (SCM 0x0C/0x16): addr+size from the src VMIDs to the dest VMIDs with perms.
+ * Arguments as ios-topaz 0121: x2 the {addr, size} list, x3 its size, x4 the src list, x5 the
+ * extended arguments {src size, dest list, dest size, 0}; dest entries {vmid, perm, ctx(8), ctx
+ * size, unused}. Returns x0, or the result word when x0 is 0.
+ */
+static uint64_t
+scm_assign(uint64_t addr, uint64_t size, const uint32_t *src, unsigned nsrc, const uint32_t *dst,
+    const uint32_t *perm, unsigned ndst)
+{
+	uint64_t pa = 0;
+	uint64_t *p = (uint64_t *)pool_alloc(0x1000, &pa);
+	if (p == NULL || nsrc > 8 || ndst > 4) {
+		return ~0ull;
+	}
+	p[0] = addr;                                /* 0x000: mem list {addr, size} */
+	p[1] = size;
+	uint32_t *s = (uint32_t *)(p + 8);          /* 0x040: src vmids */
+	for (unsigned i = 0; i < nsrc; i++) {
+		s[i] = src[i];
+	}
+	uint32_t *d = (uint32_t *)(p + 16);         /* 0x080: dest entries, 24 bytes each */
+	for (unsigned i = 0; i < ndst; i++) {
+		d[6 * i] = dst[i];
+		d[6 * i + 1] = perm[i];
+	}
+	p[32] = 4ull * nsrc;                        /* 0x100: extended arguments */
+	p[33] = pa + 0x80;
+	p[34] = 24ull * ndst;
+	p[35] = 0;
+	mb();
+	const uint64_t info = 7 | (1 << 4) | (1 << 8) | (1 << 12);
+	uint64_t args[8] = { SCM_FN(0x0C, 0x16), info, pa, 16, pa + 0x40, pa + 0x100, 0, 0 };
+	smc(args);
+	for (unsigned n = 0; args[0] == 1 && n < 100000; n++) {
+		uint64_t again[8] = { 1, info, pa, 16, pa + 0x40, pa + 0x100, args[6], 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	return args[0] != 0 ? args[0] : args[1];
+}
+
 /* ---------------------------------------------------------------- SMEM */
 
 static struct smem_part_hdr *
@@ -213,6 +286,40 @@ m0(void)
 	smem = NULL;
 }
 
+/* M1: the pool, and one page there and back through hyp_assign. */
+static bool
+m1(void)
+{
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(POOL_PA, POOL_SIZE, kIODirectionInOut);
+	pool_map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (pool_map == NULL) {
+		LOG("M1: pool map at %#llx failed", POOL_PA);
+		return false;
+	}
+	pool = (uint8_t *)pool_map->getVirtualAddress();
+	uint64_t pa = 0;
+	volatile uint32_t *page = (volatile uint32_t *)pool_alloc(0x1000, &pa);
+	if (page == NULL) {
+		return false;
+	}
+	page[0] = 0x5441494d;                       /* "TAIM" */
+	mb();
+	static const uint32_t hlos[] = {VMID_HLOS}, both[] = {VMID_HLOS, VMID_MSS_MSA};
+	static const uint32_t rwx[] = {PERM_RWX}, both_perm[] = {PERM_RWX, PERM_RW};
+	uint64_t r1 = scm_assign(pa, 0x1000, hlos, 1, both, both_perm, 2);
+	uint32_t v1 = page[0];
+	page[1] = 0x31;
+	mb();
+	uint64_t r2 = scm_assign(pa, 0x1000, both, 2, hlos, rwx, 1);
+	uint32_t v2 = page[1];
+	page[2] = 0x32;
+	mb();
+	LOG("M1: pool %#llx+%#llx mapped; page %#llx to HLOS+MSS_MSA -> %#llx (reads %#x), back to HLOS -> %#llx "
+	    "(reads %#x, writes %s)", POOL_PA, POOL_SIZE, pa, r1, v1, r2, v2, page[2] == 0x32 ? "ok" : "LOST");
+	return r1 == 0 && r2 == 0;
+}
