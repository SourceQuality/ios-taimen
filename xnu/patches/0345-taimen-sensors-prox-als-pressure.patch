+/* 0345: a setProperties dictionary's keys, for the log */
+static void
+prop_keys(OSDictionary *d, char *keys, size_t size)
+{
+	size_t n = 0;
+	keys[0] = 0;
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+	if (it) {
+		for (OSString *k; (k = OSDynamicCast(OSString, it->getNextObject())) != NULL && n + 2 < size;) {
+			n += (size_t)snprintf(keys + n, size - n, "%s%s", n ? " " : "", k->getCStringNoCopy());
+		}
+		it->release();
+	}
+}
