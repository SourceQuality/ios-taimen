+/*
+ * 0345: proximity, as backboardd and locationd look for it. backboardd's BKHIDUISensorController matches
+ * {DeviceUsagePage 0xff00, DeviceUsage 8} (the dictionary built at backboardd 0x100046f2c) and then
+ * "ignoring discrete prox service %llX not top placement" unless the service's Placement is 1; without
+ * NeedsHostState it takes it as a discrete prox and sets ProxDetectionMode on it. Its proximity handler
+ * (0x10002cce4) and locationd's CLProximityNotifier ({0xff00, 8}, 0x101471268; callback 0x100766388) read
+ * the detection mask (kIOHIDEventFieldProximityDetectionMask): an object is near when it is not 0. So
+ * near sends kIOHIDProximityDetectionReceiver (0x40, the earpiece), far 0, on each change.
+ */
+class SweetHIDProx : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDProx);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEvent *copyEvent(IOHIDEventType type, IOHIDEvent *matching = NULL, IOOptionBits options = 0) APPLE_KEXT_OVERRIDE;
+	void update(bool isNear);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 8; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 10; }
+private:
+	IOHIDEvent *event();
+	volatile bool fNear, fKnown;
+	UInt32 fSaid, fChanges;
+};
+OSDefineMetaClassAndStructors(SweetHIDProx, IOHIDEventService);
+static SweetHIDProx *gSweetProx;
+
+bool
+SweetHIDProx::start(IOService *provider)
+{
+	int level = 0;
+	if (!PE_parse_boot_argn("taimensensors", &level, sizeof(level)) || level < 8) {
+		return false;
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	setProperty("Placement", 1ULL, 32);     /* top: backboardd ignores a discrete prox anywhere else */
+	gSweetProx = this;
+	registerService();
+	IOLog("TAIMEN SENSORS: SweetHIDProx up (0xff00/8, Placement 1, the SLPI's proximity)\n");
+	return true;
+}
+
+IOHIDEvent *
+SweetHIDProx::event()
+{
+	IOHIDProximityDetectionMask mask = fNear ? (IOHIDProximityDetectionMask)kIOHIDProximityDetectionReceiver : 0;
+	return IOHIDEvent::proximityEvent(mach_absolute_time(), mask, fNear ? 1 : 0);
+}
+
+IOReturn
+SweetHIDProx::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	if (fSaid < 16) {
+		fSaid++;
+		char keys[160];
+		prop_keys(d, keys, sizeof(keys));
+		OSNumber *mode = OSDynamicCast(OSNumber, d->getObject("ProxDetectionMode"));
+		IOLog("SWEET HID: SweetHIDProx properties [%s]: ProxDetectionMode %lld\n", keys,
+		    mode ? (long long)mode->unsigned64BitValue() : -1LL);
+	}
+	return kIOReturnSuccess;
+}
+
+IOHIDEvent *
+SweetHIDProx::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return type == kIOHIDEventTypeProximity && fKnown ? event() : NULL;
+}
+
+void
+SweetHIDProx::update(bool isNear)
+{
+	if (fKnown && isNear == fNear) {
+		return;
+	}
+	fNear = isNear;
+	fKnown = true;
+	if (fChanges++ < 64) {
+		IOLog("TAIMEN SENSORS: proximity now %s (%u clients)\n", isNear ? "near" : "far", _clients ? _clients->getCount() : 0);
+	}
+	IOHIDEvent *e = event();
+	if (e) {
+		dispatchEvent(e);
+		e->release();
+	}
+}
+
+/*
+ * 0345: ambient light, kIOHIDEventTypeAmbientLightSensor with the level in lux, each sample (about 5 Hz).
+ * Neither locationd nor backboardd's own code builds an ALS matcher (auto-brightness is CoreBrightness,
+ * in the shared cache, not read here), so the pair is IOHIDFamily's AppleVendor AmbientLightSensor,
+ * 0xff00/4 (AppleHIDUsageTables.h): unverified. The kernel's event has no illuminance field (its size is
+ * IOHIDAmbientLightSensorEventData), so lux goes in the level and channel 0.
+ */
+class SweetHIDALS : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDALS);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOHIDEvent *copyEvent(IOHIDEventType type, IOHIDEvent *matching = NULL, IOOptionBits options = 0) APPLE_KEXT_OVERRIDE;
+	void update(UInt32 lux);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return 4; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 9; }
+private:
+	IOHIDEvent *event();
+	volatile UInt32 fLux;
+	volatile bool fKnown;
+	UInt32 fSaid, fSent;
+};
+OSDefineMetaClassAndStructors(SweetHIDALS, IOHIDEventService);
+static SweetHIDALS *gSweetALS;
+
+bool
+SweetHIDALS::start(IOService *provider)
+{
+	int level = 0;
+	if (!PE_parse_boot_argn("taimensensors", &level, sizeof(level)) || level < 8) {
+		return false;
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	gSweetALS = this;
+	registerService();
+	IOLog("TAIMEN SENSORS: SweetHIDALS up (0xff00/4, the SLPI's ambient light, lux)\n");
+	return true;
+}
+
+IOHIDEvent *
+SweetHIDALS::event()
+{
+	return IOHIDEvent::ambientLightSensorEvent(mach_absolute_time(), fLux, fLux);
+}
+
+IOReturn
+SweetHIDALS::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	if (fSaid < 16) {
+		fSaid++;
+		char keys[160];
+		prop_keys(d, keys, sizeof(keys));
+		IOLog("SWEET HID: SweetHIDALS properties [%s] (%u samples sent)\n", keys, fSent);
+	}
+	return kIOReturnSuccess;
+}
+
+IOHIDEvent *
+SweetHIDALS::copyEvent(IOHIDEventType type, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return type == kIOHIDEventTypeAmbientLightSensor && fKnown ? event() : NULL;
+}
+
+void
+SweetHIDALS::update(UInt32 lux)
+{
+	fLux = lux;
+	fKnown = true;
+	if (fSent < 4) {
+		IOLog("TAIMEN SENSORS: ambient light %u lux (%u clients)\n", (unsigned)lux, _clients ? _clients->getCount() : 0);
+	}
+	IOHIDEvent *e = event();
+	if (e) {
+		dispatchEvent(e);
+		e->release();
+		fSent++;
+	}
+}
