+/*
+ * SwapWait (selector 6: swap id, flags, timeout; IOMobileFramebuffer kern_SwapWait): done once
+ * the presenter has copied that swap's surface, or a later one. It used to answer at once, so
+ * CA drew into a surface the presenter was still copying (paced up to 3/4 of a frame after the
+ * swap, then the panel wait and the copy): the panel showed torn and half-drawn frames, a flicker
+ * at 60 frames/s (Mesa). CA polls from IOMFBDisplay::can_update_ with flag bit 31 (do not
+ * block): busy until then, and it skips that vsync tick. Without the bit: wait, 100 ms at most.
+ * Boot-arg sweetfb_swapwait=0: the old answer.
+ */
+static int sweet_fb_swapwait = -1;
+
+IOReturn
+AppleCLCD::swapWait(uint32_t id, bool block)
+{
+	if (sweet_fb_swapwait < 0) {
+		int on = 1;
+		(void)PE_parse_boot_argn("sweetfb_swapwait", &on, sizeof(on));
+		sweet_fb_swapwait = on ? 1 : 0;
+	}
+	if (!sweet_fb_swapwait) {
+		return kIOReturnSuccess;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+	IOReturn ret = kIOReturnSuccess;
+	IOLockLock(fLock);
+	/* an id never handed out (or from before a wrap) counts as done */
+	while ((int32_t)(id - fShownID) > 0 && (int32_t)(fSwapID - id) >= 0 && !fBlanked) {
+		if (!block) {
+			ret = kIOReturnBusy;
+			break;
+		}
+		if (IOLockSleepDeadline(fLock, &fShownID, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			ret = kIOReturnTimeout;
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
