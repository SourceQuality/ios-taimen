+/* NAME in a comma-separated list */
+static bool
+sweet_name_in(const char *list, const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = list; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
 bool
 sweet_logp_match(const char *name)
