diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 8b52190..73d77c3 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -660,12 +660,23 @@ sweet_ufs_init(void)
 	sweet_log_start();
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	/*
+	 * Pixel 1 drivers: every one of them pokes MSM8996 addresses (SPMI arbiter
+	 * at 0x400f000, TLMM at 0x1010000, APC PLLs at 0x6400000, RPM msg RAM at
+	 * 0x68000, ...). On taimen (MSM8998) several of those land inside the PMIC
+	 * arbiter windows and the rest are unclaimed. Nothing of this runs until
+	 * each driver is retargeted (docs/taimen-boot-audit.md).
+	 */
+	printf("SWEET UFS: taimen: Pixel 1 keys/touch/usb/perf/gpu/wlan drivers not started\n");
+#else
 	sweet_keys_init();
 	sweet_touch_init();
 	sweet_usb_probe();
 	sweet_perf_init();
 	sweet_gpu_init();
 	sailfish_wlan_init();
+#endif
 	return 0;
 }
 
