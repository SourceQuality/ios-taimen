+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+static vm_offset_t g_gpucc;
+
+/*
+ * 0372: the GX power domain cycled, for a hang the soft reset cannot clear (boot 252: a Metal Performance
+ * Shaders kernel of PridePosterExtension ran away after reading unmapped memory; after RBBM_SW_RESET the CP
+ * never read the ring, RBBM_STATUS stayed busy, and the GPU service went off with backboardd). As Linux's
+ * adreno_recover powers the GPU down and up: the core's branches off, IO clamped, the GX GDSC collapsed until
+ * PWR_ON drops, then taimen_power_up's GX half again (BCR and GMEM reset pulses, clamp off, GDSC on, branches
+ * on). CX (the RCGs and their rates, the SMMU) stays up. No GPU register is touched while GX is off.
+ */
+static bool
+taimen_gx_cycle(void)
+{
+	vm_offset_t cc = g_gpucc != 0 ? g_gpucc : (g_gpucc = ml_io_map(GPUCC_PA, 0x2000));
+	if (cc == 0) {
+		return false;
+	}
+	wr(cc, 0x10d0, rd(cc, 0x10d0) & ~1u);                           /* rbbmtimer branch off */
+	wr(cc, 0x1098, rd(cc, 0x1098) & ~1u);                           /* gfx3d branch off */
+	bool stopped = poll(cc, 0x1098, 1u << 31, 1u << 31, 1);         /* CLK_OFF */
+	wr(cc, 0x130, rd(cc, 0x130) | 1u);                              /* clamp IO */
+	wr(cc, 0x1094, rd(cc, 0x1094) | 1u);                            /* GX GDSC: SW_COLLAPSE */
+	bool off = poll(cc, 0x1094, 1u << 31, 0, 10);                   /* PWR_ON low */
+	delay(100);
+	wr(cc, 0x1090, 1u);                                             /* GX BCR pulse */
+	delay(1);
+	wr(cc, 0x1090, 0);
+	wr(cc, 0x130, rd(cc, 0x130) | (1u << 4));                       /* GMEM reset pulse */
+	delay(1);
+	wr(cc, 0x130, rd(cc, 0x130) & ~(1u << 4));
+	wr(cc, 0x130, rd(cc, 0x130) & ~1u);                             /* clamp off */
+	wr(cc, 0x1094, rd(cc, 0x1094) & ~1u);                           /* GX GDSC on */
+	bool on = poll(cc, 0x1094, 1u << 31, 1u << 31, 1);
+	delay(10);
+	wr(cc, 0x1098, rd(cc, 0x1098) | 1u);                            /* gfx3d (retain mem/periph kept) */
+	bool b1 = poll(cc, 0x1098, 1u << 31, 0, 1);
+	wr(cc, 0x10d0, rd(cc, 0x10d0) | 1u);                            /* rbbmtimer: after GX */
+	bool b2 = poll(cc, 0x10d0, 1u << 31, 0, 1);
+	printf("SWEET GPU: GX power cycle: clock %s, GDSC %s then %s (%08x), gfx3d %s, rbbm %s\n",
+	    stopped ? "stopped" : "NOT stopped", off ? "off" : "NOT off", on ? "on" : "NOT on", rd(cc, 0x1094),
+	    b1 ? "on" : "OFF", b2 ? "on" : "OFF");
+	return off && on && b1 && b2;
+}
+#endif
