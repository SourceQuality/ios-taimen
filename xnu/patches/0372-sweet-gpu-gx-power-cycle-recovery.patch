+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+		/* 0372: what the soft reset left running, a power cycle stops */
+		if (!hard && taimen_gx_cycle()) {
+			hard = true;
+			goto again;
+		}
+#endif
 		return false;
 	}
 	/* the hung submits' fences and the kernel quads' as done, by the CPU and then by the CP */
@@ -1869,9 +1926,9 @@ gpu_recover(const char *why)
 	g_fence_when = 0;
 	smmu_report();
 	g_ready = true;
-	printf("SWEET GPU: recovered (%s) in %llu ms: soft reset (RPTR %u, RBBM_STATUS %08x), CP restarted, zap resumed, "
+	printf("SWEET GPU: recovered (%s) in %llu ms: %s (RPTR %u, RBBM_STATUS %08x), CP restarted, zap resumed, "
 	    "secure mode left, fences done up to %u (recovery %u of %d)\n", why, usecs(mach_absolute_time() - t0) / 1000,
-	    rptr, st, g_submit_seq, g_recoveries, max);
