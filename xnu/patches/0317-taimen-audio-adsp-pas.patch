--- /dev/null
+++ b/iokit/Kernel/arm/TaimenAudio.cpp
@@ -0,0 +1,695 @@
+/*
+ * taimen (MSM8998) sound through the ADSP, docs/taimen-audio-plan.md. Boot-arg taimenaudio=N runs
+ * the bring-up stages 1 through N of section 3:
+ *
+ * 1 (0317): the firmware is there: the payload blobs ADSP-MDT and ADSP-Bnn (boot-xnu.sh AUDIOFW,
+ *   the reader's fw-adsp.* copy of /vendor/firmware), TAS-FW and TAS-CAL.
+ * 2 (0317): the ADSP boots by PAS (id 1) like the A540 zap shader (bsd/dev/sweet_gpu.c zap_load):
+ *   CX at turbo over the RPM, SMP2P out (item 429, "master-kernel") in the APPS<->ADSP partition,
+ *   INIT_IMAGE with the .mdt, MEM_SETUP for a relocatable image, the .bNN segments into the
+ *   carve-out (0x8B200000, 26 MB), AUTH_AND_RESET; then READY (bit 1 of "slave-kernel" in the
+ *   ADSP's item 443) within 5 s.
+ *
+ * SMEM, the hwlock and SMP2P as TaimenModem.cpp (from ios-topaz TopazModem.cpp), with the ADSP's
+ * host id, items and doorbell bits. Only partitions APPS is a host of are read (another pair's
+ * header hung a CPU, boot 109).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" vm_map_address_t phystokv(uint64_t pa);
+extern "C" bool sweet_rpm_rail_level(uint32_t type, uint32_t level);
+extern "C" void taimen_audio_init(void);
+
+#define LOG(fmt, ...)           IOLog("TAIMEN AUDIO: " fmt "\n", ##__VA_ARGS__)
+
+#define SMEM_PA                 0x86000000ull
+#define SMEM_SIZE               0x00200000u
+#define TCSR_MUTEX_PA           0x01F40000ull
+#define SMEM_HWLOCK             3
+#define HOST_APPS               0
+#define HOST_ADSP               2
+#define ITEM_ADSP_CRASH         423
+#define ITEM_SMP2P_OUT          429             /* apps -> adsp */
+#define ITEM_SMP2P_IN           443             /* adsp -> apps */
+#define ITEM_GLINK              478
+#define ITEM_GLINK_RX           480
+
+#define APCS_GLB_PA             0x17911000ull
+#define APCS_IPC                0x008
+#define ADSP_SMP2P_BIT          10
+#define ADSP_GLINK_BIT          9
+
+#define POOL_PA                 0x8A000000ull   /* free Linux RAM below SPSS, after the modem pool */
+#define POOL_SIZE               0x00100000ull
+#define ADSP_PA                 0x8B200000ull   /* pil_adsp_region */
+#define ADSP_SIZE               0x01A00000ull
+#define ADSP_PAS_ID             1
+
+#define SCM_FN(svc, cmd)        (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+
+#define PT_LOAD                 1
+#define MDT_TYPE_MASK           (7u << 24)
+#define MDT_TYPE_HASH           (2u << 24)
+#define MDT_RELOCATABLE         (1u << 27)
+
+#define SMP2P_MAGIC             0x504D5324u     /* "$SMP" */
+#define SMP2P_MAX_ENTRY         16
+#define SLAVE_ERR_FATAL         (1u << 0)
+#define SLAVE_READY             (1u << 1)
+
+struct elf32_ehdr {
+	uint8_t  e_ident[16];
+	uint16_t e_type, e_machine;
+	uint32_t e_version, e_entry, e_phoff, e_shoff, e_flags;
+	uint16_t e_ehsize, e_phentsize, e_phnum, e_shentsize, e_shnum, e_shstrndx;
+} __attribute__((packed));
+struct elf32_phdr {
+	uint32_t p_type, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align;
+} __attribute__((packed));
+
+struct smem_global_entry { uint32_t allocated, offset, size, aux_base; } __attribute__((packed));
+struct smem_header {
+	uint32_t proc_comm[16];
+	uint32_t version[32];
+	uint32_t initialized, free_offset, available, reserved;
+	struct smem_global_entry toc[512];
+} __attribute__((packed));
+struct smem_pt_entry { uint32_t offset, size, flags; uint16_t host0, host1; uint32_t cacheline, rsvd[7]; } __attribute__((packed));
+struct smem_pt { uint8_t magic[4]; uint32_t version, num_entries, rsvd[5]; } __attribute__((packed));
+struct smem_part_hdr { uint8_t magic[4]; uint16_t host0, host1; uint32_t size, free_uncached, free_cached, rsvd[3]; } __attribute__((packed));
+struct smem_priv_entry { uint16_t canary, item; uint32_t size; uint16_t pad_data, pad_hdr; uint32_t rsvd; } __attribute__((packed));
+struct smp2p_hdr { uint32_t magic; uint8_t version, features[3]; uint16_t local_pid, remote_pid, total, valid; uint32_t flags; } __attribute__((packed));
+struct smp2p_entry { char name[16]; uint32_t value; } __attribute__((packed));
+
+static inline void mb(void) { __asm__ volatile ("dsb sy" ::: "memory"); }
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000000;
+}
+
+/* ---------------------------------------------------------------- firmware blobs */
+
+static bool
+blob(const char *name, const uint8_t **data, uint32_t *len)
+{
+	DTEntry node;
+	uint64_t const *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, (void const **)&v, &size) != kSuccess || size != 16) {
+		return false;
+	}
+	*data = (const uint8_t *)phystokv(v[0]);
+	*len = (uint32_t)v[1];
+	return true;
+}
+
+/* ---------------------------------------------------------------- the audio pool */
+
+static IOMemoryMap *pool_map;
+static uint8_t *pool;                   /* write-combined */
+static uint64_t pool_used;
+
+static bool
+pool_init(void)
+{
+	if (pool != NULL) {
+		return true;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(POOL_PA, POOL_SIZE, kIODirectionInOut);
+	pool_map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (pool_map == NULL) {
+		return false;
+	}
+	pool = (uint8_t *)pool_map->getVirtualAddress();
+	return true;
+}
+
+static void *
+pool_alloc(uint64_t size, uint64_t *pa)
+{
+	size = (size + 0xfff) & ~0xfffull;
+	if (pool == NULL || pool_used + size > POOL_SIZE) {
+		return NULL;
+	}
+	*pa = POOL_PA + pool_used;
+	void *va = pool + pool_used;
+	pool_used += size;
+	bzero(va, size);
+	return va;
+}
+
+/* ---------------------------------------------------------------- TrustZone */
+
+static uint64_t
+smc(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+	return x0;
+}
+
+/* A standard SCM call; long calls return INTERRUPTED (1): resume with x0 = 1 and x6. */
+static uint64_t
+scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t args[8] = { fn, arginfo, a, b, c, 0, 0, 0 };
+
+	smc(args);
+	for (unsigned n = 0; args[0] == 1 && n < 100000; n++) {
+		uint64_t again[8] = { 1, arginfo, a, b, c, 0, args[6], 0 };
+		memcpy(args, again, sizeof(args));
+		smc(args);
+	}
+	if (res1 != NULL) {
+		*res1 = args[1];
+	}
+	return args[0];
+}
+
+/* ---------------------------------------------------------------- SMEM and SMP2P */
+
+static IOMemoryMap *smem_map;
+static uint8_t *smem;
+static volatile uint32_t *smem_mutex, *apcs;
+
+static bool
+smem_init(void)
+{
+	if (smem != NULL) {
+		return true;
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(SMEM_PA, SMEM_SIZE, kIODirectionInOut);
+	smem_map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	smem_mutex = (volatile uint32_t *)ml_io_map(TCSR_MUTEX_PA + SMEM_HWLOCK * 0x1000, 0x1000);
+	apcs = (volatile uint32_t *)ml_io_map(APCS_GLB_PA, 0x1000);
+	if (smem_map == NULL || smem_mutex == NULL || apcs == NULL) {
+		LOG("SMEM map failed (smem %p, mutex %p, apcs %p)", smem_map, smem_mutex, apcs);
+		return false;
+	}
+	smem = (uint8_t *)smem_map->getVirtualAddress();
+	return true;
+}
+
+static struct smem_part_hdr *
+smem_partition(uint16_t a, uint16_t b)
+{
+	struct smem_pt *pt = (struct smem_pt *)(smem + SMEM_SIZE - 0x1000);
+	struct smem_pt_entry *e = (struct smem_pt_entry *)(pt + 1);
+
+	if (memcmp(pt->magic, "$TOC", 4) != 0 || pt->num_entries > 64) {
+		return NULL;
+	}
+	for (uint32_t i = 0; i < pt->num_entries; i++) {
+		if (e[i].offset != 0 && e[i].size != 0 && e[i].offset < SMEM_SIZE &&
+		    ((e[i].host0 == a && e[i].host1 == b) || (e[i].host0 == b && e[i].host1 == a))) {
+			return (struct smem_part_hdr *)(smem + e[i].offset);
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+smem_part_cacheline(const struct smem_part_hdr *p)
+{
+	struct smem_pt *pt = (struct smem_pt *)(smem + SMEM_SIZE - 0x1000);
+	struct smem_pt_entry *e = (struct smem_pt_entry *)(pt + 1);
+	uint32_t off = (uint32_t)((const uint8_t *)p - smem);
+	for (uint32_t i = 0; i < pt->num_entries && i < 64; i++) {
+		if (e[i].offset == off) {
+			return e[i].cacheline != 0 ? e[i].cacheline : 8;
+		}
+	}
+	return 8;
+}
+
+/* An item of a private partition, uncached list then cached list (TaimenModem.cpp, 0279). */
+static void *
+smem_part_get(struct smem_part_hdr *p, uint16_t item, uint32_t *size)
+{
+	uint8_t *e, *end;
+
+	if (p == NULL || memcmp(p->magic, "$PRT", 4) != 0 || p->free_uncached > p->size ||
+	    p->free_cached > p->size || p->free_uncached > p->free_cached) {
+		return NULL;
+	}
+	e = (uint8_t *)p + sizeof(*p);
+	end = (uint8_t *)p + p->free_uncached;
+	while (e + sizeof(struct smem_priv_entry) <= end) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5) {
+			return NULL;
+		}
+		if (h->item == item) {
+			if (size != NULL) {
+				*size = h->size - h->pad_data;
+			}
+			return e + sizeof(*h) + h->pad_hdr;
+		}
+		e += sizeof(*h) + h->pad_hdr + h->size;
+	}
+	uint32_t cl = smem_part_cacheline(p);
+	uint32_t hdr = (uint32_t)((sizeof(struct smem_priv_entry) + cl - 1) / cl * cl);
+	e = (uint8_t *)p + p->size - hdr;
+	end = (uint8_t *)p + p->free_cached;
+	while (e > end && e >= (uint8_t *)p + sizeof(*p)) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)e;
+		if (h->canary != 0xA5A5 || h->size > p->size) {
+			return NULL;
+		}
+		if (h->item == item) {
+			if (size != NULL) {
+				*size = h->size - h->pad_data;
+			}
+			return e - h->size;
+		}
+		e -= h->size + hdr;
+	}
+	return NULL;
+}
+
+static void *
+smem_global_get(uint16_t item, uint32_t *size)
+{
+	struct smem_header *h = (struct smem_header *)smem;
+	if (item >= 512 || !h->toc[item].allocated || h->toc[item].offset >= SMEM_SIZE) {
+		return NULL;
+	}
+	if (size != NULL) {
+		*size = h->toc[item].size;
+	}
+	return smem + h->toc[item].offset;
+}
+
+/* The TCSR hwlock: write the APPS id 1, ours if it reads back (shared with the modem thread). */
+static bool
+smem_lock(void)
+{
+	for (unsigned i = 0; i < 100000; i++) {
+		*smem_mutex = 1;
+		mb();
+		if (*smem_mutex == 1) {
+			return true;
+		}
+		IODelay(1);
+	}
+	return false;
+}
+
+static void
+smem_unlock(void)
+{
+	mb();
+	*smem_mutex = 0;
+	mb();
+}
+
+static void *
+smem_alloc(struct smem_part_hdr *p, uint16_t item, uint32_t size)
+{
+	uint32_t aligned = (size + 7) & ~7u, need = sizeof(struct smem_priv_entry) + aligned;
+	void *v = smem_part_get(p, item, NULL);
+	if (v != NULL || p == NULL || !smem_lock()) {
+		return v;
+	}
+	v = smem_part_get(p, item, NULL);
+	if (v == NULL && p->free_uncached + need <= p->free_cached) {
+		struct smem_priv_entry *h = (struct smem_priv_entry *)((uint8_t *)p + p->free_uncached);
+		h->canary = 0xA5A5;
+		h->item = item;
+		h->size = aligned;
+		h->pad_data = (uint16_t)(aligned - size);
+		h->pad_hdr = 0;
+		h->rsvd = 0;
+		v = h + 1;
+		bzero(v, aligned);
+		mb();
+		p->free_uncached += need;
+		mb();
+	} else if (v == NULL) {
+		LOG("SMEM partition full: %#x..%#x, need %#x", p->free_uncached, p->free_cached, need);
+	}
+	smem_unlock();
+	return v;
+}
+
+static void
+apcs_kick(unsigned bit)
+{
+	mb();
+	apcs[APCS_IPC / 4] = 1u << bit;
+	mb();
+}
+
+static volatile uint32_t *
+smp2p_find(struct smp2p_hdr *h, const char *name)
+{
+	struct smp2p_entry *e = (struct smp2p_entry *)(h + 1);
+	char want[16] = {};
+	memcpy(want, name, strlen(name) < 16 ? strlen(name) : 15);
+	for (uint32_t i = 0; i < h->valid && i < SMP2P_MAX_ENTRY; i++) {
+		if (memcmp(e[i].name, want, 16) == 0) {
+			return &e[i].value;
+		}
+	}
+	return NULL;
+}
+
+static volatile uint32_t *
+smp2p_add(struct smp2p_hdr *o, const char *name, uint32_t value)
+{
+	struct smp2p_entry *e = (struct smp2p_entry *)(o + 1);
+	volatile uint32_t *v = smp2p_find(o, name);
+	if (v != NULL || o->valid >= o->total || o->valid >= SMP2P_MAX_ENTRY) {
+		return v;
+	}
+	bzero(e[o->valid].name, sizeof(e[o->valid].name));
+	memcpy(e[o->valid].name, name, strlen(name) < 16 ? strlen(name) : 15);
+	e[o->valid].value = value;
+	mb();
+	o->valid++;
+	apcs_kick(ADSP_SMP2P_BIT);
+	return &e[o->valid - 1].value;
+}
+
+static struct smp2p_hdr *
+smp2p_create_out(struct smem_part_hdr *p)
+{
+	struct smp2p_hdr *o = (struct smp2p_hdr *)smem_alloc(p, ITEM_SMP2P_OUT,
+	    sizeof(struct smp2p_hdr) + SMP2P_MAX_ENTRY * sizeof(struct smp2p_entry));
+	if (o == NULL || o->version != 0) {
+		return o;
+	}
+	o->magic = SMP2P_MAGIC;
+	o->local_pid = HOST_APPS;
+	o->remote_pid = HOST_ADSP;
+	o->total = SMP2P_MAX_ENTRY;
+	o->valid = 0;
+	o->features[0] = 1;                         /* SSR_ACK */
+	mb();
+	o->version = 1;                             /* validates the item */
+	apcs_kick(ADSP_SMP2P_BIT);
+	return o;
+}
+
+/* The ADSP's crash text (item 423, global heap, else the partition). */
+static void
+adsp_crash_reason(struct smem_part_hdr *part)
+{
+	uint32_t n = 0;
+	const char *r = (const char *)smem_global_get(ITEM_ADSP_CRASH, &n);
+	if (r == NULL) {
+		r = (const char *)smem_part_get(part, ITEM_ADSP_CRASH, &n);
+	}
+	if (r == NULL || n == 0) {
+		LOG("no crash reason (item %u)", ITEM_ADSP_CRASH);
+		return;
+	}
+	char buf[160];
+	uint32_t k = 0;
+	for (uint32_t i = 0; i < n && k + 1 < sizeof(buf); i++) {
+		buf[k++] = (r[i] >= 0x20 && r[i] < 0x7f) ? r[i] : (r[i] == 0 ? '\0' : '.');
+		if (r[i] == 0) {
+			break;
+		}
+	}
+	buf[k] = 0;
+	LOG("crash reason (item %u, %u bytes): %s", ITEM_ADSP_CRASH, n, buf);
+}
+
+/* ---------------------------------------------------------------- stage 1: firmware */
+
+static const uint8_t *fw_mdt;
+static uint32_t fw_mdt_len;
+
+static bool
+stage1(void)
+{
+	if (!blob("ADSP-MDT", &fw_mdt, &fw_mdt_len) || fw_mdt_len < sizeof(struct elf32_ehdr)) {
+		LOG("1: no ADSP-MDT in the payload (boot-xnu.sh AUDIOFW)");
+		return false;
+	}
+	const struct elf32_ehdr *eh = (const struct elf32_ehdr *)fw_mdt;
+	if (memcmp(eh->e_ident, "\177ELF", 4) != 0 || eh->e_ident[4] != 1 || eh->e_phentsize != sizeof(struct elf32_phdr) ||
+	    eh->e_phoff + (uint64_t)eh->e_phnum * sizeof(struct elf32_phdr) > fw_mdt_len) {
+		LOG("1: ADSP-MDT (%u bytes) is not a 32-bit ELF with its program headers", fw_mdt_len);
+		return false;
+	}
+	unsigned have = 0, want = 0;
+	uint64_t total = fw_mdt_len;
+	const struct elf32_phdr *ph = (const struct elf32_phdr *)(fw_mdt + eh->e_phoff);
+	for (unsigned i = 0; i < eh->e_phnum; i++) {
+		if (ph[i].p_type != PT_LOAD || (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH ||
+		    ph[i].p_memsz == 0 || ph[i].p_filesz == 0) {
+			continue;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "ADSP-B%02u", i);
+		const uint8_t *d;
+		uint32_t n;
+		want++;
+		if (blob(name, &d, &n) && n == ph[i].p_filesz) {
+			have++;
+			total += n;
+		} else {
+			LOG("1: segment %u (paddr %#x, filesz %#x): %s missing or the wrong size", i, ph[i].p_paddr,
+			    ph[i].p_filesz, name);
+		}
+	}
+	const uint8_t *d;
+	uint32_t tas = 0, cal = 0;
+	(void)blob("TAS-FW", &d, &tas);
+	(void)blob("TAS-CAL", &d, &cal);
+	LOG("1: firmware: adsp.mdt %u bytes, %u program headers, %u/%u segments (%llu bytes in all); "
+	    "TAS2557 firmware %u bytes, calibration %u bytes", fw_mdt_len, eh->e_phnum, have, want, total, tas, cal);
+	return have == want && want > 0;
+}
+
+/* ---------------------------------------------------------------- stage 2: ADSP by PAS */
+
+static struct smem_part_hdr *adsp_part;
+static struct smp2p_hdr *smp2p_out;
+
+/* mainline qcom_mdt_load (__qcom_mdt_load) + qcom_scm_pas_auth_and_reset for the split adsp.* */
+static bool
+pas_boot(void)
+{
+	const struct elf32_ehdr *eh = (const struct elf32_ehdr *)fw_mdt;
+	const struct elf32_phdr *ph = (const struct elf32_phdr *)(fw_mdt + eh->e_phoff);
+	uint64_t r1 = 0;
+	uint64_t r = scm(SCM_FN(2, 7), 1, ADSP_PAS_ID, 0, 0, &r1);
+	LOG("2: PAS_IS_SUPPORTED(%u) -> %lld/%llu", ADSP_PAS_ID, (int64_t)r, r1);
+
+	/* the metadata (ELF header, program headers, hash segment), contiguous for TZ */
+	uint64_t meta_pa = 0;
+	uint8_t *meta = (uint8_t *)pool_alloc(fw_mdt_len, &meta_pa);
+	if (meta == NULL) {
+		LOG("2: no pool room for the %u-byte metadata", fw_mdt_len);
+		return false;
+	}
+	memcpy(meta, fw_mdt, fw_mdt_len);
+	mb();
+	r = scm(SCM_FN(2, 1), 2u | (2u << 6), ADSP_PAS_ID, meta_pa, 0, &r1);
+	LOG("2: PAS_INIT_IMAGE(%u, meta %#llx, %u bytes) -> %lld/%llu", ADSP_PAS_ID, meta_pa, fw_mdt_len, (int64_t)r, r1);
+	if (r != 0 || r1 != 0) {
+		return false;
+	}
+
+	uint32_t lo = ~0u, hi = 0;
+	bool reloc = false;
+	for (unsigned i = 0; i < eh->e_phnum; i++) {
+		if (ph[i].p_type != PT_LOAD || (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH || ph[i].p_memsz == 0) {
+			continue;
+		}
+		reloc |= (ph[i].p_flags & MDT_RELOCATABLE) != 0;
+		lo = MIN(lo, ph[i].p_paddr);
+		hi = MAX(hi, (ph[i].p_paddr + ph[i].p_memsz + 0xfff) & ~0xfffu);
+	}
+	uint64_t base = ADSP_PA;
+	if (reloc) {
+		r = scm(SCM_FN(2, 2), 3, ADSP_PAS_ID, ADSP_PA, hi - lo, &r1);
+		LOG("2: relocatable image %#x..%#x: PAS_MEM_SETUP(%#llx + %#x) -> %lld/%llu", lo, hi, ADSP_PA,
+		    hi - lo, (int64_t)r, r1);
+		if (r != 0 || r1 != 0) {
+			return false;
+		}
+		base = lo;
+	} else {
+		LOG("2: image at %#x..%#x (not relocatable)", lo, hi);
+	}
+
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(ADSP_PA, ADSP_SIZE, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);
+	if (map == NULL) {
+		LOG("2: carve-out map failed");
+		return false;
+	}
+	uint8_t *region = (uint8_t *)map->getVirtualAddress();
+	bool ok = true;
+	uint64_t copied = 0, t0 = now_ms();
+	for (unsigned i = 0; i < eh->e_phnum && ok; i++) {
+		if (ph[i].p_type != PT_LOAD || (ph[i].p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH || ph[i].p_memsz == 0) {
+			continue;
+		}
+		uint64_t off = (uint64_t)ph[i].p_paddr - (reloc ? base : ADSP_PA);
+		if (ph[i].p_paddr < (reloc ? base : ADSP_PA) || off + ph[i].p_memsz > ADSP_SIZE ||
+		    ph[i].p_filesz > ph[i].p_memsz) {
+			LOG("2: segment %u (paddr %#x, memsz %#x) does not fit the carve-out", i, ph[i].p_paddr, ph[i].p_memsz);
+			ok = false;
+			break;
+		}
+		if (ph[i].p_filesz != 0) {
+			char name[16];
+			snprintf(name, sizeof(name), "ADSP-B%02u", i);
+			const uint8_t *d;
+			uint32_t n;
+			if (!blob(name, &d, &n) || n != ph[i].p_filesz) {
+				LOG("2: %s missing", name);
+				ok = false;
+				break;
+			}
+			memcpy(region + off, d, n);
+			copied += n;
+		}
+		if (ph[i].p_memsz > ph[i].p_filesz) {
+			bzero(region + off + ph[i].p_filesz, ph[i].p_memsz - ph[i].p_filesz);
+		}
+	}
+	mb();
+	map->release();
+	if (!ok) {
+		return false;
+	}
+	LOG("2: %llu bytes of segments into the carve-out in %llu ms", copied, now_ms() - t0);
+
+	r = scm(SCM_FN(2, 5), 1, ADSP_PAS_ID, 0, 0, &r1);
+	LOG("2: PAS_AUTH_AND_RESET(%u) -> %lld/%llu", ADSP_PAS_ID, (int64_t)r, r1);
+	return r == 0 && r1 == 0;
+}
+
+static bool
+stage2(void)
+{
+	if (!pool_init() || !smem_init()) {
+		LOG("2: pool or SMEM map failed");
+		return false;
+	}
+	adsp_part = smem_partition(HOST_APPS, HOST_ADSP);
+	if (adsp_part == NULL || memcmp(adsp_part->magic, "$PRT", 4) != 0) {
+		LOG("2: no APPS<->ADSP SMEM partition");
+		return false;
+	}
+	/* never over a DSP that already ran (ios-topaz 0144): its items would be stale */
+	uint32_t n = 0;
+	if (smem_part_get(adsp_part, ITEM_SMP2P_IN, &n) != NULL || smem_part_get(adsp_part, ITEM_GLINK_RX, &n) != NULL) {
+		LOG("2: the ADSP's SMP2P (%u) or GLINK FIFO (%u) is already in SMEM: stale state, not booting it",
+		    ITEM_SMP2P_IN, ITEM_GLINK_RX);
+		return false;
+	}
+	LOG("2: APPS<->ADSP partition at %#x, %u bytes, free %#x..%#x", (uint32_t)((uint8_t *)adsp_part - smem),
+	    adsp_part->size, adsp_part->free_uncached, adsp_part->free_cached);
+	/* proxy votes, kept for the run: CX at turbo ("rwcx" level 384); XO stays on with APPS */
+	bool cx = sweet_rpm_rail_level(0x78637772u, 0x180);
+	LOG("2: CX turbo vote: %s", cx ? "ok" : "FAILED");
+
+	smp2p_out = smp2p_create_out(adsp_part);
+	if (smp2p_out == NULL || smp2p_add(smp2p_out, "master-kernel", 0) == NULL) {
+		LOG("2: SMP2P out (item %u) failed", ITEM_SMP2P_OUT);
+		return false;
+	}
+	uint64_t t0 = now_ms();
+	if (!pas_boot()) {
+		return false;
+	}
+	uint64_t t1 = now_ms(), seen = 0;
+	struct smp2p_hdr *in = NULL;
+	volatile uint32_t *slave = NULL;
+	while (now_ms() - t1 < 5000) {
+		if (in == NULL && (in = (struct smp2p_hdr *)smem_part_get(adsp_part, ITEM_SMP2P_IN, &n)) != NULL) {
+			seen = now_ms() - t1;
+		}
+		if (in != NULL && in->magic == SMP2P_MAGIC && slave == NULL) {
+			slave = smp2p_find(in, "slave-kernel");
+		}
+		if (slave != NULL && (*slave & (SLAVE_READY | SLAVE_ERR_FATAL)) != 0) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (in == NULL) {
+		LOG("2: no SMP2P from the ADSP (item %u) within 5 s of the reset", ITEM_SMP2P_IN);
+		adsp_crash_reason(adsp_part);
+		return false;
+	}
+	LOG("2: ADSP SMP2P item %u after %llu ms: v%u features %#x pids %u->%u, %u/%u entries", ITEM_SMP2P_IN, seen,
+	    in->version, in->features[0], in->local_pid, in->remote_pid, in->valid, in->total);
+	struct smp2p_entry *e = (struct smp2p_entry *)(in + 1);
+	for (uint32_t i = 0; i < in->valid && i < SMP2P_MAX_ENTRY; i++) {
+		char nm[17] = {};
+		memcpy(nm, e[i].name, 16);
+		LOG("2:   entry '%s' = %#x", nm, e[i].value);
+	}
+	if (slave == NULL || (*slave & SLAVE_ERR_FATAL) != 0 || (*slave & SLAVE_READY) == 0) {
+		LOG("2: ADSP not ready: slave-kernel %s %#x", slave != NULL ? "=" : "absent", slave != NULL ? *slave : 0);
+		adsp_crash_reason(adsp_part);
+		return false;
+	}
+	LOG("2: M2 ADSP READY %llu ms after AUTH_AND_RESET (%llu ms from the first SCM call)", now_ms() - t1,
+	    now_ms() - t0);
+	return true;
+}
+
+/* ---------------------------------------------------------------- the thread */
+
+static void
+audio_thread(void *arg, wait_result_t)
+{
+	int level = (int)(intptr_t)arg;
+	LOG("taimenaudio=%d", level);
+	if (level >= 1 && !stage1()) {
+		return;
+	}
+	if (level >= 2 && !stage2()) {
+		return;
+	}
+	LOG("stages 1..%d done", MIN(level, 2));
+}
+
+void
+taimen_audio_init(void)
+{
+	int level = 0;
+	thread_t t;
+	(void)PE_parse_boot_argn("taimenaudio", &level, sizeof(level));
+	if (level <= 0) {
+		return;
+	}
+	if (kernel_thread_start(audio_thread, (void *)(intptr_t)level, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
