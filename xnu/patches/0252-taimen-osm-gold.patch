+/*
+ * A1 (taimenosm=ROW, gold only, needs cpus=8): CPRh apc1 in open loop, then the gold OSM, as
+ * downstream Linux 4.4 sets them up (clock-osm.c, cpr3-regulator.c, cprh-kbss-regulator.c). The
+ * values are this phone's (fuse combo 19: speed bin 2, revision 3), worked out with the source
+ * lines in docs/taimen-osm-cprh.md (sections in brackets below). Gold enters the OSM on GPLL0 as
+ * under Linux (G1 does not run); the OSM starts at row 0 (300 MHz, 652 mV) and steps up the
+ * all-core rows to ROW (19 = 1728, 21 = 1881.6, 33 = 2361.6 MHz). From then on the OSM's
+ * sequencer sets the PLL, the GFMUX, the APM and MEM-ACC, and CPRh sends each row's voltage to S13
+ * through the L2 SAW; XNU only writes the desired row. A refusal before the OSM is on leaves gold
+ * to G1 (taimengold).
+ */
+#define TO_OSM_PA       0x179c2000u     /* gold OSM (perfcl) */
+#define TO_CPRH_PA      0x179c4000u     /* CPRh apc1 */
+#define TO_SAW_PA       0x17812000u     /* gold L2 SAW4 */
+#define TO_GCC_PA       0x148000u       /* rbcpr CBCR +0x8, RCG +0x44; hmss_gpll0 RCG +0x5c */
+#define TO_APCS_PA      0x179d1000u     /* OSM clock RCG +0x12c; gold MEM-ACC +0x368..+0x370 */
+#define TO_APM_PA       0x179d0000u     /* gold APM status +0x18 */
+
+/* CPRH_REG_CORNER(0..31) [3.3]: open-loop volts and floor in 4 mV steps over 360 mV, RO 11, quot
+ * delta, bit 29 = closed loop off; 30 and 31 are the APM (880 mV) and MEM-ACC (852 mV) crossovers. */
+static const uint32_t to_corner[32] = {
+	0x36004149, 0x36004149, 0x36004149, 0x36004149, 0x36004149, 0x36004149, 0x36004149, 0x36004149,
+	0x36004149, 0x36004149, 0x36004149, 0x36004149, 0x3607444b, 0x36144850, 0x36204d55, 0x362e525a,
+	0x363a575f, 0x36475c64, 0x36556068, 0x3661656d, 0x36726e74, 0x36807b7d, 0x368e7b84, 0x369d838d,
+	0x36ac8b95, 0x36be959f, 0x36ca9ba5, 0x36d5a1ab, 0x36d9a3ad, 0x36dda5af, 0x20008282, 0x20007b7b,
+};
+
+/* The bin-2 LUT [5.2]: FREQ (src/div/cores/L), VOLT (VC << 16 | mV), OVERRIDE, SPARE (MEM-ACC level). */
+static const struct {
+	uint32_t freq, volt, ovr, spare;
+} to_lut[35] = {
+	{0x0004000f, 0x0000028c, 0x01200020, 1}, {0x05040012, 0x0001028c, 0x01200020, 1},
+	{0x05040016, 0x0002028c, 0x02200020, 1}, {0x0504001a, 0x0003028c, 0x02200020, 1},
+	{0x0504001e, 0x0004028c, 0x02200020, 1}, {0x05040022, 0x0005028c, 0x03200020, 1},
+	{0x05040026, 0x0006028c, 0x03200020, 1}, {0x0504002a, 0x0007028c, 0x03220022, 1},
+	{0x0404002f, 0x0008028c, 0x04260026, 1}, {0x04040033, 0x0009028c, 0x04290029, 1},
+	{0x04040037, 0x000a028c, 0x052c002c, 1}, {0x0404003b, 0x000b028c, 0x052f002f, 1},
+	{0x0404003e, 0x000c0294, 0x05320032, 2}, {0x04040042, 0x000d02a8, 0x06350035, 2},
+	{0x04040046, 0x000e02bc, 0x06380038, 2}, {0x0404004a, 0x000f02d0, 0x063b003b, 2},
+	{0x0404004e, 0x001002e4, 0x073e003e, 2}, {0x04040052, 0x001102f8, 0x07420042, 2},
+	{0x04040056, 0x00120308, 0x07450045, 2}, {0x0404005a, 0x0013031c, 0x08480048, 2},
+	{0x0404005e, 0x00140338, 0x084b004b, 2}, {0x04040062, 0x0015035c, 0x094e004e, 2},
+	{0x04040066, 0x00160378, 0x09520052, 2}, {0x0404006a, 0x0017039c, 0x09550055, 3},
+	{0x0404006e, 0x001803bc, 0x0a580058, 3}, {0x04040073, 0x001903e4, 0x0a5c005c, 3},
+	{0x04010076, 0x001903e4, 0x0a5e005e, 3}, {0x04040076, 0x001a03fc, 0x0a5e005e, 3},
+	{0x0401007a, 0x001a03fc, 0x0a620062, 3}, {0x04040079, 0x001b0414, 0x0a610061, 3},
+	{0x0401007e, 0x001b0414, 0x0a650065, 3}, {0x0404007a, 0x001c041c, 0x0a620062, 3},
+	{0x0401007f, 0x001c041c, 0x0a660066, 3}, {0x0404007b, 0x001d0424, 0x0a620062, 3},
+	{0x04010080, 0x001d0424, 0x0a660066, 3},
+};
+
+/* The all-core rows above Linux's boot row 19 (26, 28, ... are single-core rows). */
+static const uint8_t to_ramp[] = {19, 20, 21, 22, 23, 24, 25, 27, 29, 31, 33};
+
+/* Sequencer registers TZ owns, through SCM io-write [5.7]: B + 0x300 + 4n, value; then B + 0x1048. */
+static const struct {
+	uint32_t pa, val;
+} to_seq[] = {
+	{0x179c2460, 31}, {0x179c23dc, 11}, {0x179c23e0, 12}, {0x179c23e4, 20}, {0x179c23e8, 21},
+	{0x179c2380, 0x62}, {0, 20}, {0x179c2420, 30}, {0x179c233c, 20}, {0x179c237c, 19}, {0x179c2430, 0x539},
+};
+
+static vm_offset_t to_cprh, to_saw, to_gcc, to_apcs, to_apm;
+
+/* One SMC64 to TZ, atomic calls only (no INTERRUPTED, no retry) [5.11]. Returns x0; *r1 = x1. */
+static int64_t
+to_smc(uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t *r1)
+{
+	register uint64_t x0 __asm__("x0") = a0, x1 __asm__("x1") = a1, x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3, x4 __asm__("x4") = 0, x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0, x7 __asm__("x7") = 0;
+	__asm__ volatile("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    :
+	    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	if (r1 != NULL) {
+		*r1 = x1;
+	}
+	return (int64_t)x0;
+}
+
+static void
+to_rmw(vm_offset_t b, uint32_t off, uint32_t clear, uint32_t set)
+{
+	clk_wr(b, off, (clk_rd(b, off) & ~clear) | set);
+}
+
+/* RCG update (clock-local2.c): CFG = CMD + 4, [10:8] source, [4:0] 2 x div - 1, then CMD bit 0 [1]. */
+static bool
+to_rcg(vm_offset_t b, uint32_t cmd, uint32_t src_div)
+{
+	to_rmw(b, cmd + 4, 0x71fu, src_div);
+	to_rmw(b, cmd, 0, 1u);
+	return tg_poll(b, cmd, 1u, 0u, 500);
+}
+
+static unsigned
+to_s13_mv(void)
+{
+	uint8_t lo = 0, hi = 0;
+	return sweet_pmic_read(0x138, 0x40, &lo) && sweet_pmic_read(0x138, 0x41, &hi) ? (unsigned)hi << 8 | lo : 0;
+}
+
+static void
+to_state(const char *tag)
+{
+	printf("TAIMEN OSM: %s: enable %#x row %u pstate %#x | cprh status %#x ctl %#x | S13 %u mV saw %#x | "
+	    "pll L %#x gfmux %#x | apm %#x memacc %#x\n", tag, clk_rd(to_osm, 0x1004), clk_rd(to_osm, 0x1f10),
+	    clk_rd(to_osm, 0x1c00), clk_rd(to_cprh, 0x3aa4), clk_rd(to_cprh, 0x3aa0), to_s13_mv(),
+	    clk_rd(to_saw, 0xc18), clk_rd(tg_pll, 0x4), clk_rd(tg_mux, 0x54), clk_rd(to_apm, 0x18),
+	    clk_rd(to_apcs, 0x370));
+}
+
+/* CPRh apc1, in Linux's order, closed loop off (MARGIN_ADJ_CTL bit 4 = 0, CORNER bit 29) [3.2]. */
+static bool
+to_cprh_init(void)
+{
+	clk_wr(to_cprh, 0xcc, 0x13);                    /* GCNT(11): 1000 ns at 19.2 MHz, - 1 */
+	clk_wr(to_cprh, 0xc, 0x17700);                  /* TIMER_AUTO_CONT: 5 ms */
+	clk_wr(to_cprh, 0x4, 0x21e);                    /* CPR_CTL: idle 15, count repeat 1, loop off */
+	clk_wr(to_cprh, 0x14, 0x389);                   /* STEP_QUOT: min 9, max 14 */
+	for (uint32_t n = 0; n < 9; n++) {
+		clk_wr(to_cprh, 0x200 + 4 * n, 0);      /* SENSOR_OWNER: thread 0 */
+	}
+	clk_wr(to_cprh, 0x808, 0x4202);                 /* THRESH(0) */
+	clk_wr(to_cprh, 0x80c, 0xffff);                 /* RO_MASK(0) */
+	to_rmw(to_cprh, 0x7f8, 1u << 4, 0);             /* MARGIN_ADJ_CTL: HW closed loop off */
+	clk_wr(to_cprh, 0x80c, 0xf7ff);                 /* RO 11 only */
+	for (uint32_t ro = 0; ro < 16; ro++) {
+		clk_wr(to_cprh, 0x840 + 4 * ro, ro == 11 ? 0x3ed : 0);  /* TARGET_QUOT: base quotient 1005 */
+	}
+	for (uint32_t i = 0; i < 32; i++) {
+		clk_wr(to_cprh, 0x3a00 + 4 * i, to_corner[i]);
+	}
+	to_rmw(to_cprh, 0x7f8, 0x1fu << 12, 4u << 12);  /* PMIC step 4 mV (saw-use-unit-mV) */
+	to_rmw(to_cprh, 0x7a4, 0x1fu << 5, 1u << 5);    /* SAW_ERROR_STEP_LIMIT down 1 */
+	to_rmw(to_cprh, 0x7a4, 0x1fu, 1u);              /* up 1 */
+	to_rmw(to_cprh, 0x7f8, 0x3fu << 26, 0);         /* KV step quot 0 */
+	to_rmw(to_cprh, 0x7f8, 0, 1u << 7);             /* per-RO KV margin (dynamic step quot) */
+	to_rmw(to_cprh, 0x7a8, 0x7ffu << 18, 33u << 18); /* settle 1760 ns */
+	to_rmw(to_cprh, 0x3aa0, 0xffu << 17, 5u << 17);  /* mode switch delay 1042 ns / 4 */
+	to_rmw(to_cprh, 0x3aa0, 0x1e0007ffu, 4u << 25 | 90u << 1 | 1u);  /* x 4 mV, base 360 mV, OSM on */
+	to_rmw(to_cprh, 0x4, 0, 1u);                    /* loop enable */
+	uint32_t cc = clk_rd(to_cprh, 0x4), mc = clk_rd(to_cprh, 0x7f8), ctl = clk_rd(to_cprh, 0x3aa0);
+	uint32_t c19 = clk_rd(to_cprh, 0x3a4c);
+	printf("TAIMEN OSM: cprh apc1: CPR_CTL %#x MARGIN_ADJ %#x CTL %#x CORNER(19) %#x\n", cc, mc, ctl, c19);
+	return cc == 0x21f && (ctl & 0x1e1fffffu) == 0x080a00b5u && c19 == to_corner[19];
+}
+
+/* Gold OSM registers, Linux's order without ACD [5.1-5.8]; false if TZ refuses a sequencer write. */
+static bool
+to_osm_init(void)
+{
+	clk_wr(to_osm, 0x1f00, 0x13);                   /* cycle counter: on, 200 / 19.2 MHz - 1 */
+	for (uint32_t i = 0; i < 40; i++) {
+		uint32_t r = i < 35 ? i : 34, o = 0x1150 + 32 * i;
+		clk_wr(to_osm, o, i);
+		clk_wr(to_osm, o + 0x4, to_lut[r].freq);
+		clk_wr(to_osm, o + 0x8, to_lut[r].volt);
+		clk_wr(to_osm, o + 0xc, to_lut[r].ovr);
+		clk_wr(to_osm, o + 0x14, to_lut[r].spare);
+	}
+	(void)clk_rd(to_osm, 0x0);
+	/* policy [5.3]: core-count hysteresis 1 us each way, power collapse -> row 0, retention active */
+	to_rmw(to_osm, 0x101c, 0, 0xc8u << 16);
+	to_rmw(to_osm, 0x101c, 0, 0xc8u);
+	clk_wr(to_osm, 0x100c, 1);
+	(void)clk_rd(to_osm, 0x0);
+	clk_wr(to_osm, 0x1024, 0);
+	clk_wr(to_osm, 0x1020, 0);
+	/* LLM [5.4] */
+	to_rmw(to_osm, 0x102c, 0, 0xffffu << 16);
+	to_rmw(to_osm, 0x102c, 0, 0xffffu);
+	to_rmw(to_osm, 0x1034, 0, 0);
+	to_rmw(to_osm, 0x1030, 0, 0xffffu << 16);
+	to_rmw(to_osm, 0x1030, 0, 0xffffu);
+	to_rmw(to_osm, 0x1034, 0, 0);
+	/* FSMs [5.5]: boost, safe, PS, WFx and PC droop, DCVS droop */
+	static const uint32_t fsm[][2] = {
+		{0x1070, 1u << 0}, {0x1074, 0x03e807d0}, {0x1078, 0x07d007d0}, {0x107c, 0xc8},
+		{0x1070, 1u << 2}, {0x1084, 0x03e807d0}, {0x1088, 0x07d007d0}, {0x108c, 0xc8},
+		{0x1070, 1u << 1}, {0x1094, 0x03e807d0}, {0x1098, 0x07d007d0}, {0x109c, 0xc8},
+	};
+	for (unsigned i = 0; i < sizeof(fsm) / sizeof(fsm[0]); i++) {
+		to_rmw(to_osm, fsm[i][0], 0, fsm[i][1]);
+	}
+	clk_wr(to_osm, 0x10a0, 5);
+	to_rmw(to_osm, 0x1070, 0, 1u << 4);
+	to_rmw(to_osm, 0x10ac, 0, 0x64u << 16);
+	to_rmw(to_osm, 0x10b0, 0, 0x32u << 16);
+	to_rmw(to_osm, 0x1070, 0, 1u << 3);
+	to_rmw(to_osm, 0x10ac, 0, 0x64u);
+	to_rmw(to_osm, 0x10b0, 0, 0x32u);
+	to_rmw(to_osm, 0x1070, 0, 1u << 5);
+	clk_wr(to_osm, 0x10bc, 1);
+	clk_wr(to_osm, 0x10a8, 1);
+	clk_wr(to_osm, 0x10b8, 0x64);
+	to_rmw(to_osm, 0x10a4, 0, 0x80020008u);
+	to_rmw(to_osm, 0x10c0, 0, 1u);
+	printf("TAIMEN OSM: gold LUT, policy, LLM and FSMs written: FSM ctrl %#x droop %#x\n",
+	    clk_rd(to_osm, 0x1070), clk_rd(to_osm, 0x10a4));
+	/* MEM-ACC and APM thresholds for the sequencer [5.7-5.8] */
+	for (unsigned i = 0; i < sizeof(to_seq) / sizeof(to_seq[0]); i++) {
+		if (to_seq[i].pa == 0) {
+			clk_wr(to_osm, 0x1048, to_seq[i].val);  /* SEQ_REG1: the APM threshold VC, plain */
+			continue;
+		}
+		int64_t r = to_smc(0xc2000502ull, 2, to_seq[i].pa, to_seq[i].val, NULL);
+		if (r != 0) {
+			printf("TAIMEN OSM: scm io-write %#x = %#x -> %lld: stop\n", to_seq[i].pa, to_seq[i].val, r);
+			return false;
+		}
+	}
+	printf("TAIMEN OSM: 10 sequencer writes through TZ ok\n");
+	return true;
+}
+
+/* Row r: every gold core must run at the row's clock (1 %) and give CPU0's self-test result. */
+static bool
+to_step(unsigned r, uint64_t *buf, size_t words, uint64_t ref)
+{
+	unsigned want = (to_lut[r].freq & 0xffu) * 192 / 10;
+	char tag[16], line[120];
+	int len = 0;
+	clk_wr(to_osm, 0x1f10, r);
+	(void)clk_rd(to_osm, 0x0);
+	delay(2000);
+	snprintf(tag, sizeof(tag), "row %u", r);
+	to_state(tag);
+	for (int c = 4; c < 8; c++) {
+		thread_bind(cpu_to_processor(c));
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t mhz = perf_mhz(), res = taimen_selftest(buf, words);
+		len += snprintf(line + len, sizeof(line) - (size_t)len, " cpu%d %llu MHz %s", c, mhz,
+		    res == ref ? "ok" : "MISMATCH");
+		thread_bind(cpu_to_processor(0));
+		thread_block(THREAD_CONTINUE_NULL);
+		if (res != ref) {
+			taimen_gold_park("self-test");
+			panic("TAIMEN OSM: gold cpu%d at row %u (%u MHz): self-test mismatch at %llu MHz", c, r, want,
+			    mhz);
+		}
+		if (mhz * 100 < (uint64_t)want * 99 || mhz * 100 > (uint64_t)want * 101) {
+			printf("TAIMEN OSM: row %u: cpu%d at %llu MHz, not %u:%s\n", r, c, mhz, want, line);
+			return false;
+		}
+	}
+	printf("TAIMEN OSM: gold at row %u, %u MHz:%s\n", r, want, line);
+	return true;
+}
+
+static bool
+taimen_osm(unsigned row)
+{
+	const size_t words = (1u << 20) / 8;
+	if (ml_get_cpu_count() < 8 || row >= 35 || ((to_lut[row].freq >> 16) & 7u) != 4u) {
+		printf("TAIMEN OSM: refused: row %u (needs cpus=8 and an all-core row up to 33)\n", row);
+		return false;
+	}
+	to_osm = ml_io_map(TO_OSM_PA, 0x2000);
+	to_cprh = ml_io_map(TO_CPRH_PA, 0x4000);
+	to_saw = ml_io_map(TO_SAW_PA, 0x1000);
+	to_gcc = ml_io_map(TO_GCC_PA, 0x1000);
+	to_apcs = ml_io_map(TO_APCS_PA, 0x1000);
+	to_apm = ml_io_map(TO_APM_PA, 0x1000);
+	tg_pll = ml_io_map(TG_PLL_PA, 0x1000);
+	tg_mux = ml_io_map(TG_MUX_PA, 0x1000);
+	if (!to_osm || !to_cprh || !to_saw || !to_gcc || !to_apcs || !to_apm || !tg_pll || !tg_mux) {
+		printf("TAIMEN OSM: refused: map failed\n");
+		return false;
+	}
+	uint64_t *buf = kalloc_data(words * 8, Z_WAITOK);
+	if (buf == NULL) {
+		return false;
+	}
+	thread_bind(cpu_to_processor(0));
+	thread_block(THREAD_CONTINUE_NULL);
+	const char *refuse = NULL;
+	/* S0, S1: SCM answers; the fuses are combo 19's, which every number here assumes [7] */
+	uint64_t r1 = 0;
+	int64_t r0 = to_smc(0xc2000601ull, 1, 0x82000601ull, 0, &r1);
+	uint32_t f38 = taimen_rd1(0x784130), f39 = taimen_rd1(0x78413c), f100 = taimen_rd1(0x784324);
+	uint64_t f69 = (uint64_t)taimen_rd1(0x78422c) << 32 | taimen_rd1(0x784228);
+	printf("TAIMEN OSM: scm probe %lld/%llu; fuses bin %u rev %u force-high %u gold %#llx\n", r0, r1, f38 >> 29,
+	    (f39 >> 19) & 7u, (f100 >> 13) & 1u, f69);
+	unsigned v0 = to_s13_mv();
+	if (r0 != 0 || r1 == 0) {
+		refuse = "SCM did not answer";
+	} else if ((f38 >> 29) != 2 || ((f39 >> 19) & 7u) != 3 || (f100 & (1u << 13)) ||
+	    ((f69 >> 48) & 0x3f) != 0x2b || ((f69 >> 42) & 0x3f) != 0x2b || ((f69 >> 36) & 0x3f) != 0x23 ||
+	    ((f69 >> 30) & 0x3f) != 0x22 || ((f69 >> 14) & 0xffff) != 0xbbbb) {
+		refuse = "fuses are not combo 19's";
+	} else if (clk_rd(to_osm, 0x1004) & 1u) {
+		refuse = "the OSM is already on";
+	} else if (((clk_rd(tg_mux, 0x54) >> 8) & 7u) != 4u) {
+		refuse = "gold is not on GPLL0";
+	}
+	/* S2: the CPRh clock, 19.2 MHz from CXO [1.1-1.3] */
+	if (refuse == NULL && (!to_rcg(to_gcc, 0x44, 0x001) || (to_rmw(to_gcc, 0x8, 0, 1u),
+	    !tg_poll(to_gcc, 0x8, 0xf0000000u, 0, 500)))) {
+		refuse = "rbcpr clock did not start";
+	}
