+/* a/b/c from the root */
+static bool
+fat_open_path(struct fat *f, const char *path, struct fat_file *out)
+{
+	struct fat_file cur = {}, next = {};
+	bool at_root = true;
+	char comp[128];
+	while (*path == '/') {
+		path++;
+	}
+	while (*path != 0) {
+		size_t n = 0;
+		while (path[n] != 0 && path[n] != '/') {
+			n++;
+		}
+		if (n == 0 || n >= sizeof(comp) || (!at_root && !cur.dir)) {
+			return false;
+		}
+		memcpy(comp, path, n);
+		comp[n] = 0;
+		if (!fat_lookup(f, at_root ? NULL : &cur, comp, &next)) {
+			return false;
+		}
+		cur = next;
+		at_root = false;
+		path += n;
+		while (*path == '/') {
+			path++;
+		}
+	}
+	if (at_root) {
+		return false;
+	}
+	*out = cur;
+	return true;
 }
 
