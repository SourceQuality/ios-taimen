+/* the modem's path -> a modem_a path: /readonly/firmware/image/x -> image/x */
+static const char *
+tftp_map(const char *path)
+{
+	static const char *pre[] = {
+		"/readonly/firmware/", "/readonly/vendor/firmware_mnt/", "/readonly/vendor/firmware/",
+	};
+	for (unsigned i = 0; i < sizeof(pre) / sizeof(pre[0]); i++) {
+		size_t l = strlen(pre[i]);
+		if (strncmp(path, pre[i], l) == 0) {
+			return path + l;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+dec(const char *p)
+{
+	uint32_t v = 0;
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (uint32_t)(*p++ - '0');
+	}
+	return v;
+}
+
+static void
+tftp_request(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
+{
+	char buf[512], *p, *end, *file, *mode, oack[256], *o;
+	uint16_t op = (uint16_t)(d[0] << 8 | d[1]);
+	struct tftp_sess *s = NULL;
+	bool opts, want_tsize = false;
+	uint32_t timeoutms = 1000;
+	if (len < 4 || len >= sizeof(buf)) {
+		return;
+	}
+	memcpy(buf, d, len);
+	buf[len] = 0;
+	end = buf + len;
+	file = buf + 2;
+	mode = file + strlen(file) + 1;
+	if (mode >= end) {
+		return;
+	}
+	p = mode + strlen(mode) + 1;
+	opts = p < end;
+	for (unsigned i = 0; i < 16; i++) {
+		if (!sess[i].used) {
+			s = &sess[i];
+			break;
+		}
+	}
+	if (s == NULL) {
+		LOG("M6: tftp: out of sessions");
+		return;
+	}
+	bzero(s, sizeof(*s));
+	s->used = true;
+	s->write = op == OP_WRQ;
+	s->port = next_sess_port++;
+	s->node = node;
+	s->rport = port;
+	s->blk = 512;
+	s->wsize = 1;
+	s->rw = -1;
+	while (p < end) {
+		char *name = p, *val = p + strlen(p) + 1;
+		if (val >= end) {
+			break;
+		}
+		uint32_t v = dec(val);
+		if (strcmp(name, "blksize") == 0) {
+			s->blk = MAX(8u, MIN(v, 16384u));
+		} else if (strcmp(name, "timeoutms") == 0) {
+			timeoutms = v;
+		} else if (strcmp(name, "tsize") == 0) {
+			want_tsize = true;
+		} else if (strcmp(name, "rsize") == 0) {
+			s->rsize = v;
+		} else if (strcmp(name, "wsize") == 0) {
+			s->wsize = MAX(1u, v);
+		} else if (strcmp(name, "seek") == 0) {
+			s->seek = v;
+		}
+		p = val + strlen(val) + 1;
+	}
+	tftp_reqs++;
+	if (strncmp(file, "/readwrite/", 11) == 0) {
+		s->rw = rw_find(file, s->write);
+	}
+	if (s->write) {
+		tftp_writes++;
+		LOG("M6: t=%u ms: tftp WRQ %s seek %u%s", g_ms, file, s->seek, s->rw < 0 ? " (no RAM slot, dropped)" : "");
+		if (s->rw >= 0 && s->seek == 0) {
+			rw_files[s->rw].size = 0;       /* a write from the start replaces the file */
+		}
+	} else if (s->rw >= 0) {
+		s->size = rw_files[s->rw].size;
+		LOG("M6: t=%u ms: tftp RRQ %s (RAM, %llu B)", g_ms, file, s->size);
+	} else {
+		const char *rel = tftp_map(file);
+		if (rel == NULL || !fat_open_path(&modem_fs, rel, &s->ff) || s->ff.dir) {
+			tftp_missing++;
+			LOG("M6: t=%u ms: tftp RRQ %s: not found", g_ms, file);
+			tftp_error(s, 1, "file not found");
+			tftp_close(s);
+			return;
+		}
+		s->size = s->ff.size;
+		LOG("M6: t=%u ms: tftp RRQ %s seek %u rsize %u blk %u w %u (%llu B)", g_ms, rel, s->seek, s->rsize, s->blk,
+		    s->wsize, s->size);
+	}
+	if (!opts) {
+		if (s->write) {
+			uint8_t ack[4] = { 0, OP_ACK, 0, 0 };
+			tftp_send(s, ack, 4);
+		} else {
+			tftp_data(s, 1, 0, 0);
+		}
+		return;
+	}
+	o = oack;
+	*o++ = 0;
+	*o++ = OP_OACK;
+	o = tftp_opt(o, oack + sizeof(oack), "blksize", s->blk);
+	o = tftp_opt(o, oack + sizeof(oack), "timeoutms", timeoutms);
+	if (want_tsize && !s->write) {
+		o = tftp_opt(o, oack + sizeof(oack), "tsize", s->size);
+	}
+	o = tftp_opt(o, oack + sizeof(oack), "wsize", s->wsize);
+	if (s->rsize != 0) {
+		o = tftp_opt(o, oack + sizeof(oack), "rsize", s->rsize);
+	}
+	if (s->seek != 0) {
+		o = tftp_opt(o, oack + sizeof(oack), "seek", s->seek);
+	}
+	tftp_send(s, oack, (uint32_t)(o - oack));
+}
+
+/* traffic on a session port: ACKs for reads, DATA for writes (tqftpserv handle_reader) */
+static bool
+tftp_session(uint32_t dst_port, const uint8_t *d, uint32_t len)
+{
+	struct tftp_sess *s = NULL;
+	for (unsigned i = 0; i < 16; i++) {
+		if (sess[i].used && sess[i].port == dst_port) {
+			s = &sess[i];
+			break;
+		}
+	}
+	if (s == NULL || len < 4) {
+		return s != NULL;
+	}
+	uint16_t op = (uint16_t)(d[0] << 8 | d[1]), blk = (uint16_t)(d[2] << 8 | d[3]);
+	if (op == OP_ERROR) {
+		/* rsize 0 + tsize is a stat: the modem ends it with ERROR 9 "End of Transfer" */
+		if (blk != 9) {
+			LOG("M6: t=%u ms: tftp sess %#x: modem ERROR %u after %llu B", g_ms, s->port, blk, s->sent);
+		}
+		tftp_close(s);
+		return true;
+	}
+	if (s->write) {
+		if (op == OP_DATA) {
+			uint32_t payload = len - 4;
+			if (s->rw >= 0 && blk >= 1) {
+				(void)rw_write(s->rw, s->seek + (uint64_t)(blk - 1) * s->blk, d + 4, payload);
+			}
+			if ((blk % s->wsize) == 0 || payload < s->blk) {
+				uint8_t ack[4] = { 0, OP_ACK, (uint8_t)(blk >> 8), (uint8_t)blk };
+				tftp_send(s, ack, 4);
+			}
+			if (payload < s->blk) {
+				tftp_close(s);
+			}
+		}
+		return true;
+	}
+	if (op != OP_ACK) {
+		tftp_error(s, 4, "Expected ACK opcode");
+		tftp_close(s);
+		return true;
+	}
+	if (s->rsize == 0) {
+		/* the whole file: blocks until a short one */
+		uint64_t total = s->size > s->seek ? s->size - s->seek : 0;
+		uint32_t last = (uint32_t)(total / s->blk) + 1;
+		if ((uint32_t)blk >= last) {
+			tftp_close(s);
+			return true;
+		}
+		for (uint32_t i = blk + 1u; i <= blk + s->wsize && i <= last; i++) {
+			if (!tftp_data(s, i, s->seek + (uint64_t)(i - 1) * s->blk, 0)) {
+				break;
+			}
+		}
+		return true;
+	}
+	if ((uint64_t)blk * s->blk > s->rsize) {
+		tftp_close(s);
+		return true;
+	}
+	for (uint32_t i = blk; i < blk + s->wsize; i++) {
+		uint64_t off = s->seek + (uint64_t)i * s->blk;
+		uint32_t rs = (i + 1) * s->blk > s->rsize ? s->rsize % s->blk : 0;
+		if (!tftp_data(s, i + 1, off, rs) || (i + 1) * s->blk > s->rsize) {
+			break;
+		}
+	}
+	return true;
+}
+
+/* rmtfs */
+#define RMTFS_BUF_SIZE          0x200000u       /* DTS qcom,rmtfs_sharedmem: dynamic, 2 MB */
+
+static const struct { const char *path, *part; } rmtfs_parts[] = {
+	{ "/boot/modem_fs1", "modemst1" },
+	{ "/boot/modem_fs2", "modemst2" },
+	{ "/boot/modem_fsc", "fsc" },
+	{ "/boot/modem_fsg", "fsg" },
+};
+static struct part rmtfs_part[4];
+static bool rmtfs_part_ok[4];
+static uint64_t rmtfs_pa;
+static uint8_t *rmtfs_va;
+static unsigned rmtfs_reads, rmtfs_writes, rmtfs_err;
+
+static void
+rmtfs_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t *d, uint32_t len)
+{
+	struct qmsg m;
+	char path[64];
+	uint16_t l = 0;
+	const uint8_t *v;
+	uint32_t caller = 0, i;
+	bool ok = true;
+	qm_init(&m, txn, msg);
+	v = qm_find(d, len, 1, &l);
+	if (msg != 1 && v != NULL && l >= 4) {
+		memcpy(&caller, v, 4);
+	}
+	switch (msg) {
+	case 1:                                     /* OPEN */
+		qm_string(d, len, 1, path, sizeof(path));
+		for (i = 0; i < 4; i++) {
+			if (strcmp(path, rmtfs_parts[i].path) == 0) {
+				break;
+			}
+		}
+		if (i < 4 && !rmtfs_part_ok[i]) {
+			rmtfs_part_ok[i] = part_open(rmtfs_parts[i].part, &rmtfs_part[i]);
+		}
+		ok = i < 4 && rmtfs_part_ok[i];
+		LOG("M6: t=%u ms: rmtfs: open %s -> %s", g_ms, path, ok ? rmtfs_parts[i].part : "FAILED");
+		qm_result(&m, ok);
+		if (ok) {
+			caller = i + 1;
+			qm_tlv(&m, 0x10, &caller, 4);
+		}
+		break;
+	case 2:                                     /* CLOSE */
+		qm_result(&m, true);
+		break;
+	case 3: {                                   /* RW_IOVEC: {sector, phys, count} x n */
+		uint16_t l2 = 0;
+		const uint8_t *dir = qm_find(d, len, 2, &l2);
+		const uint8_t *iov = qm_find(d, len, 3, &l2);
+		bool write = dir != NULL && *dir != 0;
+		ok = caller >= 1 && caller <= 4 && rmtfs_part_ok[caller - 1] && iov != NULL && l2 >= 1 &&
+		    1u + 12u * iov[0] <= l2 && rmtfs_pa != 0;
+		for (i = 0; ok && i < iov[0]; i++) {
+			uint32_t e[3];
+			memcpy(e, iov + 1 + 12 * i, 12);
+			uint64_t bytes = (uint64_t)e[2] * 512;
+			if (e[1] < rmtfs_pa || e[1] + bytes > rmtfs_pa + RMTFS_BUF_SIZE) {
+				ok = false;
+				break;
+			}
+			if (write) {
+				rmtfs_writes++;                 /* never written to the phone's EFS */
+			} else {
+				ok = part_read(&rmtfs_part[caller - 1], (uint64_t)e[0] * 512, rmtfs_va + (e[1] - rmtfs_pa),
+				    (uint32_t)bytes) == 0;
+				rmtfs_reads++;
+			}
+		}
+		if (!ok && ++rmtfs_err <= 3) {
+			LOG("M6: t=%u ms: rmtfs: iovec caller %u %s FAILED", g_ms, caller, write ? "write" : "read");
+		}
+		qm_result(&m, ok);
+		break;
+	}
+	case 4: {                                   /* ALLOC_BUFF */
+		if (rmtfs_pa == 0) {
+			uint64_t pa = 0;
+			uint8_t *va = (uint8_t *)pool_alloc(RMTFS_BUF_SIZE, &pa);
+			static const uint32_t hlos[] = {VMID_HLOS}, both[] = {VMID_HLOS, VMID_MSS_MSA};
+			static const uint32_t both_perm[] = {PERM_RW, PERM_RW};
+			uint64_t ar = va != NULL ? scm_assign(pa, RMTFS_BUF_SIZE, hlos, 1, both, both_perm, 2) : ~0ull;
+			LOG("M6: t=%u ms: rmtfs buffer %#llx+%#x to HLOS+MSS_MSA -> %#llx", g_ms, pa, RMTFS_BUF_SIZE, ar);
+			if (ar == 0) {
+				rmtfs_pa = pa;
+				rmtfs_va = va;
+			}
+		}
+		LOG("M6: t=%u ms: rmtfs: alloc for caller %u -> %#llx", g_ms, caller, rmtfs_pa);
+		ok = rmtfs_pa != 0;
+		qm_result(&m, ok);
+		if (ok) {
+			uint64_t a = rmtfs_pa;
+			qm_tlv(&m, 0x10, &a, 8);
+		}
+		break;
+	}
+	case 5: {                                   /* GET_DEV_ERROR */
+		uint8_t st = 0;
+		qm_result(&m, true);
+		qm_tlv(&m, 0x10, &st, 1);
+		break;
+	}
+	default:
+		LOG("M6: t=%u ms: rmtfs: msg %#x", g_ms, msg);
+		qm_result(&m, false);
+		break;
+	}
+	qm_send(&m, PORT_RMTFS, node, port);
+}
+
+static void
+svc_announce(void)
+{
+	static const uint32_t svc[][3] = {
+		{ 0x40, 0x101, PORT_PDM },              /* servreg-locator, version 0x101 instance 0 */
+		{ 4096, 1,     PORT_TFTP },             /* tftp */
+		{ 14,   1,     PORT_RMTFS },            /* rmtfs */
+	};
+	for (unsigned i = 0; i < 3; i++) {
+		struct qrtr_ctrl c = { QRTR_TYPE_NEW_SERVER, svc[i][0], svc[i][1], QRTR_NODE_APPS, svc[i][2] };
+		qrtr_send(QRTR_TYPE_NEW_SERVER, QRTR_PORT_CTRL, q_modem_node, QRTR_PORT_CTRL, &c, sizeof(c));
+	}
+	LOG("M6: t=%u ms: announced pd-mapper 0x40, tftp 0x1000, rmtfs 0x0e", g_ms);
+}
+
+static bool
+svc_rx(uint32_t src_node, uint32_t src_port, uint32_t dst_port, const uint8_t *data, uint32_t len)
+{
+	if (dst_port == PORT_TFTP) {
+		if (len >= 2 && (data[1] == OP_RRQ || data[1] == OP_WRQ)) {
+			tftp_request(src_node, src_port, data, len);
+		}
+		return true;
+	}
+	if (dst_port >= PORT_SESS && dst_port < PORT_SESS + 0x10000) {
+		return tftp_session(dst_port, data, len);
+	}
+	if (len < 7 || data[0] != QMI_REQ) {
+		return false;
+	}
+	uint16_t txn, msg;
+	memcpy(&txn, data + 1, 2);
+	memcpy(&msg, data + 3, 2);
+	if (dst_port == PORT_PDM) {
+		pdm_rx(src_node, src_port, txn, msg, data, len);
+		return true;
+	}
+	if (dst_port == PORT_RMTFS) {
+		rmtfs_rx(src_node, src_port, txn, msg, data, len);
+		return true;
+	}
+	return false;
+}
+
+static void
+svc_summary(void)
+{
+	LOG("M6: pd-mapper %u reqs; tftp %u reqs (%u missing, %u writes); rmtfs reads %u writes %u (not kept) "
+	    "errors %u", pd_reqs, tftp_reqs, tftp_missing, tftp_writes, rmtfs_reads, rmtfs_writes, rmtfs_err);
+}
