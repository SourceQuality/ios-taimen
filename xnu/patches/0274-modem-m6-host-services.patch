+/* name as a short name: at most 8 + 3 characters and one dot */
+static bool
+fat_is_83(const char *name)
+{
+	const char *dot = strchr(name, '.');
+	size_t n = strlen(name);
+	return dot == NULL ? n <= 8 : (size_t)(dot - name) <= 8 && n - (size_t)(dot - name) - 1 <= 3 &&
+	       strchr(dot + 1, '.') == NULL;
+}
+
+static bool
+fat_name_eq(const char *a, const char *b)
+{
+	for (; *a != 0 && *b != 0; a++, b++) {
+		char x = *a >= 'a' && *a <= 'z' ? (char)(*a - 32) : *a, y = *b >= 'a' && *b <= 'z' ? (char)(*b - 32) : *b;
+		if (x != y) {
+			return false;
+		}
+	}
+	return *a == *b;
+}
