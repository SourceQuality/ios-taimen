+/*
+ * 0341: a real sensor's sample (TaimenSensors.cpp M5, about 50 Hz): no log line; dispatched only while
+ * a client streams (ReportInterval > 0), and then the timer stops resending the last sample; the
+ * orientation follows once it held for 10 samples.
+ */
+void
+SweetHIDAccel::realSample(int mx, int my, int mz)
+{
+	fMg[0] = mx;
+	fMg[1] = my;
+	fMg[2] = mz;
+	fRealAt = mach_absolute_time();
+	if (fIntervalUS != 0) {
+		IOHIDEvent *e = event();
+		if (e) {
+			dispatchEvent(e);
+			e->release();
+			fSent++;
+		}
+	}
+	UInt32 o = orientation_of(mx, my, mz);
+	if (o != fCandidate) {
+		fCandidate = o;
+		fSteady = 0;
+	} else if (fSteady < 10 && ++fSteady == 10 && gSweetOrientation) {
+		gSweetOrientation->update(o);
+	}
+}
