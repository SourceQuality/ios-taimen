+/*
+ * 0277: the /vendor/firmware files the modem asks for (wlanmdsp.mbn, bdwlan.*, modemuw.jsn) are
+ * not on modem_a: boot-xnu.sh passes them as payload blobs (/chosen/memory-map WLAN-*), taken by
+ * the request's last path component.
+ */
+static const uint8_t *
+tftp_blob(const char *path, uint64_t *size)
+{
+	static const struct { const char *file, *blob; } map[] = {
+		{ "wlanmdsp.mbn", "WLAN-MDSP" }, { "bdwlan.bin", "WLAN-BDF" }, { "bdwlan.b09", "WLAN-BDF09" },
+		{ "modemuw.jsn", "WLAN-UWJSN" },
+	};
+	const char *base = strrchr(path, '/');
+	base = base != NULL ? base + 1 : path;
+	for (unsigned i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
+		DTEntry node;
+		uint64_t const *v;
+		unsigned int sz;
+		if (fat_name_eq(base, map[i].file) && SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) == kSuccess &&
+		    SecureDTGetProperty(node, map[i].blob, (void const **)&v, &sz) == kSuccess && sz == 16 && v[1] != 0) {
+			*size = v[1];
+			return (const uint8_t *)phystokv(v[0]);
+		}
+	}
+	return NULL;
+}
