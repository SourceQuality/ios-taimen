+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Adreno 540 power-up at XO (docs/taimen-gpu-plan.md 2.2; boot 50 with the same sequence in the
+ * perf thread: the GPU answered, VBIF_VERSION 0x200a0000, ALWAYSON counting). PM8005 S1 is left
+ * as ABL set it (752 mV, on: enough for XO and the 257 MHz corner). Returns the GPU's register
+ * mapping, or 0 after logging where it stopped.
+ */
+static vm_offset_t
+taimen_power_up(void)
+{
+	vm_offset_t g146 = ml_io_map(0x146000, 0x1000), cc = ml_io_map(GPUCC_PA, 0x2000);
+	uint8_t en = 0, lo = 0, hi = 0;
+	if (g146 == 0 || cc == 0) {
+		printf("SWEET GPU: map failed\n");
+		return 0;
+	}
+	bool s1 = sweet_pmic_read(0x514, 0x46, &en) && sweet_pmic_read(0x514, 0x40, &lo) &&
+	    sweet_pmic_read(0x514, 0x41, &hi);
+	printf("SWEET GPU: taimen: S1 %s en %02x %u mV; gpucc cx %08x gx %08x misc %08x gfx3d %08x\n",
+	    s1 ? "ok" : "UNREADABLE", en, (unsigned)hi << 8 | lo, rd(cc, 0x1004), rd(cc, 0x1094), rd(cc, 0x130),
+	    rd(cc, 0x1098));
+	if (!s1 || !(en & 0x80) || ((unsigned)hi << 8 | lo) < 700) {
+		printf("SWEET GPU: GFX rail off or below 700 mV, stop\n");
+		return 0;
+	}
+	wr(g146, 0x40, rd(g146, 0x40) | 1u);                            /* gcc_bimc_gfx_clk */
+	bool bimc = poll(g146, 0x40, 1u << 31, 0, 1);
+	wr(cc, 0x1004, rd(cc, 0x1004) & ~1u);                           /* CX GDSC */
+	bool cx = poll(cc, 0x1008, 1u << 31, 1u << 31, 1);
+	delay(10);
+	wr(cc, 0x1074, 0);                                              /* gfx3d RCG: XO */
+	wr(cc, 0x1070, 0x3);
+	bool r1 = poll(cc, 0x1070, 1u, 0, 1);
+	wr(cc, 0x10b4, 0);                                              /* rbbmtimer RCG: XO */
+	wr(cc, 0x10b0, 0x3);
+	bool r2 = poll(cc, 0x10b0, 1u, 0, 1);
+	printf("SWEET GPU: bimc_gfx %s, cx gdsc %s (%08x), rcg gfx3d %s rbbm %s\n", bimc ? "on" : "TIMEOUT",
+	    cx ? "on" : "TIMEOUT", rd(cc, 0x1008), r1 ? "ok" : "TIMEOUT", r2 ? "ok" : "TIMEOUT");
+	if (!(bimc && cx && r1 && r2)) {
+		return 0;
+	}
+	wr(cc, 0x1090, 1u);                                             /* GX BCR pulse */
+	delay(1);
+	wr(cc, 0x1090, 0);
+	wr(cc, 0x130, rd(cc, 0x130) | (1u << 4));                       /* GMEM reset pulse */
+	delay(1);
+	wr(cc, 0x130, rd(cc, 0x130) & ~(1u << 4));
+	wr(cc, 0x130, rd(cc, 0x130) & ~1u);                             /* clamp off */
+	wr(cc, 0x1094, rd(cc, 0x1094) & ~1u);                           /* GX GDSC */
+	bool gx = poll(cc, 0x1094, 1u << 31, 1u << 31, 1);
+	delay(10);
+	wr(cc, 0x1098, rd(cc, 0x1098) | (1u << 14) | (1u << 13));       /* retain mem, periph */
+	wr(cc, 0x1098, rd(cc, 0x1098) | 1u);
+	bool b1 = poll(cc, 0x1098, 1u << 31, 0, 1);
+	wr(cc, 0x10d0, rd(cc, 0x10d0) | 1u);                            /* rbbmtimer: after GX (boot 49) */
+	bool b2 = poll(cc, 0x10d0, 1u << 31, 0, 1);
+	printf("SWEET GPU: gx gdsc %s (%08x misc %08x), branches gfx3d %s (%08x) rbbm %s (%08x)\n",
+	    gx ? "on" : "TIMEOUT", rd(cc, 0x1094), rd(cc, 0x130), b1 ? "on" : "OFF", rd(cc, 0x1098),
+	    b2 ? "on" : "OFF", rd(cc, 0x10d0));
+	if (!(gx && b1 && b2)) {
+		return 0;
+	}
+	vm_offset_t gpu = ml_io_map(GPU_PA, 0x40000);
+	if (gpu == 0) {
+		printf("SWEET GPU: GPU map failed\n");
+		return 0;
+	}
+	printf("SWEET GPU: reading GPU registers\n");
+	uint32_t vbif = rd(gpu, 0x3000 * 4), status = rd(gpu, 0x4f5 * 4), aon0 = rd(gpu, 0x4d2 * 4);
+	delay(1000);
+	uint32_t aon1 = rd(gpu, 0x4d2 * 4);
+	printf("SWEET GPU: VBIF_VERSION %08x RBBM_STATUS %08x ALWAYSON %08x -> %08x (%s)\n",
+	    vbif, status, aon0, aon1, aon1 != aon0 ? "counting: GPU alive" : "not counting");
+	return aon1 != aon0 ? gpu : 0;
+}
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	g_level = (int)(uintptr_t)arg;
+	gpu_sleep(40);
+	vm_offset_t gpu = taimen_power_up();
+	if (gpu != 0 && g_level >= 2) {
+		gpu_wait(11);
+		cp_test(gpu, g_level);
+	}
+}
+#else
 static void
 gpu_thread(void *arg, wait_result_t result)
 {
@@ -2234,6 +2398,7 @@ gpu_thread(void *arg, wait_result_t result)
 		cp_test(gpu, (int)(uintptr_t)arg);
 	}
 }
+#endif
 
 void
 sweet_gpu_init(void)
@@ -2243,6 +2408,13 @@ sweet_gpu_init(void)
 	if (!PE_parse_boot_argn("sweetgpu", &on, sizeof(on)) || on == 0) {
 		return;
 	}
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+	if (on > TAIMEN_GPU_MAX_LEVEL) {
+		printf("SWEET GPU: sweetgpu=%d capped at %d on taimen (zap and clocks not ported yet)\n", on,
+		    TAIMEN_GPU_MAX_LEVEL);
+		on = TAIMEN_GPU_MAX_LEVEL;
+	}
+#endif
 	if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)on, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
