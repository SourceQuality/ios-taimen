+/*
+ * 0355 (0350's, factored out): the reference axes in device coordinates, Q14, from up (-accel) and a field
+ * (or any vector off the vertical): E = f x up (east), N = up x E (north, the field's horizontal part),
+ * W = U x N (west). The rows N, W, U make the rotation device -> North/West/Up. False when degenerate.
+ */
+static bool
+measured_frame(const int64_t up[3], const int64_t f[3], int32_t N[3], int32_t W[3], int32_t U[3], int32_t E[3])
+{
+	int64_t e[3], n[3];
+	e[0] = f[1] * up[2] - f[2] * up[1];
+	e[1] = f[2] * up[0] - f[0] * up[2];
+	e[2] = f[0] * up[1] - f[1] * up[0];
+	n[0] = up[1] * e[2] - up[2] * e[1];
+	n[1] = up[2] * e[0] - up[0] * e[2];
+	n[2] = up[0] * e[1] - up[1] * e[0];
+	if (!unit14(e, E) || !unit14(n, N) || !unit14(up, U)) {
+		return false;
+	}
+	W[0] = (int32_t)(((int64_t)U[1] * N[2] - (int64_t)U[2] * N[1]) / 16384);
+	W[1] = (int32_t)(((int64_t)U[2] * N[0] - (int64_t)U[0] * N[2]) / 16384);
+	W[2] = (int32_t)(((int64_t)U[0] * N[1] - (int64_t)U[1] * N[0]) / 16384);
+	return true;
+}
