+/* 0355: only the event user client: CoreMotion's fast path (another type) then fails and it uses the events */
+IOReturn
+SweetHIDMotion9::newUserClient(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties,
+    IOUserClient **handler)
+{
+	if (type != kIOHIDEventServiceUserClientType) {
+		if (fRefused++ < 4) {
+			IOLog("TAIMEN SENSORS: %s refuses user client type %#x (CoreMotion's fast path; it reads the events)\n",
+			    getName(), (unsigned)type);
+		}
+		return kIOReturnUnsupported;
+	}
+	return SweetHIDAccel::newUserClient(owningTask, securityID, type, properties, handler);
+}
+
+/* 0355: after each filter step: a report while streamed, at most one per 3/4 of the ReportInterval */
+void
+SweetHIDMotion9::motionTick()
+{
+	uint64_t now = mach_absolute_time(), gap;
+	fRealAt = now;
+	UInt32 us = fIntervalUS;
+	if (us == 0) {
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)us * 750, &gap);
+	if (fLastAt != 0 && now - fLastAt < gap) {
+		return;
+	}
+	fLastAt = now;
+	IOHIDEvent *e = event();
+	if (e) {
+		dispatchEvent(e);
+		e->release();
+		fSent++;
+	}
+}
+
+IOHIDEvent *
+SweetHIDMotion9::event()
+{
+	bool nine9 = nine();
+	if (!(nine9 ? gMotion.init9 : gMotion.init6)) {
+		return NULL;
+	}
+	int32_t q[4];
+	for (int i = 0; i < 4; i++) {
+		q[i] = nine9 ? gMotion.q9[i] : gMotion.q6[i];
+	}
+	int64_t r[3][3];
+	quat_rows(q, r);
+	int32_t N[3], U[3], E[3];
+	for (int i = 0; i < 3; i++) {
+		N[i] = (int32_t)(r[0][i] >> 16);
+		E[i] = (int32_t)(-r[1][i] >> 16);
+		U[i] = (int32_t)(r[2][i] >> 16);
+	}
+	int a[3] = {0, 0, -1000};
+	if (gSweetAccel) {
+		gSweetAccel->latestMg(a);
+	}
+	IOFixed w[3] = {gMotion.w[0], gMotion.w[1], gMotion.w[2]};
+	unsigned flags = 0x0104 | (gMotion.still >= 50 ? 0x10 : 0);     /* initialized, gravity (+ bias estimation) */
+	uint8_t rep[88];
+	bzero(rep, sizeof(rep));
+	UInt32 len, qo, ro, uo;
+	IOFixed m[3] = {0, 0, 0}, b[3];
+	bool cal = mag_bias(b), flat = true;
+	int32_t h = 0;
+	if (nine9) {
+		if (gSweetCompass) {
+			gSweetCompass->latestFixed(m);
+		}
+		if (gMotion.yaw9) {
+			flags |= 0x08;                  /* yaw correction */
+		}
+		h = heading_cdeg(N, E, U, &flat);
+		rep[0] = 2;
+		rep[1] = (uint8_t)(cal ? 2 : 1);    /* CMMagneticFieldCalibrationAccuracy high / medium */
+		rep[2] = (uint8_t)flags;
+		rep[3] = (uint8_t)(flags >> 8);
+		put32(rep + 12, f32_bits(-1, 0));
+		for (int i = 0; i < 3; i++) {
+			put32(rep + 16 + 4 * i, f32_bits(m[i], 16));
+			put32(rep + 76 + 4 * i, f32_bits(b[i], 16));
+		}
+		put32(rep + 68, f32_bits((int64_t)h * 256 / 100, 8));
+		put32(rep + 72, f32_bits(cal ? 15 : 30, 0));
+		len = 88;
+		qo = 28;
+		ro = 44;
+		uo = 56;
+	} else {
+		rep[0] = 3;
+		rep[1] = (uint8_t)flags;
+		rep[2] = (uint8_t)(flags >> 8);
+		len = 52;
+		qo = 12;
+		ro = 28;
+		uo = 40;
+	}
+	for (int i = 0; i < 4; i++) {
+		put32(rep + qo + 4 * i, f32_bits(q[i], 30));
+	}
+	int32_t ua[3];
+	for (int i = 0; i < 3; i++) {
+		ua[i] = (int32_t)((int64_t)a[i] * 16384 / 1000 + U[i]);   /* user acceleration = accel - gravity, gravity = -up; g Q14 */
+		put32(rep + ro + 4 * i, f32_bits(w[i], 16));
+		put32(rep + uo + 4 * i, f32_bits(ua[i], 14));
+	}
+	uint64_t ts = mach_absolute_time(), minute;
+	IOHIDEvent *ev = IOHIDEvent::vendorDefinedEvent(ts, 0xff0c, getPrimaryUsage(), 0, rep, len);
+	fReports++;
+	nanoseconds_to_absolutetime(60 * NSEC_PER_SEC, &minute);
+	if (fLogged < 3 || ts - fLoggedAt > minute) {
+		fLogged++;
+		fLoggedAt = ts;
+		char chk[96] = "no turns yet";
+		if (gMotion.chkN != 0) {
+			int pc[3];
+			for (int i = 0; i < 3; i++) {
+				pc[i] = gMotion.chkG[i] > 0 ? (int)(gMotion.chkS[i] * 100 / gMotion.chkG[i]) : 0;
+			}
+			snprintf(chk, sizeof(chk), "x %d y %d z %d over %u turns", pc[0], pc[1], pc[2], gMotion.chkN);
+		}
+		IOLog("TAIMEN SENSORS: %s report %u (type %u): q %d %d %d %d /16384, heading %d.%02d (%s, field %s), "
+		    "up %d %d %d /16384, rate %d %d %d mrad/s, user accel %d %d %d mg, gyro bias %d %d %d mrad/s "
+		    "(still %u), gyro check %s\n", getName(), fReports, (unsigned)rep[0], q[0] >> 16, q[1] >> 16, q[2] >> 16, q[3] >> 16,
+		    h / 100, h % 100, nine9 ? (flat ? "flat: the top" : "upright: the back") : "6-axis: none",
+		    nine9 ? (cal ? "calibrated" : "not calibrated yet") : "unused", U[0], U[1], U[2],
+		    (int)((int64_t)w[0] * 1000 / 65536), (int)((int64_t)w[1] * 1000 / 65536), (int)((int64_t)w[2] * 1000 / 65536),
+		    ua[0] * 1000 / 16384, ua[1] * 1000 / 16384, ua[2] * 1000 / 16384,
+		    (int)((int64_t)gMotion.bias[0] * 1000 / 65536), (int)((int64_t)gMotion.bias[1] * 1000 / 65536),
+		    (int)((int64_t)gMotion.bias[2] * 1000 / 65536), gMotion.still, chk);
+	}
+	return ev;
+}
+
+/* 0355: a gyro sample (IOFixed rad/s): one step of both attitudes, then the reports */
+static void
+motion_gyro(IOFixed gx, IOFixed gy, IOFixed gz)
+{
+	uint64_t now = mach_absolute_time(), ns = 20 * NSEC_PER_MSEC;
+	if (gMotion.at != 0) {
+		absolutetime_to_nanoseconds(now - gMotion.at, &ns);
+	}
+	gMotion.at = now;
+	uint32_t dt_us = (uint32_t)(ns / 1000 > 40000 ? 40000 : ns / 1000);
+	if (!gSweetAccel || !gSweetAccel->flowing()) {
+		return;                         /* no tilt reference: no device motion */
+	}
+	int a[3];
+	gSweetAccel->latestMg(a);
+	const IOFixed raw[3] = {gx, gy, gz};
+	bool still = true;
+	for (int i = 0; i < 3; i++) {
+		still = still && abs64((int64_t)raw[i] - gMotion.bias[i]) < 3932 && abs64(a[i] - gMotion.lastA[i]) < 25;
+	}
+	IOFixed w[3];
+	for (int i = 0; i < 3; i++) {
+		if (still) {
+			gMotion.bias[i] += (raw[i] - gMotion.bias[i]) / 32;      /* 0.06 rad/s and 25 mg: still */
+		}
+		w[i] = raw[i] - gMotion.bias[i];
+		gMotion.w[i] = w[i];
+		gMotion.lastA[i] = a[i];
+		gMotion.turn[i] += (int64_t)w[i] * dt_us / 1000000;
+	}
+	if (still) {
+		gMotion.still++;
+	}
+	int64_t up[3] = {-a[0], -a[1], -a[2]};
+	uint64_t g = hid_isqrt((uint64_t)(up[0] * up[0] + up[1] * up[1] + up[2] * up[2]));
+	int32_t Um[3];
+	bool tilt = g > 800 && g < 1200 && unit14(up, Um);
+	IOFixed m[3] = {0, 0, 0}, b[3] = {0, 0, 0};
+	int64_t f[3] = {0, 0, 0};
+	bool field = gSweetCompass && gSweetCompass->flowing();
+	if (field) {
+		gSweetCompass->latestFixed(m);
+		mag_bias(b);
+		for (int i = 0; i < 3; i++) {
+			f[i] = ((int64_t)m[i] - b[i]) / 64;     /* uT in Q10 */
+		}
+		uint64_t ut = hid_isqrt((uint64_t)(f[0] * f[0] + f[1] * f[1] + f[2] * f[2])) / 1024;
+		field = ut >= 15 && ut <= 100;
+	}
+	if (tilt && !gMotion.init9) {
+		gMotion.init9 = motion_init(gMotion.q9, up, field ? f : NULL);
+	} else if (gMotion.init9) {
+		gMotion.yaw9 = motion_step(gMotion.q9, w, dt_us, tilt ? Um : NULL, field ? f : NULL);
+	}
+	if (tilt && (!gMotion.init6 || gMotion.reset6)) {
+		gMotion.reset6 = false;
+		gMotion.init6 = motion_init(gMotion.q6, up, NULL);
+	} else if (gMotion.init6) {
+		motion_step(gMotion.q6, w, dt_us, tilt ? Um : NULL, NULL);
+	}
+	if (gSweetMotion9) {
+		gSweetMotion9->motionTick();
+	}
+	if (gSweetMotion6) {
+		gSweetMotion6->motionTick();
+	}
+}
+
+/*
+ * 0355: a field sample: the gyro check. The frame measured from the accelerometer and field turns by
+ * dR = D' D^T (D's columns the reference axes in device coordinates; dD/dt = -[w]x D), so its turn is
+ * x = (dR12 - dR21) / 2, y = (dR20 - dR02) / 2, z = (dR01 - dR10) / 2; against the gyro's turn over the
+ * same time, while turning faster than about 0.5 rad/s and near 1 g.
+ */
+static void
+motion_field(const IOFixed m[3])
+{
+	int a[3];
+	if (!gSweetAccel || !gSweetAccel->flowing()) {
+		gMotion.prevOK = false;
+		return;
+	}
+	gSweetAccel->latestMg(a);
+	int64_t up[3] = {-a[0], -a[1], -a[2]}, f[3];
+	IOFixed b[3];
+	mag_bias(b);
+	for (int i = 0; i < 3; i++) {
+		f[i] = ((int64_t)m[i] - b[i]) / 64;
+	}
+	uint64_t g = hid_isqrt((uint64_t)(up[0] * up[0] + up[1] * up[1] + up[2] * up[2]));
+	int32_t N[3], W[3], U[3], E[3];
+	int64_t turn[3] = {gMotion.turn[0], gMotion.turn[1], gMotion.turn[2]};
+	gMotion.turn[0] = gMotion.turn[1] = gMotion.turn[2] = 0;
+	if (g < 900 || g > 1100 || !measured_frame(up, f, N, W, U, E)) {
+		gMotion.prevOK = false;
+		return;
+	}
+	if (gMotion.prevOK && abs64(turn[0]) + abs64(turn[1]) + abs64(turn[2]) > 655) {   /* 0.01 rad */
+		int64_t d[3][3];
+		for (int i = 0; i < 3; i++) {
+			for (int j = 0; j < 3; j++) {
+				d[i][j] = (int64_t)N[i] * gMotion.prev[0][j] + (int64_t)W[i] * gMotion.prev[1][j] +
+				    (int64_t)U[i] * gMotion.prev[2][j];     /* Q28 */
+			}
+		}
+		const int64_t obs[3] = {(d[1][2] - d[2][1]) >> 13, (d[2][0] - d[0][2]) >> 13, (d[0][1] - d[1][0]) >> 13};
+		for (int i = 0; i < 3; i++) {
+			gMotion.chkS[i] += turn[i] * obs[i];
+			gMotion.chkG[i] += turn[i] * turn[i];
+		}
+		gMotion.chkN++;
+	}
+	for (int i = 0; i < 3; i++) {
+		gMotion.prev[0][i] = N[i];
+		gMotion.prev[1][i] = W[i];
+		gMotion.prev[2][i] = U[i];
+	}
+	gMotion.prevOK = true;
+}
