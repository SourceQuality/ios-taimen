+/*
+ * 0355: the magnetometer's hard-iron bias, shared by the heading and device motion: the middle of each
+ * axis's range once every axis has spanned 40 uT (the phone turned around). 0350 tracked it inside the
+ * heading's report, so only while locationd streamed; now every sample counts (sweet_hid_compass_sample).
+ */
+static IOFixed gMagMin[3], gMagMax[3];
+static bool gMagSeen;
+
+static void
+mag_track(const IOFixed m[3])
+{
+	for (int i = 0; i < 3; i++) {
+		if (!gMagSeen || m[i] < gMagMin[i]) {
+			gMagMin[i] = m[i];
+		}
+		if (!gMagSeen || m[i] > gMagMax[i]) {
+			gMagMax[i] = m[i];
+		}
+	}
+	gMagSeen = true;
+}
+
+/* 0355: the bias (zero until calibrated); true once calibrated */
+static bool
+mag_bias(IOFixed b[3])
+{
+	bool calibrated = gMagSeen;
+	for (int i = 0; i < 3; i++) {
+		calibrated = calibrated && gMagMax[i] - gMagMin[i] >= (40 << 16);
+	}
+	for (int i = 0; i < 3; i++) {
+		b[i] = calibrated ? gMagMin[i] + (gMagMax[i] - gMagMin[i]) / 2 : 0;
+	}
+	return calibrated;
+}
