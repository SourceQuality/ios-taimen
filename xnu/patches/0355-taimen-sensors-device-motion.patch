+/*
+ * 0355: device motion, as the iPhone X's motion coprocessor serves it. CoreMotion runs the fusion client
+ * inside each app (boot 196: Compass[282] "Starting device motion, mode=0xf ... Starting device motion
+ * service 2", then "Service for device with usage pair {65292, 4} is not ready" for good). The same code
+ * (CoreLocation/Shared/Motion/DeviceMotion) is in locationd, where these addresses are:
+ * - CLDeviceMotion::start (0x100d05400) picks per mode, by CLPlatformInfo::motionCaps (D22's mask has bits
+ *   3, 4, 5 and 7): 9-axis modes 7/0xf/0x8f (xArbitraryCorrected, xMagneticNorth, xTrueNorth) ->
+ *   CLSensorFusionService9AxisSPU (bit 4), usage pair {0xff0c, 4}; 6-axis modes 3/0x43 (xArbitraryZVertical)
+ *   -> CLSensorFusionService6AxisSPU (bit 3), {0xff0c, 5}; gyro-only mode 2 -> 3AxisSPU (bit 7), {0xff0c, 7}
+ *   (also CLSPU's command channel, so not served here); 0x22 (the parallax) runs on the raw gyro.
+ * - CLSensorFusionServiceSPU::start (0x10017adac) sets ReportInterval (us; 16667 from the Compass app) and
+ *   takes every event in 0x10017b20c -> populateDeviceMotion (0x10017b370): IOHIDEventGetVendorDefinedData,
+ *   timestamp = the event's; the payload, memcpy'd only when its length matches its type (0x1002152fc), is
+ *   type 2 (88 bytes: the Compass layout of 0350, read as attitude + rate + user acceleration + field - bias +
+ *   heading + accuracy, mode 0xf), type 3 (52 bytes, mode 3) or type 4 (52 bytes, mode 2):
+ *     0 u8 type, 1 u16 flags, 3 u8 -, 4 u64 0, 12 f32[4] attitude x y z w, 28 f32[3] rotation rate rad/s,
+ *     40 f32[3] user acceleration g.
+ *   Flags as 0350's: bit 8 initialized, 2 gravity correction, 3 yaw correction, 4 bias estimation; the level
+ *   byte (type 2) becomes CMMagneticFieldCalibrationAccuracy (-1..2). The service's "fast path" (an extra
+ *   user client for polling) may fail: it then serves the last event's sample (0x10017b290).
+ * - CLDeviceMotion (0x100d05c74) hands service 2's samples to the 9-axis, north and (with a declination)
+ *   true-north clients, service 1's to the 6-axis ones. The attitude is device -> reference: R(q)'s rows are
+ *   the reference axes (North/X, West/Y, Up/Z) in device coordinates, gravity = -row 2.
+ * locationd's CLDeviceMotionControl "Configure failed" (a 4-byte command {2, alwaysOn, gyroController,
+ * visualLocalization} through CLSPUHIDDriverInterface: IOCreatePlugInInterfaceForService type
+ * 3BC5CC87-845E-48AB-A9C2-9436001BA68A, the AppleSPU user-client plugin) is not needed for any of this.
+ *
+ * Here: a complementary (Mahony) filter in integer math at each of the SLPI's gyro samples (50 Hz):
+ * q' = q + q (x) (0, (w + k e) dt / 2), renormalized, with e = measured up x estimated up (accelerometer
+ * within 0.8..1.2 g; k = 1/s, 4/s past 15 degrees off) plus, for 9 axes, the vertical part of measured north
+ * x estimated north (the field's horizontal part, hard-iron bias removed, 15..100 uT). The gyro bias is
+ * learned while the phone is still. Two attitudes: 9-axis (always running, yaw on magnetic north) and
+ * 6-axis (gyro and accelerometer only, its yaw restarted at 0 when a client starts it). Each service sends
+ * one report per gyro sample while streamed, at most one per 3/4 of its ReportInterval. A gyro check logs,
+ * per axis, how the gyro's rotation agrees with the accelerometer's and field's frames (100: it agrees,
+ * -100: that axis is flipped; taimengyromap= fixes the map). taimensensors>=7.
+ */
+static struct {
+	volatile int32_t q9[4], q6[4];  /* attitude x y z w, Q30, device -> reference */
+	volatile bool init9, init6, reset6;
+	volatile bool yaw9;             /* the last 9-axis step had a usable field */
+	volatile IOFixed w[3];          /* the last rotation rate, bias removed, rad/s */
+	IOFixed bias[3];                /* the gyro's bias, rad/s */
+	UInt32 still;                   /* samples the bias learned from */
+	int lastA[3];                   /* the accelerometer at the last step, mg */
+	uint64_t at;                    /* mach time of the last gyro sample */
+	int64_t turn[3];                /* the gyro check: the gyro's rotation since the last field sample, Q16 rad */
+	int64_t chkS[3], chkG[3];
+	UInt32 chkN;
+	int32_t prev[3][3];             /* the last measured frame, rows N W U, Q14 */
+	bool prevOK;
+} gMotion;
+
+/* 0355: the rows of R(q) (q Q30 x y z w), Q30: the reference axes North/X, West/Y, Up/Z in device coordinates */
+static void
+quat_rows(const int32_t q[4], int64_t r[3][3])
+{
+	int64_t x = q[0], y = q[1], z = q[2], w = q[3];
+#define M30(a, b) (((a) * (b)) >> 30)
+	r[0][0] = (1LL << 30) - 2 * (M30(y, y) + M30(z, z));
+	r[0][1] = 2 * (M30(x, y) - M30(z, w));
+	r[0][2] = 2 * (M30(x, z) + M30(y, w));
+	r[1][0] = 2 * (M30(x, y) + M30(z, w));
+	r[1][1] = (1LL << 30) - 2 * (M30(x, x) + M30(z, z));
+	r[1][2] = 2 * (M30(y, z) - M30(x, w));
+	r[2][0] = 2 * (M30(x, z) - M30(y, w));
+	r[2][1] = 2 * (M30(y, z) + M30(x, w));
+	r[2][2] = (1LL << 30) - 2 * (M30(x, x) + M30(y, y));
+#undef M30
+}
+
+/* 0355: q = v / |v| (Q30); false for a zero vector */
+static bool
+quat_norm30(const int64_t v[4], volatile int32_t q[4])
+{
+	uint64_t n2 = 0;
+	for (int i = 0; i < 4; i++) {
+		n2 += (uint64_t)(v[i] * v[i]);
+	}
+	int64_t n = (int64_t)hid_isqrt(n2);
+	if (n == 0) {
+		return false;
+	}
+	for (int i = 0; i < 4; i++) {
+		q[i] = (int32_t)(v[i] * (1LL << 30) / n);
+	}
+	return true;
+}
+
+/* 0355: an attitude straight from up (mg) and a field (Q10 uT), or with none, yaw 0 on the device's x (y if x is vertical) */
+static bool
+motion_init(volatile int32_t q[4], const int64_t up[3], const int64_t *f)
+{
+	int64_t axis[3] = {1024, 0, 0};
+	if (f == NULL) {
+		uint64_t len = hid_isqrt((uint64_t)(up[0] * up[0] + up[1] * up[1] + up[2] * up[2]));
+		if (10 * (uint64_t)abs64(up[0]) > 9 * len) {
+			axis[0] = 0;
+			axis[1] = 1024;
+		}
+		f = axis;
+	}
+	int32_t N[3], W[3], U[3], E[3], q14[4];
+	if (!measured_frame(up, f, N, W, U, E)) {
+		return false;
+	}
+	const int32_t r[3][3] = {{N[0], N[1], N[2]}, {W[0], W[1], W[2]}, {U[0], U[1], U[2]}};
+	quat14(r, q14);
+	const int64_t v[4] = {(int64_t)q14[0] * 65536, (int64_t)q14[1] * 65536, (int64_t)q14[2] * 65536, (int64_t)q14[3] * 65536};
+	return quat_norm30(v, q);
+}
+
+/*
+ * 0355: one filter step: w the rotation rate (rad/s, Q16), Um the measured up (Q14) or NULL, f the field
+ * (Q10 uT, bias removed) or NULL; true when the field corrected the yaw.
+ */
+static bool
+motion_step(volatile int32_t q[4], const IOFixed w[3], uint32_t dt_us, const int32_t *Um, const int64_t *f)
+{
+	const int32_t qq[4] = {q[0], q[1], q[2], q[3]};
+	int64_t r[3][3];
+	quat_rows(qq, r);
+	int64_t N[3], U[3], c[3] = {0, 0, 0};   /* Q14; the correction, rad/s Q16 */
+	for (int i = 0; i < 3; i++) {
+		N[i] = r[0][i] >> 16;
+		U[i] = r[2][i] >> 16;
+	}
+	if (Um != NULL) {
+		int64_t e[3] = {(Um[1] * U[2] - Um[2] * U[1]) >> 14, (Um[2] * U[0] - Um[0] * U[2]) >> 14,
+			        (Um[0] * U[1] - Um[1] * U[0]) >> 14};
+		int64_t k = abs64(e[0]) + abs64(e[1]) + abs64(e[2]) > 4240 ? 16 : 4;   /* x4 for Q14 -> Q16 */
+		for (int i = 0; i < 3; i++) {
+			c[i] += e[i] * k;
+		}
+	}
+	bool yaw = false;
+	if (f != NULL) {
+		int64_t em[3] = {f[1] * U[2] - f[2] * U[1], f[2] * U[0] - f[0] * U[2], f[0] * U[1] - f[1] * U[0]};
+		int64_t nm[3] = {U[1] * em[2] - U[2] * em[1], U[2] * em[0] - U[0] * em[2], U[0] * em[1] - U[1] * em[0]};
+		int32_t Nm[3];
+		if (unit14(nm, Nm)) {
+			int64_t e[3] = {(Nm[1] * N[2] - Nm[2] * N[1]) >> 14, (Nm[2] * N[0] - Nm[0] * N[2]) >> 14,
+				        (Nm[0] * N[1] - Nm[1] * N[0]) >> 14};
+			int64_t ev = (e[0] * U[0] + e[1] * U[1] + e[2] * U[2]) >> 14;    /* the yaw error, sin, Q14 */
+			int64_t k = abs64(ev) > 4240 ? 16 : 4;
+			for (int i = 0; i < 3; i++) {
+				c[i] += ((ev * U[i]) >> 14) * k;
+			}
+			yaw = true;
+		}
+	}
+	int64_t h[3];                           /* half the turn, Q30 */
+	for (int i = 0; i < 3; i++) {
+		h[i] = ((int64_t)w[i] + c[i]) * dt_us * 8192 / 1000000;
+	}
+	const int64_t x = qq[0], y = qq[1], z = qq[2], s = qq[3];
+	const int64_t v[4] = {
+		x + ((s * h[0] + y * h[2] - z * h[1]) >> 30),
+		y + ((s * h[1] + z * h[0] - x * h[2]) >> 30),
+		z + ((s * h[2] + x * h[1] - y * h[0]) >> 30),
+		s - ((x * h[0] + y * h[1] + z * h[2]) >> 30),
+	};
+	quat_norm30(v, q);
+	return yaw;
+}
