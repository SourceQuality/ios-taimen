+/*
+ * Where submit time goes, logged every 10 s of submits ("SWEET GPU: ...
+ * submits"): the cache loop (pages checked, pages flushed) against the ring
+ * (and the part of it spent waiting for room behind the GPU).
+ */
+static void
+submitStats(uint64_t t0, uint64_t t1, uint64_t t2, uint64_t ring_wait, uint64_t checked, uint64_t flushed)
+{
+	static uint64_t start, n, cache, ring, wait, pages, dirty;
+	if (start == 0) {
+		start = t0;
+	}
+	n++;
+	cache += t1 - t0;
+	ring += t2 - t1;
+	wait += ring_wait;
+	pages += checked;
+	dirty += flushed;
+	uint64_t span, a, b, c;
+	absolutetime_to_nanoseconds(t2 - start, &span);
+	if (span < 10 * NSEC_PER_SEC) {
+		return;
+	}
+	absolutetime_to_nanoseconds(cache, &a);
+	absolutetime_to_nanoseconds(ring, &b);
+	absolutetime_to_nanoseconds(wait, &c);
+	printf("SWEET GPU: %llu submits in %llu ms: cache %llu ms (%llu pages checked, %llu flushed), ring %llu ms "
+	    "(%llu ms waiting for room)\n", n, span / 1000000, a / 1000000, pages, dirty, b / 1000000, c / 1000000);
+	start = n = cache = ring = wait = pages = dirty = 0;
+}
