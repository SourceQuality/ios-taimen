diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index 8e29586..d0f5223 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -249,6 +249,30 @@ rt_runq_is_low_latency(processor_set_t pset)
 
 TUNABLE(bool, cpulimit_affects_quantum, "cpulimit_affects_quantum", true);
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * taimenamp=1 (0248; docs/taimen-amp-plan.md 2.C level 1 on the amp-plan branch): one pset
+ * spans silver (cpu 0-3) and gold (4-7), and the idle search takes the lowest idle CPU, a silver
+ * one. Level 1 narrows the idle choice: gold for threads above utility priority (UI, the CA
+ * render server, kernel threads), silver for utility and background, any idle CPU when the
+ * preferred cluster has none. taimen_fast_map: the gold CPUs while gold runs at full clock
+ * (bsd/dev/sweet_perf.c sets it after the ramp and clears it when gold is parked).
+ */
+uint64_t taimen_fast_map;
+static TUNABLE(int, taimen_amp_level, "taimenamp", 0);
+
+static inline uint64_t
+taimen_amp_prefer(uint64_t map, int pri)
+{
+	uint64_t fast = os_atomic_load(&taimen_fast_map, relaxed);
+	if (taimen_amp_level == 0 || fast == 0) {
+		return map;
+	}
+	uint64_t want = pri <= BASEPRI_UTILITY ? (map & ~fast) : (map & fast);
+	return want ? want : map;
+}
+#endif
+
 #define         DEFAULT_PREEMPTION_RATE         100             /* (1/s) */
 TUNABLE(int, default_preemption_rate, "preempt", DEFAULT_PREEMPTION_RATE);
 
