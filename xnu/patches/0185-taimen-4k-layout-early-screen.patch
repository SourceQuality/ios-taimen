diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 75e3fbb..0f58f4e 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -342,6 +342,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# taimen (Pixel 2 XL) runs 4 KiB pages: TTBR1 covers 39 bits, so the -2 TiB
+# ARM_LARGE_MEMORY link address is unreachable. Keep the compact layout.
+ifeq ($(CURRENT_MACHINE_CONFIG),TAIMEN)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 7ed7d29..acdc2ca 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1832,6 +1832,44 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * for a Device alias of the early log block (sweet_early.c) that survives
  * bootstrap TTBR0 teardown.
  */
+#if defined(TAIMEN)
+/*
+ * 4K pages, compact layout: VM_MIN_KERNEL_ADDRESS sits in another 1 GB L1
+ * entry than the kernel, which has no L2 table yet. Use the free 2 MB slots
+ * between the low globals and the kernel text inside the kernel's own L1
+ * entry instead: slots 1-18 alias the splash framebuffer, 19 the early log
+ * block, 20 the MDP block (sweet_early.c relocates to this layout).
+ */
+#define SWEET_EARLY_FB_VA ((VM_KERNEL_LINK_ADDRESS & ~((1ULL << 30) - 1)) + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_ALIAS_BLOCKS 20u
+
+static void
+sweet_early_map_block(vm_map_address_t va, uint64_t pa)
+{
+	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+	assert(*slot == ARM_TTE_EMPTY);
+	*slot = pa | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+}
+
+static void
+sweet_early_map_final(void)
+{
+	const vm_map_address_t va = SWEET_EARLY_FB_VA;
+	assert(va + SWEET_EARLY_ALIAS_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
+	for (unsigned int i = 0; i < 18u; i++) {
+		sweet_early_map_block(va + i * ARM_TT_L2_SIZE, 0x9d400000ULL + (uint64_t)i * ARM_TT_L2_SIZE);
+	}
+	sweet_early_map_block(va + 18u * ARM_TT_L2_SIZE, SWEET_EARLY_LOG_BLOCK);
+	sweet_early_map_block(va + 19u * ARM_TT_L2_SIZE, 0xc800000ULL);
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+#else /* !TAIMEN */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
 static void
@@ -1850,6 +1888,7 @@ sweet_early_map_final(void)
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
+#endif /* TAIMEN */
 #endif
 
