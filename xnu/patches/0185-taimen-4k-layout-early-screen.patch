diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 885c1e4..67f4c3f 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -20,9 +20,47 @@
 /* persistent_ram_buffer: "DBGC", start, size, then the text (no ECC) */
 #define PRZ_OFF         (SWEET_EARLY_LOG_PRZ - SWEET_EARLY_LOG_BLOCK)
 #define PRZ_SIG         0x43474244u
+#if defined(TAIMEN)
+#define PRZ_DATA_MAX    (0x100000u - 12u)       /* taimen ramoops console zone is 1 MiB */
+#else
 #define PRZ_DATA_MAX    (0x80000u - 12u)
+#endif
 
 static volatile uint8_t *early_base = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_LOG_BLOCK;
+
+#if defined(TAIMEN)
+/*
+ * On taimen RAM does not survive a reset, so the stage marks also go on the
+ * screen: a full-width band per mark at rows 2000 + 8*stage of the ABL splash
+ * framebuffer, followed by an MDP CTL0 START (the panel shows frames on request).
+ * Before arm_vm_init both are V=P through the bootstrap tables (start.s); after
+ * sweet_early_relocate they are aliases next to the log zone (arm_vm_init.c).
+ */
+#define TAIMEN_FB_PA    0x9d400000ULL
+#define TAIMEN_FB_W     1440u
+#define TAIMEN_FB_STRIDE 5760u
+#define TAIMEN_FB_BLOCKS 18u            /* 36 MiB of 2 MB blocks */
+#define TAIMEN_MDP_BLOCK_PA 0xc800000ULL
+#define TAIMEN_KICK_OFF  (0xc90201cULL - TAIMEN_MDP_BLOCK_PA)
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)TAIMEN_FB_PA;
+static volatile uint32_t *early_kick = (volatile uint32_t *)(uintptr_t)(TAIMEN_MDP_BLOCK_PA + TAIMEN_KICK_OFF);
+
+static void
+sweet_early_band(unsigned int stage)
+{
+	unsigned int y0 = 2000u + 8u * (stage % 100u);
+	uint32_t color = 0xff000000u | (0x00ff00u >> ((stage % 3u) * 8u)) | ((stage & 1u) ? 0x0000ffu : 0u);
+	for (unsigned int y = y0; y < y0 + 6u && y < 2880u; y++) {
+		volatile uint32_t *row = early_fb + (y * TAIMEN_FB_STRIDE) / 4u;
+		for (unsigned int x = 0; x < TAIMEN_FB_W; x++) {
+			row[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*early_kick = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
