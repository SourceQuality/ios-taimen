+/* ---------------------------------------------------------------- microphones (taimenmic=N) */
+
+#define MLOG(fmt, ...)          IOLog("TAIMEN MIC: " fmt "\n", ##__VA_ARGS__)
+#define SLIM_QMI_SELECT_INST    0x20            /* WH slim-msm.c SLIMBUS_QMI_SELECT_INSTANCE_REQ_V01 */
+#define SLIM_QMI_POWER          0x21            /* SLIMBUS_QMI_POWER_REQ_V01 */
+#define SLIM_MODE_MASTER        2u              /* SLIMBUS_MODE_MASTER_V01: the ADSP is the bus master */
+#define SLIM_PM_ACTIVE          2u              /* SLIMBUS_PM_ACTIVE_V01 (INACTIVE 1 is never sent) */
+#define SLIM_QMI_WAIT_MS        1000            /* WH SLIM_QMI_RESP_TOUT */
+
+static int mic_level;                   /* taimenmic=N, default 0 */
+static uint16_t mic_txn = 1, mic_wait_txn, mic_wait_msg;
+static bool mic_qmi_got;
+static uint32_t mic_qmi_res, mic_qmi_err, mic_qmi_stray;
+
+static inline uint16_t mic_ld16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+static inline void mic_st16(uint8_t *p, uint16_t v) { memcpy(p, &v, 2); }
+
+/* GLINK and QRTR keep running while a microphone stage waits (also the SLIMbus code's idle) */
+static void
+mic_idle(void)
+{
+	if (!glink_poll()) {
+		IOSleep(1);
+	}
+	qrtr_poll();
+}
+
+/* QRTR DATA to port 0x4002: the response in flight, or a stray */
+static void
+mic_qmi_rx(uint32_t node, uint32_t port, const uint8_t *d, uint32_t len)
+{
+	uint16_t txn = mic_ld16(d + 1), msg = mic_ld16(d + 3), tl = 0;
+	if (d[0] != QMI_RESP || txn != mic_wait_txn || msg != mic_wait_msg || mic_qmi_got) {
+		if (mic_qmi_stray++ < 8) {
+			MLOG("QMI type %u msg %#x txn %u from %u:%#x, %u bytes: not expected", d[0], msg, txn, node, port, len);
+		}
+		return;
+	}
+	const uint8_t *r = qm_find(d, len, 0x02, &tl);          /* the result TLV: u16 result, u16 error */
+	mic_qmi_res = r != NULL && tl >= 2 ? mic_ld16(r) : 0xFFFFu;
+	mic_qmi_err = r != NULL && tl >= 4 ? mic_ld16(r + 2) : 0xFFFFu;
+	mic_qmi_got = true;
+}
+
+/* m: a request, its TLVs from byte 7, n bytes in all. 0 when answered (mic_qmi_res/err), -1 not. */
+static int
+mic_qmi_call(uint16_t msg, uint8_t *m, uint32_t n, unsigned *took)
+{
+	mic_wait_txn = mic_txn++;
+	if (mic_txn == 0) {
+		mic_txn = 1;
+	}
+	mic_wait_msg = msg;
+	mic_qmi_got = false;
+	m[0] = QMI_REQ;
+	mic_st16(m + 1, mic_wait_txn);
+	mic_st16(m + 3, msg);
+	mic_st16(m + 5, (uint16_t)(n - 7));
+	uint64_t t = now_ms();
+	qrtr_send(QRTR_TYPE_DATA, PORT_MIC, slim_qnode, slim_qport, m, n);
+	while (!mic_qmi_got && now_ms() - t < SLIM_QMI_WAIT_MS) {
+		mic_idle();
+	}
+	*took = (unsigned)(now_ms() - t);
+	return mic_qmi_got ? 0 : -1;
+}
+
+/*
+ * M1: the census, the slimbus QMI handshake (WH msm_slim_qmi_init, msm_slim_qmi_power_request),
+ * then the NGD (taimen_slim_up), whose registers are touched only after POWER(ACTIVE) said 0.
+ */
+static bool
+mic_m1(void)
+{
+	uint8_t m[32];
+	uint32_t inst = 0, mode = SLIM_MODE_MASTER, pm = SLIM_PM_ACTIVE, n;
+	unsigned took = 0;
+	int rc = -1;
+
+	taimen_wcd_census();
+	uint64_t t = now_ms();
+	while (slim_qnode == 0xFFFFFFFFu && now_ms() - t < 5000) {
+		mic_idle();
+	}
+	if (slim_qnode == 0xFFFFFFFFu) {
+		MLOG("1: the ADSP announced no slimbus QMI service (0x301 v1 inst 0) in 5 s");
+		return false;
+	}
+	MLOG("1: slimbus QMI 0x301 v1 inst 0 at node %u port %#x", slim_qnode, slim_qport);
+	n = qm_tlv(m, 7, 0x01, &inst, 4);                       /* instance: cell-index 1 >> 1 */
+	n = qm_tlv(m, n, 0x10, &mode, 4);
+	if (mic_qmi_call(SLIM_QMI_SELECT_INST, m, n, &took) != 0) {
+		MLOG("1: SELECT_INSTANCE(0, MASTER): no answer in %u ms", took);
+		return false;
+	}
+	MLOG("1: SELECT_INSTANCE(0, MASTER) -> %u/%u in %u ms", mic_qmi_res, mic_qmi_err, took);
+	if (mic_qmi_res != 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		n = qm_tlv(m, 7, 0x01, &pm, 4);
+		rc = mic_qmi_call(SLIM_QMI_POWER, m, n, &took);
+		if (rc == 0 && mic_qmi_res == 0) {
+			break;
+		}
+		MLOG("1: POWER(ACTIVE) try %u: %s %u/%u after %u ms", i + 1, rc == 0 ? "answered" : "NO answer", mic_qmi_res,
+		    mic_qmi_err, took);
+		rc = -1;
+	}
+	if (rc != 0) {
+		MLOG("1: POWER(ACTIVE) failed: the NGD's registers are not touched");
+		return false;
+	}
+	MLOG("1: POWER(ACTIVE) -> %u/%u in %u ms", mic_qmi_res, mic_qmi_err, took);
+	return taimen_slim_up(mic_idle);
+}
+
+/* The microphone stages 1..taimenmic, once; a failure ends them and nothing else. */
+static void
+mic_stages(void)
+{
+	MLOG("t=%u.%03u taimenmic=%d: stage 1", T, mic_level);
+	if (!mic_m1()) {
+		MLOG("1: M1 NOT reached; the microphone stages end here (the speaker is not affected)");
+		return;
+	}
+	if (mic_level > 1) {
+		MLOG("taimenmic=%d: stages 2 and up are not built yet", mic_level);
+	}
+}
