+	IOLog("TAIMEN FB %d: VIG0 SIZE 0x%x SRC0 0x%x YSTR 0x%x DSI0 0x%x 0x%x\n",
+	    t, r[5], r[6], r[7], r[8], r[9]);
+}
 
