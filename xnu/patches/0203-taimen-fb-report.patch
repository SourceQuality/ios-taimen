+/*
+ * TAIMEN FB report (SweetPlatformExpert.cpp): the MDP/DSI registers a
+ * kickoff depends on, 0 where nothing is mapped. The kernel's frames have
+ * never reached the taimen panel (boots 4-18); this shows whether the
+ * kickoffs are taken.
+ */
+void sweet_fbcon_regs(uint32_t r[10]);
+void
+sweet_fbcon_regs(uint32_t r[10])
+{
+	volatile uint32_t *k = fbcon_kickoff, *v = fbcon_vig0, *i = fbcon_intr, *d = fbcon_dsi;
+
+	r[0] = i ? i[-1] : 0;           /* MDP INTR_EN */
+	r[1] = i ? i[0] : 0;            /* MDP INTR_STATUS */
+	r[2] = k ? k[-7] : 0;           /* CTL0 LAYER(LM0) */
+	r[3] = k ? k[-2] : 0;           /* CTL0 TOP */
+	r[4] = k ? k[-1] : 0;           /* CTL0 FLUSH: pending bits until a frame starts */
+	r[5] = v ? v[0] : 0;            /* VIG0 SRC_SIZE */
+	r[6] = v ? v[0x14 / 4] : 0;     /* VIG0 SRC0_ADDR */
+	r[7] = v ? v[0x24 / 4] : 0;     /* VIG0 SRC_YSTRIDE0 */
+	r[8] = d ? d[0x08 / 4] : 0;     /* DSI0 STATUS0 */
+	r[9] = d ? d[0x110 / 4] : 0;    /* DSI0 INTR_CTRL */
+}
