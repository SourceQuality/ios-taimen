diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 848e6ac..38ef7f3 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -486,6 +486,38 @@ sweet_exec_denied(const char *name)
  * without editing launchd.plist on the phone). Several NAME:... entries
  * are separated by ';'.
  */
+/*
+ * 0306: boot-arg sweetwklog=1: WebKit's processes and MobileSafari mirror their os_log and CFLog
+ * messages to stderr (as under Xcode), which is /dev/null for them and teed into the kernel log
+ * (bsd/dev/mem.c). The boot-args have no room for it in sweetenv (607 bytes, ROOT=1 + GPU boots).
+ */
+static int
+sweet_exec_wklog(struct image_params *imgp, int ptr_size, const char *base)
+{
+	static int wklog = -1;
+	if (wklog < 0) {
+		wklog = 0;
+		(void)PE_parse_boot_argn("sweetwklog", &wklog, sizeof(wklog));
+	}
+	if (!wklog || (strncmp(base, "com.apple.WebKit.", 17) != 0 && strcmp(base, "MobileSafari") != 0)) {
+		return 0;
+	}
+	static const char *const vars[] = { "OS_ACTIVITY_DT_MODE=YES", "CFLOG_FORCE_STDERR=1" };
+	for (unsigned i = 0; i < sizeof(vars) / sizeof(vars[0]); i++) {
+		int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(vars[i]), UIO_SYSSPACE, TRUE);
+		if (error) {
+			return error;
+		}
+		if (imgp->ip_argspace < ptr_size) {
+			return E2BIG;
+		}
+		imgp->ip_argspace -= ptr_size;
+		imgp->ip_envc++;
+	}
+	printf("SWEET ENV: %s += OS_ACTIVITY_DT_MODE=YES CFLOG_FORCE_STDERR=1 (sweetwklog)\n", base);
+	return 0;
+}
