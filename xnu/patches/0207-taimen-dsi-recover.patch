diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 070cce1..b1c7e3b 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -783,6 +783,55 @@ static uint32_t fbcon_kick_lock;        /* kickoffs and DSI commands */
 static uint64_t fbcon_kick_last;
 static bool fbcon_kick_pending = true;  /* the shim's last frame may still be out */
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * Taimen, boot 22: a kernel frame starved the DSI lanes (FIFO_STATUS 0x99991080 = HS FIFO
+ * underflow on DLN0-3), after which the DSI command engine stayed busy for good (STATUS0 0x5
+ * in 20000 of 20000 reads, lanes out of LP-11) and nothing more reached the panel, although
+ * PP0 kept reporting done. The shim, idle between frames, reads STATUS0 0 and no underflow.
+ * So: a frame is only done once DSI0 is idle too, and a DSI0 that underflowed or stayed busy
+ * past the 50 ms timeout gets the msm-4.4 mdss_dsi_sw_reset() (CTRL enable off, CLK_CTRL all
+ * on, SOFT_RESET pulse, CTRL back) and its latched FIFO errors cleared before the next START.
+ */
+#define DSI_CTRL                (0x004 / 4)
+#define DSI_STATUS0             (0x008 / 4)
+#define DSI_FIFO_STATUS         (0x00c / 4)
+#define DSI_SOFT_RESET          (0x118 / 4)
+#define DSI_CLK_CTRL            (0x11c / 4)
+#define DSI_STATUS0_BUSY        0x5u            /* CMD_MODE_ENGINE_BUSY | CMD_MODE_MDP_BUSY */
+#define DSI_FIFO_HS_UNDERFLOW   0x88880000u     /* DLN0..3_HS_FIFO_UNDERFLOW */
+uint64_t sweet_fbcon_stat_dsi_resets;
+uint32_t sweet_fbcon_last_dsi_fifo;
+
+static void
+fbcon_dsi_recover(void)
+{
+	volatile uint32_t *d = fbcon_dsi;
+
+	if (d == NULL) {
+		return;
+	}
+	uint32_t fifo = d[DSI_FIFO_STATUS];
+	if (!(fifo & DSI_FIFO_HS_UNDERFLOW) && !(d[DSI_STATUS0] & DSI_STATUS0_BUSY)) {
+		return;
+	}
+	uint32_t ctrl = d[DSI_CTRL];
+	d[DSI_CTRL] = ctrl & ~1u;
+	__builtin_arm_dsb(DSB_SY);
+	d[DSI_CLK_CTRL] = 0x23f;
+	__builtin_arm_dsb(DSB_SY);
+	d[DSI_SOFT_RESET] = 1;
+	__builtin_arm_dsb(DSB_SY);
+	d[DSI_SOFT_RESET] = 0;
+	__builtin_arm_dsb(DSB_SY);
+	d[DSI_CTRL] = ctrl;
+	d[DSI_FIFO_STATUS] = fifo;              /* write-1-to-clear */
+	__builtin_arm_dsb(DSB_SY);
+	sweet_fbcon_last_dsi_fifo = fifo;
+	sweet_fbcon_stat_dsi_resets++;
+}
+#endif
+
 /* fbcon_kick_lock held: the previous frame is done (or 50 ms passed). */
 static bool
 fbcon_frame_done(uint64_t now)
@@ -790,7 +839,12 @@ fbcon_frame_done(uint64_t now)
 	if (!fbcon_kick_pending) {
 		return true;
