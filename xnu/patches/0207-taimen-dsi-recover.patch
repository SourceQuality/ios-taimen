+	if (fbcon_intr != NULL && (*fbcon_intr & FBCON_PP0_DONE) &&
+	    (fbcon_dsi == NULL || !(fbcon_dsi[DSI_STATUS0] & DSI_STATUS0_BUSY))) {
+#else
 	if (fbcon_intr != NULL && (*fbcon_intr & FBCON_PP0_DONE)) {
+#endif
 		sweet_fbcon_stat_done++;
 		return true;
 	}
@@ -810,6 +864,9 @@ fbcon_try_kick(void)
 	uint64_t now = mach_absolute_time();
 	bool ok = fbcon_frame_done(now);
 	if (ok) {
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+		fbcon_dsi_recover();
+#endif
 		if (fbcon_intr != NULL) {
 			fbcon_intr[1] = FBCON_PP0_DONE;
 		}
@@ -947,6 +1004,29 @@ sweet_fbcon_kick(bool force)
 	}
 }
 
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+/*
+ * AppleCLCD: wait (50 ms at most) for the frame in flight before copying the next one into
+ * the panel memory, so the CPU copy does not compete with the MDP fetch that starved the
+ * DSI lanes in boot 22.
+ */
+void sweet_fbcon_wait_idle(void);
+void
+sweet_fbcon_wait_idle(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint64_t lim = gPEClockFrequencyInfo.timebase_frequency_hz / 20;
+
+	while (fbcon_kick_pending && fbcon_intr != NULL && mach_absolute_time() - t0 < lim) {
+		if ((*fbcon_intr & FBCON_PP0_DONE) &&
+		    (fbcon_dsi == NULL || !(fbcon_dsi[DSI_STATUS0] & DSI_STATUS0_BUSY))) {
+			return;
+		}
+		delay(200);
+	}
+}
+#endif
