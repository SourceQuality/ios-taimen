+++ b/bsd/dev/taimen_fwfile.c
@@ -0,0 +1,74 @@
+/*
+ * Firmware files from the iOS root for taimen's drivers (xnu 0330): TaimenAudio reads the ADSP
+ * and TAS2557 firmware from /usr/standalone/firmware/taimen-audio, which a ROOTFIX installs once
+ * (tools/taimen/mkrootfix.py --audio-fw), instead of carrying ~9.4 MB of payload blobs on every
+ * boot (ABL starts no payload over ~35 MiB, NOTES boot 78). Plain vnode KPIs with the kernel's
+ * context, as bsd/kern/taimen_rootfix.c writes its files; usable once the root is mounted.
+ *
+ *   taimen_fw_load(path, max, &data, &len)  the whole file into kalloc_data memory: 0, ENOENT,
+ *                                           EFBIG (empty or over max), EIO, ENOMEM
+ *   taimen_fw_free(data, len)
+ */
+#if defined(ARM64_BOARD_CONFIG_TAIMEN)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <kern/kalloc.h>
+
+int taimen_fw_load(const char *path, uint32_t max, void **data, uint32_t *len);
+void taimen_fw_free(void *data, uint32_t len);
+
+int
+taimen_fw_load(const char *path, uint32_t max, void **data, uint32_t *len)
+{
+	if (rootvnode == NULLVP) {
+		return ENOENT;          /* no root yet: the caller asks again */
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err != 0) {
+		return ENOENT;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_data_size);
+	err = vnode_getattr(vp, &va, ctx);
+	if (err != 0 || !VATTR_IS_SUPPORTED(&va, va_data_size) || va.va_data_size == 0 ||
+	    va.va_data_size > max) {
+		(void)vnode_close(vp, FREAD, ctx);
+		return err != 0 ? EIO : EFBIG;
+	}
+	uint32_t n = (uint32_t)va.va_data_size;
+	void *buf = kalloc_data(n, Z_WAITOK);
+	if (buf == NULL) {
+		(void)vnode_close(vp, FREAD, ctx);
+		return ENOMEM;
+	}
+	int resid = 0;
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)n, 0, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (err != 0 || resid != 0) {
+		kfree_data(buf, n);
+		return EIO;
+	}
+	*data = buf;
+	*len = n;
+	return 0;
+}
+
+void
+taimen_fw_free(void *data, uint32_t len)
+{
+	if (data != NULL) {
+		kfree_data(data, len);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_TAIMEN */
