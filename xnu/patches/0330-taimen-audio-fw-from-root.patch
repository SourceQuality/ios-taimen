+#define FW_DIR                  "/usr/standalone/firmware/taimen-audio/"
+static struct fw_file { const char *blob, *file; void *data; uint32_t len; } fw_files[] = {
+	{ "ADSP-MDT", "adsp.mdt", NULL, 0 },
+	{ "ADSP-B02", "adsp.b02", NULL, 0 }, { "ADSP-B03", "adsp.b03", NULL, 0 }, { "ADSP-B04", "adsp.b04", NULL, 0 },
+	{ "ADSP-B05", "adsp.b05", NULL, 0 }, { "ADSP-B06", "adsp.b06", NULL, 0 }, { "ADSP-B07", "adsp.b07", NULL, 0 },
+	{ "ADSP-B08", "adsp.b08", NULL, 0 }, { "ADSP-B09", "adsp.b09", NULL, 0 }, { "ADSP-B10", "adsp.b10", NULL, 0 },
+	{ "ADSP-B11", "adsp.b11", NULL, 0 }, { "ADSP-B12", "adsp.b12", NULL, 0 },
+	{ "TAS-FW", "tas2557s_PG21_uCDSP.bin", NULL, 0 }, { "TAS-CAL", "tas2557_cal.bin", NULL, 0 },
+};
+
 static bool
 blob(const char *name, const uint8_t **data, uint32_t *len)
 {
 	DTEntry node;
 	uint64_t const *v;
 	unsigned int size;
-	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
-	    SecureDTGetProperty(node, name, (void const **)&v, &size) != kSuccess || size != 16) {
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) == kSuccess &&
+	    SecureDTGetProperty(node, name, (void const **)&v, &size) == kSuccess && size == 16) {
+		*data = (const uint8_t *)phystokv(v[0]);
+		*len = (uint32_t)v[1];
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(fw_files) / sizeof(fw_files[0]); i++) {
+		if (strcmp(fw_files[i].blob, name) == 0 && fw_files[i].data != NULL) {
+			*data = (const uint8_t *)fw_files[i].data;
+			*len = fw_files[i].len;
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The firmware from FW_DIR, once the root has it (the install boot: after the ROOTFIX), 300 s at most. */
+static bool
+fw_from_root(void)
+{
+	uint64_t t = now_ms();
+	char path[96];
+	int err = ENOENT;
+	while (now_ms() - t < 300000) {
+		snprintf(path, sizeof(path), "%s%s", FW_DIR, fw_files[0].file);
+		err = taimen_fw_load(path, 1u << 20, &fw_files[0].data, &fw_files[0].len);
+		if (err == 0) {
+			break;
+		}
+		IOSleep(1000);
+	}
+	if (err != 0) {
+		LOG("1: no payload blobs and no %sadsp.mdt after %llu s (%d)", FW_DIR, (now_ms() - t) / 1000, err);
 		return false;
 	}
-	*data = (const uint8_t *)phystokv(v[0]);
-	*len = (uint32_t)v[1];
+	uint64_t bytes = fw_files[0].len;
+	unsigned n = 1;
+	for (unsigned i = 1; i < sizeof(fw_files) / sizeof(fw_files[0]); i++) {
+		snprintf(path, sizeof(path), "%s%s", FW_DIR, fw_files[i].file);
+		if (taimen_fw_load(path, 16u << 20, &fw_files[i].data, &fw_files[i].len) == 0) {
+			bytes += fw_files[i].len;
+			n++;
+		}
+	}
+	LOG("1: firmware from the root (%s): %u files, %llu bytes, %llu ms after the thread asked", FW_DIR, n,
+	    bytes, now_ms() - t);
 	return true;
 }
 
+static void
+fw_release(void)
+{
+	for (unsigned i = 0; i < sizeof(fw_files) / sizeof(fw_files[0]); i++) {
+		taimen_fw_free(fw_files[i].data, fw_files[i].len);
+		fw_files[i].data = NULL;
+		fw_files[i].len = 0;
+	}
+}
