+/* LDOn's software enable off in the active set (TaimenModem's WLAN power cycle, icnss_hw_power_off). */
+bool sweet_rpm_ldoa_off(unsigned ldo);
+bool
+sweet_rpm_ldoa_off(unsigned ldo)
+{
+	uint32_t kv[2] = {0x6e657773u, 0u};                     /* swen = 0 */
+	char what[8];
+	snprintf(what, sizeof(what), "L%u", ldo);
+	lck_mtx_lock(&sweet_rpm_lock);
+	bool ok = rpm_request(what, 0, 0x616f646cu, ldo, kv, 1);       /* "ldoa" */
+	lck_mtx_unlock(&sweet_rpm_lock);
+	printf("SWEET RPM: L%u off: %s\n", ldo, ok ? "ok" : "FAILED");
+	return ok;
+}
