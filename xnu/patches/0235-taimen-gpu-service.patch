+/* The Pixel 1's fields (GPLL0 600 MHz / 1, 1.5, 2, 3) onto taimen's corners (0235). */
+static bool
+gfx_clock(uint32_t field)
+{
+	unsigned mhz = field == 1 ? 596 : field == 2 ? 414 : field == 3 ? 342 : 257;
+	return g_tgpu != 0 && taimen_gfx_set(g_tgpu, mhz);
